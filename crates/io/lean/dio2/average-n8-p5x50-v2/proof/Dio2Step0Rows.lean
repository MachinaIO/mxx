/-- The fresh plaintext of a refresh part: its own block of fresh cells. -/
noncomputable def freshError (fresh : Fin 900 → ErrorPoly 8) (part : Fin 36) :
    ErrorMatrix 8 1 25 :=
  fun _ column ↦ fresh ⟨25 * part.val + column.val, by omega⟩

/-- The common row of a refresh part, independent of the CRT prime. -/
noncomputable def rowValue {model : HashModel} (ctx : OnlineCtx model)
    (next : ErrorPoly 8) (target : Fin 36 → ErrorPoly 8) (fresh : Fin 900 → ErrorPoly 8)
    (part : Fin 36) : ExactMatrix modulus_0 8 1 25 :=
  reducePoly modulus_0 8 next • MxxExponentLut.rowOf (generatedRoot.w_872_3 ctx part) 0 +
    MxxExponentLut.rowOf (generatedRoot.w_872_3 ctx part) 1 -
    reducePoly modulus_0 8 (target part) • generatedRoot.w_57_0 ctx +
    reduceMatrix modulus_0 8 1 25 (freshError fresh part)

/-- The target premise of every refresh part, at its certified class budget. -/
def TargetRows {model : HashModel} (ctx : OnlineCtx model) (old : ErrorPoly 8)
    (target : Fin 36 → ErrorPoly 8) : Prop :=
  ∀ part : Fin 36, ∃ error : ErrorMatrix 8 1 25,
    CoeffBound error (Online0Assembly.targetBudget part) ∧
    generatedRoot.w_872_0 ctx part =
      maskPart (reducePoly modulus_0 8 old)
        ![generatedRoot.w_872_1 ctx part, generatedRoot.w_872_2 ctx part] -
      reducePoly modulus_0 8 (target part) • generatedRoot.w_57_0 ctx +
      reduceMatrix modulus_0 8 1 25 error

theorem rebase_self_eq {q r c : Nat} (hq : 1 < q) {G G' : ExactMatrix q 8 r c}
    (h : centeredRebaseRuns G G') : G' = G := by
  rw [centeredRebaseRuns_reduce h]
  exact reduceMatrix_centeredIntLift hq (by norm_num) G

/-! ## Packed source cells -/

/-- The component-one key of a packed source cell. -/
noncomputable def cellKey {C : Nat} (rows : Tup (ExactMatrix modulus_0 8 1 (C * 25)) 6)
    (cell : Fin C) : Fin 2 → ExactMatrix modulus_0 8 1 25 :=
  fun k ↦ Enc.A (blkT rows cell) k 1

theorem cell_rows {C : Nat} {rows : Tup (ExactMatrix modulus_0 8 1 (C * 25)) 6}
    {old payload : ErrorPoly 8} {t : Fin C → ErrorPoly 8}
    {G : ExactMatrix modulus_0 8 1 25} {B : Nat}
    (h : ∀ cell, EncRel old (blkT rows cell)
      (fun component ↦ reducePoly modulus_0 8 (t cell * unitPair payload component) • G) B) :
    ∃ error : Fin C → ErrorMatrix 8 1 25, (∀ cell, CoeffBound (error cell) B) ∧
      ∀ cell, blk (rows.get 5) cell = maskPart (reducePoly modulus_0 8 old) (cellKey rows cell) -
        reducePoly modulus_0 8 (t cell) • G + reduceMatrix modulus_0 8 1 25 (error cell) := by
  refine ⟨fun cell ↦ Classical.choose (h cell) 1,
    fun cell ↦ (Classical.choose_spec (h cell)).1 1, fun cell ↦ ?_⟩
  have equation := (Classical.choose_spec (h cell)).2 1
  have hc : Enc.c (blkT rows cell) 1 = blk (rows.get 5) cell := rfl
  rw [hc] at equation
  rw [equation]
  simp only [maskPart, cellKey, unitPair, Matrix.cons_val_one, Matrix.cons_val_fin_one, mul_one]

theorem cellsKey_cellKey0 {C : Nat} (rows : Tup (ExactMatrix modulus_0 8 1 (C * 25)) 6) :
    cellsKey (cellKey rows) 0 = rows.get 1 := by
  apply row_eq_of_blk
  intro cell
  rw [blk_cellsKey]
  rfl

theorem cellsKey_cellKey1 {C : Nat} (rows : Tup (ExactMatrix modulus_0 8 1 (C * 25)) 6) :
    cellsKey (cellKey rows) 1 = rows.get 3 := by
  apply row_eq_of_blk
  intro cell
  rw [blk_cellsKey]
  rfl

