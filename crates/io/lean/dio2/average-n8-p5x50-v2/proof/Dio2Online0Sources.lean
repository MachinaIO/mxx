noncomputable def sigmaKey {model : HashModel} {params : Params}
    (online : generatedRoot.Ctx Backend.backend model params) (key : Fin 2) :=
  Enc.A (sigmaRows online) key 1 * (generatedRoot.w_62_0 online)

noncomputable def oneKey {model : HashModel} {params : Params}
    (online : generatedRoot.Ctx Backend.backend model params) (key : Fin 2) :=
  labelKeysG model (generatedRoot.w_7_0 online) modulus_0 25 ([114, 110, 115, 45, 98, 103, 103, 47, 114, 111, 111, 116, 45, 105, 110, 112, 117, 116, 47, 100, 105, 111, 50, 47, 108, 97, 98, 101, 108, 45, 48])
