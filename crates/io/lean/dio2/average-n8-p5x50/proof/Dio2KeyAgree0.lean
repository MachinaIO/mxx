/-- A member of a packed family is the list's member. -/
theorem familyPack_get {α : Type} {size : Nat} {c : Int} {l : List α} {f : Fin size → α}
    (h : familyPack c l f) (j : Fin size) : ∃ hj : j.val < l.length, f j = l.get ⟨j.val, hj⟩ := by
  obtain ⟨-, -, h⟩ := h
  obtain ⟨p, hp, e⟩ := h j
  refine ⟨hp ▸ p.isLt, ?_⟩
  rw [e]
  congr 1
  exact Fin.ext hp

