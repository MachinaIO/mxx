      generatedRoot.w_985_0 ctx := by
    change localCtx.inputs.2.2.2.2.2.2.2.2.2.1 = _
    rw [hinputs]
    rfl
  have half_eq : parallel_generatedRoot_991.w_55_0 localCtx =
      (allCoefficients 904625697163682872125158399399175198226681342373069820760217620276403972497 : ExactMatrix modulus_0 8 1 25) := by
    change localCtx.inputs.2.2.2.2.2.2.2.2.2.2.2.2.1 = _
    rw [hinputs]
    rfl
  let packed (digit : Fin 1) (column : Fin 25) : ErrorPoly 8 :=
    readout ⟨0 + 125 * part.val + 4500 * digit.val + column.val, by omega⟩
  let coefficients (digit : Fin 1) (column : Fin 25)
      (coefficient : Fin 8) : Int := (packed digit column).coeff coefficient
  have packed_eq (digit : Fin 1) (column : Fin 25) :
      reducePoly modulus_0 8 (packed digit column) =
        reducePoly modulus_0 8 (intPoly (coefficients digit column)) := by
    congr 1
    apply negacyclic_ext (by omega)
    intro coefficient
    rw [intPoly_coeff (by omega)]
  apply smudge_hTH (d := 0) (by omega) (by norm_num)
    (half := 904625697163682872125158399399175198226681342373069820760217620276403972497) (by
      apply (ZMod.intCast_eq_intCast_iff (2 * 904625697163682872125158399399175198226681342373069820760217620276403972497) 1 1809251394327365744250316798798350396453362684746139641520435240552807944993).2
      norm_num [Int.ModEq]) coefficients packed packed_eq
    (fun digit column coefficient ↦ hodd _ coefficient)
    (fun digit column coefficient ↦ hbound _ coefficient) ?_ half_eq
  rw [← Fin.sum_univ_eq_sum_range]
  funext row column
  simp only [Matrix.sum_apply]
  apply Finset.sum_congr rfl
  intro digit _
  rw [smudgePartTarget0, dif_pos digit.isLt]
  change reducePoly modulus_0 8 (packed digit column) *
    (parallel_generatedRoot_991.w_49_0 localCtx digit) 0 0 = _
  rw [weights_eq, online0_smudge_weights ctx facts digit]
  norm_cast

