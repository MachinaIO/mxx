set_option maxRecDepth 1000000 in
set_option maxHeartbeats 0 in
theorem scatterList_eq : scatterList = List.ofFn (fun pair : Fin 11520 ↦
    (((pair / 45 + helperIdx (pair % 45)) % 256 : Nat) : Int)) := by
  decide +kernel

theorem scatterList_read (row lane : Nat) (row_bound : row < 256) (lane_bound : lane < 45) :
    MxxIR.selectInt (45 * Int.ofNat row + Int.ofNat lane) scatterList =
      (((row + helperIdx lane) % 256 : Nat) : Int) := by
  have index : 45 * Int.ofNat row + Int.ofNat lane = Int.ofNat (45 * row + lane) := by
    simp only [Int.ofNat_eq_natCast, Nat.cast_add, Nat.cast_mul, Nat.cast_ofNat]
  rw [index]
  unfold MxxIR.selectInt
  rw [scatterList_eq, show (Int.ofNat (45 * row + lane)).toNat = 45 * row + lane from rfl,
    List.getElem?_ofFn, dif_pos (show 45 * row + lane < 11520 by omega), Option.getD_some]
  have div : (45 * row + lane) / 45 = row := by omega
  have mod : (45 * row + lane) % 45 = lane := by omega
  simp only [div, mod]

noncomputable def indicator (index : Int) (rows : Nat) : ExactMatrix Q N rows 1 :=
  fun row _ ↦ if index = (row.val : Int) then 1 else 0

theorem indicator_scalar (index : Int) (offset : Nat) :
    liftInteger (q := Q) (n := N) (if decide (index = (offset : Int)) then 1 else 0) 0 0 =
      if index = (offset : Int) then 1 else 0 := by
  by_cases equal : index = (offset : Int) <;> simp [liftInteger, equal]

theorem indicator_concat {count : Nat} {index : Int}
    {left : ExactMatrix Q N count 1} {right : ExactMatrix Q N 1 1}
    {output : ExactMatrix Q N (count + 1) 1}
    (left_eq : left = indicator index count)
    (right_eq : right 0 0 = if index = (count : Int) then 1 else 0)
    (concat : concatRows left right output) : output = indicator index (count + 1) := by
  funext row column
  rw [Subsingleton.elim column 0, concat]
  split_ifs with bound
  · rw [left_eq]
    rfl
  · have value : row.val = count := by omega
    rw [Subsingleton.elim (⟨row.val - count, by omega⟩ : Fin 1) 0, right_eq]
    simp only [indicator, value]

noncomputable def scatterTerm (model : HashModel) (key : ByteArray)
    (packed : ExactMatrix Q N 60 45) (row : Fin 256) (lane : Fin 45) :
    ExactMatrix Q N 256 1 := fun target _ ↦
  (if target = row then
    (substituteMatrix (slotAut row) (slotAut_odd row)
      (joinRow (helperKey model key (kHelp lane) 0)) * packed) 0 lane else 0) -
  (if target.val = (row.val + helperIdx lane) % 256 then (gZero * packed) 0 lane else 0)

