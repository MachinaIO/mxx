/-- The error entering block `12`. -/
noncomputable def err12 (tape : SampleTape) : Fin 2 → ErrorMatrix N 1 92 :=
  ∑ i : Fin 113, fun j ↦ divInt P25 (numerM11 model key ext tape i j) -
