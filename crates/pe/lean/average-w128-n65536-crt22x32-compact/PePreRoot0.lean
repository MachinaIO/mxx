  have hint := fun b : Fin 15 ↦ PreInt0.internalKey b.isLt (F.c4.h47_3 b)
  refine ⟨hM, fun d1 hk h0 h1 b r jj ↦ ?_, fun d1 d2 hk1 h10 h11 hk2 h20 h21 ↦ ⟨fun l r jj ↦ ?_, ?_⟩⟩
  · have e : ![d1.Tb0 b b.isLt, d1.Tb1 b b.isLt] r 0 jj =
