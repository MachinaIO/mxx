/-- The rounded anchor `b - B^(2)` over `R_Q`. -/
noncomputable def roundedAnchor (model : HashModel) (key : ByteArray) (bQ : ExactMatrix PQ N 1 501) :
    ExactMatrix Q N 1 501 :=
  modulusSwitch bQ - modulusSwitch (anchorSecond model key)

/-- The decompressed anchor difference `b'' - B''^(2)`. -/
noncomputable def compressedAnchor (model : HashModel) (key : ByteArray) (bQ : ExactMatrix PQ N 1 501) :
    ExactMatrix Q N 1 44 :=
  expand (fun _ _ ↦ bQ 0 0) - expand (fun _ _ ↦ anchorSecond model key 0 0)

set_option maxRecDepth 200000 in
set_option maxHeartbeats 64000000 in
/-- Decryption: the phase and its bits. -/
theorem decode_phase {model : HashModel} {tape : SampleTape} {path : List Nat}
    {ctx : Stage_decode.generatedRoot.Ctx Backend.backend model tape path GeneratedClaim.stage_8_params}
    {o : Fin N → Int} (F : Stage_decode.generatedRoot.Facts ctx o) :
    let key := Stage_decode.generatedRoot.w_1_0 ctx
    let bQ := Stage_decode.generatedRoot.w_5_0 ctx
    let phase := (Stage_decode.generatedRoot.w_0_0 ctx - messageRow model key 1) -
      (∑ i : Fin 128, substituteMatrix (slotAut i) (slotAut_odd i) (roundedAnchor model key bQ * anchorIn ctx i) +
        ∑ i : Fin 128, substituteMatrix (slotAut i) (slotAut_odd i) (compressedAnchor model key bQ) *
          Stage_decode.generatedRoot.w_537_0 ctx i +
        ∑ p : Fin 4736, helperValue model key (Stage_decode.generatedRoot.w_541_0 ctx)
          (Stage_decode.generatedRoot.w_542_0 ctx) p * Stage_decode.generatedRoot.w_546_0 ctx p +
        (joinRow ![Stage_decode.generatedRoot.w_549_0 ctx, Stage_decode.generatedRoot.w_550_0 ctx] -
          joinRow ![Stage_decode.generatedRoot.w_552_0 ctx, Stage_decode.generatedRoot.w_553_0 ctx]) *
          Stage_decode.generatedRoot.w_556_0 ctx)
    ∀ k : Fin N, o k = ((2 * (((phase 0 0).coeff k).val : Int) + (Q : Int) / 2) / (Q : Int)) % 2 := by
  intro key bQ phase
  have e2 : Stage_decode.generatedRoot.w_2_0 ctx = messageRow model key 1 := hashSample_eq F.c0.h2_0
  have e7 : Stage_decode.generatedRoot.w_7_0 ctx = anchorSecond model key := hashSample_eq F.c0.h7_0
  have e6 := F.c0.h6_0.2.2.2.2
  have e8 := F.c0.h8_0.2.2.2.2
  rw [e7] at e8
  have e9 : Stage_decode.generatedRoot.w_9_0 ctx = roundedAnchor model key bQ := by
    show matrixSub _ _ = _
    rw [e6, e8]
    rfl
  have hA := anchorContract F
  rw [e9] at hA
  obtain ⟨_, e523⟩ := sliceMatrix_column F.c4.h523_0
  obtain ⟨_, e530⟩ := sliceMatrix_column F.c4.h530_0
  have e529 : Stage_decode.generatedRoot.w_529_0 ctx = anchorSecond model key := hashSample_eq F.c4.h529_0
  have e527 : Stage_decode.generatedRoot.w_527_0 ctx = expand (fun _ _ ↦ bQ 0 0) := by
    rw [expand_read F.c4.h524_0 F.c4.h525_0 F.c4.h527_0]
    congr 1
    funext a b
    rw [Subsingleton.elim a 0, Subsingleton.elim b 0, e523]
    rfl
  have e534 : Stage_decode.generatedRoot.w_534_0 ctx = expand (fun _ _ ↦ anchorSecond model key 0 0) := by
    rw [expand_read F.c4.h531_0 F.c4.h532_0 F.c4.h534_0]
    congr 1
    funext a b
    rw [Subsingleton.elim a 0, Subsingleton.elim b 0, e530, e529]
    rfl
  have e536 : Stage_decode.generatedRoot.w_536_0 ctx = compressedAnchor model key bQ := by
    show matrixSub (Stage_decode.generatedRoot.w_527_0 ctx) (Stage_decode.generatedRoot.w_534_0 ctx) = _
    rw [e527, e534]
    rfl
  have hC := compactLoop F.c4.h538_0
  rw [e536] at hC
  have e544 := gadgetMatrixRuns_unique F.c4.h544_0 g0_runs
  have h545 := F.c4.h545_0
  rw [e544] at h545
  have e545 : Stage_decode.generatedRoot.w_545_0 ctx = zeroG := concat_joinRow (r := ![0, g0]) h545
  have h547 := F.c4.h547_0
  rw [e545] at h547
  have hH := helperContract h547
  have e551 := concat_joinRow (r := ![_, _]) F.c4.h551_0
  have e554 := concat_joinRow (r := ![_, _]) F.c5.h554_0
  have hphase : Stage_decode.generatedRoot.w_559_0 ctx = phase := by
    show matrixSub (matrixSub (Stage_decode.generatedRoot.w_0_0 ctx) (Stage_decode.generatedRoot.w_2_0 ctx))
