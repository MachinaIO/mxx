    {g' : ExactMatrix q n 1 m} (hg' : gadgetMatrixRuns backend base digits g')
    {g : ExactMatrix q n 1 m} (hg : centeredRebaseRuns g' g) {B Bh : Nat}
    (henc : Rel sm ![![a00, a01], ![a10, a11]]
