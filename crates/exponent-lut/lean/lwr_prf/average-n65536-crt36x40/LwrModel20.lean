/-- The numerator `A v` of the alignment of a member of `a`: its error after the digits `H`, minus
the row residue, plus the mask-weighted key residues. -/
noncomputable def alignNumer20 (sm : ErrorPoly N) (mk : Fin 2 → Fin 2 → ExactMatrix Q36 N 1 144)
    (ea : Fin 2 → ErrorMatrix N 1 144) (row : Fin 2 → ExactMatrix Q36 N 1 144) (j : Fin 2) :
    ErrorMatrix N 1 64 :=
  ea j * liftMatrix alignDigits20 - downResidue A16 (row j * alignDigits20) +
    sm • downResidue A16 (mk 0 j * alignDigits20) + downResidue A16 (mk 1 j * alignDigits20)

/-- The numerator `p v` of a block-1 cell. -/
noncomputable def cellNumer20 (sm : ErrorPoly N) (mk : Fin 2 → Fin 2 → ExactMatrix Q36 N 1 144)
    (va : Fin 2 → ErrorMatrix N 1 64) (es : Fin 2 → ErrorMatrix N 1 60) (α : ErrorPoly N)
    (As : Fin 2 → Fin 2 → ExactMatrix Q16 N 1 60) (top bot : Fin 2 → ExactMatrix Q15 N 1 56)
    (crow : Fin 2 → ExactMatrix Q16 N 1 64) (cs : Fin 2 → ExactMatrix Q16 N 1 60)
    (pay : ExactMatrix Q16 N 1 1) (j : Fin 2) : ErrorMatrix N 1 56 :=
  pairMul (fun j' ↦ pairMul va (liftMatrix (pubDigits20 As j')) + α • es j')
      (liftMatrix (rhsDigits20 top bot j)) -
    downResidue P16 (pairMul (fun j' ↦ pairMul crow (pubDigits20 As j') +
      matrixMulScalarRight (cs j') pay) (rhsDigits20 top bot j)) +
    sm • downResidue P16 (cellKeyUp20 mk As top bot 0 j) + downResidue P16 (cellKeyUp20 mk As top bot 1 j)

