/-- The error entering block `25`. -/
noncomputable def err25 (tape : SampleTape) : Fin 2 → ErrorMatrix N 1 40 :=
  ∑ i : Fin 113, fun j ↦ divInt P12 (numerM24 model key ext tape i j) -
    (alphaOf ext ⟨coords 24 i, coords_lt 24 i⟩ * muOf ext 24) • rhsError24 tape [2] i j

/-- The alignment and cell numerators of block `24` are divisible by their dropped factors. -/
def div24 (tape : SampleTape) : Prop :=
  (∀ i j row column, alignM24 model key ext tape i j row column =
    ((A12 : Int) : ErrorPoly N) * divInt A12 (alignM24 model key ext tape i j) row column) ∧
  ∀ i j row column, numerM24 model key ext tape i j row column =
    ((P12 : Int) : ErrorPoly N) * divInt P12 (numerM24 model key ext tape i j) row column

