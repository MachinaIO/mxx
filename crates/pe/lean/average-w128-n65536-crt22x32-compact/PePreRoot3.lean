theorem preLeafT_leaf_3 (ctx : generatedRoot.Ctx Backend.backend model tape path params)
    (leaf : Fin 105) (r : Fin 2) :
    groupedPreLeafRows (preLeafT_3 ctx) r leaf =
      preLeafGroups_3 ctx ⟨(1 + leaf.val % 15) / 4, by omega⟩
        ⟨(1 + leaf.val % 15) % 4, by omega⟩ r ⟨leaf.val / 15, by omega⟩ := by
  unfold groupedPreLeafRows
  rw [← preLeafT_chunk_3]
  congr 1
  apply Fin.ext
  simp only
  omega

