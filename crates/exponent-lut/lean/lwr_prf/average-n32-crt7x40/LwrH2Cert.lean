/-!
# The average-case certificate under H2

Generated by `generator/gen_h2_cert.py`. A run whose decoded coefficient is below the threshold
decodes the ideal output; the decoded coefficient is the remainder plus the sum over the H2 sites;
under H2 (`LwrH2`), the tail of that form at the threshold is below `2^-100`.
-/

namespace LwrProof

open Mxx.Primitives MxxRuntime MxxExponentLut

set_option maxRecDepth 1000000

/-- The threshold of the decoded coefficient. -/
def h2Threshold : ℝ := 3175328153

/-- The numbering of the H2 sites. -/
noncomputable def siteIdx (j : Site) : ℕ := (Fintype.equivFin Site j).val

theorem siteIdx_injective : Function.Injective siteIdx :=
  Fin.val_injective.comp (Fintype.equivFin Site).injective

/-- H2 for `lwr_prf`: replacing the residues of the H2 sites by independent uniforms does not
decrease the tail of the decoded coefficient at the threshold. -/
def LwrH2 : Prop :=
  ∀ (model : HashModel) (external : GeneratedClaim.ExternalInputs),
    ResidueReplacement siteIdx (fun j tape ↦ siteRho model external.input_0 external j tape) siteH
      (remainder model external.input_0 external)
      (fun j tape ↦ siteG model external.input_0 external j tape) h2Threshold

variable {tape : SampleTape}

/-- The selected sum of the ideal output is the exponent of the LUT input of the model. -/
theorem selectedSum_eq {model : HashModel} {external : GeneratedClaim.ExternalInputs}
    {execution : GeneratedClaim.Execution} (hruns : GeneratedClaim.Runs model external tape execution) :
    selectedSum external.input_3 ![external.input_6, external.input_8, external.input_10, external.input_12, external.input_14] = (zOf external 5 : Int) := by
  obtain ⟨hvalid, -, -, -, -, -, -, -, -, -⟩ := hruns
  obtain ⟨-, -, -, ha, -, -, hs0, -, hs1, -, hs2, -, hs3, -, hs4, -⟩ := hvalid
  have hnn : 0 ≤ ∑ b : Fin 5, ∑ i : Fin 14, selOf external b i *
      external.input_3 ⟨coords b i, coords_lt b i⟩ := by
    refine Finset.sum_nonneg fun b _ ↦ Finset.sum_nonneg fun i _ ↦ mul_nonneg ?_ (ha _).1
    fin_cases b
    exacts [(hs0 i).1, (hs1 i).1, (hs2 i).1, (hs3 i).1, (hs4 i).1]
  rw [zOf, Finset.filter_true_of_mem fun b _ ↦ b.isLt, Int.toNat_of_nonneg hnn]
  rfl

theorem divisible_of_runs {model : HashModel} {external : GeneratedClaim.ExternalInputs}
    {execution : GeneratedClaim.Execution} (hruns : GeneratedClaim.Runs model external tape execution) :
    Divisible model external.input_0 external tape := by
  obtain ⟨w, -, hd0, hd1, hd2, hd3, hd4, hdL, -, -⟩ := chainFinal hruns
  exact ⟨hd0, hd1, hd2, hd3, hd4, hdL⟩

theorem finalDigits_of_runs {model : HashModel} {external : GeneratedClaim.ExternalInputs}
    {execution : GeneratedClaim.Execution} (hruns : GeneratedClaim.Runs model external tape execution) :
    FinalDigits := by
  obtain ⟨w, -, -, -, -, -, -, -, ⟨d, hd, hdb, hdc, G, hG, hrec⟩, -⟩ := chainFinal hruns
  intro c
  rw [hd]
  exact (column_l1_constant_le hdb hdc c).trans (by norm_num)

set_option maxRecDepth 100000 in
set_option maxHeartbeats 64000000 in
/-- A run whose decoded coefficient is below the threshold decodes the ideal output. -/
theorem correct_of_small {model : HashModel} {external : GeneratedClaim.ExternalInputs}
    {execution : GeneratedClaim.Execution} (hruns : GeneratedClaim.Runs model external tape execution)
    (hsmall : |estar model external.input_0 external tape| < h2Threshold) :
    execution.«stage_5» = execution.«ideal» := by
  have hz := selectedSum_eq hruns
  obtain ⟨w, hb, -, -, -, -, -, -, -, hrel⟩ := chainFinal hruns
  obtain ⟨-, -, hmask, -, -, -, hdec, -, hideal, -⟩ := hruns
  have hid := ideal_value hideal
  have hsmM := mask_model hmask
  have hb2 := hb
  unfold Stage_online_eval.generatedRoot.body at hb2
  extract_lets at hb2
  have houtOnlineEval := hb2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2
  obtain ⟨wd, hd⟩ := hdec
  unfold Stage_decode.generatedRoot.body at hd
  dsimp only at hd
  obtain ⟨hm1, hm2, -, hdec1, hout⟩ := hd
  rw [hsmM] at hm1
  have hw2 := modulusReduce_poly hQ7 hQ1 hN hm1
  have hw6 := modulusReduce_one hQ7 hQ1 hN hm2
  have hcoef : |((finalErr model external.input_0 external tape 1 0 0).coeff ⟨0, hN⟩ : ℤ)| < 3175328153 := by
    have he : estar model external.input_0 external tape =
        (((finalErr model external.input_0 external tape 1 0 0).coeff ⟨0, hN⟩ : ℤ) : ℝ) :=
      pairing_coeffZero hN _
    have h := hsmall
    rw [he, h2Threshold] at h
    exact_mod_cast h
  have hval := decode_terminal_scaledE (t := 8) (k := 137170518016) (r := 2147481921) (W := 3)
    hQ1 hN (by norm_num) (by norm_num) hrel (i := ⟨0, hN⟩) (by push_cast; omega)
    (lutValue_coeff_bound _) (by
      rw [houtOnlineEval, hw2, hw6]
      funext r c
      obtain rfl : r = 0 := Subsingleton.elim _ _
      obtain rfl : c = 0 := Subsingleton.elim _ _
      simp only [matrixNeg, matrixSub, matrixAdd, matrixMulScalarLeft_eq, Matrix.neg_apply,
        Matrix.sub_apply, Matrix.add_apply, Matrix.smul_apply, smul_eq_mul, Matrix.one_apply_eq,
        one_mul]
      rfl) hdec1
  rw [hout, hval, Nat.cast_ofNat, readout_mod8, hid, hz]

/-- The average-case correctness claim under H2. -/
theorem certificateH2 (hH2 : LwrH2) : GeneratedClaim.CorrectnessClaim := by
  classical
  intro model external
  by_cases hrun : ∃ t e, GeneratedClaim.Runs model external t e
  swap
  · have hempty : {t | ∃ execution, GeneratedClaim.Runs model external t execution ∧
        ¬ execution.«stage_5» = execution.«ideal»} = ∅ := by
      ext t
      simp only [Set.mem_setOf_eq, Set.mem_empty_iff_false, iff_false]
      rintro ⟨e, hr, -⟩
      exact hrun ⟨t, e, hr⟩
    rw [hempty, MeasureTheory.measure_empty]
    exact zero_le _
  obtain ⟨t0, e0, hr0⟩ := hrun
  have hF := finalDigits_of_runs hr0
  have hsub : {t | ∃ execution, GeneratedClaim.Runs model external t execution ∧
      ¬ execution.«stage_5» = execution.«ideal»} ⊆
      {t | h2Threshold ≤ |remainder model external.input_0 external t +
        ∑ j, siteG model external.input_0 external j t * (siteRho model external.input_0 external j t : ℝ)|} := by
    rintro t ⟨e, hr, hne⟩
    simp only [Set.mem_setOf_eq]
    by_contra hlt
    push_neg at hlt
    rw [← decomposition model external.input_0 external t (divisible_of_runs hr)] at hlt
    exact hne (correct_of_small hr hlt)
  refine (MeasureTheory.measure_mono hsub).trans ?_
  refine (h2_tail siteIdx_injective (hH2 model external)
    (remainder_le model external.input_0 external hF) (by rw [h2Threshold]; norm_num) siteKeys
    (fun j ↦ residue_not_site _ _) (siteG_dependsOn model external.input_0 external)
    (energyRow_le model external.input_0 external hF) [1, 0] preKeys (fun k ↦ mask_not_pre _)
    (fun x ↦ uKey_dependsOn model external.input_0 external x)
    (fun x t ↦ keyForm model external.input_0 external t x)
    (τ := 14) (by norm_num) (energyKey_le model external.input_0 external hF) (by norm_num)).trans ?_
  have hcard : Fintype.card KeySite = 32256 := by
    simp only [KeySite, Fintype.card_sum, Fintype.card_prod, Fintype.card_fin, N]
  rw [hcard]
  refine ennreal_tail_le (by positivity) (by positivity) ?_
  have h1 : 2 * Real.exp (-(14 : ℝ) ^ 2 / 2) ≤ 2 * (10 / 27 : ℝ) ^ 98 := by
    have := exp_le_of_le_neg_nat 98 (x := -(14 : ℝ) ^ 2 / 2) (by norm_num)
    linarith
  have h2 : 2 * Real.exp (-(h2Threshold - (907735648 : ℝ)) ^ 2 / (2 * ((6047369789440 : ℝ) + (36205049591889920 : ℝ)))) ≤
      2 * (10 / 27 : ℝ) ^ 71 := by
    have := exp_le_of_le_neg_nat 71
      (x := -(h2Threshold - (907735648 : ℝ)) ^ 2 / (2 * ((6047369789440 : ℝ) + (36205049591889920 : ℝ))))
      (by rw [h2Threshold]; norm_num)
    linarith
  calc (32256 : ℕ) * (2 * Real.exp (-(14 : ℝ) ^ 2 / 2)) +
        2 * Real.exp (-(h2Threshold - (907735648 : ℝ)) ^ 2 / (2 * ((6047369789440 : ℝ) + (36205049591889920 : ℝ))))
      ≤ (32256 : ℕ) * (2 * (10 / 27 : ℝ) ^ 98) + 2 * (10 / 27 : ℝ) ^ 71 := by
        gcongr
    _ ≤ (1 / 2 : ℝ) ^ 100 := by norm_num

