  have hq : 1 < modulus_0 := by decide
  have gadget : parallel_generatedRoot_991.w_220_0 local_ = generatedRoot.w_57_0 ctx :=
    gadgetMatrixRuns_unique pf.c5.h220_0 R.gadget
  have gadgetLift : parallel_generatedRoot_991.w_221_0 local_ = generatedRoot.w_57_0 ctx :=
    (rebase_self_eq hq pf.c5.h221_0).trans gadget
  have gadgetIn := input_w_31_0 local_ hin
