    (hs : ∀ k : Fin W, s (o * W + k) = if k = sel then 1 else 0) :
    (∑ k ∈ Finset.range W, s ((Int.ofNat o * (W : Int) + Int.ofNat k).toNat) * a (t ((Int.ofNat o * (W : Int) + Int.ofNat k).toNat)).toNat) =
