    · rw [eb]; exact hR
    · rw [ec]; exact hR
    · rw [ed]; exact hR
  have hM : ∀ r (j : Fin 2) (l : Fin 44), preM_0 ctx r j 0 l =
      ∑ a, keyCompanionSum model (generatedRoot.w_3_0 ctx) p A r ⟨44 * (j : Nat) + l, by omega⟩ a +
      ∑ a : Fin 44, A r 0 0 a *
        rowDigits (joinRow ![rhsTop model (generatedRoot.w_3_0 ctx) p 0,
          rhsTop model (generatedRoot.w_3_0 ctx) p 1]) a ⟨44 * (j : Nat) + l, by omega⟩ := by
    intro r j l
    unfold preM_0
    rw [select_four F.c1.h25_0 hw1, select_four F.c2.h30_0 hw1, select_four F.c3.h35_0 hw1,
      select_four F.c4.h40_0 hw1]
    fin_cases p
    · exact P0 r j l
    · exact P1 r j l
    · exact P2 r j l
    · exact P3 r j l
  -- The LUT key rows.
  have hM0 : concatColumns (preM_0 ctx 0 0) (preM_0 ctx 0 1) (generatedRoot.w_42_0 ctx) := F.c4.h42_0
  have hM1 : concatColumns (preM_0 ctx 1 0) (preM_0 ctx 1 1) (generatedRoot.w_43_0 ctx) := F.c4.h43_0
  have hT1 := lut_T1 (model := model) hM0 hM1 rfl (fun r q ↦ PreLut0.lutTopLoop F.c4.h44_1 r q)
