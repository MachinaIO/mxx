import PeOnlineGlue
import PePreGlue
import PePreRootLayout
import PePreSum«s»
import PePreLaneI«s»
import PePreLaneL«s»
import PePreLaneM«s»
import PePreRootKey«s»_0
import PePreRootKey«s»_1

/-!
# Preprocessing step «s» at the root

Generated by `gen_pre_root.py` from `PePreRoot.lean.in`. From the incoming key `A`: the product
key of the position of step «s», the key rows of every first-depth branch (lanes
`parallel_generatedRoot_«I»` and grouped `parallel_generatedRoot_«L»`), and the output key
from the member sums. Group zero slot zero is a first-depth leaf. Second-depth leaf `l`
uses group `(1 + l % 15) / 4`, local slot `(1 + l % 15) % 4`, and member `l / 15`.
The sixteen-slot view below flattens these four consecutive groups.
-/

namespace PeProof

open Mxx.Primitives MxxRuntime MxxExponentLut MxxPe Stage_preprocess

variable {model : HashModel} {tape : SampleTape} {path : List Nat} {params : Params}

/-- The product key of preprocessing step «s». -/
noncomputable def preM_«s» (ctx : generatedRoot.Ctx Backend.backend model tape path params) :
    Fin 2 → Fin 2 → ExactMatrix Q N 1 44 :=
  ![![generatedRoot.w_«m00»_0 ctx, generatedRoot.w_«m01»_0 ctx],
    ![generatedRoot.w_«m10»_0 ctx, generatedRoot.w_«m11»_0 ctx]]

/-- Published T families, indexed by flattened slot, row, then member. -/
def preLeafT_«s» (ctx : generatedRoot.Ctx Backend.backend model tape path params) :
    Fin 16 → Fin 2 → Fin 7 → ExactMatrix Q N 1 88 :=
  «families»

/-- The physical group/local-slot/row/member artifact layout. -/
def preLeafGroups_«s» (ctx : generatedRoot.Ctx Backend.backend model tape path params) :
    Fin 4 → Fin 4 → Fin 2 → Fin 7 → ExactMatrix Q N 1 88 :=
  «group_families»

theorem preLeafT_chunk_«s» (ctx : generatedRoot.Ctx Backend.backend model tape path params)
    (group slot : Fin 4) (r : Fin 2) (member : Fin 7) :
    preLeafT_«s» ctx ⟨4 * group.val + slot.val, by omega⟩ r member =
      preLeafGroups_«s» ctx group slot r member := by
  exact «chunk_proof» group slot

theorem preLeafT_leaf_«s» (ctx : generatedRoot.Ctx Backend.backend model tape path params)
    (leaf : Fin 105) (r : Fin 2) :
    groupedPreLeafRows (preLeafT_«s» ctx) r leaf =
      preLeafGroups_«s» ctx ⟨(1 + leaf.val % 15) / 4, by omega⟩
        ⟨(1 + leaf.val % 15) % 4, by omega⟩ r ⟨leaf.val / 15, by omega⟩ := by
  unfold groupedPreLeafRows
  rw [← preLeafT_chunk_«s»]
  congr 1
  apply Fin.ext
  simp only
  omega

/-- The sum of the four group outputs for one member. -/
noncomputable def preLeafKey_«s» (ctx : generatedRoot.Ctx Backend.backend model tape path params)
    (r j : Fin 2) (member : Fin 7) : ExactMatrix Q N 1 44 :=
    «leafKeys»

set_option maxRecDepth 200000 in
set_option maxHeartbeats 0 in
theorem pre_root«s» {ctx : generatedRoot.Ctx Backend.backend model tape path params}
    {outputs : _} (F : generatedRoot.Facts ctx outputs)
    {A : Fin 2 → Fin 2 → ExactMatrix Q N 1 44}
    (hA0 : concatColumns (A 0 0) (A 0 1) (generatedRoot.w_«A0»_0 ctx))
    (hA1 : concatColumns (A 1 0) (A 1 1) (generatedRoot.w_«A1»_0 ctx))
    (p : Fin 2) (hp : generatedRoot.w_0_0 ctx «s» = p) :
    (∀ r (j : Fin 2) (l : Fin 44), preM_«s» ctx r j 0 l =
      ∑ a, keyCompanionSum model (generatedRoot.w_3_0 ctx) p A r ⟨44 * (j : Nat) + l, by omega⟩ a +
      ∑ a : Fin 44, A r 0 0 a *
        rowDigits (joinRow ![rhsTop model (generatedRoot.w_3_0 ctx) p 0,
          rhsTop model (generatedRoot.w_3_0 ctx) p 1]) a ⟨44 * (j : Nat) + l, by omega⟩) ∧
    (∀ d1 : BranchData, d1.key = generatedRoot.w_3_0 ctx →
      d1.TI0 = generatedRoot.w_«I»_0 ctx → d1.TI1 = generatedRoot.w_«I»_1 ctx →
      d1.TL0 = generatedRoot.w_«L»_0 ctx → d1.TL1 = generatedRoot.w_«L»_1 ctx →
      ∀ (b : Fin 22) r jj, ![d1.Tb0 b b.isLt, d1.Tb1 b b.isLt] r 0 jj =
        ∑ a, lutKeyCompanionSum model (generatedRoot.w_3_0 ctx) b (preM_«s» ctx) r jj a +
        ∑ a : Fin 44, substitution (kSw b) (kSw_odd b) (preM_«s» ctx r 0 0 a) *
          rowDigits (switchTopRow model (generatedRoot.w_3_0 ctx) b) a jj) ∧
    (∀ (d1 : BranchData) (d2 : Leaf2Data), d1.key = generatedRoot.w_3_0 ctx →
      d1.TI0 = generatedRoot.w_«I»_0 ctx → d1.TI1 = generatedRoot.w_«I»_1 ctx →
      d1.TL0 = generatedRoot.w_«L»_0 ctx → d1.TL1 = generatedRoot.w_«L»_1 ctx →
      d2.key = generatedRoot.w_3_0 ctx → d2.T0 = groupedPreLeafRows (preLeafT_«s» ctx) 0 →
      d2.T1 = groupedPreLeafRows (preLeafT_«s» ctx) 1 →
      (∀ (l : Fin 105) r jj, ![d2.Tb0 l l.isLt, d2.Tb1 l l.isLt] r 0 jj =
        ∑ a, lutKeyCompanionSum model (generatedRoot.w_3_0 ctx) (member2 l l.isLt)
          (d1.key1 model ⟨l % 15, by omega⟩) r jj a +
        ∑ a : Fin 44, substitution (kSw (15 + l / 15)) (kSw_odd (member2 l l.isLt))
          (d1.key1 model ⟨l % 15, by omega⟩ r 0 0 a) *
          rowDigits (switchTopRow model (generatedRoot.w_3_0 ctx) (member2 l l.isLt)) a jj) ∧
      keyOf (generatedRoot.w_«k0»_0 ctx, generatedRoot.w_«k1»_0 ctx, generatedRoot.w_«k2»_0 ctx,
          generatedRoot.w_«k3»_0 ctx, ()) =
        stepKey model (preM_«s» ctx) d1 d2
          (fun k ↦ branchCoef«C_» (generatedRoot.w_43_0 ctx) «off» k (by norm_num))) := by
  -- The position of the step.
  have hw1 : generatedRoot.w_«posW»_0 ctx = ((p : Nat) : Int) := by
    rw [familyStatic_four (k := «s») (by norm_num) @@h«posW»_0@@, ← hp]
    rfl
@@POS@@
  -- The product key at row `r`, block `j` of each position.
  have P«q» : ∀ r (j : Fin 2) (l : Fin 44),
      ![![generatedRoot.w_«sa»_0 ctx, generatedRoot.w_«sb»_0 ctx],
        ![generatedRoot.w_«sc»_0 ctx, generatedRoot.w_«sd»_0 ctx]] r j 0 l =
      ∑ a, keyCompanionSum model (generatedRoot.w_3_0 ctx) «q» A r ⟨44 * (j : Nat) + l, by omega⟩ a +
      ∑ a : Fin 44, A r 0 0 a *
        rowDigits (joinRow ![rhsTop model (generatedRoot.w_3_0 ctx) «q» 0,
          rhsTop model (generatedRoot.w_3_0 ctx) «q» 1]) a ⟨44 * (j : Nat) + l, by omega⟩ := by
    have R := pos_rows hA0 hA1
      (comp := fun k jj a ↦ keyCompanionSum model (generatedRoot.w_3_0 ctx) «q» A k jj a)
      (X := joinRow ![rhsTop model (generatedRoot.w_3_0 ctx) «q» 0, rhsTop model (generatedRoot.w_3_0 ctx) «q» 1])
      (fun r w ↦ PreKey«s»_«q».topStep (tape := tape) (path := path)
        (params := params) (by norm_num) (iter_one @@h«top»_1@@) r w)
      (fun k jj ↦ PreKey«s»_«q».keyLoop (tape := tape) (path := path)
        (params := params) hA0 hA1 @@h«key»_1@@ k jj)
    intro r j l
    have ea := sliceMatrix_window 0 @@h«sa»_0@@ rfl (by omega)
    have eb := sliceMatrix_window 44 @@h«sb»_0@@ rfl (by omega)
    have ec := sliceMatrix_window 0 @@h«sc»_0@@ rfl (by omega)
    have ed := sliceMatrix_window 44 @@h«sd»_0@@ rfl (by omega)
    have hR := R r ⟨44 * (j : Nat) + l, by omega⟩
    fin_cases r <;> fin_cases j
    · rw [ea]; exact hR
    · rw [eb]; exact hR
    · rw [ec]; exact hR
    · rw [ed]; exact hR
@@ENDPOS@@
  have hM : ∀ r (j : Fin 2) (l : Fin 44), preM_«s» ctx r j 0 l =
      ∑ a, keyCompanionSum model (generatedRoot.w_3_0 ctx) p A r ⟨44 * (j : Nat) + l, by omega⟩ a +
      ∑ a : Fin 44, A r 0 0 a *
        rowDigits (joinRow ![rhsTop model (generatedRoot.w_3_0 ctx) p 0,
          rhsTop model (generatedRoot.w_3_0 ctx) p 1]) a ⟨44 * (j : Nat) + l, by omega⟩ := by
    intro r j l
    unfold preM_«s»
    rw [select_two @@h«m00»_0@@ hw1, select_two @@h«m01»_0@@ hw1, select_two @@h«m10»_0@@ hw1,
      select_two @@h«m11»_0@@ hw1]
    fin_cases p
    · exact P0 r j l
    · exact P1 r j l
  -- The lanes of the LUT depths.
  have hM0 : concatColumns (preM_«s» ctx 0 0) (preM_«s» ctx 0 1) (generatedRoot.w_«M0»_0 ctx) := @@h«M0»_0@@
  have hM1 : concatColumns (preM_«s» ctx 1 0) (preM_«s» ctx 1 1) (generatedRoot.w_«M1»_0 ctx) := @@h«M1»_0@@
  have LI := fun b : Fin 15 ↦ PreLaneI«s».lane b.isLt hM0 hM1 (@@h«I»_9@@ b)
  have LL := fun m : Fin 7 ↦ PreLaneM«s».lane m.isLt hM0 hM1
    (@@h«L»_11@@ m) (@@h«L1»_11@@ m) (@@h«L2»_11@@ m) (@@h«L3»_11@@ m)
  have hRows : ∀ (m : Fin 7) (slot : Fin 16) r jj,
      preLeafT_«s» ctx slot r m 0 jj = lutTRow model (generatedRoot.w_3_0 ctx)
        ⟨15 + m, by omega⟩ (PreLaneM«s».inputsKey (preM_«s» ctx)
          (generatedRoot.w_«I»_2 ctx) (generatedRoot.w_«I»_3 ctx)
          (generatedRoot.w_«I»_4 ctx) (generatedRoot.w_«I»_5 ctx) slot) r jj := by
    intro m slot r jj
    exact (LL m).1 slot r jj
  refine ⟨hM, fun d1 hk h0 h1 h2 h3 b r jj ↦ ?_, fun d1 d2 hk h0 h1 h2 h3 hk2 h20 h21 ↦ ⟨fun l r jj ↦ ?_, ?_⟩⟩
  · exact branch_rows d1 (fun b r jj ↦ (LI b).1 r jj)
      (fun m r jj ↦ hRows m 0 r jj) h0 h1 h2 h3 b r jj
  · have hK := parent_keys (model := model) d1 hk h0 h1 (fun e r j ↦ (LI e).2.1 r j)
    have e := hRows ⟨l / 15, by omega⟩ ⟨1 + l.val % 15, by omega⟩ r jj
    have hslot : (⟨1 + l.val % 15, by omega⟩ : Fin 16) =
        (⟨l.val % 15, by omega⟩ : Fin 15).succ := Fin.ext (by simp; omega)
    rw [hslot, PreLaneM«s».inputsKey_succ, hK] at e
    have hTl : ![d2.Tb0 l l.isLt, d2.Tb1 l l.isLt] r 0 jj =
        preLeafT_«s» ctx ⟨1 + l.val % 15, by omega⟩ r ⟨l / 15, by omega⟩ 0 jj := by
      simp only [Leaf2Data.Tb0, Leaf2Data.Tb1, h20, h21, groupedPreLeafRows]
      fin_cases r <;> rfl
    rw [hTl, hslot]
    exact e
  · -- The output key.
    have hc := PreSum«s».coefLoopId (model := model) (tape := tape)
      (path := path) (params := params) @@h«C»_0@@
    have hV : generatedRoot.w_«V»_0 ctx =
        scalarV (branchCoef«C_» (generatedRoot.w_43_0 ctx) «off» 1 (by norm_num)) := by
      refine scalarV_eq @@h«g»_0@@ ?_
      have hv := @@h«V»_0@@
      change gadgetDecomposeRuns _ _ _ (matrixMulScalarLeft (matrixMulScalarLeft winvPoly
        (generatedRoot.w_«C»_0 ctx)) (generatedRoot.w_«g»_0 ctx)) _ at hv
      rw [hc] at hv
      exact hv
    have S1 := PreSum«s».sumInt (model := model) (tape := tape)
      (path := path) (params := params) (member_init (n := 13) @@h«rI0»_0@@ @@h«rI1»_0@@ @@h«rI2»_0@@ @@h«rI3»_0@@
      @@h«rI4»_0@@ @@h«rI5»_0@@ @@h«rI6»_0@@ @@h«rI7»_0@@) @@h«SI»_3@@
«leaf_sum_proofs»
    have S2 : ∀ r j, «leaf_sum_keys» = ∑ member, preLeafKey_«s» ctx r j member := by
      intro r j
      rw [S20 r j, S21 r j, S22 r j, S23 r j]
      simp only [preLeafKey_«s», Finset.sum_add_distrib]
      rfl
    have hs' : ∀ r j, keyOf (generatedRoot.w_«k0»_0 ctx, generatedRoot.w_«k1»_0 ctx,
        generatedRoot.w_«k2»_0 ctx, generatedRoot.w_«k3»_0 ctx, ()) r j =
        preM_«s» ctx r j * generatedRoot.w_«V»_0 ctx +
        keyOf (generatedRoot.w_«SI»_0 ctx, generatedRoot.w_«SI»_1 ctx, generatedRoot.w_«SI»_2 ctx,
          generatedRoot.w_«SI»_3 ctx, ()) r j +
        («leaf_sum_keys») := by
      intro r j
      fin_cases r <;> fin_cases j
«key_association»
    have hXI : ∀ (b : Fin 15) (r j : Fin 2),
        ![![generatedRoot.w_«I»_6 ctx b, generatedRoot.w_«I»_7 ctx b],
          ![generatedRoot.w_«I»_8 ctx b, generatedRoot.w_«I»_9 ctx b]] r j =
        d1.key1 model ⟨b, by omega⟩ r j *
          scalarV (branchCoef«C_» (generatedRoot.w_43_0 ctx) «off» (kSw b) (by norm_num)) := by
      intro b r j
      rw [(LI b).2.2 r j, (LI b).2.1 r j, key1_int d1 hk h0 h1 b r j]
    have hXL : ∀ (m : Fin 7) (r j : Fin 2),
        preLeafKey_«s» ctx r j m =
        d1.key1 model ⟨15 + m, by omega⟩ r j *
          scalarV (branchCoef«C_» (generatedRoot.w_43_0 ctx) «off» (kSw (15 + m)) (by norm_num)) +
        ∑ parent : Fin 15, d2.key2 model ⟨parent.val + 15 * m.val, by omega⟩ r j *
          scalarV (branchCoef«C_» (generatedRoot.w_43_0 ctx) «off»
            (kLeaf2 (parent.val + 15 * m.val)) (by norm_num)) := by
      intro m r j
      have e := (LL m).2 r j
      change preLeafKey_«s» ctx r j m =
        pairMul (helperKey model (generatedRoot.w_3_0 ctx) (kSw (15 + m)) r)
          (actionDigits (preLeafT_«s» ctx 0 0 m) (preLeafT_«s» ctx 0 1 m) j) * _ +
        ∑ parent : Fin 15, pairMul
          (helperKey model (generatedRoot.w_3_0 ctx) (kSw (15 + m)) r)
          (actionDigits (preLeafT_«s» ctx parent.succ 0 m)
            (preLeafT_«s» ctx parent.succ 1 m) j) * _ at e
      refine e.trans ?_
      apply congrArg₂ (· + ·)
      · exact congrArg (fun key : ExactMatrix Q N 1 44 ↦ key * scalarV
          (branchCoef«C_» (generatedRoot.w_43_0 ctx) «off» (kSw (15 + m)) (by norm_num)))
          (key1_leaf (model := model) d1 hk h2 h3 m r j).symm
      · apply Finset.sum_congr rfl
        intro parent _
        exact congrArg (fun key : ExactMatrix Q N 1 44 ↦ key * scalarV
          (branchCoef«C_» (generatedRoot.w_43_0 ctx) «off»
            (kLeaf2 (parent.val + 15 * m.val)) (by norm_num)))
          (groupedPreLeaf_key2 (model := model) (preLeafT_«s» ctx) d2 hk2 h20 h21 parent m r j)
    funext r j
    change _ = preM_«s» ctx r j * _ + _ + _ + _
    rw [hs' r j, S1 r j, S2 r j, hV]
    simp only [hXI, hXL]
    rw [grouped_leaf_sum
      (fun m : Fin 7 ↦ d1.key1 model ⟨15 + m, by omega⟩ r j *
        scalarV (branchCoef«C_» (generatedRoot.w_43_0 ctx) «off» (kSw (15 + m)) (by norm_num)))
      (fun leaf : Fin 105 ↦ d2.key2 model leaf r j *
        scalarV (branchCoef«C_» (generatedRoot.w_43_0 ctx) «off» (kLeaf2 leaf) (by norm_num)))]
    abel

end PeProof
