  have m4 : w.w_680_4 = ∑ i : Fin 113, w.w_661_4 i := by rw [l4, e674, e675]; exact sum_cells _
  have m5 : w.w_680_5 = ∑ i : Fin 113, w.w_661_5 i := by rw [l5, e677, e678]; exact sum_cells _
  have hA : (∑ i : Fin 113, ![![w.w_661_0 i, w.w_661_1 i], ![w.w_661_2 i, w.w_661_3 i]]) =
      ![![w.w_680_0, w.w_680_1], ![w.w_680_2, w.w_680_3]] := by
    funext k j
    fin_cases k <;> fin_cases j <;> simp [Finset.sum_apply, m0, m1, m2, m3]
  have hc : (∑ i : Fin 113, ![w.w_661_4 i, w.w_661_5 i]) = ![w.w_680_4, w.w_680_5] := by
    funext j
    fin_cases j <;> simp [Finset.sum_apply, m4, m5]
  rw [hA, hc] at hsum
  refine ⟨?_, va, fun i j row column ↦ hva i j row column, v, hsum, fun i j row column ↦ hvp i j row column⟩
  rw [← hA]
  exact Finset.sum_congr rfl fun i _ ↦ hkeys i

end LwrProof
