    refine pre_sum (key := generatedRoot.w_3_0 ctx) d1 d2 _ hk1 (h10 ▸ F.c5.h50_0) (h11 ▸ F.c5.h51_0)
      hk2 (h20 ▸ F.c5.h50_0) (h21 ▸ F.c5.h51_0) (fun b r j ↦ (hint b).1 r j) ?_ hs1 hs2 hs3
    intro r j
    rw [← hV]
    fin_cases r <;> fin_cases j <;> rfl

