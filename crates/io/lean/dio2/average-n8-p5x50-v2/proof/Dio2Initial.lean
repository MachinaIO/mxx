import W_Stage_initial_Facts
import Dio2Inv
import ExponentRefresh
import ExponentIterate

/-! Generated by `gen_initial_import_preimage.py`.

Root components retain the exact sampled hash blocks and deterministic gadget.
The two-component assembly is dimension-generic; its only finite case split is
the fixed two-port ciphertext, never a label/member/coefficient family.
-/

set_option maxHeartbeats 4000000
set_option maxRecDepth 16384
set_option linter.unusedVariables false

attribute [local irreducible] Mxx.Primitives.negacyclicModulus

namespace Dio2Proof

open Mxx.Primitives MxxRuntime MxxExponentLut

variable {q n columns : Nat}

def rowOf {c : Nat} (B : ExactMatrix q n 2 c) (port : Fin 2) : ExactMatrix q n 1 c :=
  fun _ column ↦ B port column

theorem gadget_matrix_unique {backend : BackendContext} {base digits : Int}
    {left right : ExactMatrix q n 1 columns}
    (hl : gadgetMatrixRuns backend base digits left)
    (hr : gadgetMatrixRuns backend base digits right) : left = right := by
  obtain ⟨layout, hl, _, _, width, rfl⟩ := hl
  obtain ⟨other, hr, _, _, otherWidth, rfl⟩ := hr
  have heq : layout = other := Option.some.inj (hl.symm.trans hr)
  subst other
  rfl

def RootComponent (model : HashModel) (key : ByteArray) (pre : Blob)
    (components : List HashTagComponent) (sm : ErrorPoly n)
    (G : ExactMatrix q n 1 columns) (target : ErrorPoly n)
    (ciphertext : ExactMatrix q n 1 columns) (port : Fin 2) : Prop :=
  ∃ error : ErrorMatrix n 1 columns, CoeffBound error 1 ∧
    ciphertext = reducePoly q n sm • rootKey model key pre components q columns 0 port +
      rootKey model key pre components q columns 1 port - reducePoly q n target • G +
      reduceMatrix q n 1 columns error

theorem component_encode {sm target : ErrorPoly n}
    {mask unit scalar : ExactMatrix q n 1 1}
    {key0 key1 G noise0 noise1 ciphertext : ExactMatrix q n 1 columns}
    (hmask : mask 0 0 = reducePoly q n sm) (hunit : unit = 1)
    (htarget : scalar 0 0 = reducePoly q n target)
    (hnoise0 : uniformIntervalSample 0 1 noise0)
    (hnoise1 : uniformIntervalSample 0 1 noise1)
    (hc : ciphertext = matrixAdd (matrixSub
      (matrixAdd (matrixMulScalarLeft mask key0) (matrixMulScalarLeft unit key1))
      (matrixMulScalarLeft scalar G)) (matrixSub noise0 noise1)) :
    ∃ error : ErrorMatrix n 1 columns, CoeffBound error 1 ∧
      ciphertext = reducePoly q n sm • key0 + key1 - reducePoly q n target • G +
        reduceMatrix q n 1 columns error := by
  obtain ⟨error, hbound, hnoise⟩ := uniform_bits_sub hnoise0 hnoise1
  refine ⟨error, hbound, ?_⟩
  rw [hc, hunit]
  change _ + (noise0 - noise1) = _
  rw [hnoise]
  funext row column
  simp only [matrixAdd, matrixSub, matrixMulScalarLeft, Matrix.add_apply, Matrix.sub_apply,
    Matrix.smul_apply, smul_eq_mul, hmask, htarget, Matrix.one_apply, Fin.isValue,
    ↓reduceIte, one_mul]

theorem rootRow_pair_unit {model : HashModel} {key : ByteArray} {pre : Blob}
    {components : List HashTagComponent} {sm alpha payload : ErrorPoly n}
    {G c0 c1 : ExactMatrix q n 1 columns}
    (h0 : RootComponent model key pre components sm G (alpha * payload) c0 0)
    (h1 : RootComponent model key pre components sm G alpha c1 1) :
    RootRow model key pre components sm G
      (fun port ↦ fun _ _ ↦ reducePoly q n (alpha * unitPair payload port)) ![c0, c1] := by
  obtain ⟨error0, hb0, hc0⟩ := h0
  obtain ⟨error1, hb1, hc1⟩ := h1
  refine ⟨![error0, error1], ?_, ?_⟩
  · intro port
    fin_cases port <;> simpa using (by assumption)
  · intro port
    fin_cases port
    · simpa only [unitPair, Matrix.cons_val_zero, matrixMulScalarLeft] using hc0
    · simpa only [unitPair, Fin.zero_eta, Fin.mk_one, Fin.isValue, Matrix.cons_val_zero,
        Matrix.cons_val_one, matrixMulScalarLeft, mul_one] using hc1

noncomputable def intFamilyValue {count : Nat} (family : Fin count → Int) (index : Int) : Int :=
  if bound : index.toNat < count then family ⟨index.toNat, bound⟩ else 0

theorem int_family_value {count : Nat} {family : Fin count → Int} {index value : Int}
    (h : familyGetDynamic family index value) : value = intFamilyValue family index := by
  obtain ⟨position, hposition, rfl⟩ := h
  subst index
  simp [intFamilyValue]

theorem select_value {index value : Int} {table : List Int}
    (h : MxxRuntime.select index table value) : value = MxxIR.selectInt index table := by
  obtain ⟨position, hposition, rfl⟩ := h
  subst index
  simp [MxxIR.selectInt]

noncomputable def autoPlaintext (index : Int) (sm : ErrorPoly n) : ErrorPoly n :=
  if odd : Odd index.toNat then substitution index.toNat odd sm else 0

theorem auto_plaintext_entry (hq : 1 < q) (hn : 0 < n) {index : Int}
    {input output : ExactMatrix q n 1 1} {sm : ErrorPoly n}
    (h : ringAutomorphismRuns index input output)
    (hinput : input 0 0 = reducePoly q n sm) :
    output 0 0 = reducePoly q n (autoPlaintext index sm) := by
  obtain ⟨odd, hout⟩ := ringAutomorphismRuns_eq hq hn h
  rw [hout]
  simp only [hinput, autoPlaintext, dif_pos odd, ← reducePoly_substitution]

theorem one_entry : (1 : ExactMatrix q n 1 1) 0 0 = reducePoly q n 1 := by
  rw [map_one]
  rfl

theorem msl_entry {left right : ExactMatrix q n 1 1} {a b : ErrorPoly n}
    (hl : left 0 0 = reducePoly q n a) (hr : right 0 0 = reducePoly q n b) :
    matrixMulScalarLeft left right 0 0 = reducePoly q n (a * b) := by
  simp only [matrixMulScalarLeft, hl, hr, map_mul]

theorem mono_entry {input : ExactMatrix q n 1 1} {a : ErrorPoly n}
    (h : input 0 0 = reducePoly q n a) (exponent : Int) :
    multiplyMonomial input exponent 0 0 = reducePoly q n (a * message 1 exponent) := by
  have heq := congrFun (congrFun (multiplyMonomial_liftInteger (q := q) (n := n) 1 exponent) 0) 0
  simp only [multiplyMonomial, liftInteger, Int.cast_one, one_mul] at heq
  simp only [multiplyMonomial, h, map_mul, heq]

open W_Stage_initial Mxx.ExponentLut.Refresh

theorem initial_gadget {backend : BackendContext} {model : HashModel} {params : Params}
    {inputs : _} {outputs : _} (h : generatedRoot backend model params inputs outputs) :
    ∃ G : ExactMatrix modulus_0 8 1 25, gadgetMatrixRuns backend 4096 25 G := by
  obtain ⟨witness, hbody⟩ := h
  let ctx : generatedRoot.Ctx backend model params := ⟨inputs, witness⟩
  exact ⟨_, (generatedRoot.facts ctx hbody).c1.h41_0⟩

/-- The initial hint uses the sampled anchor, with one coefficient unit of error. -/
theorem initial_hint {backend : BackendContext} {model : HashModel} {params : Params}
    {inputs : _} {outputs : _} (h : generatedRoot backend model params inputs outputs)
    {sm : ErrorPoly 8} (hmask : inputs.1 0 0 = reducePoly modulus_0 8 sm) :
    ∃ error : ErrorMatrix 8 1 54, CoeffBound error 1 ∧
      outputs.1 = maskPart (reducePoly modulus_0 8 sm) (rowOf inputs.2.1) +
        reduceMatrix modulus_0 8 1 54 error := by
  obtain ⟨witness, hbody⟩ := h
  let ctx : generatedRoot.Ctx backend model params := ⟨inputs, witness⟩
  have F := generatedRoot.facts ctx hbody
  obtain ⟨error, hb, he⟩ := uniform_bits_sub F.c0.h5_0 F.c0.h6_0
  refine ⟨error, hb, ?_⟩
  rw [F.c2.hout]
  have hcat := F.c0.h2_0
  show generatedRoot.w_2_0 ctx * inputs.2.1 +
    (generatedRoot.w_5_0 ctx - generatedRoot.w_6_0 ctx) = _
  rw [he]
  congr 1
  funext row column
  rw [Matrix.mul_apply, Fin.sum_univ_two, hcat row 0, hcat row 1]
  have hrow : row = 0 := Subsingleton.elim _ _
  subst hrow
  simp only [Fin.isValue, Fin.coe_ofNat_eq_mod, Nat.zero_mod, zero_lt_one, ↓reduceDIte,
    Nat.one_mod, lt_self_iff_false, Nat.sub_self, maskPart, rowOf, Matrix.add_apply,
    Matrix.smul_apply, smul_eq_mul]
  show inputs.1 0 0 * _ + (1 : ExactMatrix modulus_0 8 1 1) 0 0 * _ = _
  rw [hmask]
  simp

end Dio2Proof
