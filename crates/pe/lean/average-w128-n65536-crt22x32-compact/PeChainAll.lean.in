namespace PeProof

open Mxx.Primitives MxxRuntime MxxExponentLut MxxPe

/-- Expand a sixteen-slot family without splitting a generated runtime context. -/
theorem leafFamilies_eta {α : Type*} (families : Fin 16 → α) :
    ![families 0, families 1, families 2, families 3,
      families 4, families 5, families 6, families 7,
      families 8, families 9, families 10, families 11,
      families 12, families 13, families 14, families 15] = families := by
  funext slot
  fin_cases slot <;> rfl

/-- A monomial table value is a monomial target. -/
theorem target_mono (s : ErrorPoly N) (n : Nat) :
    (fun j ↦ (reducePoly Q N (unitPair s j) * X Q ^ n) • g0) =
      fun j ↦ reducePoly Q N ((((1 : Nat) : Int) : ErrorPoly N) * Xe n * unitPair s j) • g0 := by
  funext j
  rw [map_mul, map_mul, reducePoly_Xe]
  simp only [Nat.cast_one, Int.cast_one, map_one, one_mul]
  rw [mul_comm]

/-- A zero constant table value is the zero target. -/
theorem target_zero (s : ErrorPoly N) {c : Int} (hc : c = 0) :
    (fun j ↦ (reducePoly Q N (unitPair s j) * ((c : Int) : ExactPoly Q N)) • g0) =
      fun _ ↦ (0 : ExactMatrix Q N 1 44) := by
  funext j
  rw [hc]
  simp

theorem tableMono_eq (t : Fin 512 → Int) (off : Nat) (ho : off + 128 ≤ 512) (e : Fin 128) (f : Fin 512)
    (hf : (f : Nat) = off + e) : tableMono t off ho e = X Q ^ (t f).toNat := by
  unfold tableMono
  congr 3
  exact Fin.ext hf.symm

theorem tableConst_eq (t : Fin 512 → Int) (off : Nat) (ho : off + 128 ≤ 512) (e : Fin 128) (f : Fin 512)
    (hf : (f : Nat) = off + e) : tableConst t off ho e = ((t f : Int) : ExactPoly Q N) := by
  unfold tableConst
  congr 2
  exact Fin.ext hf.symm

