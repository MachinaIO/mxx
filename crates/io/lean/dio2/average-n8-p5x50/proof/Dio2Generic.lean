      ![bot0, bot1] j = T j + reduceMatrix q n 1 m'' (eB j))
    (heB : ∀ j, CoeffBound (eB j) BB) :
    Rel sm ![![outputs.1, outputs.2.1], ![outputs.2.2.1, outputs.2.2.2.1]]
      (fun j ↦ reducePoly q n (α * μ) • T j) ![outputs.2.2.2.2.1, outputs.2.2.2.2.2.1]
