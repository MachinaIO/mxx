/-- Block `2` with its error and key named: the sum of the cells of `cell2E`. -/
theorem block2E {model : HashModel} {key : ByteArray}
    {s0 s1 s2 s3} {k0 k1}
    {ca0 ca1} {cs0 cs1}
    {apay}
    {r00 r01} {r10 r11}
    {r20 r21} {r30 r31}
    {r40 r41}
    {outputs} {w : Stage_online_eval.generatedRoot.Witness}
    (hb : Stage_online_eval.generatedRoot.body Backend.backend model tape path GeneratedClaim.stage_4_params
      (s0, s1, s2, s3, k0, key, k1, ca0, ca1, cs0, apay, cs1, r00, r01, r10, r11, r20, r21, r30, r31,
        r40, r41, ()) outputs w)
    {sm sp μ : ErrorPoly N} {α : Fin 17 → ErrorPoly N} {ν : Fin 14 → ErrorPoly N}
    {G : ExactMatrix Q7 N 1 14} (hG : gadgetMatrixRuns Backend.backend 1048576 14 G)
    {g' : ExactMatrix Q4 N 1 8} {g : ExactMatrix Q5 N 1 8}
    (hg' : gadgetMatrixRuns Backend.backend 1048576 8 g') (hg : centeredRebaseRuns g' g)
    {h : ExactMatrix Q4 N 1 6}
    {ea : Fin 17 → Fin 2 → ErrorMatrix N 1 14}
    (ha : ∀ k : Fin 17, RelE sm (memberKey model key k)
      (fun j ↦ reducePoly Q7 N (α k * unitPair sm j) • G) ![ca0 k, ca1 k] (ea k))
    (hpay : ∀ k : Fin 17, apay k = fun _ _ ↦ reducePoly Q7 N (α k))
    {es : Fin 2 → ErrorMatrix N 1 8}
    (hs : RelE sm ![![w.w_64_0, w.w_64_1], ![w.w_64_2, w.w_64_3]]
      (fun j ↦ reducePoly Q5 N (((P5 : Nat) : Int) * μ * unitPair sp j) • g)
      ![w.w_64_4, w.w_64_5] es)
    {eB : Fin 14 → Fin 2 → ErrorMatrix N 1 6}
    (hrhs : ∀ i : Fin 14, ∀ j,
      reducePoly Q4 N sp • rhsTop model key Q4 6 rhsPrefix2 i j + ![r20 i, r21 i] j =
        reducePoly Q4 N (((P4 : Nat) : Int) * ν i * unitPair sp j) • h +
          reduceMatrix Q4 N 1 6 (eB i j)) :
    let As := ![![w.w_64_0, w.w_64_1], ![w.w_64_2, w.w_64_3]]
    (![![w.w_86_0, w.w_86_1], ![w.w_86_2, w.w_86_3]] = ∑ i : Fin 14, fun k j ↦
      theOutput (blockModSwitchRuns [1099511626049, 1099511625409, 1099511623297, 1099511622593, 1099511622529] 1)
        (cellKeyUp2 (memberKey model key ((coords 2 i : Nat) : Int)) As
          (rhsTop model key Q4 6 rhsPrefix2 i) ![r20 i, r21 i] k j)) ∧
    ∃ va : Fin 14 → Fin 2 → ErrorMatrix N 1 10,
    (∀ i j row column,
      let c : Fin 17 := ⟨coords 2 i, coords_lt 2 i⟩
      let mk := memberKey model key c
      (ea c j * liftMatrix alignDigits2) row column -
          downResidue A5 (![ca0 c, ca1 c] j * alignDigits2) row column +
          sm * downResidue A5 (mk 0 j * alignDigits2) row column +
          downResidue A5 (mk 1 j * alignDigits2) row column =
        ((A5 : Int) : ErrorPoly N) * va i j row column) ∧
    ∃ v : Fin 14 → Fin 2 → ErrorMatrix N 1 6,
      RelE sm ![![w.w_86_0, w.w_86_1], ![w.w_86_2, w.w_86_3]]
        (∑ i : Fin 14, fun j ↦ reducePoly Q4 N (((P4 : Nat) : Int) *
          (α ⟨coords 2 i, coords_lt 2 i⟩ * μ * ν i) * unitPair sp j) • h)
        ![w.w_86_4, w.w_86_5]
        (∑ i : Fin 14, fun j ↦ v i j - (α ⟨coords 2 i, coords_lt 2 i⟩ * μ) • eB i j) ∧
      ∀ i j row column,
        let c : Fin 17 := ⟨coords 2 i, coords_lt 2 i⟩
        let top := rhsTop model key Q4 6 rhsPrefix2 i
        let bot := ![r20 i, r21 i]
        let mk := memberKey model key c
        let crow : Fin 2 → ExactMatrix Q5 N 1 10 := fun j ↦
          theOutput (blockModSwitchRuns [1099511626049, 1099511625409, 1099511623297, 1099511622593, 1099511622529, 1099511621249, 1099511619841] 1) (![ca0 c, ca1 c] j * alignDigits2)
        pairMul (fun j' ↦ pairMul (va i) (liftMatrix (pubDigits2 As j')) + α c • es j')
