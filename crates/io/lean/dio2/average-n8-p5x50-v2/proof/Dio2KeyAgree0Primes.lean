/-- Prime 4: the exported key part computes the combination, fresh and smudge rows. -/
theorem keys_part_rows4 {backend : BackendContext} {hashModel : HashModel}
    {params : W_Stage_keys_online_0_0.Params} {part : Nat}
    (keyCtx : W_Stage_keys_online_0_0.parallel_generatedRoot_988.Ctx backend hashModel params part)
    {outputs : _} (F : W_Stage_keys_online_0_0.parallel_generatedRoot_988.Facts keyCtx outputs)
