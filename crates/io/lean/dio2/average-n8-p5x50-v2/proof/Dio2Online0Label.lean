    (member : Fin 5) (ctx : parallel_generatedRoot_660.Ctx backend hashModel params member.val)
    {outputs : _} (F : parallel_generatedRoot_660.Facts ctx outputs)
    {sm : ErrorPoly 8} {B Bs : Nat} {ts : Fin 2 → ExactMatrix modulus_0 8 1 25}
    (hn : 0 < 8) (hq : 1 < modulus_0) (layout : RegularLayout modulus_0)
    (hlayout : backend.regularLayout modulus_0 8 = some layout) (hexact : layout.droppedModuli = 0)
    (hG : gadgetMatrixRuns backend 4096 25 (parallel_generatedRoot_660.w_35_0 ctx))
    (hleaves : ∀ index : Fin 4, Online0Labels.Node sm (parallel_generatedRoot_660.w_35_0 ctx) B (parallel_generatedRoot_660.w_31_0 ctx index) (parallel_generatedRoot_660.w_31_1 ctx index) (parallel_generatedRoot_660.w_31_2 ctx index) (parallel_generatedRoot_660.w_31_3 ctx index) (parallel_generatedRoot_660.w_31_4 ctx index) (parallel_generatedRoot_660.w_31_5 ctx index) (parallel_generatedRoot_660.w_31_6 ctx index))
    (hs : Rel sm ![![parallel_generatedRoot_660.w_42_0 ctx, parallel_generatedRoot_660.w_55_0 ctx], ![parallel_generatedRoot_660.w_47_0 ctx, parallel_generatedRoot_660.w_58_0 ctx]]
      ts ![parallel_generatedRoot_660.w_52_0 ctx, parallel_generatedRoot_660.w_62_0 ctx] Bs) :
    ∃ α : ErrorPoly 8, parallel_generatedRoot_660.w_51_0 ctx = (fun _ _ ↦ reducePoly modulus_0 8 α) ∧ SmulGain α 1 ∧
      Rel sm ![![outputs.2.2.1, outputs.2.2.2.1], ![outputs.2.2.2.2.1, outputs.2.2.2.2.2.1]]
        (fun j ↦ reducePoly modulus_0 8 α • ts j) ![outputs.1, outputs.2.1] (25 * 8 * (25 * 8 * online0_label_bound_2 B * 2048) * 2048 + 25 * 8 * (25 * 8 * online0_label_bound_2 B * 2048) * 2048 + Bs) := by
  let forestBound_1 : Nat := online0_label_bound_1 B
  have nodes_1 : ∀ index : Fin 2,
      Online0Labels.Node sm (parallel_generatedRoot_660.w_35_0 ctx) forestBound_1 (parallel_generatedRoot_660.w_32_0 ctx index) (parallel_generatedRoot_660.w_32_1 ctx index) (parallel_generatedRoot_660.w_32_2 ctx index) (parallel_generatedRoot_660.w_32_3 ctx index) (parallel_generatedRoot_660.w_32_4 ctx index) (parallel_generatedRoot_660.w_32_5 ctx index) (parallel_generatedRoot_660.w_32_6 ctx index) := by
    intro index
    exact parallel_parallel_generatedRoot_660_32_node hn hq layout hlayout hexact hG hleaves (F.c0.h32_6 index)
  let forestBound_2 : Nat := online0_label_bound_2 B
  have nodes_2 : ∀ index : Fin 1,
      Online0Labels.Node sm (parallel_generatedRoot_660.w_35_0 ctx) forestBound_2 (parallel_generatedRoot_660.w_33_0 ctx index) (parallel_generatedRoot_660.w_33_1 ctx index) (parallel_generatedRoot_660.w_33_2 ctx index) (parallel_generatedRoot_660.w_33_3 ctx index) (parallel_generatedRoot_660.w_33_4 ctx index) (parallel_generatedRoot_660.w_33_5 ctx index) (parallel_generatedRoot_660.w_33_6 ctx index) := by
    intro index
    exact parallel_parallel_generatedRoot_660_33_node hn hq layout hlayout hexact hG nodes_1 (F.c0.h33_6 index)
  have hroot := nodes_2 (0 : Fin 1)
  have get_w_34_0 := Online0Labels.read_at (0 : Fin 1) rfl F.c0.h34_0
  have get_w_45_0 := Online0Labels.read_at (0 : Fin 1) rfl F.c0.h45_0
  have get_w_65_0 := Online0Labels.read_at (0 : Fin 1) rfl F.c0.h65_0
  have get_w_68_0 := Online0Labels.read_at (0 : Fin 1) rfl F.c0.h68_0
  have get_w_75_0 := Online0Labels.read_at (0 : Fin 1) rfl F.c0.h75_0
