/-- The anchor publics are the public matrices of the sampled anchors. -/
theorem anchor_public (hrun : W_GeneratedClaim.Runs model external execution) :
    execution.«stage_2».1 = execution.«stage_1».1 ∧
      execution.«stage_2».2.1 = execution.«stage_1».2.2.1 := by
  obtain ⟨_, hb⟩ := hrun.2.2.2.1
  have h := anchors_trapdoor hrun.2.2.1
  simp only [W_Stage_anchor_publics.generatedRoot.body,
    W_Stage_anchor_publics.generatedRoot.constraints_0] at hb
  rw [hb]
  exact ⟨trapdoorSample_public h.1, trapdoorSample_public h.2⟩

/-- Every refreshed target pair of the actual run, under the next mask, with the
actual target-selection keys and the certified fresh error. -/
theorem refreshed_pairs (hrun : W_GeneratedClaim.Runs model external execution) {state : Nat}
    (initial : State0Witness model external execution (Xe (n := 8) (2 * state)))
    {next result : ErrorPoly 8} {fresh : Fin 900 → ErrorPoly 8}
    {smudge : Fin 4500 → ErrorPoly 8}
    (R : Online0Sources.Relations initial.context.online (execution.«stage_2».1) initial.mask
      initial.payload next result fresh smudge) :
    ∃ label : Fin 5 → ErrorPoly 8,
      (∀ (m : Fin 2) (member : Fin 5), m.val ≠ 1 → member.val = m.val * 5 →
        reducePoly modulus_0 8 (label member) = reducePoly modulus_0 8 (online1Labels external m)) ∧
      ∀ t : Fin 18, MxxExponentLut.Rel next
        (fun r c ↦ MxxExponentLut.rowOf
          (generatedRoot.w_872_3 initial.context.online (StepTransition.partIndex t c)) r)
        (fun c ↦ reducePoly modulus_0 8 (Step0Targets.stepTarget initial.payload next result label
          (StepTransition.partIndex t c)) • generatedRoot.w_57_0 initial.context.online)
        (StepTransition.nextRows initial.context.online t) 8 := by
  obtain ⟨label, hbridge, targets⟩ := Step0Targets.target_rows hrun initial R
  refine ⟨label, hbridge, ?_⟩
  obtain ⟨kw, kb⟩ := Online0Claim.key_runs hrun
  let ck : Step0Rows.KeyCtx model := ⟨Online0Claim.keyInputs external execution, kw⟩
  have Fk := W_Stage_keys_online_0_0.generatedRoot.facts ck kb
  have links := Step0Agree.key_links initial.context.online ck initial.context.online_facts Fk
    initial.context.online_inputs rfl
  have P := (claim_preimages hrun).1
  have hA : execution.«stage_2».1 = execution.«stage_1».1 := (anchor_public hrun).1
  have hk := Fk.c49.hout
  have e0 : generatedRoot.w_1_0 initial.context.online = execution.«stage_9».1 := by
    rw [generatedRoot.w_1_0, initial.context.online_inputs]; rfl
  have e1 : generatedRoot.w_987_0 initial.context.online = execution.«stage_9».2.1 := by
    rw [generatedRoot.w_987_0, initial.context.online_inputs]; rfl
  have e2 : generatedRoot.w_988_0 initial.context.online = execution.«stage_9».2.2.1 := by
    rw [generatedRoot.w_988_0, initial.context.online_inputs]; rfl
  have e3 : generatedRoot.w_989_0 initial.context.online = execution.«stage_9».2.2.2.1 := by
    rw [generatedRoot.w_989_0, initial.context.online_inputs]; rfl
  have e4 : generatedRoot.w_990_0 initial.context.online = execution.«stage_9».2.2.2.2.1 := by
    rw [generatedRoot.w_990_0, initial.context.online_inputs]; rfl
  have rows := Step0Rows.rows initial.context.online_facts Fk links R
    (fun part ↦ by rw [hA, e0]; have := P.1 part; rw [hk] at this; exact this)
    (fun part ↦ by rw [hA, e1]; have := P.2.1 part; rw [hk] at this; exact this)
    (fun part ↦ by rw [hA, e2]; have := P.2.2.1 part; rw [hk] at this; exact this)
    (fun part ↦ by rw [hA, e3]; have := P.2.2.2.1 part; rw [hk] at this; exact this)
    (fun part ↦ by rw [hA, e4]; have := P.2.2.2.2 part; rw [hk] at this; exact this)
    targets
  refine StepTransition.paired_parts initial.context.online (bound := fun _ ↦ 8)
    (fresh := fun t c ↦ Step0Rows.freshError fresh (StepTransition.partIndex t c)) ?_ ?_
  · intro t c row column coefficient
    exact (coeff_natAbs_le_polyNorm _ _).trans (R.fresh_small _)
  · intro t c
    exact rows _

