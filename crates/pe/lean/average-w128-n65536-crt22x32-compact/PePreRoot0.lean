/-- The physical group/local-slot/row/member artifact layout. -/
def preLeafGroups_0 (ctx : generatedRoot.Ctx Backend.backend model tape path params) :
    Fin 4 → Fin 4 → Fin 2 → Fin 7 → ExactMatrix Q N 1 88 :=
  fun group slot r member ↦ (![![![generatedRoot.w_45_0 ctx member, generatedRoot.w_45_1 ctx member], ![generatedRoot.w_45_2 ctx member, generatedRoot.w_45_3 ctx member], ![generatedRoot.w_45_4 ctx member, generatedRoot.w_45_5 ctx member], ![generatedRoot.w_45_6 ctx member, generatedRoot.w_45_7 ctx member]], ![![generatedRoot.w_46_0 ctx member, generatedRoot.w_46_1 ctx member], ![generatedRoot.w_46_2 ctx member, generatedRoot.w_46_3 ctx member], ![generatedRoot.w_46_4 ctx member, generatedRoot.w_46_5 ctx member], ![generatedRoot.w_46_6 ctx member, generatedRoot.w_46_7 ctx member]], ![![generatedRoot.w_47_0 ctx member, generatedRoot.w_47_1 ctx member], ![generatedRoot.w_47_2 ctx member, generatedRoot.w_47_3 ctx member], ![generatedRoot.w_47_4 ctx member, generatedRoot.w_47_5 ctx member], ![generatedRoot.w_47_6 ctx member, generatedRoot.w_47_7 ctx member]], ![![generatedRoot.w_48_0 ctx member, generatedRoot.w_48_1 ctx member], ![generatedRoot.w_48_2 ctx member, generatedRoot.w_48_3 ctx member], ![generatedRoot.w_48_4 ctx member, generatedRoot.w_48_5 ctx member], ![generatedRoot.w_48_6 ctx member, generatedRoot.w_48_7 ctx member]]]) group slot r

theorem preLeafT_chunk_0 (ctx : generatedRoot.Ctx Backend.backend model tape path params)
    (group slot : Fin 4) (r : Fin 2) (member : Fin 7) :
    preLeafT_0 ctx ⟨4 * group.val + slot.val, by omega⟩ r member =
