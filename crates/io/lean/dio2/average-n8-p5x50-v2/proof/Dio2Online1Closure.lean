        reducePoly modulus_0 8 (Xe (n := 8) (2 * bit) * unitPair sp port) • gadget +
          reduceMatrix modulus_0 8 1 25 (error port) := by
  obtain ⟨error, hbound, heq⟩ := rhs_parallel_generatedRoot_33 C.preprocess C.preprocess_facts
    (Claim1.preprocess_payload C hpayload) hG 0
  have hseed : generatedRoot.w_70_0 C.online = W_Stage_preprocess_1_1.generatedRoot.w_0_0 C.preprocess := by
    change C.online.inputs.2.2.2.2.2.2.2.2.2.2.2.2.2.2.1 =
