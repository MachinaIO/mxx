import LwrH2Model

/-!
# The bounds of the H2 decomposition

Generated by `generator/gen_h2_bounds.py`. On every tape: the `l1` norms of the weights entering
every block, the remainder of the decoded coefficient, the energy of the row sites, and the mask
forms of the key sites with their energy. The finalization digits enter through `FinalDigits`,
which every run establishes.
-/

namespace LwrProof

open Mxx.Primitives MxxRuntime MxxExponentLut

set_option maxRecDepth 1000000

/-- The finalization digits `G⁻¹(k)` have column `l1` norm at most `(20 : ℝ)`. -/
def FinalDigits : Prop :=
  ∀ c, ∑ l, ∑ j, |(((finalDigits l c).coeff j : ℤ) : ℝ)| ≤ (20 : ℝ)

theorem abs_add_bound {x y bx by' : ℝ} (hx : |x| ≤ bx) (hy : |y| ≤ by') : |x + y| ≤ bx + by' :=
  (abs_add_le x y).trans (add_le_add hx hy)

section H2Bounds

variable (model : HashModel) (key : ByteArray) (ext : GeneratedClaim.ExternalInputs)

/-! ## The pieces -/

theorem maskM_coeff (tape : SampleTape) (k : Fin N) :
    (maskM tape).coeff k = maskClamp [1, 0] tape k.val := by
  simp only [maskM, clampedWitness, intPoly_coeff hN, maskClamp, maskKey]
  rfl

theorem maskM_l1 (tape : SampleTape) : ∑ k, |(((maskM tape).coeff k : ℤ) : ℝ)| ≤ (N : ℝ) := by
  have h := sum_abs_coeff_le (x := maskM tape) (B := 1) fun k ↦ by
    rw [maskM_coeff, maskClamp]
    omega
  simpa using h

theorem sL_l1 (tape : SampleTape) (i : Fin 128) : ∑ k, |(((sL tape i).coeff k : ℤ) : ℝ)| ≤ (N : ℝ) :=
  (sum_abs_substitution_coeff_le hN _ _).trans (maskM_l1 tape)

theorem alpha_l1 (k : Fin 1025) : ∑ c, |(((alphaOf ext k).coeff c : ℤ) : ℝ)| ≤ 1 :=
  sum_abs_Xe_coeff_le hN _

theorem alphaMu_l1 (k : Fin 1025) (b : Nat) :
    ∑ c, |(((alphaOf ext k * muOf ext b).coeff c : ℤ) : ℝ)| ≤ 1 := by
  rw [show alphaOf ext k * muOf ext b = Xe (n := N) (512 * (ext.input_3 k).toNat + 512 * zOf ext b) by
    simp only [alphaOf, muOf, Xe, pow_add]]
  exact sum_abs_Xe_coeff_le hN _

theorem aL_l1 (i : Fin 128) : ∑ c, |(((aL ext i).coeff c : ℤ) : ℝ)| ≤ 1 :=
  (sum_abs_substitution_coeff_le hN _ _).trans (sum_abs_Xe_coeff_le hN _)

theorem sigma_coprime (i : Fin 128) : N.Coprime (σL i) := by
  have h := (Nat.coprime_two_left.mpr (sigma_odd i)).pow_left 16
  simpa [σL] using h

theorem memberError_bound (tape : SampleTape) (k : Fin 1025) (j : Fin 2) :
    CoeffBound (memberError tape [3] k j) 26 := by
  fin_cases j <;> exact clampedWitness_bound hN _ _ _

theorem stateError_bound (tape : SampleTape) (j : Fin 2) : CoeffBound (stateError tape [3] j) 26 := by
  fin_cases j <;> exact clampedWitness_bound hN _ _ _

