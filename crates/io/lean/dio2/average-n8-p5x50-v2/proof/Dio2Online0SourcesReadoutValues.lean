def samplerScalar (exponent : Nat) : Int :=
  (-1) ^ (exponent / 8) * MxxIR.selectInt (Int.ofNat (exponent % 8)) [0, 1, 0, 1, 0, 1, 0, 1]

noncomputable def samplerValue (exponent : Nat) : ErrorPoly 8 :=
  (samplerScalar exponent : ErrorPoly 8)

theorem sampler_scalar_small (exponent : Nat) : (samplerScalar exponent).natAbs ≤ 1 := by
  have htable : ∀ index : Fin 8,
      (MxxIR.selectInt (Int.ofNat index) [0, 1, 0, 1, 0, 1, 0, 1]).natAbs ≤ 1 := by decide
  have hvalue := htable ⟨exponent % 8, Nat.mod_lt _ (by decide)⟩
  have hsign := neg_one_pow_eq_or Int (exponent / 8)
  rcases hsign with hsign | hsign <;>
    simpa only [samplerScalar, hsign, one_mul, neg_one_mul, Int.natAbs_neg] using hvalue

theorem sampler_walsh {message : ErrorPoly 8} (exponent : Nat)
    (hmessage : message = Xe (n := 8) (1 * exponent)) :
    (∑ branch : Fin 8, reducePoly modulus_0 8
      (substitution (sigmaOf Preprocess.samplerSigmas branch).toNat (Preprocess.samplerOdd branch) message) *
        Preprocess.samplerCoefficients branch) =
      reducePoly modulus_0 8 (samplerValue exponent) := by
  have hinverse : (1583094970036445026219027198948556596896692349152872186330380835483706951869 : ExactPoly modulus_0 8) *
      (8 : ExactPoly modulus_0 8) = 1 :=
    cast_inverse (by norm_num [modulus_0]) (by norm_num [modulus_0])
  have result := PreprocessSwitch.coefficient_walsh (q := modulus_0) (n := 8)
    (inverse := 1583094970036445026219027198948556596896692349152872186330380835483706951869) (stride := 1) (log := 3)
    (by norm_num [modulus_0]) (by decide) (by decide)
    (fun index : Fin 8 ↦ MxxIR.selectInt (Int.ofNat index) [0, 1, 0, 1, 0, 1, 0, 1])
    hinverse (sigmaOf Preprocess.samplerSigmas) Preprocess.samplerOdd samplerPermutation sampler_index
    exponent (congrArg (reducePoly modulus_0 8) hmessage)
  simpa only [Preprocess.samplerCoefficients, samplerValue, samplerScalar, Int.cast_mul,
    show 2 ^ 3 = 8 from rfl] using result

theorem sampler_packed_small (exponent : Fin 8 → Nat) :
    polyNorm (∑ coefficient : Fin 8, Xe (n := 8) coefficient *
      samplerValue (exponent coefficient)) ≤ 1 := by
  have hpoly : (∑ coefficient : Fin 8, Xe (n := 8) coefficient *
      samplerValue (exponent coefficient)) = intPoly (fun coefficient ↦ samplerScalar (exponent coefficient)) := by
    simp only [samplerValue, intPoly, Xe, mul_comm]
  rw [hpoly]
  apply polyNorm_le_of_coeff
  intro coefficient
  rw [intPoly_coeff (by decide)]
  exact sampler_scalar_small _

end Dio2Proof.Online0Sources
