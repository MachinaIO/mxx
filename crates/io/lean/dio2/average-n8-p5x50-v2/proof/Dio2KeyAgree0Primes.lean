/-- Prime 0: the exported key part computes the combination, fresh and smudge rows. -/
theorem keys_part_rows0 {backend : BackendContext} {hashModel : HashModel}
    {params : W_Stage_keys_online_0_0.Params} {part : Nat}
    (keyCtx : W_Stage_keys_online_0_0.parallel_generatedRoot_984.Ctx backend hashModel params part)
    {outputs : _} (F : W_Stage_keys_online_0_0.parallel_generatedRoot_984.Facts keyCtx outputs)
    (component : Fin 2) :
    rowOf outputs component =
      (keyPartG0 keyCtx component * topRows (keyPartDigits0 keyCtx component) +
        keyPartC10 keyCtx component * bottomRows (keyPartDigits0 keyCtx component) -
        keyPartCx0 keyCtx component * keyPartY0 keyCtx component) +
        keyPartFresh0 keyCtx component + keyPartSmudge0 keyCtx component := by
  rw [F.c2.hout]
  change rowOf (W_Stage_keys_online_0_0.parallel_generatedRoot_984.w_94_0 keyCtx) component = _
  obtain ⟨leftRow, rightRow⟩ := concatRows_two F.c2.h94_0
  fin_cases component
  · calc
      _ = (W_Stage_keys_online_0_0.parallel_generatedRoot_984.w_49_0 keyCtx) := leftRow
      _ = _ := by
        have split := concatColumns_mul F.c0.h2_0 (W_Stage_keys_online_0_0.parallel_generatedRoot_984.w_7_0 keyCtx)
        exact congrArg (fun product ↦ product - (W_Stage_keys_online_0_0.parallel_generatedRoot_984.w_9_0 keyCtx) * (W_Stage_keys_online_0_0.parallel_generatedRoot_984.w_21_0 keyCtx) +
          (W_Stage_keys_online_0_0.parallel_generatedRoot_984.w_41_0 keyCtx) + (W_Stage_keys_online_0_0.parallel_generatedRoot_984.w_48_1 keyCtx)) split
  · calc
      _ = (W_Stage_keys_online_0_0.parallel_generatedRoot_984.w_93_0 keyCtx) := rightRow
      _ = _ := by
        have split := concatColumns_mul F.c1.h52_0 (W_Stage_keys_online_0_0.parallel_generatedRoot_984.w_56_0 keyCtx)
        exact congrArg (fun product ↦ product - (W_Stage_keys_online_0_0.parallel_generatedRoot_984.w_58_0 keyCtx) * (W_Stage_keys_online_0_0.parallel_generatedRoot_984.w_70_0 keyCtx) +
          (W_Stage_keys_online_0_0.parallel_generatedRoot_984.w_89_0 keyCtx) + (W_Stage_keys_online_0_0.parallel_generatedRoot_984.w_92_2 keyCtx)) split

