noncomputable def HB1 : ErrorMatrix N 14 12 := liftMatrix alignDigits1

noncomputable def RB1 (tape : SampleTape) (i : Fin 14) (k : Fin 2) : ErrorMatrix N 1 12 :=
  downResidue A6 (memberRow model key ext tape ⟨coords 1 i, coords_lt 1 i⟩ k * alignDigits1)

noncomputable def K0B1 (i : Fin 14) (k : Fin 2) : ErrorMatrix N 1 12 :=
