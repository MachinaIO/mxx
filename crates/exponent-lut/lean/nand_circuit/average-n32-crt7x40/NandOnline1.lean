    Rel sm final.key (∑ i ∈ Finset.range count, branchTarget1 μ sp fam i) final.row
        (count * branchBound1 B) ∧
      final.switch = fun k j ↦ fam k j ⟨count, by omega⟩ := by
  refine MxxIR.IterRuns.invariant
    (Invariant := fun k (s : LoopState Q6 Q5 10) ↦ ∀ hk : k ≤ 15,
