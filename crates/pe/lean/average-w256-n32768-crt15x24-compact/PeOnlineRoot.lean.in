import PeOnlineGlue
import PeOnlineStep«k»

/-!
# Online step «k» at the root

Generated by `gen_online_root.py` from `PeOnlineRoot.lean.in`. The state rows entering step «k» under
their key, the product with the attribute ciphertext of position «k», and the 128 branches with
table «k»: the internal branches as a parallel loop over their lanes, whose weighted rows a member sum
adds, then four leaf groups, each with seven member lanes and four shared-companion slots.
-/

namespace PeProof

open Mxx.Primitives MxxRuntime MxxExponentLut MxxPe Stage_online_eval

variable {model : HashModel} {tape : SampleTape} {path : List Nat} {params : Params}

/-- The preprocessed product key of step «k». -/
noncomputable def mKey_«k» (ctx : generatedRoot.Ctx Backend.backend model tape path params) :
    Fin 2 → Fin 2 → ExactMatrix Q N 1 44 :=
  ![![generatedRoot.w_«m00»_0 ctx, generatedRoot.w_«m01»_0 ctx],
    ![generatedRoot.w_«m10»_0 ctx, generatedRoot.w_«m11»_0 ctx]]

/-- The preprocessed key of the state rows entering step «k». -/ --MID
noncomputable def aKey_«k» (ctx : generatedRoot.Ctx Backend.backend model tape path params) : --MID
    Fin 2 → Fin 2 → ExactMatrix Q N 1 44 := --MID
  ![![generatedRoot.w_«a00»_0 ctx, generatedRoot.w_«a01»_0 ctx], --MID
    ![generatedRoot.w_«a10»_0 ctx, generatedRoot.w_«a11»_0 ctx]] --MID

/-- Artifact families flattened by original slot: group `slot / 4`, local slot `slot % 4`. -/
noncomputable def leafFamilies0_«k» (ctx : generatedRoot.Ctx Backend.backend model tape path params) :
    Fin 16 → Fin 7 → ExactMatrix Q N 1 88 := «families0»

noncomputable def leafFamilies1_«k» (ctx : generatedRoot.Ctx Backend.backend model tape path params) :
    Fin 16 → Fin 7 → ExactMatrix Q N 1 88 := «families1»

/-- The first-depth branch data; the leaf families now occupy group zero, slot zero. -/
noncomputable def data1_«k» (ctx : generatedRoot.Ctx Backend.backend model tape path params) : BranchData :=
  ⟨generatedRoot.w_45_0 ctx, generatedRoot.w_46_0 ctx, generatedRoot.w_«TI0»_0 ctx, generatedRoot.w_«TI1»_0 ctx,
    generatedRoot.w_«TL0»_0 ctx, generatedRoot.w_«TL1»_0 ctx, generatedRoot.w_11_0 ctx,
    generatedRoot.w_«h0»_0 ctx, generatedRoot.w_«h1»_0 ctx,
    fun b ↦ lutCompRow (mKey_«k» ctx) (expandFam (generatedRoot.w_50_0 ctx)) (expandFam (generatedRoot.w_51_0 ctx)) b⟩

/-- The second-depth leaf data of step «k»: the parents' rows and keys are the internal lanes'. -/
noncomputable def data2_«k» (ctx : generatedRoot.Ctx Backend.backend model tape path params) : Leaf2Data :=
  ⟨generatedRoot.w_45_0 ctx, generatedRoot.w_46_0 ctx,
    fun leaf ↦ leafFamilies0_«k» ctx
      (chunkSlot (leafLocation2 leaf).1 (leafLocation2 leaf).2.1) (leafLocation2 leaf).2.2,
    fun leaf ↦ leafFamilies1_«k» ctx
      (chunkSlot (leafLocation2 leaf).1 (leafLocation2 leaf).2.1) (leafLocation2 leaf).2.2,
    generatedRoot.w_11_0 ctx, generatedRoot.w_«int»_0 ctx, generatedRoot.w_«int»_1 ctx,
    fun l ↦ lutCompRow (parentKeys (generatedRoot.w_«int»_2 ctx) (generatedRoot.w_«int»_3 ctx)
        (generatedRoot.w_«int»_4 ctx) (generatedRoot.w_«int»_5 ctx) ⟨l % 15, by omega⟩)
      (expandFam (generatedRoot.w_50_0 ctx)) (expandFam (generatedRoot.w_51_0 ctx)) (member2 l l.isLt)⟩

theorem leafSlotFamilies0_«k» (ctx : generatedRoot.Ctx Backend.backend model tape path params)
    (slot : Fin 16) : (leafSlotData (data1_«k» ctx) (data2_«k» ctx) slot).TL0 = leafFamilies0_«k» ctx slot := by
  cases slot using Fin.cases with
  | zero => rfl
  | succ parent =>
    funext member
    change leafFamilies0_«k» ctx ⟨4 * ((1 + (leafIndex parent member).val % 15) / 4) +
        (1 + (leafIndex parent member).val % 15) % 4, by omega⟩
      ⟨(leafIndex parent member).val / 15, by omega⟩ = leafFamilies0_«k» ctx parent.succ member
    have hs : (⟨4 * ((1 + (leafIndex parent member).val % 15) / 4) +
        (1 + (leafIndex parent member).val % 15) % 4, by omega⟩ : Fin 16) = parent.succ :=
      Fin.ext (by simp only [leafIndex_mod, Fin.val_succ]; omega)
    have hm : (⟨(leafIndex parent member).val / 15, by omega⟩ : Fin 7) = member :=
      Fin.ext (leafIndex_div parent member)
    rw [hs, hm]

theorem leafSlotFamilies1_«k» (ctx : generatedRoot.Ctx Backend.backend model tape path params)
    (slot : Fin 16) : (leafSlotData (data1_«k» ctx) (data2_«k» ctx) slot).TL1 = leafFamilies1_«k» ctx slot := by
  cases slot using Fin.cases with
  | zero => rfl
  | succ parent =>
    funext member
    change leafFamilies1_«k» ctx ⟨4 * ((1 + (leafIndex parent member).val % 15) / 4) +
        (1 + (leafIndex parent member).val % 15) % 4, by omega⟩
      ⟨(leafIndex parent member).val / 15, by omega⟩ = leafFamilies1_«k» ctx parent.succ member
    have hs : (⟨4 * ((1 + (leafIndex parent member).val % 15) / 4) +
        (1 + (leafIndex parent member).val % 15) % 4, by omega⟩ : Fin 16) = parent.succ :=
      Fin.ext (by simp only [leafIndex_mod, Fin.val_succ]; omega)
    have hm : (⟨(leafIndex parent member).val / 15, by omega⟩ : Fin 7) = member :=
      Fin.ext (leafIndex_div parent member)
    rw [hs, hm]

/-- A static family read is the member. -/
theorem familyStatic_read {α : Type} {count : Nat} {f : Fin count → α} {o : α} {k : Nat}
    (hk : k < count) (h : familyGetStatic f (k : Int) o) : o = f ⟨k, hk⟩ := by
  obtain ⟨q, hq, ho⟩ := h
  have e : q = ⟨k, hk⟩ := Fin.ext (by simp only; omega)
  rw [ho, e]

set_option maxRecDepth 200000 in
set_option maxHeartbeats 0 in
theorem online_root«k» {ctx : generatedRoot.Ctx Backend.backend model tape path params}
    {outputs : ExactMatrix Q N 1 44 × ExactMatrix Q N 1 44 × ExactMatrix Q N 1 44 × ExactMatrix Q N 1 44 ×
      ExactMatrix Q N 1 44 × ExactMatrix Q N 1 44 × Unit}
    (F : generatedRoot.Facts ctx outputs)
    {s : ErrorPoly N} (hs : polyNorm s ≤ 1) {v B : Nat}
    (henc : Rel s (inputKey model (generatedRoot.w_11_0 ctx)) --FIRST
    (henc : Rel s (aKey_«k» ctx) --MID
      (fun j ↦ reducePoly Q N ((((1 : Nat) : Int) : ErrorPoly N) * Xe v * unitPair s j) • g0)
      ![generatedRoot.w_«r0» ctx, generatedRoot.w_«r1» ctx] B)
    (p : Fin 2) (hp : generatedRoot.w_13_0 ctx «k» = p) {xv : Nat} {eB : Fin 2 → ErrorMatrix N 1 44}
    (hrhs : ∀ j, reducePoly Q N s • ![rhsTop model (generatedRoot.w_11_0 ctx) p 0,
        rhsTop model (generatedRoot.w_11_0 ctx) p 1] j +
      ![generatedRoot.w_18_0 ctx p, generatedRoot.w_20_0 ctx p] j =
      reducePoly Q N (Xe xv * unitPair s j) • g0 + reduceMatrix Q N 1 44 (eB j))
    (heB : ∀ j, CoeffBound (eB j) 31)
    {ez0 : Fin 15488 → Fin 2 → ErrorMatrix N 1 1}
    (hcomp0 : ∀ i : Fin 15488,
      RelE s (rhsCompKey model (generatedRoot.w_11_0 ctx) ((i / 3872 : Nat) : Int) ((i % 88 : Nat) : Int)
          ((44 + (i / 88) % 44 : Nat) : Int))
        (fun j _ _ ↦ reducePoly PQ N (((P : Nat) : Int) *
          (entryDigit (joinedEntry ![generatedRoot.w_18_0 ctx ⟨i / 3872, by omega⟩,
              generatedRoot.w_20_0 ctx ⟨i / 3872, by omega⟩] ⟨i % 88, by omega⟩)
            ⟨(i / 88) % 44, by omega⟩ * unitPair s j)))
        ![generatedRoot.w_25_0 ctx i, generatedRoot.w_26_0 ctx i] (ez0 i) ∧ ∀ j, CoeffBound (ez0 i j) 31)
    (hM : ∀ r (j : Fin 2) (l : Fin 44), mKey_«k» ctx r j 0 l =
      ∑ a, keyCompanionSum model (generatedRoot.w_11_0 ctx) p (inputKey model (generatedRoot.w_11_0 ctx)) r --FIRST
        ⟨44 * (j : Nat) + l, by omega⟩ a + --FIRST
      ∑ a : Fin 44, inputKey model (generatedRoot.w_11_0 ctx) r 0 0 a * --FIRST
      ∑ a, keyCompanionSum model (generatedRoot.w_11_0 ctx) p (aKey_«k» ctx) r ⟨44 * (j : Nat) + l, by omega⟩ a + --MID
      ∑ a : Fin 44, aKey_«k» ctx r 0 0 a * --MID
        rowDigits (joinRow ![rhsTop model (generatedRoot.w_11_0 ctx) p 0,
          rhsTop model (generatedRoot.w_11_0 ctx) p 1]) a ⟨44 * (j : Nat) + l, by omega⟩)
    (hhelp : ∀ (i : Fin 37) (k : Nat) (hk : Odd k), kHelp i = k →
      Rel s (helperKey model (generatedRoot.w_11_0 ctx) k)
        (fun j ↦ reducePoly Q N ((((1 : Nat) : Int) : ErrorPoly N) * unitPair (substitution k hk s) j) • g0)
        ![generatedRoot.w_45_0 ctx i, generatedRoot.w_46_0 ctx i] 31)
    {ez : Fin 85184 → Fin 2 → ErrorMatrix N 1 1}
    (hcomp : ∀ i : Fin 85184,
      RelE (substitution (kSw (i / 3872)) (kSw_odd ⟨i / 3872, by omega⟩) s)
        (lutCompKey model (generatedRoot.w_11_0 ctx) (kSw (i / 3872)) ((i % 88 : Nat) : Int)
          ((44 + (i / 88) % 44 : Nat) : Int))
        (fun j _ _ ↦ reducePoly PQ N (((P : Nat) : Int) *
          (entryDigit (joinedEntry ![switchBot model (generatedRoot.w_11_0 ctx) (generatedRoot.w_45_0 ctx)
                (generatedRoot.w_46_0 ctx) ⟨i / 3872, by omega⟩ 0,
              switchBot model (generatedRoot.w_11_0 ctx) (generatedRoot.w_45_0 ctx)
                (generatedRoot.w_46_0 ctx) ⟨i / 3872, by omega⟩ 1] ⟨i % 88, by omega⟩)
            ⟨(i / 88) % 44, by omega⟩ *
            unitPair (substitution (kSw (i / 3872)) (kSw_odd ⟨i / 3872, by omega⟩) s) j)))
        ![generatedRoot.w_50_0 ctx i, generatedRoot.w_51_0 ctx i] (ez i) ∧ ∀ j, CoeffBound (ez i j) 31)
    (hT1 : ∀ (b : Fin 22) r jj, ![(data1_«k» ctx).Tb0 b b.isLt, (data1_«k» ctx).Tb1 b b.isLt] r 0 jj =
      ∑ a, lutKeyCompanionSum model (generatedRoot.w_11_0 ctx) b (mKey_«k» ctx) r jj a +
      ∑ a : Fin 44, substitution (kSw b) (kSw_odd b) (mKey_«k» ctx r 0 0 a) *
        rowDigits (switchTopRow model (generatedRoot.w_11_0 ctx) b) a jj)
    (hT2 : ∀ (l : Fin 105) r jj, ![(data2_«k» ctx).Tb0 l l.isLt, (data2_«k» ctx).Tb1 l l.isLt] r 0 jj =
      ∑ a, lutKeyCompanionSum model (generatedRoot.w_11_0 ctx) (member2 l l.isLt)
        ((data1_«k» ctx).key1 model ⟨l % 15, by omega⟩) r jj a +
      ∑ a : Fin 44, substitution (kSw (15 + l / 15)) (kSw_odd (member2 l l.isLt))
        ((data1_«k» ctx).key1 model ⟨l % 15, by omega⟩ r 0 0 a) *
        rowDigits (switchTopRow model (generatedRoot.w_11_0 ctx) (member2 l l.isLt)) a jj)
    (ht : ∀ j : Fin 128, 0 ≤ generatedRoot.w_38_0 ctx ⟨«off» + j, by omega⟩ ∧ --MONO
      generatedRoot.w_38_0 ctx ⟨«off» + j, by omega⟩ < 2 * N) --MONO
    (he : v + xv < 128) :
    Rel s (stepKey model (mKey_«k» ctx) (data1_«k» ctx) (data2_«k» ctx)
        (fun k ↦ branchCoef«C_» (generatedRoot.w_38_0 ctx) «off» k (by norm_num)))
      (fun j ↦ (reducePoly Q N (unitPair s j) *
        «table» (generatedRoot.w_38_0 ctx) «off» (by norm_num) ⟨v + xv, he⟩) • g0)
      ![generatedRoot.w_«out0»_0 ctx, generatedRoot.w_«out1»_0 ctx]
      (stepBound (productBound B companionBound) (bound1 (productBound B companionBound))
        (bound2 (productBound B companionBound))) := by
  -- The position of the step.
  have hw14 : generatedRoot.w_«pos»_0 ctx = ((p : Nat) : Int) := by
    obtain ⟨q, hq, hout⟩ := @@h«pos»_0@@
    have hk : ((«k» : Fin 2) : Nat) = «k» := rfl
    rw [hout, ← hp, Fin.ext (by omega : (q : Nat) = («k» : Fin 2))]
  have getp : ∀ {α : Type} {f : Fin 2 → α} {o : α}, familyGetDynamic f (generatedRoot.w_«pos»_0 ctx) o →
      o = f p := by
    intro α f o ⟨q, hq, ho⟩
    rw [ho, Fin.ext (by omega : (q : Nat) = p)]
  -- The public top row and the bottom row of the attribute ciphertext.
  obtain ⟨a12, b12, h12a, h12b, h12o⟩ := F.c0.h12_1 p
  simp only [Prod.mk.injEq] at h12o
  have hw15 : generatedRoot.w_«t0»_0 ctx = rhsTop model (generatedRoot.w_11_0 ctx) p 0 := by
    rw [getp @@h«t0»_0@@, h12o.1]; exact hashSample_eq h12a
  have hw16 : generatedRoot.w_«t1»_0 ctx = rhsTop model (generatedRoot.w_11_0 ctx) p 1 := by
    rw [getp @@h«t1»_0@@, h12o.2.1]; exact hashSample_eq h12b
  have hw17 : generatedRoot.w_«top»_0 ctx = joinRow ![rhsTop model (generatedRoot.w_11_0 ctx) p 0,
      rhsTop model (generatedRoot.w_11_0 ctx) p 1] := by
    have h := @@h«top»_0@@
    rw [hw15, hw16] at h
    exact concat_joinRow (r := ![_, _]) h
  have hw22 : generatedRoot.w_«bot»_0 ctx =
      joinRow ![generatedRoot.w_18_0 ctx p, generatedRoot.w_20_0 ctx p] := by
    have h := @@h«bot»_0@@
    rw [getp @@h«y0»_0@@, getp @@h«y1»_0@@] at h
    exact concat_joinRow (r := ![_, _]) h
  -- The hashed input key. --FIRST
  have hA0 : concatColumns (inputKey model (generatedRoot.w_11_0 ctx) 0 0) --FIRST
      (inputKey model (generatedRoot.w_11_0 ctx) 0 1) (generatedRoot.w_29_0 ctx) := by --FIRST
    have h := @@h29_0@@ --FIRST
    rw [hashSample_eq @@h27_0@@, hashSample_eq @@h28_0@@] at h --FIRST
    exact h --FIRST
  have hA1 : concatColumns (inputKey model (generatedRoot.w_11_0 ctx) 1 0) --FIRST
      (inputKey model (generatedRoot.w_11_0 ctx) 1 1) (generatedRoot.w_32_0 ctx) := by --FIRST
    have h := @@h32_0@@ --FIRST
    rw [hashSample_eq @@h30_0@@, hashSample_eq @@h31_0@@] at h --FIRST
    exact h --FIRST
  -- The product.
  have hcol := fun jj ↦ Step«k».colLoop0 (model := model) (tape := tape)
    (path := path) (params := params) @@h«col»_0@@ jj
  rw [hw17, hw22] at hcol
  have h33 := @@h«mul»_0@@
  rw [hw14] at h33
  have hmul := fun jj ↦ Step«k».mulLoop0 (model := model) (tape := tape) (path := path) (params := params) hA0 hA1 h33 jj --FIRST
  have hmul := fun jj ↦ Step«k».mulLoop0 (model := model) (tape := tape) (path := path) (params := params) (A := aKey_«k» ctx) @@h«A0»_0@@ @@h«A1»_0@@ h33 jj --MID
  have hprod := product_glue hs @@h«C»_0@@ henc p hrhs heB hcol (zc0 := generatedRoot.w_25_0 ctx)
    (zc1 := generatedRoot.w_26_0 ctx) (ez := ez0) (fun i hi ↦ by
      have e : (⟨(i : Nat) / 3872, by omega⟩ : Fin 2) = p := Fin.ext hi
      have h := hcomp0 i
      rw [e] at h
      exact h) hmul hM
  have hwh0 : generatedRoot.w_«h0»_0 ctx = rowWindow 44 0 (by omega) (generatedRoot.w_«P»_0 ctx) :=
    sliceMatrix_window 0 @@h«h0»_0@@ rfl (by omega)
  have hwh1 : generatedRoot.w_«h1»_0 ctx = rowWindow 44 44 (by omega) (generatedRoot.w_«P»_0 ctx) :=
    sliceMatrix_window 44 @@h«h1»_0@@ rfl (by omega)
  have hP : Rel s (mKey_«k» ctx)
      (fun j ↦ reducePoly Q N ((((1 : Nat) : Int) : ErrorPoly N) * Xe (v + xv) * unitPair s j) • g0)
      ![(data1_«k» ctx).c0, (data1_«k» ctx).c1] (productBound B companionBound) := by
    show Rel s _ _ ![generatedRoot.w_«h0»_0 ctx, generatedRoot.w_«h1»_0 ctx] _
    rw [hwh0, hwh1]
    exact hprod
  -- The identity coefficient and its scalar.
  have hcoef := Step«k».coefLoop0 (model := model) (tape := tape)
    (path := path) (params := params) @@h«coef»_0@@
  have hV : generatedRoot.w_«V»_0 ctx =
      scalarV (branchCoef«C_» (generatedRoot.w_38_0 ctx) «off» 1 (by norm_num)) := by
    refine scalarV_eq @@h«g»_0@@ ?_
    have hv := @@h«V»_0@@
    change gadgetDecomposeRuns _ _ _ (matrixMulScalarLeft (matrixMulScalarLeft winvPoly
      (generatedRoot.w_«coef»_0 ctx)) (generatedRoot.w_«g»_0 ctx)) _ at hv
    rw [hcoef] at hv
    exact hv
  -- The internal branches, one lane each.
  have hlane := fun b : Fin 15 ↦ Step«k».internalBranch56 (A := mKey_«k» ctx) b.isLt
    @@h«M0»_0@@ @@h«M1»_0@@ (@@h«int»_7@@ b)
  have hint : ∀ b : Fin 15, (data1_«k» ctx).Runs model b (by omega) ∧
      (∀ j, ![generatedRoot.w_«int»_0 ctx b, generatedRoot.w_«int»_1 ctx b] j =
        (data1_«k» ctx).row model b (by omega) j) ∧
      ∀ r j, ![![generatedRoot.w_«int»_2 ctx b, generatedRoot.w_«int»_3 ctx b],
        ![generatedRoot.w_«int»_4 ctx b, generatedRoot.w_«int»_5 ctx b]] r j =
        (data1_«k» ctx).key1 model ⟨b, by omega⟩ r j := fun b ↦ by
    obtain ⟨r1, r2, r3, r4, -⟩ := hlane b
    have e0 := (data1_«k» ctx).Tb0_internal b.isLt
    have e1 := (data1_«k» ctx).Tb1_internal b.isLt
    refine ⟨⟨?_, ?_⟩, fun j ↦ ?_, fun r j ↦ ?_⟩
    · rw [e0, e1]; exact r1
    · exact r2
    · rw [r3 j, BranchData.row, e0, e1]; rfl
    · rw [r4 r j, BranchData.key1]
      simp only [Fin.val_mk]
      rw [e0, e1]; rfl
  have hterm : ∀ (b : Fin 15) j, ![generatedRoot.w_«int»_6 ctx b, generatedRoot.w_«int»_7 ctx b] j =
      ![generatedRoot.w_«int»_0 ctx b, generatedRoot.w_«int»_1 ctx b] j *
        scalarV (branchCoef«C_» (generatedRoot.w_38_0 ctx) «off» (kSw b) (by norm_num)) :=
    fun b ↦ (hlane b).2.2.2.2
  -- The member sum of the weighted internal rows.
  have hsum := @@h«sum»_1@@
  have e59 : generatedRoot.w_«s0»_0 ctx = generatedRoot.w_«int»_6 ctx 0 + generatedRoot.w_«int»_6 ctx 1 := by
    show matrixAdd (generatedRoot.w_«sa»_0 ctx) (generatedRoot.w_«sb»_0 ctx) = _
    rw [familyStatic_read (k := 0) (by omega) @@h«sa»_0@@, familyStatic_read (k := 1) (by omega) @@h«sb»_0@@]
    rfl
  have e62 : generatedRoot.w_«s1»_0 ctx = generatedRoot.w_«int»_7 ctx 0 + generatedRoot.w_«int»_7 ctx 1 := by
    show matrixAdd (generatedRoot.w_«sc»_0 ctx) (generatedRoot.w_«sd»_0 ctx) = _
    rw [familyStatic_read (k := 0) (by omega) @@h«sc»_0@@, familyStatic_read (k := 1) (by omega) @@h«sd»_0@@]
    rfl
  rw [e59, e62] at hsum
  have h63 := Step«k».sumLoop63 (model := model) (tape := tape)
    (path := path) (params := params) hsum
  simp only [Prod.mk.injEq] at h63
  -- Each lane contracts the shared companions into sixteen branch rows.
  have hE : ∀ (member : Fin 7) (slot : Fin 16),
      (leafSlotData (data1_«k» ctx) (data2_«k» ctx) slot).Eb (15 + member) (by omega) =
        lutCompRow (Fin.cases (mKey_«k» ctx)
          (parentKeys (generatedRoot.w_«int»_2 ctx) (generatedRoot.w_«int»_3 ctx)
            (generatedRoot.w_«int»_4 ctx) (generatedRoot.w_«int»_5 ctx)) slot)
          (expandFam (generatedRoot.w_50_0 ctx)) (expandFam (generatedRoot.w_51_0 ctx))
          ⟨15 + member, by omega⟩ := by
    intro member slot
    cases slot using Fin.cases with
    | zero => rfl
    | succ parent =>
      change ((data2_«k» ctx).memberBranch parent).Eb (15 + member) (by omega) = _
      rw [Leaf2Data.memberBranch_E]
      change lutCompRow (parentKeys _ _ _ _ ⟨(leafIndex parent member).val % 15, by omega⟩)
          _ _ (member2 (leafIndex parent member) (leafIndex parent member).isLt) = _
      rw [leafIndex_parent, leafIndex_member]
      rfl
«GROUPS»
  have lanes«group» := fun member : Fin 7 ↦ Step«k».Group«group».memberLane member.isLt
    (data1_«k» ctx) (data2_«k» ctx)
    rfl rfl rfl (T0 := leafFamilies0_«k» ctx) (T1 := leafFamilies1_«k» ctx)
    (leafSlotFamilies0_«k» ctx) (leafSlotFamilies1_«k» ctx)
    (K00 := generatedRoot.w_«int»_2 ctx) (K01 := generatedRoot.w_«int»_3 ctx)
    (K10 := generatedRoot.w_«int»_4 ctx) (K11 := generatedRoot.w_«int»_5 ctx)
    (zc0 := generatedRoot.w_50_0 ctx) (zc1 := generatedRoot.w_51_0 ctx)
    (tables := generatedRoot.w_38_0 ctx)
    (M := mKey_«k» ctx) @@h«M0»_0@@ @@h«M1»_0@@ (hE member) (@@h«leafg»_1@@ member)
  have memberSum«group» := @@h«msumg»_1@@
  have m0«group» : generatedRoot.w_«ms0g»_0 ctx =
      generatedRoot.w_«leafg»_0 ctx 0 + generatedRoot.w_«leafg»_0 ctx 1 := by
    show matrixAdd (generatedRoot.w_«ms_ag»_0 ctx) (generatedRoot.w_«ms_bg»_0 ctx) = _
    rw [familyStatic_read (k := 0) (by omega) @@h«ms_ag»_0@@,
      familyStatic_read (k := 1) (by omega) @@h«ms_bg»_0@@]
    rfl
  have m1«group» : generatedRoot.w_«ms1g»_0 ctx =
      generatedRoot.w_«leafg»_1 ctx 0 + generatedRoot.w_«leafg»_1 ctx 1 := by
    show matrixAdd (generatedRoot.w_«ms_cg»_0 ctx) (generatedRoot.w_«ms_dg»_0 ctx) = _
    rw [familyStatic_read (k := 0) (by omega) @@h«ms_cg»_0@@,
      familyStatic_read (k := 1) (by omega) @@h«ms_dg»_0@@]
    rfl
  rw [m0«group», m1«group»] at memberSum«group»
  have summed«group» := Step«k».Group«group».memberSumLoop (model := model) (tape := tape)
    (path := path) (params := params) memberSum«group»
  simp only [Prod.mk.injEq] at summed«group»
  have laneSum«group» : ∀ port : Fin 2,
      ![generatedRoot.w_«msumg»_0 ctx, generatedRoot.w_«msumg»_1 ctx] port =
      ∑ member : Fin 7, ∑ slot : Fin 4, memberTerm model (data1_«k» ctx) (data2_«k» ctx)
        (fun index ↦ branchCoef«C_» (generatedRoot.w_38_0 ctx) «off» index (by norm_num))
        member (chunkSlot «group» slot) port := by
    intro port
    fin_cases port
    · change generatedRoot.w_«msumg»_0 ctx = _
      rw [show generatedRoot.w_«msumg»_0 ctx = ∑ member, generatedRoot.w_«leafg»_0 ctx member
        from summed«group».1]
      exact Finset.sum_congr rfl fun member _ ↦ (lanes«group» member).2 0
    · change generatedRoot.w_«msumg»_1 ctx = _
      rw [show generatedRoot.w_«msumg»_1 ctx = ∑ member, generatedRoot.w_«leafg»_1 ctx member
        from summed«group».2.1]
      exact Finset.sum_congr rfl fun member _ ↦ (lanes«group» member).2 1
«ENDGROUPS»
  have runs : ∀ (member : Fin 7) (slot : Fin 16),
      (leafSlotData (data1_«k» ctx) (data2_«k» ctx) slot).Runs model
        (15 + member) (by omega) := fun member ↦ forall16 «runs»
  have hleaf1 : ∀ i (hi : i < 7), (data1_«k» ctx).Runs model (15 + i) (by omega) :=
    fun i hi ↦ runs ⟨i, hi⟩ 0
  have hleaf2 : ∀ l (hl : l < 105), (data2_«k» ctx).Runs model l hl := by
    intro l hl
    let parent : Fin 15 := ⟨l % 15, by omega⟩
    let member : Fin 7 := ⟨l / 15, by omega⟩
    have idx : leafIndex parent member = (⟨l, hl⟩ : Fin 105) := Fin.ext (by
      dsimp only [leafIndex, parent, member]
      omega)
    have run := ((data2_«k» ctx).memberBranch_runs model parent member).mp
      (runs member parent.succ)
    rw [idx] at run
    exact run
  have laneSum : ∀ port : Fin 2,
      ![generatedRoot.w_«msum0»_0 ctx, generatedRoot.w_«msum0»_1 ctx] port +
      ![generatedRoot.w_«msum1»_0 ctx, generatedRoot.w_«msum1»_1 ctx] port +
      ![generatedRoot.w_«msum2»_0 ctx, generatedRoot.w_«msum2»_1 ctx] port +
      ![generatedRoot.w_«msum3»_0 ctx, generatedRoot.w_«msum3»_1 ctx] port =
      ∑ member : Fin 7, ∑ slot : Fin 16, memberTerm model (data1_«k» ctx) (data2_«k» ctx)
        (fun index ↦ branchCoef«C_» (generatedRoot.w_38_0 ctx) «off» index (by norm_num))
        member slot port := by
    intro port
    rw [sum_member_chunks, laneSum0 port, laneSum1 port, laneSum2 port, laneSum3 port]
  have hterm0 : ∀ b : Fin 15, generatedRoot.w_«int»_6 ctx b = generatedRoot.w_«int»_0 ctx b *
      scalarV (branchCoef«C_» (generatedRoot.w_38_0 ctx) «off» (kSw b) (by norm_num)) := fun b ↦ hterm b 0
  have hterm1 : ∀ b : Fin 15, generatedRoot.w_«int»_7 ctx b = generatedRoot.w_«int»_1 ctx b *
      scalarV (branchCoef«C_» (generatedRoot.w_38_0 ctx) «off» (kSw b) (by norm_num)) := fun b ↦ hterm b 1
  have hR : ∀ j, ![generatedRoot.w_«out0»_0 ctx, generatedRoot.w_«out1»_0 ctx] j =
      ![(data1_«k» ctx).c0, (data1_«k» ctx).c1] j *
        scalarV (branchCoef«C_» (generatedRoot.w_38_0 ctx) «off» 1 (by norm_num)) +
      ∑ b : Fin 15, ![generatedRoot.w_«int»_0 ctx b, generatedRoot.w_«int»_1 ctx b] j *
        scalarV (branchCoef«C_» (generatedRoot.w_38_0 ctx) «off» (kSw b) (by norm_num)) +
      ∑ i : Fin 7, (data1_«k» ctx).row model (15 + i) (by omega) j *
        scalarV (branchCoef«C_» (generatedRoot.w_38_0 ctx) «off» (kSw (15 + i)) (by norm_num)) +
      ∑ l : Fin 105, (data2_«k» ctx).row model l l.isLt j *
        scalarV (branchCoef«C_» (generatedRoot.w_38_0 ctx) «off» (kLeaf2 l) (by norm_num)) := by
    intro j
    have sum0 := laneSum 0
    have sum1 := laneSum 1
    rw [memberTerms_sum] at sum0 sum1
    fin_cases j
    · simp only [Fin.zero_eta, Fin.isValue, Matrix.cons_val_zero] at sum0 ⊢
      change matrixAdd (matrixAdd (matrixMul (generatedRoot.w_«h0»_0 ctx) (generatedRoot.w_«V»_0 ctx))
        (generatedRoot.w_«sum»_0 ctx)) (generatedRoot.w_«msum0»_0 ctx) +
        generatedRoot.w_«msum1»_0 ctx + generatedRoot.w_«msum2»_0 ctx +
        generatedRoot.w_«msum3»_0 ctx = _
      rw [show generatedRoot.w_«sum»_0 ctx = ∑ b, generatedRoot.w_«int»_6 ctx b from h63.1,
        Finset.sum_congr rfl (fun b _ ↦ hterm0 b), hV]
      exact add_chunk_sums _ sum0
    · simp only [Fin.mk_one, Fin.isValue, Matrix.cons_val_one, Matrix.cons_val_zero] at sum1 ⊢
      change matrixAdd (matrixAdd (matrixMul (generatedRoot.w_«h1»_0 ctx) (generatedRoot.w_«V»_0 ctx))
        (generatedRoot.w_«sum»_1 ctx)) (generatedRoot.w_«msum0»_1 ctx) +
        generatedRoot.w_«msum1»_1 ctx + generatedRoot.w_«msum2»_1 ctx +
        generatedRoot.w_«msum3»_1 ctx = _
      rw [show generatedRoot.w_«sum»_1 ctx = ∑ b, generatedRoot.w_«int»_7 ctx b from h63.2.1,
        Finset.sum_congr rfl (fun b _ ↦ hterm1 b), hV]
      exact add_chunk_sums _ sum1
  refine online_step hs he (data1_«k» ctx) (data2_«k» ctx) hP hhelp hcomp (fun _ ↦ rfl) hT1 hint hleaf1 rfl
    ⟨rfl, rfl⟩ ⟨rfl, rfl⟩ (fun _ ↦ rfl) hT2 hleaf2 («table» (generatedRoot.w_38_0 ctx) «off» (by norm_num)) _ ?_ hR
  · exact fun k hk ↦ branchCoef_fourier _ «off» (by norm_num) ht k hk --MONO
  · exact fun k hk ↦ branchCoefC_fourier _ «off» (by norm_num) k hk --CONST

end PeProof
