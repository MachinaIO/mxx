section Model5

variable (model : HashModel) (key : ByteArray) (ext : GeneratedClaim.ExternalInputs)

/-- The state rows entering block `5`. -/
noncomputable def stateRow5 (tape : SampleTape) : Fin 2 → ExactMatrix Q31 N 1 120 :=
  encRow (maskM tape) (key5 model key ext tape) (stateTarget5 ext tape) (err5 model key ext tape)

/-- The selector RHS bottoms of block `5`. -/
noncomputable def bot5 (tape : SampleTape) (i : Fin 113) (j : Fin 2) : ExactMatrix Q30 N 1 116 :=
  reducePoly Q30 N (((P30 : Nat) : Int) * nuOf ext 5 i * unitPair (payloadM tape) j) • gReb Q30 Q29 116 +
    reduceMatrix Q30 N 1 116 (rhsError5 tape [2] i j) -
    reducePoly Q30 N (payloadM tape) • rhsTop model key Q30 116 rhsPrefix5 i j

/-- The keys entering block `6`. -/
noncomputable def key6 (tape : SampleTape) : Fin 2 → Fin 2 → ExactMatrix Q30 N 1 116 :=
  ∑ i : Fin 113, fun k j ↦ theOutput (blockModSwitchRuns [1099510054913, 1099507695617, 1099506515969, 1099504549889, 1099503894529, 1099503370241, 1099502714881, 1099500617729, 1099499569153, 1099499175937, 1099498258433, 1099490000897, 1099489607681, 1099488428033, 1099486855169, 1099484889089, 1099484495873, 1099482923009, 1099480956929, 1099479121921, 1099469684737, 1099468767233, 1099468505089, 1099467194369, 1099465359361, 1099463786497, 1099461820417, 1099460902913, 1099460640769, 1099457495041, 1099455004673] 1)
    (cellKeyUp5 (memberKey model key ((coords 5 i : Nat) : Int)) (key5 model key ext tape)
      (rhsTop model key Q30 116 rhsPrefix5 i) (bot5 model key ext tape i) k j)

/-- The alignment numerator of the member of cell `i` of block `5` in the model. -/
noncomputable def alignM5 (tape : SampleTape) (i : Fin 113) (j : Fin 2) : ErrorMatrix N 1 124 :=
  alignNumer5 (maskM tape) (memberKey model key ((coords 5 i : Nat) : Int))
    (memberError tape [3] ⟨coords 5 i, coords_lt 5 i⟩) (memberRow model key ext tape ⟨coords 5 i, coords_lt 5 i⟩) j

/-- The numerator of cell `i` of block `5` in the model. -/
noncomputable def numerM5 (tape : SampleTape) (i : Fin 113) (j : Fin 2) : ErrorMatrix N 1 116 :=
  cellNumer5 (maskM tape)
      (memberKey model key ((coords 5 i : Nat) : Int))
      (fun j' ↦ divInt A31 (alignM5 model key ext tape i j'))
      (err5 model key ext tape) (alphaOf ext ⟨coords 5 i, coords_lt 5 i⟩) (key5 model key ext tape)
      (rhsTop model key Q30 116 rhsPrefix5 i) (bot5 model key ext tape i)
      (fun j' ↦ theOutput (blockModSwitchRuns [1099510054913, 1099507695617, 1099506515969, 1099504549889, 1099503894529, 1099503370241, 1099502714881, 1099500617729, 1099499569153, 1099499175937, 1099498258433, 1099490000897, 1099489607681, 1099488428033, 1099486855169, 1099484889089, 1099484495873, 1099482923009, 1099480956929, 1099479121921, 1099469684737, 1099468767233, 1099468505089, 1099467194369, 1099465359361, 1099463786497, 1099461820417, 1099460902913, 1099460640769, 1099457495041, 1099455004673, 1099454218241, 1099453431809, 1099451465729, 1099451072513, 1099450810369] 1) (memberRow model key ext tape ⟨coords 5 i, coords_lt 5 i⟩ j' * alignDigits5))
      (stateRow5 model key ext tape) (fun _ _ ↦ reducePoly Q31 N (alphaOf ext ⟨coords 5 i, coords_lt 5 i⟩)) j

/-- The error entering block `6`. -/
noncomputable def err6 (tape : SampleTape) : Fin 2 → ErrorMatrix N 1 116 :=
  ∑ i : Fin 113, fun j ↦ divInt P31 (numerM5 model key ext tape i j) -
    (alphaOf ext ⟨coords 5 i, coords_lt 5 i⟩ * muOf ext 5) • rhsError5 tape [2] i j

/-- The alignment and cell numerators of block `5` are divisible by their dropped factors. -/
def div5 (tape : SampleTape) : Prop :=
  (∀ i j row column, alignM5 model key ext tape i j row column =
    ((A31 : Int) : ErrorPoly N) * divInt A31 (alignM5 model key ext tape i j) row column) ∧
  ∀ i j row column, numerM5 model key ext tape i j row column =
    ((P31 : Int) : ErrorPoly N) * divInt P31 (numerM5 model key ext tape i j) row column

/-- The state target of block `6` at `Q30`. -/
noncomputable def stateTarget6 (tape : SampleTape) (j : Fin 2) : ExactMatrix Q30 N 1 116 :=
  reducePoly Q30 N (((P30 : Nat) : Int) * muOf ext 6 * unitPair (payloadM tape) j) • gReb Q30 Q29 116

