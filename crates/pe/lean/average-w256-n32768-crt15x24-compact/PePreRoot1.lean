/-!
# Preprocessing step 1 at the root

Generated by `gen_pre_root.py` from `PePreRoot.lean.in`. From the incoming key `A`: the product
key of the position of step 1, the key rows of every first-depth branch (lanes
`parallel_generatedRoot_154` and grouped `parallel_generatedRoot_155`), and the output key
from the member sums. Group zero slot zero is a first-depth leaf. Second-depth leaf `l`
uses group `(1 + l % 15) / 4`, local slot `(1 + l % 15) % 4`, and member `l / 15`.
The sixteen-slot view below flattens these four consecutive groups.
-/

set_option maxRecDepth 200000

namespace PeProof

open Mxx.Primitives MxxRuntime MxxExponentLut MxxPe Stage_preprocess

variable {model : HashModel} {tape : SampleTape} {path : List Nat} {params : Params}

/-- The product key of preprocessing step 1. -/
noncomputable def preM_1 (ctx : generatedRoot.Ctx Backend.backend model tape path params) :
    Fin 2 → Fin 2 → ExactMatrix Q N 1 30 :=
  ![![generatedRoot.w_142_0 ctx, generatedRoot.w_145_0 ctx],
    ![generatedRoot.w_148_0 ctx, generatedRoot.w_151_0 ctx]]

/-- Published T families, indexed by flattened slot, row, then member. -/
def preLeafT_1 (ctx : generatedRoot.Ctx Backend.backend model tape path params) :
    Fin 16 → Fin 2 → Fin 15 → ExactMatrix Q N 1 60 :=
  fun slot r member ↦ (![![generatedRoot.w_155_0 ctx member, generatedRoot.w_155_1 ctx member], ![generatedRoot.w_155_2 ctx member, generatedRoot.w_155_3 ctx member], ![generatedRoot.w_155_4 ctx member, generatedRoot.w_155_5 ctx member], ![generatedRoot.w_155_6 ctx member, generatedRoot.w_155_7 ctx member], ![generatedRoot.w_156_0 ctx member, generatedRoot.w_156_1 ctx member], ![generatedRoot.w_156_2 ctx member, generatedRoot.w_156_3 ctx member], ![generatedRoot.w_156_4 ctx member, generatedRoot.w_156_5 ctx member], ![generatedRoot.w_156_6 ctx member, generatedRoot.w_156_7 ctx member], ![generatedRoot.w_157_0 ctx member, generatedRoot.w_157_1 ctx member], ![generatedRoot.w_157_2 ctx member, generatedRoot.w_157_3 ctx member], ![generatedRoot.w_157_4 ctx member, generatedRoot.w_157_5 ctx member], ![generatedRoot.w_157_6 ctx member, generatedRoot.w_157_7 ctx member], ![generatedRoot.w_158_0 ctx member, generatedRoot.w_158_1 ctx member], ![generatedRoot.w_158_2 ctx member, generatedRoot.w_158_3 ctx member], ![generatedRoot.w_158_4 ctx member, generatedRoot.w_158_5 ctx member], ![generatedRoot.w_158_6 ctx member, generatedRoot.w_158_7 ctx member]]) slot r

/-- The physical group/local-slot/row/member artifact layout. -/
def preLeafGroups_1 (ctx : generatedRoot.Ctx Backend.backend model tape path params) :
    Fin 4 → Fin 4 → Fin 2 → Fin 15 → ExactMatrix Q N 1 60 :=
  fun group slot r member ↦ (![![![generatedRoot.w_155_0 ctx member, generatedRoot.w_155_1 ctx member], ![generatedRoot.w_155_2 ctx member, generatedRoot.w_155_3 ctx member], ![generatedRoot.w_155_4 ctx member, generatedRoot.w_155_5 ctx member], ![generatedRoot.w_155_6 ctx member, generatedRoot.w_155_7 ctx member]], ![![generatedRoot.w_156_0 ctx member, generatedRoot.w_156_1 ctx member], ![generatedRoot.w_156_2 ctx member, generatedRoot.w_156_3 ctx member], ![generatedRoot.w_156_4 ctx member, generatedRoot.w_156_5 ctx member], ![generatedRoot.w_156_6 ctx member, generatedRoot.w_156_7 ctx member]], ![![generatedRoot.w_157_0 ctx member, generatedRoot.w_157_1 ctx member], ![generatedRoot.w_157_2 ctx member, generatedRoot.w_157_3 ctx member], ![generatedRoot.w_157_4 ctx member, generatedRoot.w_157_5 ctx member], ![generatedRoot.w_157_6 ctx member, generatedRoot.w_157_7 ctx member]], ![![generatedRoot.w_158_0 ctx member, generatedRoot.w_158_1 ctx member], ![generatedRoot.w_158_2 ctx member, generatedRoot.w_158_3 ctx member], ![generatedRoot.w_158_4 ctx member, generatedRoot.w_158_5 ctx member], ![generatedRoot.w_158_6 ctx member, generatedRoot.w_158_7 ctx member]]]) group slot r

theorem preLeafT_chunk_1 (ctx : generatedRoot.Ctx Backend.backend model tape path params)
    (group slot : Fin 4) (r : Fin 2) (member : Fin 15) :
    preLeafT_1 ctx ⟨4 * group.val + slot.val, by omega⟩ r member =
      preLeafGroups_1 ctx group slot r member := by
  exact Fin.cases (Fin.cases (rfl) (Fin.cases (rfl) (Fin.cases (rfl) (Fin.cases (rfl) ((by intro index; exact Fin.elim0 index)))))) (Fin.cases (Fin.cases (rfl) (Fin.cases (rfl) (Fin.cases (rfl) (Fin.cases (rfl) ((by intro index; exact Fin.elim0 index)))))) (Fin.cases (Fin.cases (rfl) (Fin.cases (rfl) (Fin.cases (rfl) (Fin.cases (rfl) ((by intro index; exact Fin.elim0 index)))))) (Fin.cases (Fin.cases (rfl) (Fin.cases (rfl) (Fin.cases (rfl) (Fin.cases (rfl) ((by intro index; exact Fin.elim0 index)))))) ((by intro index; exact Fin.elim0 index))))) group slot

theorem preLeafT_leaf_1 (ctx : generatedRoot.Ctx Backend.backend model tape path params)
    (leaf : Fin 225) (r : Fin 2) :
    groupedPreLeafRows (preLeafT_1 ctx) r leaf =
      preLeafGroups_1 ctx ⟨(1 + leaf.val % 15) / 4, by omega⟩
        ⟨(1 + leaf.val % 15) % 4, by omega⟩ r ⟨leaf.val / 15, by omega⟩ := by
  unfold groupedPreLeafRows
  rw [← preLeafT_chunk_1]
  congr 1
  apply Fin.ext
  simp only
  omega

/-- The sum of the four group outputs for one member. -/
noncomputable def preLeafKey_1 (ctx : generatedRoot.Ctx Backend.backend model tape path params)
    (r j : Fin 2) (member : Fin 15) : ExactMatrix Q N 1 30 :=
    keyOf (generatedRoot.w_155_8 ctx member, generatedRoot.w_155_9 ctx member, generatedRoot.w_155_10 ctx member, generatedRoot.w_155_11 ctx member, ()) r j +
    keyOf (generatedRoot.w_156_8 ctx member, generatedRoot.w_156_9 ctx member, generatedRoot.w_156_10 ctx member, generatedRoot.w_156_11 ctx member, ()) r j +
    keyOf (generatedRoot.w_157_8 ctx member, generatedRoot.w_157_9 ctx member, generatedRoot.w_157_10 ctx member, generatedRoot.w_157_11 ctx member, ()) r j +
    keyOf (generatedRoot.w_158_8 ctx member, generatedRoot.w_158_9 ctx member, generatedRoot.w_158_10 ctx member, generatedRoot.w_158_11 ctx member, ()) r j

