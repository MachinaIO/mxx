variable (model : HashModel) (key : ByteArray) (ext : GeneratedClaim.ExternalInputs)

/-- The state rows entering block `1`. -/
noncomputable def stateRow1 (tape : SampleTape) : Fin 2 → ExactMatrix Q35 N 1 136 :=
