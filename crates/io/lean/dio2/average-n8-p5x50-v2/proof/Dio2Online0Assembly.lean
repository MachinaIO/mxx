/-- The certificate budget of one component/target part, not a sum over targets. -/
def targetBudget (part : Fin 36) : Nat :=
  if part.val < 2 then b1_private else
  if part.val < 4 then b1_public else
  if part.val < 6 then b1_stateTarget else
  if part.val < 16 then b1_label else
  if part.val < 18 then b1_sigma else
  if part.val < 32 then b1_automorphism else
  b1_anchor


/-- Prime 0: every target class satisfies the certificate's exact margin. -/
theorem noise_margin0 (part : Fin 36) :
    2 * (54 * 8 * 1 * cutoff +
      (25 * 8 * b1_g * half + 25 * 8 * b1_one * half +
        25 * 8 * targetBudget part * half) + b1_fresh + b1_smudge +
      b1_residue) < quotient0 := by
  unfold targetBudget
  split_ifs
  · calc
      _ = b1_left_private := by
        rw [b1_left_private_eval, b1_error_private_eval, b1_hint_eval,
          b1_root_eval, C_eval, n_eval, m_eval, anchor_eval, half_eval, base_eval]
        ring
      _ < _ := b1_private_p0
  · calc
      _ = b1_left_public := by
        rw [b1_left_public_eval, b1_error_public_eval, b1_hint_eval,
          b1_root_eval, C_eval, n_eval, m_eval, anchor_eval, half_eval, base_eval]
        ring
      _ < _ := b1_public_p0
  · calc
      _ = b1_left_stateTarget := by
        rw [b1_left_stateTarget_eval, b1_error_stateTarget_eval, b1_hint_eval,
          b1_root_eval, C_eval, n_eval, m_eval, anchor_eval, half_eval, base_eval]
        ring
      _ < _ := b1_stateTarget_p0
  · calc
      _ = b1_left_label := by
        rw [b1_left_label_eval, b1_error_label_eval, b1_hint_eval,
          b1_root_eval, C_eval, n_eval, m_eval, anchor_eval, half_eval, base_eval]
        ring
      _ < _ := b1_label_p0
  · calc
      _ = b1_left_sigma := by
        rw [b1_left_sigma_eval, b1_error_sigma_eval, b1_hint_eval,
          b1_root_eval, C_eval, n_eval, m_eval, anchor_eval, half_eval, base_eval]
        ring
      _ < _ := b1_sigma_p0
  · calc
      _ = b1_left_automorphism := by
        rw [b1_left_automorphism_eval, b1_error_automorphism_eval, b1_hint_eval,
          b1_root_eval, C_eval, n_eval, m_eval, anchor_eval, half_eval, base_eval]
        ring
      _ < _ := b1_automorphism_p0
  · calc
      _ = b1_left_anchor := by
