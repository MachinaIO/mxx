/-! ## The readout LUT -/

noncomputable def ehL (tape : SampleTape) (i : Fin 16) : Fin 2 → ErrorMatrix N 1 2 := helperError tape [3] i

noncomputable def DEL (tape : SampleTape) (i : Fin 16) : ErrorMatrix N (2 + 2) 2 :=
  liftMatrix (lutDigitsE (key5 model key ext tape) (lutFam model key tape) i 1)

noncomputable def DDL (tape : SampleTape) (i : Fin 16) : ErrorMatrix N (2 + 2) 2 :=
  liftMatrix (lutDigitsD (lutFam model key tape) i 1)

def σL (i : Fin 16) : Nat := (sigma i).toNat

noncomputable def sL (tape : SampleTape) (i : Fin 16) : ErrorPoly N :=
  substitution (sigma i).toNat (sigma_odd i) (maskM tape)

noncomputable def KM0L (tape : SampleTape) (i : Fin 16) : ErrorMatrix N 1 2 :=
  downResidue P2 (lutKeyM (key5 model key ext tape) (lutFam model key tape) i 0 1)

noncomputable def KM1L (tape : SampleTape) (i : Fin 16) : ErrorMatrix N 1 2 :=
  downResidue P2 (lutKeyM (key5 model key ext tape) (lutFam model key tape) i 1 1)

noncomputable def RL (tape : SampleTape) : ErrorMatrix N 1 2 := downResidue P2 (lutRow model key ext tape 1)

noncomputable def K0L (tape : SampleTape) : ErrorMatrix N 1 2 :=
  downResidue P2 (lutKsum model key ext tape 0 1)

noncomputable def K1L (tape : SampleTape) : ErrorMatrix N 1 2 :=
  downResidue P2 (lutKsum model key ext tape 1 1)

noncomputable def aL (i : Fin 16) : ErrorPoly N := substitution (sigma i).toNat (sigma_odd i) (muOf ext 5)

theorem lutNumer_form (tape : SampleTape) :
    lutNumer model key ext tape 1 = ∑ i, lutBranch (ehL tape) (DEL model key ext tape) σL sigma_odd
      (err5 model key ext tape) (DDL model key tape) (sL tape) (KM0L model key ext tape)
      (KM1L model key ext tape) i - RL model key ext tape + maskM tape • K0L model key ext tape +
        K1L model key ext tape := by
  unfold lutNumer lutErr
  rw [Finset.sum_apply]
  simp only [lutBranchErr, lutBranch, add_assoc]
  rfl

theorem finalErr_form (tape : SampleTape) :
    finalErr model key ext tape 1 = (divInt ((P2 : Nat) : ℤ) (lutNumer model key ext tape 1) -
      ∑ i, aL ext i • switchError tape [2] i 1) * finalDigits :=
  rfl

/-! ## Weights -/

/-- The weight of the decoded coefficient `0`. -/
noncomputable def Wfin : Weight N 1 1 := fun _ _ k ↦ if k.val = 0 then 1 else 0

/-- The weight on the LUT error before the finalization. -/
noncomputable def WL : Weight N 1 2 := pullMul Wfin finalDigits

/-- The weight on the error entering the readout LUT. -/
noncomputable def V5 (tape : SampleTape) (j' : Fin 2) : Weight N 1 2 :=
  (((P2 : Nat) : ℤ) : ℝ)⁻¹ • lutStateWeight hN WL (DDL model key tape) σL j'

/-- The weight on the error entering block `4`. -/
noncomputable def V4 (tape : SampleTape) (j' : Fin 2) : Weight N 1 4 :=
  (((P3 : Nat) : ℤ) : ℝ)⁻¹ • stateWeight (V5 model key tape) (DrB4 model key ext tape) (αB4 ext) j'

/-- The weights on the aligned members of block `4`, before the division by `P`. -/
noncomputable def U4 (tape : SampleTape) : Fin 14 → Fin 2 → Weight N 1 6 :=
  alignWeight (V5 model key tape) (DrB4 model key ext tape) (DsB4 model key ext tape)

/-- The weight on the error entering block `3`. -/
noncomputable def V3 (tape : SampleTape) (j' : Fin 2) : Weight N 1 6 :=
  (((P4 : Nat) : ℤ) : ℝ)⁻¹ • stateWeight (V4 model key ext tape) (DrB3 model key ext tape) (αB3 ext) j'

/-- The weights on the aligned members of block `3`, before the division by `P`. -/
noncomputable def U3 (tape : SampleTape) : Fin 14 → Fin 2 → Weight N 1 8 :=
  alignWeight (V4 model key ext tape) (DrB3 model key ext tape) (DsB3 model key ext tape)

/-- The weight on the error entering block `2`. -/
noncomputable def V2 (tape : SampleTape) (j' : Fin 2) : Weight N 1 8 :=
  (((P5 : Nat) : ℤ) : ℝ)⁻¹ • stateWeight (V3 model key ext tape) (DrB2 model key ext tape) (αB2 ext) j'

/-- The weights on the aligned members of block `2`, before the division by `P`. -/
noncomputable def U2 (tape : SampleTape) : Fin 14 → Fin 2 → Weight N 1 10 :=
  alignWeight (V3 model key ext tape) (DrB2 model key ext tape) (DsB2 model key ext tape)

/-- The weight on the error entering block `1`. -/
noncomputable def V1 (tape : SampleTape) (j' : Fin 2) : Weight N 1 10 :=
  (((P6 : Nat) : ℤ) : ℝ)⁻¹ • stateWeight (V2 model key ext tape) (DrB1 model key ext tape) (αB1 ext) j'

/-- The weights on the aligned members of block `1`, before the division by `P`. -/
noncomputable def U1 (tape : SampleTape) : Fin 14 → Fin 2 → Weight N 1 12 :=
  alignWeight (V2 model key ext tape) (DrB1 model key ext tape) (DsB1 model key ext tape)

/-- The weight on the state error of the encryption. -/
noncomputable def V0 (tape : SampleTape) (j' : Fin 2) : Weight N 1 12 :=
  (((P7 : Nat) : ℤ) : ℝ)⁻¹ • stateWeight (V1 model key ext tape) (DrB0 model key ext tape) (αB0 ext) j'

/-- The weights on the aligned members of block `0`, before the division by `P`. -/
noncomputable def U0 (tape : SampleTape) : Fin 14 → Fin 2 → Weight N 1 14 :=
  alignWeight (V1 model key ext tape) (DrB0 model key ext tape) (DsB0 model key)

/-! ## Sites -/

/-- The row residue sites: the private multiplications of every block, the alignments of every
block after the first, and the LUT finish. -/
abbrev RowSite : Type := (Fin 14 × Fin 2 × Fin 10 × Fin N) ⊕ (Fin 14 × Fin 2 × Fin 8 × Fin N) ⊕ (Fin 14 × Fin 2 × Fin 6 × Fin N) ⊕ (Fin 14 × Fin 2 × Fin 4 × Fin N) ⊕ (Fin 14 × Fin 2 × Fin 2 × Fin N) ⊕ (Fin 14 × Fin 2 × Fin 12 × Fin N) ⊕ (Fin 14 × Fin 2 × Fin 10 × Fin N) ⊕ (Fin 14 × Fin 2 × Fin 8 × Fin N) ⊕ (Fin 14 × Fin 2 × Fin 6 × Fin N) ⊕ (Fin 2 × Fin N)

/-- The mask-weighted key residue sites of the alignments. -/
abbrev KeySite : Type := (Fin 14 × Fin 2 × Fin 12 × Fin N) ⊕ (Fin 14 × Fin 2 × Fin 10 × Fin N) ⊕ (Fin 14 × Fin 2 × Fin 8 × Fin N) ⊕ (Fin 14 × Fin 2 × Fin 6 × Fin N)

/-- The H2 sites. -/
abbrev Site : Type := RowSite ⊕ KeySite

-- The site sums nest deeply; their instances are synthesized once here.
set_option synthInstance.maxSize 100000 in
set_option synthInstance.maxHeartbeats 2000000 in
instance : Fintype RowSite := inferInstance

set_option synthInstance.maxSize 100000 in
set_option synthInstance.maxHeartbeats 2000000 in
instance : Fintype KeySite := inferInstance

instance : Fintype Site := inferInstance

noncomputable def gRow (tape : SampleTape) : RowSite → ℝ :=
  Sum.elim (subCoef (fun _ j ↦ V1 model key ext tape j) (((P7 : Nat) : ℤ) : ℝ)) (Sum.elim (subCoef (fun _ j ↦ V2 model key ext tape j) (((P6 : Nat) : ℤ) : ℝ)) (Sum.elim (subCoef (fun _ j ↦ V3 model key ext tape j) (((P5 : Nat) : ℤ) : ℝ)) (Sum.elim (subCoef (fun _ j ↦ V4 model key ext tape j) (((P4 : Nat) : ℤ) : ℝ)) (Sum.elim (subCoef (fun _ j ↦ V5 model key tape j) (((P3 : Nat) : ℤ) : ℝ)) (Sum.elim (subCoef (U1 model key ext tape) ((((P6 : Nat) : ℤ) : ℝ) * (((A6 : Nat) : ℤ) : ℝ))) (Sum.elim (subCoef (U2 model key ext tape) ((((P5 : Nat) : ℤ) : ℝ) * (((A5 : Nat) : ℤ) : ℝ))) (Sum.elim (subCoef (U3 model key ext tape) ((((P4 : Nat) : ℤ) : ℝ) * (((A4 : Nat) : ℤ) : ℝ))) (Sum.elim (subCoef (U4 model key ext tape) ((((P3 : Nat) : ℤ) : ℝ) * (((A3 : Nat) : ℤ) : ℝ))) (lutCoef WL (((P2 : Nat) : ℤ) : ℝ))))))))))

noncomputable def rhoRow (tape : SampleTape) : RowSite → ℤ :=
  Sum.elim (siteVal (XB0 model key ext tape)) (Sum.elim (siteVal (XB1 model key ext tape)) (Sum.elim (siteVal (XB2 model key ext tape)) (Sum.elim (siteVal (XB3 model key ext tape)) (Sum.elim (siteVal (XB4 model key ext tape)) (Sum.elim (siteVal (RB1 model key ext tape)) (Sum.elim (siteVal (RB2 model key ext tape)) (Sum.elim (siteVal (RB3 model key ext tape)) (Sum.elim (siteVal (RB4 model key ext tape)) (lutVal (RL model key ext tape))))))))))

def hRow : RowSite → ℕ :=
  Sum.elim (fun _ ↦ P7 / 2) (Sum.elim (fun _ ↦ P6 / 2) (Sum.elim (fun _ ↦ P5 / 2) (Sum.elim (fun _ ↦ P4 / 2) (Sum.elim (fun _ ↦ P3 / 2) (Sum.elim (fun _ ↦ A6 / 2) (Sum.elim (fun _ ↦ A5 / 2) (Sum.elim (fun _ ↦ A4 / 2) (Sum.elim (fun _ ↦ A3 / 2) (fun _ ↦ P2 / 2)))))))))

noncomputable def gKey (tape : SampleTape) : KeySite → ℝ :=
  Sum.elim (maskCoef (U1 model key ext tape) (maskM tape) ((((P6 : Nat) : ℤ) : ℝ) * (((A6 : Nat) : ℤ) : ℝ))) (Sum.elim (maskCoef (U2 model key ext tape) (maskM tape) ((((P5 : Nat) : ℤ) : ℝ) * (((A5 : Nat) : ℤ) : ℝ))) (Sum.elim (maskCoef (U3 model key ext tape) (maskM tape) ((((P4 : Nat) : ℤ) : ℝ) * (((A4 : Nat) : ℤ) : ℝ))) (maskCoef (U4 model key ext tape) (maskM tape) ((((P3 : Nat) : ℤ) : ℝ) * (((A3 : Nat) : ℤ) : ℝ)))))

noncomputable def rhoKey (tape : SampleTape) : KeySite → ℤ :=
  Sum.elim (siteVal (K0B1 model key)) (Sum.elim (siteVal (K0B2 model key)) (Sum.elim (siteVal (K0B3 model key)) (siteVal (K0B4 model key))))

def hKey : KeySite → ℕ :=
  Sum.elim (fun _ ↦ A6 / 2) (Sum.elim (fun _ ↦ A5 / 2) (Sum.elim (fun _ ↦ A4 / 2) (fun _ ↦ A3 / 2)))

/-- The coefficient of a site. -/
noncomputable def siteG (j : Site) (tape : SampleTape) : ℝ :=
  Sum.elim (gRow model key ext tape) (gKey model key ext tape) j

/-- The value of a site. -/
noncomputable def siteRho (j : Site) (tape : SampleTape) : ℤ :=
  Sum.elim (rhoRow model key ext tape) (rhoKey model key tape) j

/-- The residue bound of a site. -/
def siteH (j : Site) : ℕ := Sum.elim hRow hKey j

/-! The site functions unfold by rewrites with proofs, never by the kernel's definitional
unfolding (see `elim_inl_eq`). -/

theorem gRow_eq (tape : SampleTape) : gRow model key ext tape =
    Sum.elim (subCoef (fun _ j ↦ V1 model key ext tape j) (((P7 : Nat) : ℤ) : ℝ)) (Sum.elim (subCoef (fun _ j ↦ V2 model key ext tape j) (((P6 : Nat) : ℤ) : ℝ)) (Sum.elim (subCoef (fun _ j ↦ V3 model key ext tape j) (((P5 : Nat) : ℤ) : ℝ)) (Sum.elim (subCoef (fun _ j ↦ V4 model key ext tape j) (((P4 : Nat) : ℤ) : ℝ)) (Sum.elim (subCoef (fun _ j ↦ V5 model key tape j) (((P3 : Nat) : ℤ) : ℝ)) (Sum.elim (subCoef (U1 model key ext tape) ((((P6 : Nat) : ℤ) : ℝ) * (((A6 : Nat) : ℤ) : ℝ))) (Sum.elim (subCoef (U2 model key ext tape) ((((P5 : Nat) : ℤ) : ℝ) * (((A5 : Nat) : ℤ) : ℝ))) (Sum.elim (subCoef (U3 model key ext tape) ((((P4 : Nat) : ℤ) : ℝ) * (((A4 : Nat) : ℤ) : ℝ))) (Sum.elim (subCoef (U4 model key ext tape) ((((P3 : Nat) : ℤ) : ℝ) * (((A3 : Nat) : ℤ) : ℝ))) (lutCoef WL (((P2 : Nat) : ℤ) : ℝ)))))))))) := rfl.trans rfl

theorem rhoRow_eq (tape : SampleTape) : rhoRow model key ext tape =
    Sum.elim (siteVal (XB0 model key ext tape)) (Sum.elim (siteVal (XB1 model key ext tape)) (Sum.elim (siteVal (XB2 model key ext tape)) (Sum.elim (siteVal (XB3 model key ext tape)) (Sum.elim (siteVal (XB4 model key ext tape)) (Sum.elim (siteVal (RB1 model key ext tape)) (Sum.elim (siteVal (RB2 model key ext tape)) (Sum.elim (siteVal (RB3 model key ext tape)) (Sum.elim (siteVal (RB4 model key ext tape)) (lutVal (RL model key ext tape)))))))))) := rfl.trans rfl

theorem gKey_eq (tape : SampleTape) : gKey model key ext tape =
    Sum.elim (maskCoef (U1 model key ext tape) (maskM tape) ((((P6 : Nat) : ℤ) : ℝ) * (((A6 : Nat) : ℤ) : ℝ))) (Sum.elim (maskCoef (U2 model key ext tape) (maskM tape) ((((P5 : Nat) : ℤ) : ℝ) * (((A5 : Nat) : ℤ) : ℝ))) (Sum.elim (maskCoef (U3 model key ext tape) (maskM tape) ((((P4 : Nat) : ℤ) : ℝ) * (((A4 : Nat) : ℤ) : ℝ))) (maskCoef (U4 model key ext tape) (maskM tape) ((((P3 : Nat) : ℤ) : ℝ) * (((A3 : Nat) : ℤ) : ℝ))))) := rfl.trans rfl

theorem rhoKey_eq (tape : SampleTape) : rhoKey model key tape =
    Sum.elim (siteVal (K0B1 model key)) (Sum.elim (siteVal (K0B2 model key)) (Sum.elim (siteVal (K0B3 model key)) (siteVal (K0B4 model key)))) := rfl.trans rfl

theorem siteG_inl (r : RowSite) (tape : SampleTape) :
    siteG model key ext (.inl r) tape = gRow model key ext tape r :=
  (Sum.elim_inl _ _ r).trans rfl

theorem siteG_inr (k : KeySite) (tape : SampleTape) :
    siteG model key ext (.inr k) tape = gKey model key ext tape k :=
  (Sum.elim_inr _ _ k).trans rfl

theorem siteRho_inl (r : RowSite) (tape : SampleTape) :
    siteRho model key ext (.inl r) tape = rhoRow model key ext tape r :=
  (Sum.elim_inl _ _ r).trans rfl

theorem siteRho_inr (k : KeySite) (tape : SampleTape) :
    siteRho model key ext (.inr k) tape = rhoKey model key tape k :=
  (Sum.elim_inr _ _ k).trans rfl

/-- The sum over the sites, one sum per site family. -/
theorem sum_sites (tape : SampleTape) :
    ∑ j, siteG model key ext j tape * (siteRho model key ext j tape : ℝ) =
      (∑ x, (subCoef (fun _ j ↦ V1 model key ext tape j) (((P7 : Nat) : ℤ) : ℝ)) x * ((siteVal (XB0 model key ext tape)) x : ℝ) +
      (∑ x, (subCoef (fun _ j ↦ V2 model key ext tape j) (((P6 : Nat) : ℤ) : ℝ)) x * ((siteVal (XB1 model key ext tape)) x : ℝ) +
      (∑ x, (subCoef (fun _ j ↦ V3 model key ext tape j) (((P5 : Nat) : ℤ) : ℝ)) x * ((siteVal (XB2 model key ext tape)) x : ℝ) +
      (∑ x, (subCoef (fun _ j ↦ V4 model key ext tape j) (((P4 : Nat) : ℤ) : ℝ)) x * ((siteVal (XB3 model key ext tape)) x : ℝ) +
      (∑ x, (subCoef (fun _ j ↦ V5 model key tape j) (((P3 : Nat) : ℤ) : ℝ)) x * ((siteVal (XB4 model key ext tape)) x : ℝ) +
      (∑ x, (subCoef (U1 model key ext tape) ((((P6 : Nat) : ℤ) : ℝ) * (((A6 : Nat) : ℤ) : ℝ))) x * ((siteVal (RB1 model key ext tape)) x : ℝ) +
      (∑ x, (subCoef (U2 model key ext tape) ((((P5 : Nat) : ℤ) : ℝ) * (((A5 : Nat) : ℤ) : ℝ))) x * ((siteVal (RB2 model key ext tape)) x : ℝ) +
      (∑ x, (subCoef (U3 model key ext tape) ((((P4 : Nat) : ℤ) : ℝ) * (((A4 : Nat) : ℤ) : ℝ))) x * ((siteVal (RB3 model key ext tape)) x : ℝ) +
      (∑ x, (subCoef (U4 model key ext tape) ((((P3 : Nat) : ℤ) : ℝ) * (((A3 : Nat) : ℤ) : ℝ))) x * ((siteVal (RB4 model key ext tape)) x : ℝ) +
      ∑ x, (lutCoef WL (((P2 : Nat) : ℤ) : ℝ)) x * ((lutVal (RL model key ext tape)) x : ℝ)))))))))) +
      (∑ x, (maskCoef (U1 model key ext tape) (maskM tape) ((((P6 : Nat) : ℤ) : ℝ) * (((A6 : Nat) : ℤ) : ℝ))) x * ((siteVal (K0B1 model key)) x : ℝ) +
      (∑ x, (maskCoef (U2 model key ext tape) (maskM tape) ((((P5 : Nat) : ℤ) : ℝ) * (((A5 : Nat) : ℤ) : ℝ))) x * ((siteVal (K0B2 model key)) x : ℝ) +
      (∑ x, (maskCoef (U3 model key ext tape) (maskM tape) ((((P4 : Nat) : ℤ) : ℝ) * (((A4 : Nat) : ℤ) : ℝ))) x * ((siteVal (K0B3 model key)) x : ℝ) +
      ∑ x, (maskCoef (U4 model key ext tape) (maskM tape) ((((P3 : Nat) : ℤ) : ℝ) * (((A3 : Nat) : ℤ) : ℝ))) x * ((siteVal (K0B4 model key)) x : ℝ)))) := by
  simp only [Fintype.sum_sum_type, siteG_inl, siteG_inr, siteRho_inl, siteRho_inr, gRow_eq, rhoRow_eq,
    gKey_eq, rhoKey_eq, elim_inl_eq, elim_inr_eq]

/-! ## Decomposition -/

/-- Every ModDown numerator of the model is divisible by its dropped factor. -/
def Divisible (tape : SampleTape) : Prop :=
  div0 model key ext tape ∧ div1 model key ext tape ∧ div2 model key ext tape ∧ div3 model key ext tape ∧ div4 model key ext tape ∧ divLut model key ext tape

/-- The decoded coefficient of the model. -/
noncomputable def estar (tape : SampleTape) : ℝ := pairing Wfin (finalErr model key ext tape 1)

/-- The remainder of the members of block `0`. -/
noncomputable def memberRem0 (tape : SampleTape) : ℝ :=
  (∑ i, ∑ k, pairing (U0 model key ext tape i k) (eaB0 tape i k)) / (((P7 : Nat) : ℤ) : ℝ)

theorem step0 (tape : SampleTape) (hd : div0 model key ext tape) :
    pairing2 (V1 model key ext tape) (err1 model key ext tape) =
      pairing2 (V0 model key ext tape) (stateError tape [3]) +
        ∑ x, subCoef (fun _ j ↦ V1 model key ext tape j) (((P7 : Nat) : ℤ) : ℝ) x * (siteVal (XB0 model key ext tape) x : ℝ) +
        memberRem0 model key ext tape +
        cellRem (V1 model key ext tape) (((P7 : Nat) : ℤ) : ℝ) (maskM tape) (M0B0 model key ext tape)
          (M1B0 model key ext tape) (ceB0 ext) (rhsError0 tape [2]) := by
  rw [err1_form]
  exact pairing2_firstBlock hN _ (by norm_num) _ _ _ _ _ _ _ _ _ hd _ _

theorem step1 (tape : SampleTape) (hd : div1 model key ext tape) :
    pairing2 (V2 model key ext tape) (err2 model key ext tape) =
      pairing2 (V1 model key ext tape) (err1 model key ext tape) +
        ∑ x, subCoef (fun _ j ↦ V2 model key ext tape j) (((P6 : Nat) : ℤ) : ℝ) x * (siteVal (XB1 model key ext tape) x : ℝ) +
        ∑ x, subCoef (U1 model key ext tape) ((((P6 : Nat) : ℤ) : ℝ) * (((A6 : Nat) : ℤ) : ℝ)) x * (siteVal (RB1 model key ext tape) x : ℝ) +
        ∑ x, maskCoef (U1 model key ext tape) (maskM tape) ((((P6 : Nat) : ℤ) : ℝ) * (((A6 : Nat) : ℤ) : ℝ)) x *
          (siteVal (K0B1 model key) x : ℝ) +
        alignRem (U1 model key ext tape) ((((P6 : Nat) : ℤ) : ℝ) * (((A6 : Nat) : ℤ) : ℝ)) HB1 (eaB1 tape) (K1B1 model key) +
        cellRem (V2 model key ext tape) (((P6 : Nat) : ℤ) : ℝ) (maskM tape) (M0B1 model key ext tape)
          (M1B1 model key ext tape) (ceB1 ext) (rhsError1 tape [2]) := by
  rw [err2_form]
  exact pairing2_alignedBlock hN _ (by norm_num) (by norm_num) _ _ _ _ _ _ _ _ _ _ _ _ _ hd.1 hd.2 _ _

theorem step2 (tape : SampleTape) (hd : div2 model key ext tape) :
    pairing2 (V3 model key ext tape) (err3 model key ext tape) =
      pairing2 (V2 model key ext tape) (err2 model key ext tape) +
        ∑ x, subCoef (fun _ j ↦ V3 model key ext tape j) (((P5 : Nat) : ℤ) : ℝ) x * (siteVal (XB2 model key ext tape) x : ℝ) +
        ∑ x, subCoef (U2 model key ext tape) ((((P5 : Nat) : ℤ) : ℝ) * (((A5 : Nat) : ℤ) : ℝ)) x * (siteVal (RB2 model key ext tape) x : ℝ) +
        ∑ x, maskCoef (U2 model key ext tape) (maskM tape) ((((P5 : Nat) : ℤ) : ℝ) * (((A5 : Nat) : ℤ) : ℝ)) x *
          (siteVal (K0B2 model key) x : ℝ) +
        alignRem (U2 model key ext tape) ((((P5 : Nat) : ℤ) : ℝ) * (((A5 : Nat) : ℤ) : ℝ)) HB2 (eaB2 tape) (K1B2 model key) +
        cellRem (V3 model key ext tape) (((P5 : Nat) : ℤ) : ℝ) (maskM tape) (M0B2 model key ext tape)
          (M1B2 model key ext tape) (ceB2 ext) (rhsError2 tape [2]) := by
  rw [err3_form]
  exact pairing2_alignedBlock hN _ (by norm_num) (by norm_num) _ _ _ _ _ _ _ _ _ _ _ _ _ hd.1 hd.2 _ _

theorem step3 (tape : SampleTape) (hd : div3 model key ext tape) :
    pairing2 (V4 model key ext tape) (err4 model key ext tape) =
      pairing2 (V3 model key ext tape) (err3 model key ext tape) +
        ∑ x, subCoef (fun _ j ↦ V4 model key ext tape j) (((P4 : Nat) : ℤ) : ℝ) x * (siteVal (XB3 model key ext tape) x : ℝ) +
        ∑ x, subCoef (U3 model key ext tape) ((((P4 : Nat) : ℤ) : ℝ) * (((A4 : Nat) : ℤ) : ℝ)) x * (siteVal (RB3 model key ext tape) x : ℝ) +
        ∑ x, maskCoef (U3 model key ext tape) (maskM tape) ((((P4 : Nat) : ℤ) : ℝ) * (((A4 : Nat) : ℤ) : ℝ)) x *
          (siteVal (K0B3 model key) x : ℝ) +
        alignRem (U3 model key ext tape) ((((P4 : Nat) : ℤ) : ℝ) * (((A4 : Nat) : ℤ) : ℝ)) HB3 (eaB3 tape) (K1B3 model key) +
        cellRem (V4 model key ext tape) (((P4 : Nat) : ℤ) : ℝ) (maskM tape) (M0B3 model key ext tape)
          (M1B3 model key ext tape) (ceB3 ext) (rhsError3 tape [2]) := by
  rw [err4_form]
  exact pairing2_alignedBlock hN _ (by norm_num) (by norm_num) _ _ _ _ _ _ _ _ _ _ _ _ _ hd.1 hd.2 _ _

theorem step4 (tape : SampleTape) (hd : div4 model key ext tape) :
    pairing2 (V5 model key tape) (err5 model key ext tape) =
      pairing2 (V4 model key ext tape) (err4 model key ext tape) +
        ∑ x, subCoef (fun _ j ↦ V5 model key tape j) (((P3 : Nat) : ℤ) : ℝ) x * (siteVal (XB4 model key ext tape) x : ℝ) +
        ∑ x, subCoef (U4 model key ext tape) ((((P3 : Nat) : ℤ) : ℝ) * (((A3 : Nat) : ℤ) : ℝ)) x * (siteVal (RB4 model key ext tape) x : ℝ) +
        ∑ x, maskCoef (U4 model key ext tape) (maskM tape) ((((P3 : Nat) : ℤ) : ℝ) * (((A3 : Nat) : ℤ) : ℝ)) x *
          (siteVal (K0B4 model key) x : ℝ) +
        alignRem (U4 model key ext tape) ((((P3 : Nat) : ℤ) : ℝ) * (((A3 : Nat) : ℤ) : ℝ)) HB4 (eaB4 tape) (K1B4 model key) +
        cellRem (V5 model key tape) (((P3 : Nat) : ℤ) : ℝ) (maskM tape) (M0B4 model key ext tape)
          (M1B4 model key ext tape) (ceB4 ext) (rhsError4 tape [2]) := by
  rw [err5_form]
  exact pairing2_alignedBlock hN _ (by norm_num) (by norm_num) _ _ _ _ _ _ _ _ _ _ _ _ _ hd.1 hd.2 _ _

/-- The remainder of the readout LUT. -/
noncomputable def lutRemM (tape : SampleTape) : ℝ :=
  lutRem WL (((P2 : Nat) : ℤ) : ℝ) (ehL tape) (DEL model key ext tape) (sL tape) (KM0L model key ext tape)
    (KM1L model key ext tape) (maskM tape) (K0L model key ext tape) (K1L model key ext tape) (aL ext)
    (fun i ↦ switchError tape [2] i 1)

theorem stepLut (tape : SampleTape) (hd : divLut model key ext tape) :
    estar model key ext tape = pairing2 (V5 model key tape) (err5 model key ext tape) +
      ∑ x, lutCoef WL (((P2 : Nat) : ℤ) : ℝ) x * (lutVal (RL model key ext tape) x : ℝ) + lutRemM model key ext tape := by
  have hdiv := hd 1
  rw [lutNumer_form] at hdiv
  rw [estar, finalErr_form, lutNumer_form]
  exact pairing_lutFinal_sites hN Wfin finalDigits (by norm_num) _ _ _ _ _ _ _ _ _ _ _ _ _ hdiv _ _

/-- The rearrangement of the decomposition. -/
theorem decomp_linear {p m sl rl x0 x1 x2 x3 x4 c0 c1 c2 c3 c4 a1 a2 a3 a4 k1 k2 k3 k4 r1 r2 r3 r4 : ℝ} :
    (((((p + x0 + m + c0) + x1 + a1 + k1 + r1 + c1) + x2 + a2 + k2 + r2 + c2) + x3 + a3 + k3 + r3 + c3) + x4 + a4 + k4 + r4 + c4) + sl + rl =
      rl + r4 + c4 + r3 + c3 + r2 + c2 + r1 + c1 + m + c0 + p + ((x0 + (x1 + (x2 + (x3 + (x4 + (a1 + (a2 + (a3 + (a4 + sl))))))))) + (k1 + (k2 + (k3 + k4)))) := by
  abel

/-- The remainder of the decoded coefficient: every term that is not an H2 site. -/
noncomputable def remainder (tape : SampleTape) : ℝ :=
  lutRemM model key ext tape +
  alignRem (U4 model key ext tape) ((((P3 : Nat) : ℤ) : ℝ) * (((A3 : Nat) : ℤ) : ℝ)) HB4 (eaB4 tape) (K1B4 model key) +
    cellRem (V5 model key tape) (((P3 : Nat) : ℤ) : ℝ) (maskM tape) (M0B4 model key ext tape)
      (M1B4 model key ext tape) (ceB4 ext) (rhsError4 tape [2]) +
  alignRem (U3 model key ext tape) ((((P4 : Nat) : ℤ) : ℝ) * (((A4 : Nat) : ℤ) : ℝ)) HB3 (eaB3 tape) (K1B3 model key) +
    cellRem (V4 model key ext tape) (((P4 : Nat) : ℤ) : ℝ) (maskM tape) (M0B3 model key ext tape)
      (M1B3 model key ext tape) (ceB3 ext) (rhsError3 tape [2]) +
  alignRem (U2 model key ext tape) ((((P5 : Nat) : ℤ) : ℝ) * (((A5 : Nat) : ℤ) : ℝ)) HB2 (eaB2 tape) (K1B2 model key) +
    cellRem (V3 model key ext tape) (((P5 : Nat) : ℤ) : ℝ) (maskM tape) (M0B2 model key ext tape)
      (M1B2 model key ext tape) (ceB2 ext) (rhsError2 tape [2]) +
  alignRem (U1 model key ext tape) ((((P6 : Nat) : ℤ) : ℝ) * (((A6 : Nat) : ℤ) : ℝ)) HB1 (eaB1 tape) (K1B1 model key) +
    cellRem (V2 model key ext tape) (((P6 : Nat) : ℤ) : ℝ) (maskM tape) (M0B1 model key ext tape)
      (M1B1 model key ext tape) (ceB1 ext) (rhsError1 tape [2]) +
  memberRem0 model key ext tape +
  cellRem (V1 model key ext tape) (((P7 : Nat) : ℤ) : ℝ) (maskM tape) (M0B0 model key ext tape)
      (M1B0 model key ext tape) (ceB0 ext) (rhsError0 tape [2]) +
  pairing2 (V0 model key ext tape) (stateError tape [3])

set_option maxRecDepth 1000000 in
/-- On a tape whose numerators are divisible, the decoded coefficient is the remainder plus the
sum over the H2 sites. -/
theorem decomposition (tape : SampleTape) (hd : Divisible model key ext tape) :
    estar model key ext tape = remainder model key ext tape +
      ∑ j, siteG model key ext j tape * (siteRho model key ext j tape : ℝ) := by
  obtain ⟨hd0, hd1, hd2, hd3, hd4, hdL⟩ := hd
  rw [stepLut model key ext tape hdL, step4 model key ext tape hd4, step3 model key ext tape hd3, step2 model key ext tape hd2, step1 model key ext tape hd1, step0 model key ext tape hd0, sum_sites, remainder]
  exact decomp_linear

end H2Model

end LwrProof
