    omega
  obtain ⟨es, hes, rowForm⟩ := online0_part_smudge_digit4 run hi hd hq L hL hLx hG
    hz he hk0 hk1
  exact ⟨es, hes, by simpa only [smudgePartTarget4, dif_pos hd] using rowForm⟩

end Dio2Proof
