section Model2

variable (model : HashModel) (key : ByteArray) (ext : GeneratedClaim.ExternalInputs)

/-- The state rows entering block `2`. -/
noncomputable def stateRow2 (tape : SampleTape) : Fin 2 → ExactMatrix Q5 N 1 8 :=
  encRow (maskM tape) (key2 model key ext tape) (stateTarget2 ext tape) (err2 model key ext tape)

/-- The selector RHS bottoms of block `2`. -/
noncomputable def bot2 (tape : SampleTape) (i : Fin 14) (j : Fin 2) : ExactMatrix Q4 N 1 6 :=
  reducePoly Q4 N (((P4 : Nat) : Int) * nuOf ext 2 i * unitPair (payloadM tape) j) • gReb Q4 Q3 6 +
    reduceMatrix Q4 N 1 6 (rhsError2 tape [2] i j) -
    reducePoly Q4 N (payloadM tape) • rhsTop model key Q4 6 rhsPrefix2 i j

/-- The keys entering block `3`. -/
noncomputable def key3 (tape : SampleTape) : Fin 2 → Fin 2 → ExactMatrix Q4 N 1 6 :=
  ∑ i : Fin 14, fun k j ↦ theOutput (blockModSwitchRuns [1099511626049, 1099511625409, 1099511623297, 1099511622593, 1099511622529] 1)
    (cellKeyUp2 (memberKey model key ((coords 2 i : Nat) : Int)) (key2 model key ext tape)
      (rhsTop model key Q4 6 rhsPrefix2 i) (bot2 model key ext tape i) k j)

/-- The alignment numerator of the member of cell `i` of block `2` in the model. -/
noncomputable def alignM2 (tape : SampleTape) (i : Fin 14) (j : Fin 2) : ErrorMatrix N 1 10 :=
  alignNumer2 (maskM tape) (memberKey model key ((coords 2 i : Nat) : Int))
    (memberError tape [3] ⟨coords 2 i, coords_lt 2 i⟩) (memberRow model key ext tape ⟨coords 2 i, coords_lt 2 i⟩) j

/-- The numerator of cell `i` of block `2` in the model. -/
noncomputable def numerM2 (tape : SampleTape) (i : Fin 14) (j : Fin 2) : ErrorMatrix N 1 6 :=
  cellNumer2 (maskM tape)
      (memberKey model key ((coords 2 i : Nat) : Int))
      (fun j' ↦ divInt A5 (alignM2 model key ext tape i j'))
      (err2 model key ext tape) (alphaOf ext ⟨coords 2 i, coords_lt 2 i⟩) (key2 model key ext tape)
      (rhsTop model key Q4 6 rhsPrefix2 i) (bot2 model key ext tape i)
      (fun j' ↦ theOutput (blockModSwitchRuns [1099511626049, 1099511625409, 1099511623297, 1099511622593, 1099511622529, 1099511621249, 1099511619841] 1) (memberRow model key ext tape ⟨coords 2 i, coords_lt 2 i⟩ j' * alignDigits2))
      (stateRow2 model key ext tape) (fun _ _ ↦ reducePoly Q5 N (alphaOf ext ⟨coords 2 i, coords_lt 2 i⟩)) j

/-- The error entering block `3`. -/
noncomputable def err3 (tape : SampleTape) : Fin 2 → ErrorMatrix N 1 6 :=
  ∑ i : Fin 14, fun j ↦ divInt P5 (numerM2 model key ext tape i j) -
    (alphaOf ext ⟨coords 2 i, coords_lt 2 i⟩ * muOf ext 2) • rhsError2 tape [2] i j

/-- The alignment and cell numerators of block `2` are divisible by their dropped factors. -/
def div2 (tape : SampleTape) : Prop :=
  (∀ i j row column, alignM2 model key ext tape i j row column =
    ((A5 : Int) : ErrorPoly N) * divInt A5 (alignM2 model key ext tape i j) row column) ∧
  ∀ i j row column, numerM2 model key ext tape i j row column =
    ((P5 : Int) : ErrorPoly N) * divInt P5 (numerM2 model key ext tape i j) row column

/-- The state target of block `3` at `Q4`. -/
noncomputable def stateTarget3 (tape : SampleTape) (j : Fin 2) : ExactMatrix Q4 N 1 6 :=
  reducePoly Q4 N (((P4 : Nat) : Int) * muOf ext 3 * unitPair (payloadM tape) j) • gReb Q4 Q3 6

end Model2


