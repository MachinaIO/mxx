      (fun j ↦ reducePoly Q6 N (((P6 : Nat) : Int) * μ * unitPair sp j) • g)
      ![w.w_42_4, w.w_42_5] es)
    {eB : Fin 14 → Fin 2 → ErrorMatrix N 1 8}
    (hrhs : ∀ i : Fin 14, ∀ j,
      reducePoly Q5 N sp • rhsTop model key Q5 8 rhsPrefix1 i j + ![r10 i, r11 i] j =
