      (∀ i j row column, (alignNumer1 sm (memberKey model key ((coords 1 i : Nat) : Int))
          (ea ⟨coords 1 i, coords_lt 1 i⟩) ![ca0 ⟨coords 1 i, coords_lt 1 i⟩, ca1 ⟨coords 1 i, coords_lt 1 i⟩] j) row column =
        ((A6 : Int) : ErrorPoly N) * divInt A6 (alignNumer1 sm (memberKey model key ((coords 1 i : Nat) : Int))
          (ea ⟨coords 1 i, coords_lt 1 i⟩) ![ca0 ⟨coords 1 i, coords_lt 1 i⟩, ca1 ⟨coords 1 i, coords_lt 1 i⟩] j) row column) ∧
      (∀ i j row column, (cellNumer1 sm (memberKey model key ((coords 1 i : Nat) : Int))
            (fun j' ↦ divInt A6 (alignNumer1 sm (memberKey model key ((coords 1 i : Nat) : Int))
              (ea ⟨coords 1 i, coords_lt 1 i⟩) ![ca0 ⟨coords 1 i, coords_lt 1 i⟩, ca1 ⟨coords 1 i, coords_lt 1 i⟩] j')) es
            (α ⟨coords 1 i, coords_lt 1 i⟩) ![![w.w_42_0, w.w_42_1], ![w.w_42_2, w.w_42_3]]
            (rhsTop model key Q5 8 rhsPrefix1 i) ![r10 i, r11 i]
