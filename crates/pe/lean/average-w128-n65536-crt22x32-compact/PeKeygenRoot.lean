/-- The targets of the slots, at the keygen wires. -/
theorem keygen_targets {model : HashModel} {tape : SampleTape} {path : List Nat}
    {td : TrapdoorValue (ExactMatrix Q N 1 501) Unit} {key : ByteArray}
    {K0 K1 : ExactMatrix Q N 1 44} {BQ : ExactMatrix PQ N 1 501}
    {w : Stage_keygen.generatedRoot.Witness} {o : KeygenOutputs}
    (F : Stage_keygen.generatedRoot.Facts (⟨(td, key, K0, K1, BQ, ()), w⟩ :
      Stage_keygen.generatedRoot.Ctx Backend.backend model tape path GeneratedClaim.stage_6_params) o) :
    ∀ k (hk : k < 128), Stage_keygen.generatedRoot.w_23_0 (⟨(td, key, K0, K1, BQ, ()), w⟩ :
      Stage_keygen.generatedRoot.Ctx Backend.backend model tape path GeneratedClaim.stage_6_params) ⟨k, hk⟩ =
      substituteMatrix (slotInv k) (slotInv_odd ⟨k, hk⟩)
        (slotResidual model key
          (messageRow model key 0 - joinRow ![K0, K1] * reduceMatrix Q N 88 1 (keySample tape (path ++ [7])))
          (Stage_keygen.generatedRoot.w_10_0 (⟨(td, key, K0, K1, BQ, ()), w⟩ :
            Stage_keygen.generatedRoot.Ctx Backend.backend model tape path GeneratedClaim.stage_6_params))
          (expand (fun _ _ ↦ BQ 0 0))
          (Stage_keygen.generatedRoot.w_21_0 (⟨(td, key, K0, K1, BQ, ()), w⟩ :
            Stage_keygen.generatedRoot.Ctx Backend.backend model tape path GeneratedClaim.stage_6_params) ⟨k, hk⟩)
          (Stage_keygen.generatedRoot.w_22_0 (⟨(td, key, K0, K1, BQ, ()), w⟩ :
            Stage_keygen.generatedRoot.Ctx Backend.backend model tape path GeneratedClaim.stage_6_params) ⟨k, hk⟩)
          ⟨k, hk⟩) := by
  set ctx : Stage_keygen.generatedRoot.Ctx Backend.backend model tape path GeneratedClaim.stage_6_params :=
    ⟨(td, key, K0, K1, BQ, ()), w⟩ with hctx
  obtain ⟨s10, s21, s22⟩ := keygen_samples F
  obtain ⟨e7, -⟩ := key_sample F.c0.h7_0
  have e3 : Stage_keygen.generatedRoot.w_3_0 ctx = messageRow model key 0 := hashSample_eq F.c0.h3_0
  have e6 : Stage_keygen.generatedRoot.w_6_0 ctx = joinRow ![K0, K1] := concat_joinRow (r := ![K0, K1]) F.c0.h6_0
  have e9 : Stage_keygen.generatedRoot.w_9_0 ctx =
      messageRow model key 0 - joinRow ![K0, K1] * reduceMatrix Q N 88 1 (keySample tape (path ++ [7])) := by
    show matrixSub (Stage_keygen.generatedRoot.w_3_0 ctx)
      (matrixMul (Stage_keygen.generatedRoot.w_6_0 ctx) (Stage_keygen.generatedRoot.w_7_0 ctx)) = _
    rw [e3, e6, e7]
    rfl
  have e11 := gadgetMatrixRuns_unique F.c0.h11_0 g0_runs
  have e13 : Stage_keygen.generatedRoot.w_13_0 ctx = gZero := by
    have h13 := F.c0.h13_0
    rw [e11] at h13
    exact concat_joinRow (r := ![g0, 0]) h13
  obtain ⟨_, e15⟩ := sliceMatrix_column F.c0.h15_0
  have e15' : Stage_keygen.generatedRoot.w_15_0 ctx = fun _ _ ↦ BQ 0 0 := by
    funext a b
    rw [Subsingleton.elim a 0, Subsingleton.elim b 0, e15]
    rfl
  have e20 : Stage_keygen.generatedRoot.w_20_0 ctx = expand (fun _ _ ↦ BQ 0 0) := by
    have := expand_read F.c0.h16_0 F.c0.h17_0 F.c0.h19_0
    show Stage_keygen.generatedRoot.w_19_0 ctx = _
    rw [this, e15']
  have hv10 : Stage_keygen.generatedRoot.w_10_1 ctx = Stage_keygen.generatedRoot.w_10_0 ctx := by
    funext i
    exact (s10 i).2.1
  intro k hk
  have h23 := F.c0.h23_0 ⟨k, hk⟩
  rw [e9, hv10, e13, e20, (s21 _).2.1, (s22 _).2.1] at h23
  exact slotTarget hk h23

