  fun slot r member ↦ (![![generatedRoot.w_459_0 ctx member, generatedRoot.w_459_1 ctx member], ![generatedRoot.w_459_2 ctx member, generatedRoot.w_459_3 ctx member], ![generatedRoot.w_459_4 ctx member, generatedRoot.w_459_5 ctx member], ![generatedRoot.w_459_6 ctx member, generatedRoot.w_459_7 ctx member], ![generatedRoot.w_460_0 ctx member, generatedRoot.w_460_1 ctx member], ![generatedRoot.w_460_2 ctx member, generatedRoot.w_460_3 ctx member], ![generatedRoot.w_460_4 ctx member, generatedRoot.w_460_5 ctx member], ![generatedRoot.w_460_6 ctx member, generatedRoot.w_460_7 ctx member], ![generatedRoot.w_461_0 ctx member, generatedRoot.w_461_1 ctx member], ![generatedRoot.w_461_2 ctx member, generatedRoot.w_461_3 ctx member], ![generatedRoot.w_461_4 ctx member, generatedRoot.w_461_5 ctx member], ![generatedRoot.w_461_6 ctx member, generatedRoot.w_461_7 ctx member], ![generatedRoot.w_462_0 ctx member, generatedRoot.w_462_1 ctx member], ![generatedRoot.w_462_2 ctx member, generatedRoot.w_462_3 ctx member], ![generatedRoot.w_462_4 ctx member, generatedRoot.w_462_5 ctx member], ![generatedRoot.w_462_6 ctx member, generatedRoot.w_462_7 ctx member]]) slot r

/-- The physical group/local-slot/row/member artifact layout. -/
def preLeafGroups_3 (ctx : generatedRoot.Ctx Backend.backend model tape path params) :
    Fin 4 → Fin 4 → Fin 2 → Fin 7 → ExactMatrix Q N 1 88 :=
  fun group slot r member ↦ (![![![generatedRoot.w_459_0 ctx member, generatedRoot.w_459_1 ctx member], ![generatedRoot.w_459_2 ctx member, generatedRoot.w_459_3 ctx member], ![generatedRoot.w_459_4 ctx member, generatedRoot.w_459_5 ctx member], ![generatedRoot.w_459_6 ctx member, generatedRoot.w_459_7 ctx member]], ![![generatedRoot.w_460_0 ctx member, generatedRoot.w_460_1 ctx member], ![generatedRoot.w_460_2 ctx member, generatedRoot.w_460_3 ctx member], ![generatedRoot.w_460_4 ctx member, generatedRoot.w_460_5 ctx member], ![generatedRoot.w_460_6 ctx member, generatedRoot.w_460_7 ctx member]], ![![generatedRoot.w_461_0 ctx member, generatedRoot.w_461_1 ctx member], ![generatedRoot.w_461_2 ctx member, generatedRoot.w_461_3 ctx member], ![generatedRoot.w_461_4 ctx member, generatedRoot.w_461_5 ctx member], ![generatedRoot.w_461_6 ctx member, generatedRoot.w_461_7 ctx member]], ![![generatedRoot.w_462_0 ctx member, generatedRoot.w_462_1 ctx member], ![generatedRoot.w_462_2 ctx member, generatedRoot.w_462_3 ctx member], ![generatedRoot.w_462_4 ctx member, generatedRoot.w_462_5 ctx member], ![generatedRoot.w_462_6 ctx member, generatedRoot.w_462_7 ctx member]]]) group slot r

theorem preLeafT_chunk_3 (ctx : generatedRoot.Ctx Backend.backend model tape path params)
    (group slot : Fin 4) (r : Fin 2) (member : Fin 7) :
    preLeafT_3 ctx ⟨4 * group.val + slot.val, by omega⟩ r member =
      preLeafGroups_3 ctx group slot r member := by
