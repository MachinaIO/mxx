import PePreLaneI⟦S⟧

set_option maxRecDepth 200000

namespace PeProof.PreLaneL⟦S⟧

open Mxx.Primitives MxxRuntime MxxExponentLut PeProof

set_option maxRecDepth 200000
set_option maxHeartbeats 1000000

abbrev Rows := ExactMatrix Q N 1 60 × ExactMatrix Q N 1 60 × ExactMatrix Q N 1 60 × ExactMatrix Q N 1 60 × ExactMatrix Q N 1 60 × ExactMatrix Q N 1 60 × ExactMatrix Q N 1 60 × ExactMatrix Q N 1 60 × Unit

def row (s : Rows) : Fin 4 → Fin 2 → ExactMatrix Q N 1 60 :=
  ![![s.1, s.2.1], ![s.2.2.1, s.2.2.2.1], ![s.2.2.2.2.1, s.2.2.2.2.2.1], ![s.2.2.2.2.2.2.1, s.2.2.2.2.2.2.2.1]]

def pack (f : Fin 4 → Fin 2 → ExactMatrix Q N 1 60) : Rows :=
  (f 0 0, f 0 1, f 1 0, f 1 1, f 2 0, f 2 1, f 3 0, f 3 1, ())

theorem row_pack (f : Fin 4 → Fin 2 → ExactMatrix Q N 1 60) :
    ∀ slot r, row (pack f) slot r = f slot r := by
  exact Fin.cases (by intro r; fin_cases r <;> rfl) (Fin.cases (by intro r; fin_cases r <;> rfl) (Fin.cases (by intro r; fin_cases r <;> rfl) (Fin.cases (by intro r; fin_cases r <;> rfl) ((by intro index; exact Fin.elim0 index)))))

theorem row_zero (slot : Fin 4) (r : Fin 2) :
    row (0, 0, 0, 0, 0, 0, 0, 0, ()) slot r = 0 := by
  revert slot r
  exact Fin.cases (by intro r; fin_cases r <;> rfl) (Fin.cases (by intro r; fin_cases r <;> rfl) (Fin.cases (by intro r; fin_cases r <;> rfl) (Fin.cases (by intro r; fin_cases r <;> rfl) ((by intro index; exact Fin.elim0 index)))))

theorem innerStep {model : HashModel} {tape : SampleTape} {path : List Nat}
    {params : Stage_preprocess.Params} {key : ByteArray} {m a j : Nat} (hm : m < 15)
    {U : Fin 4 → Fin 2 → ExactMatrix Q N 30 1} {s t : Rows}
    (h : Stage_preprocess.sequential_sequential_parallel_generatedRoot_⟦L⟧_37_41
      Backend.backend model tape path params m a j (s.1, s.2.1, s.2.2.1, s.2.2.2.1, s.2.2.2.2.1, s.2.2.2.2.2.1, s.2.2.2.2.2.2.1, s.2.2.2.2.2.2.2.1, key, U 0 0, U 0 1, U 1 0, U 1 1, U 2 0, U 2 1, U 3 0, U 3 1, ()) t) :
    ∀ slot r, row t slot r = row s slot r +
      (expand (lutCompKey model key (kSw (15 + m)) (j : Int) ((30 + a : Nat) : Int) r 0) * U slot 0 +
        expand (lutCompKey model key (kSw (15 + m)) (j : Int) ((30 + a : Nat) : Int) r 1) * U slot 1) 0 0 •
          unitRow (j : Int) := by
  obtain ⟨w_2_0, w_3_0, w_4_0, w_6_0, w_9_0, w_10_0, w_12_0, w_17_0, w_21_0, w_22_0, w_24_0, w_26_0, w_27_0, w_29_0, hbody⟩ := h
  have h2 := hbody.2.2.1
  have h9 := hbody.2.2.2.2.2.2.2.2.1
  have h21 := hbody.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.1
  have h26 := hbody.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.1
  have hrow : (30 : Int) + Int.ofNat a = ((30 + a : Nat) : Int) := by
    simp only [Int.ofNat_eq_natCast]; push_cast; ring
  rw [leaf_switch hm, hrow] at h2 h9 h21 h26
  have e2 : w_2_0 = lutCompKey model key (kSw (15 + m)) (j : Int) ((30 + a : Nat) : Int) 0 0 := hashSample_eq h2
  have e9 : w_9_0 = lutCompKey model key (kSw (15 + m)) (j : Int) ((30 + a : Nat) : Int) 0 1 := hashSample_eq h9
  have e21 : w_21_0 = lutCompKey model key (kSw (15 + m)) (j : Int) ((30 + a : Nat) : Int) 1 0 := hashSample_eq h21
  have e26 : w_26_0 = lutCompKey model key (kSw (15 + m)) (j : Int) ((30 + a : Nat) : Int) 1 1 := hashSample_eq h26
  have e6 := expand_read hbody.2.2.2.1 hbody.2.2.2.2.1 hbody.2.2.2.2.2.1
  have e12 := expand_read hbody.2.2.2.1 hbody.2.2.2.2.2.2.2.2.2.1 hbody.2.2.2.2.2.2.2.2.2.2.1
  have e24 := expand_read hbody.2.2.2.1 hbody.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.1 hbody.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.1
  have e29 := expand_read hbody.2.2.2.1 hbody.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.1 hbody.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.1
  have e17 := unitRow_window (c := (j : Int)) (by simp only [Int.ofNat_eq_natCast]; omega) hbody.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.1
  have hout := hbody.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2
  clear hbody h2 h9 h21 h26
  subst e2 e9 e21 e26
  subst hout e6 e12 e24 e29 e17
  exact Fin.cases (by intro r; fin_cases r <;> rfl) (Fin.cases (by intro r; fin_cases r <;> rfl) (Fin.cases (by intro r; fin_cases r <;> rfl) (Fin.cases (by intro r; fin_cases r <;> rfl) ((by intro index; exact Fin.elim0 index)))))

theorem topStep {model : HashModel} {tape : SampleTape} {path : List Nat}
    {params : Stage_preprocess.Params} {m i : Nat} (hm : m < 15) (hi : i < 30)
    {A : Fin 4 → Fin 2 → ExactMatrix Q N 1 60} {D : ExactMatrix Q N 30 60} {s t : Rows}
    (h : Stage_preprocess.sequential_parallel_generatedRoot_⟦L⟧_36 Backend.backend model tape path
      params m i (s.1, s.2.1, s.2.2.1, s.2.2.2.1, s.2.2.2.2.1, s.2.2.2.2.2.1, s.2.2.2.2.2.2.1, s.2.2.2.2.2.2.2.1, A 0 0, D, A 0 1, A 1 0, A 1 1, A 2 0, A 2 1, A 3 0, A 3 1, ()) t) :
    ∀ slot r w, row t slot r 0 w = row s slot r 0 w +
      substitution (kSw (15 + m)) (kSw_odd ⟨15 + m, by omega⟩) (A slot r 0 ⟨i, by omega⟩) * D ⟨i, hi⟩ w := by
  obtain ⟨w_2_0, w_3_0, w_5_0, w_12_0, w_13_0, w_18_0, w_19_0, w_24_0, w_25_0, w_30_0, w_31_0, w_36_0, w_37_0, w_42_0, w_43_0, w_48_0, w_49_0, hbody⟩ := h
  have e5 := unitRow_window (c := (i : Int)) (by simp only [Int.ofNat_eq_natCast]; ring) hbody.1.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.1
  have hrow : ∀ w : Fin 60, (w_5_0 * D : ExactMatrix Q N 1 60) 0 w = D ⟨i, hi⟩ w := by
    intro w
    rw [e5, Matrix.mul_apply, Finset.sum_eq_single ⟨i, hi⟩]
    · simp [unitRow]
    · intro c _ hc
      have : (c.val : Int) ≠ i := fun h ↦ hc (Fin.ext (by exact_mod_cast h))
      simp [unitRow, this]
    · simp
  obtain ⟨_, e2⟩ := sliceMatrix_column hbody.1.2.2.2.2.2.2.1
  have h3 := hbody.1.2.2.2.2.2.2.2.2.2.1
  rw [leaf_switch hm, kSw_cast (15 + m) (by omega)] at h3
  have e3 := routing_kSw (by omega : 15 + m < 30) h3
  obtain ⟨_, e12⟩ := sliceMatrix_column hbody.1.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.1
  have h13 := hbody.1.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.1
  rw [leaf_switch hm, kSw_cast (15 + m) (by omega)] at h13
  have e13 := routing_kSw (by omega : 15 + m < 30) h13
  obtain ⟨_, e18⟩ := sliceMatrix_column hbody.2.1.2.2.2.1
  have h19 := hbody.2.1.2.2.2.2.2.2.1
  rw [leaf_switch hm, kSw_cast (15 + m) (by omega)] at h19
  have e19 := routing_kSw (by omega : 15 + m < 30) h19
  obtain ⟨_, e24⟩ := sliceMatrix_column hbody.2.1.2.2.2.2.2.2.2.2.2.2.2.2.2.1
  have h25 := hbody.2.1.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.1
  rw [leaf_switch hm, kSw_cast (15 + m) (by omega)] at h25
  have e25 := routing_kSw (by omega : 15 + m < 30) h25
  obtain ⟨_, e30⟩ := sliceMatrix_column hbody.2.1.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.1
  have h31 := hbody.2.1.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.1
  rw [leaf_switch hm, kSw_cast (15 + m) (by omega)] at h31
  have e31 := routing_kSw (by omega : 15 + m < 30) h31
  obtain ⟨_, e36⟩ := sliceMatrix_column hbody.2.2.2.1
  have h37 := hbody.2.2.2.2.2.2.1
  rw [leaf_switch hm, kSw_cast (15 + m) (by omega)] at h37
  have e37 := routing_kSw (by omega : 15 + m < 30) h37
  obtain ⟨_, e42⟩ := sliceMatrix_column hbody.2.2.2.2.2.2.2.2.2.2.2.2.2.1
  have h43 := hbody.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.1
  rw [leaf_switch hm, kSw_cast (15 + m) (by omega)] at h43
  have e43 := routing_kSw (by omega : 15 + m < 30) h43
  obtain ⟨_, e48⟩ := sliceMatrix_column hbody.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.1
  have h49 := hbody.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.1
  rw [leaf_switch hm, kSw_cast (15 + m) (by omega)] at h49
  have e49 := routing_kSw (by omega : 15 + m < 30) h49
  simp only [Int.ofNat_eq_natCast, Int.toNat_natCast] at e2 e12 e18 e24 e30 e36 e42 e48
  let U : Fin 4 → Fin 2 → ExactMatrix Q N 1 1 :=
    ![![w_2_0, w_12_0], ![w_18_0, w_24_0], ![w_30_0, w_36_0], ![w_42_0, w_48_0]]
  have hU : ∀ slot r, U slot r 0 0 = A slot r 0 ⟨i, by omega⟩ := by
    exact Fin.cases (Fin.cases (e2) (Fin.cases (e12) ((by intro index; exact Fin.elim0 index)))) (Fin.cases (Fin.cases (e18) (Fin.cases (e24) ((by intro index; exact Fin.elim0 index)))) (Fin.cases (Fin.cases (e30) (Fin.cases (e36) ((by intro index; exact Fin.elim0 index)))) (Fin.cases (Fin.cases (e42) (Fin.cases (e48) ((by intro index; exact Fin.elim0 index)))) ((by intro index; exact Fin.elim0 index)))))
  have hout := hbody.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2
  clear hbody
  subst hout e3 e13 e19 e25 e31 e37 e43 e49
  intro slot r w
  change row (pack (fun branch component ↦ row s branch component +
    substitution (kSw (15 + m)) (kSw_odd ⟨15 + m, by omega⟩)
      (U branch component 0 0) • (w_5_0 * D))) slot r 0 w = _
  rw [row_pack]
  simp only [Matrix.add_apply, Matrix.smul_apply, smul_eq_mul, hrow, hU]

set_option maxHeartbeats 16000000 in
theorem keyStep {model : HashModel} {tape : SampleTape} {path : List Nat}
    {params : Stage_preprocess.Params} {key : ByteArray} {m a : Nat} (hm : m < 15) (ha : a < 30)
    {A : Fin 4 → Fin 2 → Fin 2 → ExactMatrix Q N 1 30}
    {X : Fin 4 → Fin 2 → ExactMatrix Q N 1 60}
    (hA : ∀ slot r, concatColumns (A slot r 0) (A slot r 1) (X slot r)) {s t : Rows}
    (h : Stage_preprocess.sequential_parallel_generatedRoot_⟦L⟧_37 Backend.backend model tape path
      params m a (s.1, s.2.1, s.2.2.1, s.2.2.2.1, s.2.2.2.2.1, s.2.2.2.2.2.1, s.2.2.2.2.2.2.1, s.2.2.2.2.2.2.2.1, key, X 0 0, X 0 1, X 1 0, X 1 1, X 2 0, X 2 1, X 3 0, X 3 1, ()) t) (slot : Fin 4) (r : Fin 2) (jj : Fin 60) :
    row t slot r 0 jj = row s slot r 0 jj +
      lutKeyCompanionSum model key ⟨15 + m, by omega⟩ (A slot) r jj ⟨a, ha⟩ := by
  obtain ⟨wit, hbody⟩ := h
  let ctx : Stage_preprocess.sequential_parallel_generatedRoot_⟦L⟧_37.Ctx
      Backend.backend model tape path params m a := ⟨(s.1, s.2.1, s.2.2.1, s.2.2.2.1, s.2.2.2.2.1, s.2.2.2.2.2.1, s.2.2.2.2.2.2.1, s.2.2.2.2.2.2.2.1, key, X 0 0, X 0 1, X 1 0, X 1 1, X 2 0, X 2 1, X 3 0, X 3 1, ()), wit⟩
  have F := Stage_preprocess.sequential_parallel_generatedRoot_⟦L⟧_37.facts ctx hbody
  have hcol : (30 : Int) + Int.ofNat a = ((30 + a : Nat) : Int) := by
    simp only [Int.ofNat_eq_natCast]; push_cast; ring
  have hcol1 : (31 : Int) + Int.ofNat a = 1 + ((30 + a : Nat) : Int) := by
    simp only [Int.ofNat_eq_natCast]; push_cast; ring
  have hx0 := F.c0.h10_0
  have hy0 := F.c0.h11_0
  rw [hcol, hcol1] at hx0
  rw [leaf_switch hm, kSw_cast (15 + m) (by omega)] at hy0
  have hu0 := routed_column_digits (r := 0) (by omega : 15 + m < 30) (by omega) (hA 0 0) hx0 hy0 F.c0.h12_0
  have hx1 := F.c0.h14_0
  have hy1 := F.c0.h15_0
  rw [hcol, hcol1] at hx1
  rw [leaf_switch hm, kSw_cast (15 + m) (by omega)] at hy1
  have hu1 := routed_column_digits (r := 1) (by omega : 15 + m < 30) (by omega) (hA 0 1) hx1 hy1 F.c0.h16_0
  have hx2 := F.c0.h18_0
  have hy2 := F.c0.h19_0
  rw [hcol, hcol1] at hx2
  rw [leaf_switch hm, kSw_cast (15 + m) (by omega)] at hy2
  have hu2 := routed_column_digits (r := 0) (by omega : 15 + m < 30) (by omega) (hA 1 0) hx2 hy2 F.c1.h20_0
  have hx3 := F.c1.h22_0
  have hy3 := F.c1.h23_0
  rw [hcol, hcol1] at hx3
  rw [leaf_switch hm, kSw_cast (15 + m) (by omega)] at hy3
  have hu3 := routed_column_digits (r := 1) (by omega : 15 + m < 30) (by omega) (hA 1 1) hx3 hy3 F.c1.h24_0
  have hx4 := F.c1.h26_0
  have hy4 := F.c1.h27_0
  rw [hcol, hcol1] at hx4
  rw [leaf_switch hm, kSw_cast (15 + m) (by omega)] at hy4
  have hu4 := routed_column_digits (r := 0) (by omega : 15 + m < 30) (by omega) (hA 2 0) hx4 hy4 F.c1.h28_0
  have hx5 := F.c1.h30_0
  have hy5 := F.c2.h31_0
  rw [hcol, hcol1] at hx5
  rw [leaf_switch hm, kSw_cast (15 + m) (by omega)] at hy5
  have hu5 := routed_column_digits (r := 1) (by omega : 15 + m < 30) (by omega) (hA 2 1) hx5 hy5 F.c2.h32_0
  have hx6 := F.c2.h34_0
  have hy6 := F.c2.h35_0
  rw [hcol, hcol1] at hx6
  rw [leaf_switch hm, kSw_cast (15 + m) (by omega)] at hy6
  have hu6 := routed_column_digits (r := 0) (by omega : 15 + m < 30) (by omega) (hA 3 0) hx6 hy6 F.c2.h36_0
  have hx7 := F.c2.h38_0
  have hy7 := F.c2.h39_0
  rw [hcol, hcol1] at hx7
  rw [leaf_switch hm, kSw_cast (15 + m) (by omega)] at hy7
  have hu7 := routed_column_digits (r := 1) (by omega : 15 + m < 30) (by omega) (hA 3 1) hx7 hy7 F.c2.h40_0
  have hin := F.c2.h41_7
  rw [hu0, hu1, hu2, hu3, hu4, hu5, hu6, hu7] at hin
  have hc88 : Int.toNat 60 = 60 := rfl
  rw [hc88] at hin
  have hacc := carriedColAccum (fun s : Rows ↦ row s slot r)
    (fun jj ↦ lutKeyCompanionSum model key ⟨15 + m, by omega⟩ (A slot) r jj ⟨a, ha⟩)
    (fun j s t hj hb ↦ innerStep
      (U := fun branch component ↦ keyDigits
        (routedKey (kSw (15 + m)) (kSw_odd ⟨15 + m, by omega⟩) (A branch))
        ⟨30 + a, by omega⟩ component) hm hb slot r) hin jj
  rw [F.c2.hout]
  exact hacc


end PeProof.PreLaneL⟦S⟧
