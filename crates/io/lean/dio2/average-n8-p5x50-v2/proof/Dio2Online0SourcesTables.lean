/-- A small exponent table retains the native negacyclic period in every term. -/
theorem online0_sources_native_walsh_terms {n q native width stride : Nat}
    (hq : 1 < q) (hn : 0 < n) {sigma : Nat} (hodd : Odd sigma)
    (hperiod : n = stride * native) (hwidth : width ≤ native)
    (inverse : ExactPoly q n) (outputStride : Nat) (table : Fin width → Nat) :
    inverse * ∑ index : Fin width,
      (multiplyMonomial (ringAutomorphism sigma
        (multiplyMonomial (matrixPolynomial [1] : ExactMatrix q n 1 1)
          ((index : Nat) * -(stride : Int))))
        ((table index : Int) * (outputStride : Int))) 0 0 =
      lutFourierCoefficient native (X q ^ stride) inverse
        (fun index ↦ reducePoly q n (Xe (n := n) (outputStride * table index))) sigma := by
  unfold lutFourierCoefficient
  congr 1
  apply Finset.sum_congr rfl
  intro index _
  simp only [multiplyMonomial]
  rw [show ringAutomorphism sigma
      (multiplyMonomial (matrixPolynomial [1] : ExactMatrix q n 1 1)
        ((index : Nat) * -(stride : Int))) 0 0 =
        (X q ^ stride) ^ (sigma * (2 * native - index)) from
      term_root hq hn hodd hperiod ⟨index.val, index.isLt.trans_le hwidth⟩]
  rw [reducePoly_Xe, mul_comm]
  congr 1
  rw [root_pow_mod2n (outputStride * table index)]
  congr 1
  have hexponent : (((table index : Int) * (outputStride : Int)) %
      (2 * (n : Int))).toNat = (outputStride * table index) % (2 * n) := by
    rw [show (table index : Int) * (outputStride : Int) =
        ((outputStride * table index : Nat) : Int) by push_cast; ring,
      show 2 * (n : Int) = ((2 * n : Nat) : Int) by push_cast; ring]
    rw [← Int.natCast_mod, Int.toNat_natCast]
  rw [hexponent]

/-- The generated finite table sum is Fourier-normalized at its native width. -/
theorem online0_sources_exponent_coefficient_native {n q native width stride outputStride : Nat}
    (hq : 1 < q) (hn : 0 < n) (hperiod : n = stride * native)
    (hwidth : width ≤ native) {sigma : Int} (hodd : Odd sigma.toNat)
    (inverse : Int) (table : Fin width → Int) (hnonnegative : ∀ index, 0 ≤ table index) :
    PreprocessSwitch.exponentCoefficient (q := q) (n := n) sigma stride outputStride
      inverse table = lutFourierCoefficient native (X q ^ stride)
        (inverse : ExactPoly q n)
        (fun index ↦ reducePoly q n (Xe (n := n) (outputStride * (table index).toNat)))
        sigma.toNat := by
  have hcast : ∀ index, ((table index).toNat : Int) = table index :=
    fun index ↦ Int.toNat_of_nonneg (hnonnegative index)
  have hterms := online0_sources_native_walsh_terms hq hn hodd hperiod hwidth
    (inverse : ExactPoly q n) outputStride (fun index ↦ (table index).toNat)
  simp only [hcast] at hterms
  unfold PreprocessSwitch.exponentCoefficient keyTableG keyTermE
  rw [range_dite_sum (fun index : Fin width ↦
    multiplyMonomial (ringAutomorphism sigma.toNat
      (multiplyMonomial (matrixPolynomial [1] : ExactMatrix q n 1 1)
        (Int.ofNat index.val * -(stride : Int))))
      (table index * (outputStride : Int)))]
  simpa only [matrixMulScalarLeft, matrixPolynomial_single, Int.cast_one, one_mul,
    Matrix.sum_apply] using hterms

open W_Stage_online_0 in
theorem state_walsh (state bit : Nat) (hstate : state ≤ 1) (hbit : bit ≤ 1) :
    (∑ branch : Fin 4, reducePoly modulus_0 8
      (substitution (sigmaOf Preprocess.stateSigmas branch).toNat (Preprocess.stateOdd branch)
        (Xe (n := 8) (2 * (state + bit)))) *
      Preprocess.stateCoefficients branch) =
      reducePoly modulus_0 8
        (Xe (n := 8) (2 * (entry table0 ((state + bit : Nat) : Int)).toNat)) := by
  have hcoeff (branch : Fin 4) : Preprocess.stateCoefficients branch =
      lutFourierCoefficient 4 (X modulus_0 ^ 2)
        (1356938545745524308187737599098762797340022013559604731140326430414605958745 : ExactPoly modulus_0 8)
        (fun index : Fin 4 ↦ reducePoly modulus_0 8
          (Xe (n := 8) (2 * (entry table0 (index.val : Int)).toNat)))
        (sigmaOf Preprocess.stateSigmas branch).toNat := by
    simpa [Preprocess.stateCoefficients, table0, entry, MxxIR.selectInt] using
      online0_sources_exponent_coefficient_native (q := modulus_0) (n := 8)
        (native := 4) (stride := 2) (outputStride := 2)
        (by norm_num [modulus_0]) (by norm_num) (by norm_num) (by norm_num)
        (Preprocess.stateOdd branch) 1356938545745524308187737599098762797340022013559604731140326430414605958745
        (fun index : Fin 4 ↦ MxxIR.selectInt (Int.ofNat index) [1, 0, 1, 0]) (by decide)
  simp_rw [hcoeff]
  have hinverse : (1356938545745524308187737599098762797340022013559604731140326430414605958745 : ExactPoly modulus_0 8) *
      (4 : ExactPoly modulus_0 8) = 1 :=
    cast_inverse (by norm_num [modulus_0]) (by norm_num [modulus_0])
  have hindex : ∀ branch : Fin 4,
      (sigmaOf Preprocess.stateSigmas branch).toNat % 8 =
        1 + 2 * 1 * branch.val := by decide
  have hvalue := lut_gen (q := modulus_0) (n := 8) (inverse := 1356938545745524308187737599098762797340022013559604731140326430414605958745)
    (s := 2) (log := 2) (quotient := 1)
    (by norm_num) (by norm_num)
    (fun index : Fin 4 ↦ Xe (n := 8) (2 * (entry table0 (index.val : Int)).toNat))
    hinverse (fun branch ↦ (sigmaOf Preprocess.stateSigmas branch).toNat) Preprocess.stateOdd
    (Equiv.refl _) hindex (state + bit)
  have hsmall : state + bit < 4 := by omega
  simpa [Nat.mod_eq_of_lt hsmall, Xe] using hvalue

