section Model3

variable (model : HashModel) (key : ByteArray) (ext : GeneratedClaim.ExternalInputs)

/-- The state rows entering block `3`. -/
noncomputable def stateRow3 (tape : SampleTape) : Fin 2 → ExactMatrix Q4 N 1 6 :=
  encRow (maskM tape) (key3 model key ext tape) (stateTarget3 ext tape) (err3 model key ext tape)

/-- The selector RHS bottoms of block `3`. -/
noncomputable def bot3 (tape : SampleTape) (i : Fin 14) (j : Fin 2) : ExactMatrix Q3 N 1 4 :=
  reducePoly Q3 N (((P3 : Nat) : Int) * nuOf ext 3 i * unitPair (payloadM tape) j) • gReb Q3 Q2 4 +
    reduceMatrix Q3 N 1 4 (rhsError3 tape [2] i j) -
    reducePoly Q3 N (payloadM tape) • rhsTop model key Q3 4 rhsPrefix3 i j

/-- The keys entering block `4`. -/
noncomputable def key4 (tape : SampleTape) : Fin 2 → Fin 2 → ExactMatrix Q3 N 1 4 :=
  ∑ i : Fin 14, fun k j ↦ theOutput (blockModSwitchRuns [1099511626049, 1099511625409, 1099511623297, 1099511622593] 1)
    (cellKeyUp3 (memberKey model key ((coords 3 i : Nat) : Int)) (key3 model key ext tape)
      (rhsTop model key Q3 4 rhsPrefix3 i) (bot3 model key ext tape i) k j)

/-- The alignment numerator of the member of cell `i` of block `3` in the model. -/
noncomputable def alignM3 (tape : SampleTape) (i : Fin 14) (j : Fin 2) : ErrorMatrix N 1 8 :=
  alignNumer3 (maskM tape) (memberKey model key ((coords 3 i : Nat) : Int))
    (memberError tape [3] ⟨coords 3 i, coords_lt 3 i⟩) (memberRow model key ext tape ⟨coords 3 i, coords_lt 3 i⟩) j

/-- The numerator of cell `i` of block `3` in the model. -/
noncomputable def numerM3 (tape : SampleTape) (i : Fin 14) (j : Fin 2) : ErrorMatrix N 1 4 :=
  cellNumer3 (maskM tape)
      (memberKey model key ((coords 3 i : Nat) : Int))
      (fun j' ↦ divInt A4 (alignM3 model key ext tape i j'))
      (err3 model key ext tape) (alphaOf ext ⟨coords 3 i, coords_lt 3 i⟩) (key3 model key ext tape)
      (rhsTop model key Q3 4 rhsPrefix3 i) (bot3 model key ext tape i)
      (fun j' ↦ theOutput (blockModSwitchRuns [1099511626049, 1099511625409, 1099511623297, 1099511622593, 1099511622529, 1099511621249, 1099511619841] 1) (memberRow model key ext tape ⟨coords 3 i, coords_lt 3 i⟩ j' * alignDigits3))
      (stateRow3 model key ext tape) (fun _ _ ↦ reducePoly Q4 N (alphaOf ext ⟨coords 3 i, coords_lt 3 i⟩)) j

/-- The error entering block `4`. -/
noncomputable def err4 (tape : SampleTape) : Fin 2 → ErrorMatrix N 1 4 :=
  ∑ i : Fin 14, fun j ↦ divInt P4 (numerM3 model key ext tape i j) -
    (alphaOf ext ⟨coords 3 i, coords_lt 3 i⟩ * muOf ext 3) • rhsError3 tape [2] i j

/-- The alignment and cell numerators of block `3` are divisible by their dropped factors. -/
def div3 (tape : SampleTape) : Prop :=
  (∀ i j row column, alignM3 model key ext tape i j row column =
    ((A4 : Int) : ErrorPoly N) * divInt A4 (alignM3 model key ext tape i j) row column) ∧
  ∀ i j row column, numerM3 model key ext tape i j row column =
    ((P4 : Int) : ErrorPoly N) * divInt P4 (numerM3 model key ext tape i j) row column

/-- The state target of block `4` at `Q3`. -/
noncomputable def stateTarget4 (tape : SampleTape) (j : Fin 2) : ExactMatrix Q3 N 1 4 :=
  reducePoly Q3 N (((P3 : Nat) : Int) * muOf ext 4 * unitPair (payloadM tape) j) • gReb Q3 Q2 4

end Model3


