/-- Branch `i` of the round-2 LUT, zero past the sixteen branches. -/
noncomputable def branchTarget2 (μ sp : ErrorPoly N)
    (fam : Fin 2 → Fin 2 → Fin 16 → ExactMatrix Q4 N 1 8) (i : Nat) : Fin 2 → ExactMatrix Q5 N 1 8 :=
  if h : i < 16 then branchTarget (q := Q5) (p := P5) μ sp fam ⟨i, h⟩ else 0

/-- The generated round-2 loop accumulates the first fifteen branches and carries the switching
ciphertext of branch `15`. -/
theorem loop2 {model : HashModel} {key : ByteArray} {sm sp μ : ErrorPoly N}
    (hsm : polyNorm sm ≤ 1)
    {g' : ExactMatrix Q4 N 1 8} {g : ExactMatrix Q5 N 1 8}
    (hg' : gadgetMatrixRuns Backend.backend 1048576 8 g') (hg : centeredRebaseRuns g' g)
    {c : Fin 2 → ExactMatrix Q5 N 1 8} {A : Fin 2 → Fin 2 → ExactMatrix Q5 N 1 8} {B : Nat}
    (henc : Rel sm A (fun j ↦ reducePoly Q5 N (((P5 : Nat) : Int) * μ * unitPair sp j) • g) c B)
    {h0 h1 : Fin 16 → ExactMatrix Q5 N 1 8}
    (hhelp : ∀ i : Fin 16, Rel sm (lutA model key Q5 8 5 (sigma i))
      (fun j ↦ reducePoly Q5 N (((P5 : Nat) : Int) *
        unitPair (substitution (sigma i).toNat (sigma_odd i) sm) j) • g) ![h0 i, h1 i] 26)
    {fam : Fin 2 → Fin 2 → Fin 16 → ExactMatrix Q4 N 1 8} {count : Nat} (hcount : count ≤ 15)
    {final : LoopState Q5 Q4 8}
    (hruns : MxxIR.IterRuns (fun (i : Nat) (current next : LoopState Q5 Q4 8) ↦
      Stage_online.sequential_generatedRoot_246 Backend.backend model GeneratedClaim.stage_4_params i
        (current.1, current.2.1, current.2.2.1, current.2.2.2.1, current.2.2.2.2.1,
          current.2.2.2.2.2.1, current.2.2.2.2.2.2.1, current.2.2.2.2.2.2.2.1,
          current.2.2.2.2.2.2.2.2.1, current.2.2.2.2.2.2.2.2.2.1, h0, key, h1, c 0, A 0 0, A 1 0,
          c 1, A 0 1, A 1 1, fam 0 0, fam 0 1, fam 1 0, fam 1 1, ()) next) count
      (0, 0, 0, 0, 0, 0, fam 0 0 0, fam 0 1 0, fam 1 0 0, fam 1 1 0, ()) final) :
    Rel sm final.key (∑ i ∈ Finset.range count, branchTarget2 μ sp fam i) final.row
        (count * branchBound2 B) ∧
      final.switch = fun k j ↦ fam k j ⟨count, by omega⟩ := by
  refine MxxIR.IterRuns.invariant
    (Invariant := fun k (s : LoopState Q5 Q4 8) ↦ ∀ hk : k ≤ 15,
      Rel sm s.key (∑ i ∈ Finset.range k, branchTarget2 μ sp fam i) s.row (k * branchBound2 B) ∧
        s.switch = fun k' j ↦ fam k' j ⟨k, by omega⟩) ?_ ?_ hruns hcount
  · intro _
    refine ⟨?_, ?_⟩
    · rw [Finset.range_zero, Finset.sum_empty, zero_mul]
      have hrow : (![0, 0] : Fin 2 → ExactMatrix Q5 N 1 8) = 0 := by
