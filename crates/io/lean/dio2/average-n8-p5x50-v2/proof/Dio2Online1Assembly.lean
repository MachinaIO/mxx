/-- The remaining semantic work is precisely the state and smudge components.
The imported hint, key-source agreement, sampled preimage and final certified
margin are obtained here from roots and actual claim runs, not supplied again. -/
theorem online1_output_from_components {model : HashModel}
    {external : GeneratedClaim.ExternalInputs} {execution : GeneratedClaim.Execution}
    (C : Claim1.Context model external execution)
    (hrun : W_GeneratedClaim.Runs model external execution)
    {sm sp current : ErrorPoly 8} {gadget : ExactMatrix modulus_0 8 1 25}
    (roots : Online1Roots C.online execution.«stage_1».2.2.1 sm sp current
      (online1Labels external) gadget)
