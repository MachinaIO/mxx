noncomputable def M1B1 (tape : SampleTape) (i : Fin 14) (j : Fin 2) : ErrorMatrix N 1 8 :=
  downResidue P6 (cellKeyUp1 (memberKey model key ((coords 1 i : Nat) : Int)) (key1 model key ext tape)
    (rhsTop model key Q5 8 rhsPrefix1 i) (bot1 model key ext tape i) 1 j)

noncomputable def ceB1 (i : Fin 14) : ErrorPoly N := alphaOf ext ⟨coords 1 i, coords_lt 1 i⟩ * muOf ext 1

theorem err2_form (tape : SampleTape) :
    err2 model key ext tape = ∑ i, fun j ↦ divInt ((P6 : Nat) : ℤ) (cellNum (fun i k ↦ divInt ((A6 : Nat) : ℤ) (alignNum (eaB1 tape) HB1 (maskM tape) (RB1 model key ext tape)
        (K0B1 model key) (K1B1 model key) i k))
      (DsB1 model key ext tape) (αB1 ext) (err1 model key ext tape) (DrB1 model key ext tape) (maskM tape)
      (XB1 model key ext tape) (M0B1 model key ext tape) (M1B1 model key ext tape) i j) -
        ceB1 ext i • rhsError1 tape [2] i j :=
  rfl

