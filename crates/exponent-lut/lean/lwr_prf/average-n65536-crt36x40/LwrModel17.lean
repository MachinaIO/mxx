/-- The numerator `A v` of the alignment of a member of `a`: its error after the digits `H`, minus
the row residue, plus the mask-weighted key residues. -/
noncomputable def alignNumer17 (sm : ErrorPoly N) (mk : Fin 2 → Fin 2 → ExactMatrix Q36 N 1 144)
    (ea : Fin 2 → ErrorMatrix N 1 144) (row : Fin 2 → ExactMatrix Q36 N 1 144) (j : Fin 2) :
    ErrorMatrix N 1 76 :=
  ea j * liftMatrix alignDigits17 - downResidue A19 (row j * alignDigits17) +
    sm • downResidue A19 (mk 0 j * alignDigits17) + downResidue A19 (mk 1 j * alignDigits17)

/-- The numerator `p v` of a block-1 cell. -/
noncomputable def cellNumer17 (sm : ErrorPoly N) (mk : Fin 2 → Fin 2 → ExactMatrix Q36 N 1 144)
    (va : Fin 2 → ErrorMatrix N 1 76) (es : Fin 2 → ErrorMatrix N 1 72) (α : ErrorPoly N)
    (As : Fin 2 → Fin 2 → ExactMatrix Q19 N 1 72) (top bot : Fin 2 → ExactMatrix Q18 N 1 68)
    (crow : Fin 2 → ExactMatrix Q19 N 1 76) (cs : Fin 2 → ExactMatrix Q19 N 1 72)
    (pay : ExactMatrix Q19 N 1 1) (j : Fin 2) : ErrorMatrix N 1 68 :=
  pairMul (fun j' ↦ pairMul va (liftMatrix (pubDigits17 As j')) + α • es j')
      (liftMatrix (rhsDigits17 top bot j)) -
    downResidue P19 (pairMul (fun j' ↦ pairMul crow (pubDigits17 As j') +
      matrixMulScalarRight (cs j') pay) (rhsDigits17 top bot j)) +
    sm • downResidue P19 (cellKeyUp17 mk As top bot 0 j) + downResidue P19 (cellKeyUp17 mk As top bot 1 j)

