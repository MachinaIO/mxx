          rhsTop model (generatedRoot.w_3_0 ctx) p 1]) a ⟨30 * (j : Nat) + l, by omega⟩) ∧
    (∀ d1 : BranchData, d1.key = generatedRoot.w_3_0 ctx →
      d1.TI0 = generatedRoot.w_154_0 ctx → d1.TI1 = generatedRoot.w_154_1 ctx →
      d1.TL0 = generatedRoot.w_155_0 ctx → d1.TL1 = generatedRoot.w_155_1 ctx →
      ∀ (b : Fin 30) r jj, ![d1.Tb0 b b.isLt, d1.Tb1 b b.isLt] r 0 jj =
        ∑ a, lutKeyCompanionSum model (generatedRoot.w_3_0 ctx) b (preM_1 ctx) r jj a +
        ∑ a : Fin 30, substitution (kSw b) (kSw_odd b) (preM_1 ctx r 0 0 a) *
