        rw [h21, ← c1]
        exact congrArg (generatedRoot.w_51_0 ctx 0) (Fin.ext (by simp only; omega))
    rw [e]
    exact hT2 l r jj
  · -- The output key.
    have hc := PreSum0.coefLoopId F.c5.h55_0
    have hV : generatedRoot.w_59_0 ctx =
        scalarV (branchCoef (generatedRoot.w_54_0 ctx) 0 1 (by norm_num)) := by
      refine scalarV_eq F.c5.h57_0 ?_
      have h59 := F.c5.h59_0
