/-- The numerator `A v` of the alignment of a member of `a`: its error after the digits `H`, minus
the row residue, plus the mask-weighted key residues. -/
noncomputable def alignNumer1 (sm : ErrorPoly N) (mk : Fin 2 → Fin 2 → ExactMatrix Q36 N 1 144)
    (ea : Fin 2 → ErrorMatrix N 1 144) (row : Fin 2 → ExactMatrix Q36 N 1 144) (j : Fin 2) :
    ErrorMatrix N 1 140 :=
  ea j * liftMatrix alignDigits1 - downResidue A35 (row j * alignDigits1) +
    sm • downResidue A35 (mk 0 j * alignDigits1) + downResidue A35 (mk 1 j * alignDigits1)

/-- The numerator `p v` of a block-1 cell. -/
noncomputable def cellNumer1 (sm : ErrorPoly N) (mk : Fin 2 → Fin 2 → ExactMatrix Q36 N 1 144)
    (va : Fin 2 → ErrorMatrix N 1 140) (es : Fin 2 → ErrorMatrix N 1 136) (α : ErrorPoly N)
    (As : Fin 2 → Fin 2 → ExactMatrix Q35 N 1 136) (top bot : Fin 2 → ExactMatrix Q34 N 1 132)
    (crow : Fin 2 → ExactMatrix Q35 N 1 140) (cs : Fin 2 → ExactMatrix Q35 N 1 136)
    (pay : ExactMatrix Q35 N 1 1) (j : Fin 2) : ErrorMatrix N 1 132 :=
  pairMul (fun j' ↦ pairMul va (liftMatrix (pubDigits1 As j')) + α • es j')
      (liftMatrix (rhsDigits1 top bot j)) -
    downResidue P35 (pairMul (fun j' ↦ pairMul crow (pubDigits1 As j') +
      matrixMulScalarRight (cs j') pay) (rhsDigits1 top bot j)) +
    sm • downResidue P35 (cellKeyUp1 mk As top bot 0 j) + downResidue P35 (cellKeyUp1 mk As top bot 1 j)

