/-- The product key of preprocessing step 3. -/
noncomputable def preM_3 (ctx : generatedRoot.Ctx Backend.backend model tape path params) :
    Fin 2 → Fin 2 → ExactMatrix Q N 1 44 :=
  ![![generatedRoot.w_440_0 ctx, generatedRoot.w_445_0 ctx],
    ![generatedRoot.w_450_0 ctx, generatedRoot.w_455_0 ctx]]

/-- Published T families, indexed by flattened slot, row, then member. -/
def preLeafT_3 (ctx : generatedRoot.Ctx Backend.backend model tape path params) :
