/-! ## The readout LUT -/

noncomputable def ehL (tape : SampleTape) (i : Fin 128) : Fin 2 → ErrorMatrix N 1 4 := helperError tape [3] i

noncomputable def DEL (tape : SampleTape) (i : Fin 128) : ErrorMatrix N (4 + 4) 4 :=
  liftMatrix (lutDigitsE (key34 model key ext tape) (lutFam model key tape) i 1)

noncomputable def DDL (tape : SampleTape) (i : Fin 128) : ErrorMatrix N (4 + 4) 4 :=
  liftMatrix (lutDigitsD (lutFam model key tape) i 1)

def σL (i : Fin 128) : Nat := (sigma i).toNat

noncomputable def sL (tape : SampleTape) (i : Fin 128) : ErrorPoly N :=
  substitution (sigma i).toNat (sigma_odd i) (maskM tape)

noncomputable def KM0L (tape : SampleTape) (i : Fin 128) : ErrorMatrix N 1 4 :=
  downResidue P2 (lutKeyM (key34 model key ext tape) (lutFam model key tape) i 0 1)

noncomputable def KM1L (tape : SampleTape) (i : Fin 128) : ErrorMatrix N 1 4 :=
  downResidue P2 (lutKeyM (key34 model key ext tape) (lutFam model key tape) i 1 1)

noncomputable def RL (tape : SampleTape) : ErrorMatrix N 1 4 := downResidue P2 (lutRow model key ext tape 1)

noncomputable def K0L (tape : SampleTape) : ErrorMatrix N 1 4 :=
  downResidue P2 (lutKsum model key ext tape 0 1)

noncomputable def K1L (tape : SampleTape) : ErrorMatrix N 1 4 :=
  downResidue P2 (lutKsum model key ext tape 1 1)

noncomputable def aL (i : Fin 128) : ErrorPoly N := substitution (sigma i).toNat (sigma_odd i) (muOf ext 34)

theorem lutNumer_form (tape : SampleTape) :
    lutNumer model key ext tape 1 = ∑ i, lutBranch (ehL tape) (DEL model key ext tape) σL sigma_odd
      (err34 model key ext tape) (DDL model key tape) (sL tape) (KM0L model key ext tape)
      (KM1L model key ext tape) i - RL model key ext tape + maskM tape • K0L model key ext tape +
        K1L model key ext tape := by
  unfold lutNumer lutErr
  rw [Finset.sum_apply]
  simp only [lutBranchErr, lutBranch, add_assoc]
  rfl

theorem finalErr_form (tape : SampleTape) :
    finalErr model key ext tape 1 = (divInt ((P2 : Nat) : ℤ) (lutNumer model key ext tape 1) -
      ∑ i, aL ext i • switchError tape [2] i 1) * finalDigits :=
  rfl

/-! ## Weights -/

/-- The weight of the decoded coefficient `0`. -/
noncomputable def Wfin : Weight N 1 1 := fun _ _ k ↦ if k.val = 0 then 1 else 0

/-- The weight on the LUT error before the finalization. -/
noncomputable def WL : Weight N 1 4 := pullMul Wfin finalDigits

/-- The weight on the error entering the readout LUT. -/
noncomputable def V34 (tape : SampleTape) (j' : Fin 2) : Weight N 1 4 :=
  (((P2 : Nat) : ℤ) : ℝ)⁻¹ • lutStateWeight hN WL (DDL model key tape) σL j'

/-- The weight on the error entering block `33`. -/
noncomputable def V33 (tape : SampleTape) (j' : Fin 2) : Weight N 1 8 :=
  (((P3 : Nat) : ℤ) : ℝ)⁻¹ • stateWeight (V34 model key tape) (DrB33 model key ext tape) (αB33 ext) j'

/-- The weights on the aligned members of block `33`, before the division by `P`. -/
noncomputable def U33 (tape : SampleTape) : Fin 113 → Fin 2 → Weight N 1 12 :=
  alignWeight (V34 model key tape) (DrB33 model key ext tape) (DsB33 model key ext tape)

/-- The weight on the error entering block `32`. -/
noncomputable def V32 (tape : SampleTape) (j' : Fin 2) : Weight N 1 12 :=
  (((P4 : Nat) : ℤ) : ℝ)⁻¹ • stateWeight (V33 model key ext tape) (DrB32 model key ext tape) (αB32 ext) j'

/-- The weights on the aligned members of block `32`, before the division by `P`. -/
