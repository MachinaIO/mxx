import MxxIR
import MxxRuntime

set_option maxRecDepth 16384
set_option maxHeartbeats 2000000

namespace Stage_decrypt

structure Params where
  «instance_width» : Int
  «witness_width» : Int
  «depth» : Int
  «max_layer_width» : Int

local notation "mxxNat0" => 
local notation "mxxMat0" => Mxx.Primitives.ExactMatrix mxxNat0 524288 1 2
local notation "mxxMat1" => Mxx.Primitives.ExactMatrix mxxNat0 524288 1 1
local notation "mxxMat2" => Mxx.Primitives.ExactMatrix mxxNat0 524288 2 1

set_option genInjectivity false in
set_option genSizeOf false in
structure generatedRoot.Witness where
  w_3_0 : mxxMat0
  w_7_0_decoded : Int

abbrev generatedRoot.constraints_0 (w_1_0 : mxxMat1) (w_2_0 : mxxMat1) (w_3_0 : mxxMat0) (w_6_0 : mxxMat1) (w_7_0_decoded : Int) (w_7_0 : Bool) (outputs : Bool) : Prop :=
  MxxRuntime.concatColumns w_1_0 w_2_0 w_3_0 ∧
  (1) = 1 ∧
  MxxRuntime.thresholdDecode (2) (1) 0 w_6_0 w_7_0_decoded ∧
  outputs = w_7_0

abbrev generatedRoot.body (_ : MxxRuntime.SampleTape) (_ : List Nat) (params : Params) (inputs : mxxMat1 × mxxMat1 × mxxMat2 × Unit) (outputs : Bool) (witness : generatedRoot.Witness) : Prop :=
  let _params := params
  let w_0_0 : mxxMat1 := inputs.1
  let w_1_0 : mxxMat1 := inputs.2.1
  let w_4_0 : mxxMat2 := inputs.2.2.1
  let w_2_0 : mxxMat1 := (1 : mxxMat1)
  let w_3_0 := witness.w_3_0
  let w_5_0 : mxxMat1 := MxxRuntime.matrixMul w_3_0 w_4_0
  let w_6_0 : mxxMat1 := MxxRuntime.matrixSub w_0_0 w_5_0
  let w_7_0_decoded := witness.w_7_0_decoded
  let w_7_0 : Bool := decide (w_7_0_decoded ≠ 0)
  generatedRoot.constraints_0 w_1_0 w_2_0 w_3_0 w_6_0 w_7_0_decoded w_7_0 outputs

def generatedRoot (tape : MxxRuntime.SampleTape) (path : List Nat) (params : Params) (inputs : mxxMat1 × mxxMat1 × mxxMat2 × Unit) (outputs : Bool) : Prop :=
  ∃ witness : generatedRoot.Witness,
    generatedRoot.body tape path params inputs outputs witness


end Stage_decrypt
