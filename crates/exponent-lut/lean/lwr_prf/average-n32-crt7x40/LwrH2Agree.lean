section Depends

variable (model : HashModel) (key : ByteArray) (ext : GeneratedClaim.ExternalInputs)

theorem siteG_dependsOn : DependsOn (fun t j ↦ siteG model key ext j t) (siteKeys : Set SampleKey) := by
  intro t t' h
  have hp : ∀ k ∈ (preKeys : Set SampleKey), t k = t' k := fun k hk ↦
    h k (by rw [siteKeys_def]; exact Finset.mem_union_left _ hk)
  funext j
  simp only [siteG, gRow_agree model key ext hp, gKey_agree model key ext h]

theorem uKey_dependsOn (x : KeySite) :
    DependsOn (fun t ↦ uKey model key ext t x) (preKeys : Set SampleKey) := by
  intro t t' h
  simp only [uKey_agree model key ext h]

end Depends

