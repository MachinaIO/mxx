import LwrModelLut
import ExponentH2

/-!
# The model in the form of the H2 decomposition

Generated by `generator/gen_h2_model.py`. The error leaving every block and the finalized error of
the readout LUT, written with the generic cell, alignment and LUT numerators of
`ExponentCellStep`; the weights pulled back from the decoded coefficient; the H2 sites (the row
residues of the private multiplications, of the alignments and of the LUT finish, and the
mask-weighted key residues of the alignments) with their coefficients and values; and the
decomposition of the decoded coefficient into a remainder and the sum over the sites.
-/

namespace LwrProof

open Mxx.Primitives MxxRuntime MxxExponentLut

section H2Model

variable (model : HashModel) (key : ByteArray) (ext : GeneratedClaim.ExternalInputs)

/-! ## Block 0 -/

noncomputable def eaB0 (tape : SampleTape) (i : Fin 14) : Fin 2 → ErrorMatrix N 1 14 :=
  memberError tape [3] ⟨coords 0 i, coords_lt 0 i⟩

noncomputable def DsB0 (j' : Fin 2) : ErrorMatrix N (14 + 14) 12 :=
  liftMatrix (pubDigits0 (stateKey model key) j')

noncomputable def αB0 (i : Fin 14) : ErrorPoly N := alphaOf ext ⟨coords 0 i, coords_lt 0 i⟩

noncomputable def DrB0 (tape : SampleTape) (i : Fin 14) (j : Fin 2) : ErrorMatrix N (12 + 12) 10 :=
  liftMatrix (rhsDigits0 (rhsTop model key Q6 10 rhsPrefix0 i) (bot0 model key ext tape i) j)

noncomputable def XB0 (tape : SampleTape) (i : Fin 14) (j : Fin 2) : ErrorMatrix N 1 10 :=
  downResidue P7 (pairMul (fun j' ↦ pairMul (memberRow model key ext tape ⟨coords 0 i, coords_lt 0 i⟩)
      (pubDigits0 (stateKey model key) j') +
    matrixMulScalarRight (stateRow0 model key ext tape j')
      (fun _ _ ↦ reducePoly Q7 N (alphaOf ext ⟨coords 0 i, coords_lt 0 i⟩)))
    (rhsDigits0 (rhsTop model key Q6 10 rhsPrefix0 i) (bot0 model key ext tape i) j))

noncomputable def M0B0 (tape : SampleTape) (i : Fin 14) (j : Fin 2) : ErrorMatrix N 1 10 :=
  downResidue P7 (cellKeyUp0 (memberKey model key ((coords 0 i : Nat) : Int)) (stateKey model key)
    (rhsTop model key Q6 10 rhsPrefix0 i) (bot0 model key ext tape i) 0 j)

noncomputable def M1B0 (tape : SampleTape) (i : Fin 14) (j : Fin 2) : ErrorMatrix N 1 10 :=
  downResidue P7 (cellKeyUp0 (memberKey model key ((coords 0 i : Nat) : Int)) (stateKey model key)
    (rhsTop model key Q6 10 rhsPrefix0 i) (bot0 model key ext tape i) 1 j)

noncomputable def ceB0 (i : Fin 14) : ErrorPoly N := alphaOf ext ⟨coords 0 i, coords_lt 0 i⟩ * muOf ext 0

theorem err1_form (tape : SampleTape) :
    err1 model key ext tape = ∑ i, fun j ↦ divInt ((P7 : Nat) : ℤ) (cellNum (eaB0 tape)
      (DsB0 model key) (αB0 ext) (stateError tape [3]) (DrB0 model key ext tape) (maskM tape)
      (XB0 model key ext tape) (M0B0 model key ext tape) (M1B0 model key ext tape) i j) -
        ceB0 ext i • rhsError0 tape [2] i j :=
  rfl

/-! ## Block 1 -/

noncomputable def eaB1 (tape : SampleTape) (i : Fin 14) : Fin 2 → ErrorMatrix N 1 14 :=
