            (kLeaf2 (parent.val + 15 * m.val)) (by norm_num)) := by
      intro m r j
      have e := (LL m).2 r j
      change preLeafKey_0 ctx r j m =
        pairMul (helperKey model (generatedRoot.w_3_0 ctx) (kSw (15 + m)) r)
          (actionDigits (preLeafT_0 ctx 0 0 m) (preLeafT_0 ctx 0 1 m) j) * _ +
        ∑ parent : Fin 15, pairMul
          (helperKey model (generatedRoot.w_3_0 ctx) (kSw (15 + m)) r)
          (actionDigits (preLeafT_0 ctx parent.succ 0 m)
            (preLeafT_0 ctx parent.succ 1 m) j) * _ at e
      refine e.trans ?_
      apply congrArg₂ (· + ·)
      · exact congrArg (fun key : ExactMatrix Q N 1 30 ↦ key * scalarV
          (branchCoef (generatedRoot.w_29_0 ctx) 0 (kSw (15 + m)) (by norm_num)))
          (key1_leaf (model := model) d1 hk h2 h3 m r j).symm
      · apply Finset.sum_congr rfl
        intro parent _
        exact congrArg (fun key : ExactMatrix Q N 1 30 ↦ key * scalarV
          (branchCoef (generatedRoot.w_29_0 ctx) 0
            (kLeaf2 (parent.val + 15 * m.val)) (by norm_num)))
          (groupedPreLeaf_key2 (model := model) (preLeafT_0 ctx) d2 hk2 h20 h21 parent m r j)
    funext r j
    change _ = preM_0 ctx r j * _ + _ + _ + _
    rw [hs' r j, S1 r j, S2 r j, hV]
    simp only [hXI, hXL]
    rw [grouped_leaf_sum
      (fun m : Fin 15 ↦ d1.key1 model ⟨15 + m, by omega⟩ r j *
        scalarV (branchCoef (generatedRoot.w_29_0 ctx) 0 (kSw (15 + m)) (by norm_num)))
      (fun leaf : Fin 225 ↦ d2.key2 model leaf r j *
        scalarV (branchCoef (generatedRoot.w_29_0 ctx) 0 (kLeaf2 leaf) (by norm_num)))]
    abel

end PeProof
