  -- The LUT key rows.
  have hM0 : concatColumns (preM_2 ctx 0 0) (preM_2 ctx 0 1) (generatedRoot.w_163_0 ctx) := F.c15.h163_0
  have hM1 : concatColumns (preM_2 ctx 1 0) (preM_2 ctx 1 1) (generatedRoot.w_164_0 ctx) := F.c15.h164_0
  have hT1 := lut_T1 (model := model) hM0 hM1 rfl (fun r q ↦ PreLut2.lutTopLoop F.c15.h165_1 r q)
