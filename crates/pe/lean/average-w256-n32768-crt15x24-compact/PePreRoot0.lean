  -- The lanes of the LUT depths.
  have hM0 : concatColumns (preM_0 ctx 0 0) (preM_0 ctx 0 1) (generatedRoot.w_27_0 ctx) := F.c2.h27_0
  have hM1 : concatColumns (preM_0 ctx 1 0) (preM_0 ctx 1 1) (generatedRoot.w_28_0 ctx) := F.c2.h28_0
  have LI := fun b : Fin 15 ↦ PreLaneI0.lane b.isLt hM0 hM1 (F.c2.h30_9 b)
  have LL := fun m : Fin 15 ↦ PreLaneM0.lane m.isLt hM0 hM1
    (F.c2.h31_11 m) (F.c2.h32_11 m) (F.c3.h33_11 m) (F.c3.h34_11 m)
  have hRows : ∀ (m : Fin 15) (slot : Fin 16) r jj,
      preLeafT_0 ctx slot r m 0 jj = lutTRow model (generatedRoot.w_3_0 ctx)
