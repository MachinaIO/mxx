/-! ## Block 0 -/

noncomputable def eaB0 (tape : SampleTape) (i : Fin 113) : Fin 2 → ErrorMatrix N 1 144 :=
  memberError tape [3] ⟨coords 0 i, coords_lt 0 i⟩

noncomputable def DsB0 (j' : Fin 2) : ErrorMatrix N (144 + 144) 140 :=
  liftMatrix (pubDigits0 (stateKey model key) j')

noncomputable def αB0 (i : Fin 113) : ErrorPoly N := alphaOf ext ⟨coords 0 i, coords_lt 0 i⟩

noncomputable def DrB0 (tape : SampleTape) (i : Fin 113) (j : Fin 2) : ErrorMatrix N (140 + 140) 136 :=
  liftMatrix (rhsDigits0 (rhsTop model key Q35 136 rhsPrefix0 i) (bot0 model key ext tape i) j)

noncomputable def XB0 (tape : SampleTape) (i : Fin 113) (j : Fin 2) : ErrorMatrix N 1 136 :=
  downResidue P36 (pairMul (fun j' ↦ pairMul (memberRow model key ext tape ⟨coords 0 i, coords_lt 0 i⟩)
      (pubDigits0 (stateKey model key) j') +
    matrixMulScalarRight (stateRow0 model key ext tape j')
      (fun _ _ ↦ reducePoly Q36 N (alphaOf ext ⟨coords 0 i, coords_lt 0 i⟩)))
    (rhsDigits0 (rhsTop model key Q35 136 rhsPrefix0 i) (bot0 model key ext tape i) j))

noncomputable def M0B0 (tape : SampleTape) (i : Fin 113) (j : Fin 2) : ErrorMatrix N 1 136 :=
  downResidue P36 (cellKeyUp0 (memberKey model key ((coords 0 i : Nat) : Int)) (stateKey model key)
    (rhsTop model key Q35 136 rhsPrefix0 i) (bot0 model key ext tape i) 0 j)

noncomputable def M1B0 (tape : SampleTape) (i : Fin 113) (j : Fin 2) : ErrorMatrix N 1 136 :=
  downResidue P36 (cellKeyUp0 (memberKey model key ((coords 0 i : Nat) : Int)) (stateKey model key)
    (rhsTop model key Q35 136 rhsPrefix0 i) (bot0 model key ext tape i) 1 j)

noncomputable def ceB0 (i : Fin 113) : ErrorPoly N := alphaOf ext ⟨coords 0 i, coords_lt 0 i⟩ * muOf ext 0

theorem err1_form (tape : SampleTape) :
    err1 model key ext tape = ∑ i, fun j ↦ divInt ((P36 : Nat) : ℤ) (cellNum (eaB0 tape)
      (DsB0 model key) (αB0 ext) (stateError tape [3]) (DrB0 model key ext tape) (maskM tape)
      (XB0 model key ext tape) (M0B0 model key ext tape) (M1B0 model key ext tape) i j) -
        ceB0 ext i • rhsError0 tape [2] i j :=
  rfl

