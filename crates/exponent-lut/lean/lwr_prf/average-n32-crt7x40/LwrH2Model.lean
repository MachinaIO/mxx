theorem err3_form (tape : SampleTape) :
    err3 model key ext tape = ∑ i, fun j ↦ divInt ((P5 : Nat) : ℤ) (cellNum (fun i k ↦ divInt ((A5 : Nat) : ℤ) (alignNum (eaB2 tape) HB2 (maskM tape) (RB2 model key ext tape)
