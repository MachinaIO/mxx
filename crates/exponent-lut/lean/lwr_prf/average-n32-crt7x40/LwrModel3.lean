/-!
# The model of block 3

Generated by `generator/gen_model.py`: the numerators of block `3`, `block3E` with its errors as
their divisions, and the keys, rows and errors of the model that block `3` produces.
-/

namespace LwrProof

open Mxx.Primitives MxxRuntime MxxExponentLut

variable {tape : SampleTape} {path : List Nat}

/-- The numerator `A v` of the alignment of a member of `a`: its error after the digits `H`, minus
the row residue, plus the mask-weighted key residues. -/
noncomputable def alignNumer3 (sm : ErrorPoly N) (mk : Fin 2 → Fin 2 → ExactMatrix Q7 N 1 14)
    (ea : Fin 2 → ErrorMatrix N 1 14) (row : Fin 2 → ExactMatrix Q7 N 1 14) (j : Fin 2) :
    ErrorMatrix N 1 8 :=
  ea j * liftMatrix alignDigits3 - downResidue A4 (row j * alignDigits3) +
    sm • downResidue A4 (mk 0 j * alignDigits3) + downResidue A4 (mk 1 j * alignDigits3)

/-- The numerator `p v` of a block-1 cell. -/
noncomputable def cellNumer3 (sm : ErrorPoly N) (mk : Fin 2 → Fin 2 → ExactMatrix Q7 N 1 14)
    (va : Fin 2 → ErrorMatrix N 1 8) (es : Fin 2 → ErrorMatrix N 1 6) (α : ErrorPoly N)
    (As : Fin 2 → Fin 2 → ExactMatrix Q4 N 1 6) (top bot : Fin 2 → ExactMatrix Q3 N 1 4)
    (crow : Fin 2 → ExactMatrix Q4 N 1 8) (cs : Fin 2 → ExactMatrix Q4 N 1 6)
    (pay : ExactMatrix Q4 N 1 1) (j : Fin 2) : ErrorMatrix N 1 4 :=
  pairMul (fun j' ↦ pairMul va (liftMatrix (pubDigits3 As j')) + α • es j')
      (liftMatrix (rhsDigits3 top bot j)) -
    downResidue P4 (pairMul (fun j' ↦ pairMul crow (pubDigits3 As j') +
      matrixMulScalarRight (cs j') pay) (rhsDigits3 top bot j)) +
    sm • downResidue P4 (cellKeyUp3 mk As top bot 0 j) + downResidue P4 (cellKeyUp3 mk As top bot 1 j)

set_option maxHeartbeats 16000000 in
set_option maxRecDepth 100000 in
/-- `block3E` with the cell and alignment errors as divisions of their numerators. -/
theorem block3M {model : HashModel} {key : ByteArray}
    {s0 s1 s2 s3} {k0 k1}
    {ca0 ca1} {cs0 cs1}
    {apay}
    {r00 r01} {r10 r11}
    {r20 r21} {r30 r31}
    {r40 r41}
    {outputs} {w : Stage_online_eval.generatedRoot.Witness}
    (hb : Stage_online_eval.generatedRoot.body Backend.backend model tape path GeneratedClaim.stage_4_params
      (s0, s1, s2, s3, k0, key, k1, ca0, ca1, cs0, apay, cs1, r00, r01, r10, r11, r20, r21, r30, r31,
        r40, r41, ()) outputs w)
    {sm sp μ : ErrorPoly N} {α : Fin 17 → ErrorPoly N} {ν : Fin 14 → ErrorPoly N}
    {G : ExactMatrix Q7 N 1 14} (hG : gadgetMatrixRuns Backend.backend 1048576 14 G)
    {g' : ExactMatrix Q3 N 1 6} {g : ExactMatrix Q4 N 1 6}
    (hg' : gadgetMatrixRuns Backend.backend 1048576 6 g') (hg : centeredRebaseRuns g' g)
    {h : ExactMatrix Q3 N 1 4}
    {ea : Fin 17 → Fin 2 → ErrorMatrix N 1 14}
    (ha : ∀ k : Fin 17, RelE sm (memberKey model key k)
      (fun j ↦ reducePoly Q7 N (α k * unitPair sm j) • G) ![ca0 k, ca1 k] (ea k))
    (hpay : ∀ k : Fin 17, apay k = fun _ _ ↦ reducePoly Q7 N (α k))
    {es : Fin 2 → ErrorMatrix N 1 6}
    (hs : RelE sm ![![w.w_86_0, w.w_86_1], ![w.w_86_2, w.w_86_3]]
      (fun j ↦ reducePoly Q4 N (((P4 : Nat) : Int) * μ * unitPair sp j) • g)
      ![w.w_86_4, w.w_86_5] es)
    {eB : Fin 14 → Fin 2 → ErrorMatrix N 1 4}
    (hrhs : ∀ i : Fin 14, ∀ j,
      reducePoly Q3 N sp • rhsTop model key Q3 4 rhsPrefix3 i j + ![r30 i, r31 i] j =
        reducePoly Q3 N (((P3 : Nat) : Int) * ν i * unitPair sp j) • h +
          reduceMatrix Q3 N 1 4 (eB i j)) :
    (![![w.w_108_0, w.w_108_1], ![w.w_108_2, w.w_108_3]] = ∑ i : Fin 14, fun k j ↦
      theOutput (blockModSwitchRuns [1099511626049, 1099511625409, 1099511623297, 1099511622593] 1)
        (cellKeyUp3 (memberKey model key ((coords 3 i : Nat) : Int)) ![![w.w_86_0, w.w_86_1], ![w.w_86_2, w.w_86_3]]
          (rhsTop model key Q3 4 rhsPrefix3 i) ![r30 i, r31 i] k j)) ∧
      (∀ i j row column, (alignNumer3 sm (memberKey model key ((coords 3 i : Nat) : Int))
          (ea ⟨coords 3 i, coords_lt 3 i⟩) ![ca0 ⟨coords 3 i, coords_lt 3 i⟩, ca1 ⟨coords 3 i, coords_lt 3 i⟩] j) row column =
        ((A4 : Int) : ErrorPoly N) * divInt A4 (alignNumer3 sm (memberKey model key ((coords 3 i : Nat) : Int))
          (ea ⟨coords 3 i, coords_lt 3 i⟩) ![ca0 ⟨coords 3 i, coords_lt 3 i⟩, ca1 ⟨coords 3 i, coords_lt 3 i⟩] j) row column) ∧
      (∀ i j row column, (cellNumer3 sm (memberKey model key ((coords 3 i : Nat) : Int))
            (fun j' ↦ divInt A4 (alignNumer3 sm (memberKey model key ((coords 3 i : Nat) : Int))
              (ea ⟨coords 3 i, coords_lt 3 i⟩) ![ca0 ⟨coords 3 i, coords_lt 3 i⟩, ca1 ⟨coords 3 i, coords_lt 3 i⟩] j')) es
            (α ⟨coords 3 i, coords_lt 3 i⟩) ![![w.w_86_0, w.w_86_1], ![w.w_86_2, w.w_86_3]]
            (rhsTop model key Q3 4 rhsPrefix3 i) ![r30 i, r31 i]
            (fun j' ↦ theOutput (blockModSwitchRuns [1099511626049, 1099511625409, 1099511623297, 1099511622593, 1099511622529, 1099511621249, 1099511619841] 1) (![ca0 ⟨coords 3 i, coords_lt 3 i⟩, ca1 ⟨coords 3 i, coords_lt 3 i⟩] j' * alignDigits3))
            ![w.w_86_4, w.w_86_5] (fun _ _ ↦ reducePoly Q4 N (α ⟨coords 3 i, coords_lt 3 i⟩)) j) row column =
        ((P4 : Int) : ErrorPoly N) * divInt P4 (cellNumer3 sm (memberKey model key ((coords 3 i : Nat) : Int))
            (fun j' ↦ divInt A4 (alignNumer3 sm (memberKey model key ((coords 3 i : Nat) : Int))
              (ea ⟨coords 3 i, coords_lt 3 i⟩) ![ca0 ⟨coords 3 i, coords_lt 3 i⟩, ca1 ⟨coords 3 i, coords_lt 3 i⟩] j')) es
            (α ⟨coords 3 i, coords_lt 3 i⟩) ![![w.w_86_0, w.w_86_1], ![w.w_86_2, w.w_86_3]]
            (rhsTop model key Q3 4 rhsPrefix3 i) ![r30 i, r31 i]
            (fun j' ↦ theOutput (blockModSwitchRuns [1099511626049, 1099511625409, 1099511623297, 1099511622593, 1099511622529, 1099511621249, 1099511619841] 1) (![ca0 ⟨coords 3 i, coords_lt 3 i⟩, ca1 ⟨coords 3 i, coords_lt 3 i⟩] j' * alignDigits3))
            ![w.w_86_4, w.w_86_5] (fun _ _ ↦ reducePoly Q4 N (α ⟨coords 3 i, coords_lt 3 i⟩)) j) row column) ∧
      RelE sm ![![w.w_108_0, w.w_108_1], ![w.w_108_2, w.w_108_3]]
        (∑ i : Fin 14, fun j ↦ reducePoly Q3 N (((P3 : Nat) : Int) *
          (α ⟨coords 3 i, coords_lt 3 i⟩ * μ * ν i) * unitPair sp j) • h)
        ![w.w_108_4, w.w_108_5]
        (∑ i : Fin 14, fun j ↦ divInt P4 (cellNumer3 sm (memberKey model key ((coords 3 i : Nat) : Int))
            (fun j' ↦ divInt A4 (alignNumer3 sm (memberKey model key ((coords 3 i : Nat) : Int))
              (ea ⟨coords 3 i, coords_lt 3 i⟩) ![ca0 ⟨coords 3 i, coords_lt 3 i⟩, ca1 ⟨coords 3 i, coords_lt 3 i⟩] j')) es
            (α ⟨coords 3 i, coords_lt 3 i⟩) ![![w.w_86_0, w.w_86_1], ![w.w_86_2, w.w_86_3]]
            (rhsTop model key Q3 4 rhsPrefix3 i) ![r30 i, r31 i]
            (fun j' ↦ theOutput (blockModSwitchRuns [1099511626049, 1099511625409, 1099511623297, 1099511622593, 1099511622529, 1099511621249, 1099511619841] 1) (![ca0 ⟨coords 3 i, coords_lt 3 i⟩, ca1 ⟨coords 3 i, coords_lt 3 i⟩] j' * alignDigits3))
            ![w.w_86_4, w.w_86_5] (fun _ _ ↦ reducePoly Q4 N (α ⟨coords 3 i, coords_lt 3 i⟩)) j) - (α ⟨coords 3 i, coords_lt 3 i⟩ * μ) • eB i j) := by
  obtain ⟨hk, va, hva, v, hv, hid⟩ := block3E hb hG hg' hg ha hpay hs hrhs
  have hvaM : ∀ i, va i = fun j ↦ divInt A4 (alignNumer3 sm (memberKey model key ((coords 3 i : Nat) : Int))
      (ea ⟨coords 3 i, coords_lt 3 i⟩) ![ca0 ⟨coords 3 i, coords_lt 3 i⟩, ca1 ⟨coords 3 i, coords_lt 3 i⟩] j) := by
    intro i
    funext j
    exact div_of_identity (by norm_num) (fun row column ↦ hva i j row column)
  have hvM : ∀ i, v i = fun j ↦ divInt P4 (cellNumer3 sm (memberKey model key ((coords 3 i : Nat) : Int))
            (fun j' ↦ divInt A4 (alignNumer3 sm (memberKey model key ((coords 3 i : Nat) : Int))
              (ea ⟨coords 3 i, coords_lt 3 i⟩) ![ca0 ⟨coords 3 i, coords_lt 3 i⟩, ca1 ⟨coords 3 i, coords_lt 3 i⟩] j')) es
            (α ⟨coords 3 i, coords_lt 3 i⟩) ![![w.w_86_0, w.w_86_1], ![w.w_86_2, w.w_86_3]]
