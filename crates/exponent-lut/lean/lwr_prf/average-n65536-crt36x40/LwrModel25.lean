/-- The numerator `A v` of the alignment of a member of `a`: its error after the digits `H`, minus
the row residue, plus the mask-weighted key residues. -/
noncomputable def alignNumer25 (sm : ErrorPoly N) (mk : Fin 2 → Fin 2 → ExactMatrix Q36 N 1 144)
    (ea : Fin 2 → ErrorMatrix N 1 144) (row : Fin 2 → ExactMatrix Q36 N 1 144) (j : Fin 2) :
    ErrorMatrix N 1 44 :=
  ea j * liftMatrix alignDigits25 - downResidue A11 (row j * alignDigits25) +
    sm • downResidue A11 (mk 0 j * alignDigits25) + downResidue A11 (mk 1 j * alignDigits25)

/-- The numerator `p v` of a block-1 cell. -/
noncomputable def cellNumer25 (sm : ErrorPoly N) (mk : Fin 2 → Fin 2 → ExactMatrix Q36 N 1 144)
    (va : Fin 2 → ErrorMatrix N 1 44) (es : Fin 2 → ErrorMatrix N 1 40) (α : ErrorPoly N)
    (As : Fin 2 → Fin 2 → ExactMatrix Q11 N 1 40) (top bot : Fin 2 → ExactMatrix Q10 N 1 36)
    (crow : Fin 2 → ExactMatrix Q11 N 1 44) (cs : Fin 2 → ExactMatrix Q11 N 1 40)
    (pay : ExactMatrix Q11 N 1 1) (j : Fin 2) : ErrorMatrix N 1 36 :=
  pairMul (fun j' ↦ pairMul va (liftMatrix (pubDigits25 As j')) + α • es j')
      (liftMatrix (rhsDigits25 top bot j)) -
    downResidue P11 (pairMul (fun j' ↦ pairMul crow (pubDigits25 As j') +
      matrixMulScalarRight (cs j') pay) (rhsDigits25 top bot j)) +
    sm • downResidue P11 (cellKeyUp25 mk As top bot 0 j) + downResidue P11 (cellKeyUp25 mk As top bot 1 j)

