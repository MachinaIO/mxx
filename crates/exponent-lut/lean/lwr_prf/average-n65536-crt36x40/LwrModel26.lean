/-- The numerator `A v` of the alignment of a member of `a`: its error after the digits `H`, minus
the row residue, plus the mask-weighted key residues. -/
noncomputable def alignNumer26 (sm : ErrorPoly N) (mk : Fin 2 → Fin 2 → ExactMatrix Q36 N 1 144)
    (ea : Fin 2 → ErrorMatrix N 1 144) (row : Fin 2 → ExactMatrix Q36 N 1 144) (j : Fin 2) :
    ErrorMatrix N 1 40 :=
  ea j * liftMatrix alignDigits26 - downResidue A10 (row j * alignDigits26) +
    sm • downResidue A10 (mk 0 j * alignDigits26) + downResidue A10 (mk 1 j * alignDigits26)

/-- The numerator `p v` of a block-1 cell. -/
noncomputable def cellNumer26 (sm : ErrorPoly N) (mk : Fin 2 → Fin 2 → ExactMatrix Q36 N 1 144)
    (va : Fin 2 → ErrorMatrix N 1 40) (es : Fin 2 → ErrorMatrix N 1 36) (α : ErrorPoly N)
    (As : Fin 2 → Fin 2 → ExactMatrix Q10 N 1 36) (top bot : Fin 2 → ExactMatrix Q9 N 1 32)
    (crow : Fin 2 → ExactMatrix Q10 N 1 40) (cs : Fin 2 → ExactMatrix Q10 N 1 36)
    (pay : ExactMatrix Q10 N 1 1) (j : Fin 2) : ErrorMatrix N 1 32 :=
  pairMul (fun j' ↦ pairMul va (liftMatrix (pubDigits26 As j')) + α • es j')
      (liftMatrix (rhsDigits26 top bot j)) -
    downResidue P10 (pairMul (fun j' ↦ pairMul crow (pubDigits26 As j') +
      matrixMulScalarRight (cs j') pay) (rhsDigits26 top bot j)) +
    sm • downResidue P10 (cellKeyUp26 mk As top bot 0 j) + downResidue P10 (cellKeyUp26 mk As top bot 1 j)

