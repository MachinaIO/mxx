    (fam : Fin 2 → Fin 2 → Fin 16 → ExactMatrix Q3 N 1 1) (i : Nat) : Fin 2 → ExactMatrix Q4 N 1 1 :=
  if h : i < 16 then branchTarget (q := Q4) (p := P4) μ sp fam ⟨i, h⟩ else 0

