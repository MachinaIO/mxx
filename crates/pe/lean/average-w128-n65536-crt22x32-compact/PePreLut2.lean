        rowDigits (switchTopRow model key ⟨b, hb⟩) a ⟨(p : Nat) % 88, by omega⟩ else 0) else 0
  have hacc := IterRuns.accumulate (fun s : ExactMatrix Q N 1 1936 × ExactMatrix Q N 1 1936 × Unit ↦
      ![s.1, s.2.1] r 0 p) G (fun _ _ ↦ True) trivial
    (fun b s t hb _ hst ↦ ⟨by simp only [G, dif_pos hb]; exact lutTopStep hb hst r p, trivial⟩) h
  obtain ⟨hs, -⟩ := hacc
  dsimp only at hs
  rw [hs]
  congr 1
  rw [Finset.sum_eq_single ((p : Nat) / 88)]
  · simp only [G, dif_pos (show (p : Nat) / 88 < 22 by omega)]
    simp
  · intro b _ hb
    simp only [G]
    split_ifs with h1 h2
    · exact absurd h2.symm hb
    · rfl
    · rfl
  · intro hp
    exact absurd (Finset.mem_range.mpr (by omega)) hp

end PeProof.PreLut2
