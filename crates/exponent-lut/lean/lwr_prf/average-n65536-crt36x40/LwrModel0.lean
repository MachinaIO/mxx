    (hrhs : ∀ i : Fin 113, ∀ j,
      reducePoly Q35 N sp • rhsTop model key Q35 136 rhsPrefix0 i j + ![r00 i, r01 i] j =
        reducePoly Q35 N (((P35 : Nat) : Int) * ν i * unitPair sp j) • h +
