/-- The numerator `A v` of the alignment of a member of `a`: its error after the digits `H`, minus
the row residue, plus the mask-weighted key residues. -/
noncomputable def alignNumer1 (sm : ErrorPoly N) (mk : Fin 2 → Fin 2 → ExactMatrix Q7 N 1 14)
    (ea : Fin 2 → ErrorMatrix N 1 14) (row : Fin 2 → ExactMatrix Q7 N 1 14) (j : Fin 2) :
    ErrorMatrix N 1 12 :=
  ea j * liftMatrix alignDigits1 - downResidue A6 (row j * alignDigits1) +
    sm • downResidue A6 (mk 0 j * alignDigits1) + downResidue A6 (mk 1 j * alignDigits1)

/-- The numerator `p v` of a block-1 cell. -/
noncomputable def cellNumer1 (sm : ErrorPoly N) (mk : Fin 2 → Fin 2 → ExactMatrix Q7 N 1 14)
    (va : Fin 2 → ErrorMatrix N 1 12) (es : Fin 2 → ErrorMatrix N 1 10) (α : ErrorPoly N)
    (As : Fin 2 → Fin 2 → ExactMatrix Q6 N 1 10) (top bot : Fin 2 → ExactMatrix Q5 N 1 8)
    (crow : Fin 2 → ExactMatrix Q6 N 1 12) (cs : Fin 2 → ExactMatrix Q6 N 1 10)
    (pay : ExactMatrix Q6 N 1 1) (j : Fin 2) : ErrorMatrix N 1 8 :=
  pairMul (fun j' ↦ pairMul va (liftMatrix (pubDigits1 As j')) + α • es j')
      (liftMatrix (rhsDigits1 top bot j)) -
    downResidue P6 (pairMul (fun j' ↦ pairMul crow (pubDigits1 As j') +
      matrixMulScalarRight (cs j') pay) (rhsDigits1 top bot j)) +
    sm • downResidue P6 (cellKeyUp1 mk As top bot 0 j) + downResidue P6 (cellKeyUp1 mk As top bot 1 j)

set_option maxHeartbeats 16000000 in
set_option maxRecDepth 100000 in
/-- `block1E` with the cell and alignment errors as divisions of their numerators. -/
