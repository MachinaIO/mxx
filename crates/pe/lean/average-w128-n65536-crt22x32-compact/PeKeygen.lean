theorem slotList_eq (i : Nat) (hi : i < 128) :
    MxxIR.selectInt (Int.ofNat i) slotList = ((hIndex i : Nat) : Int) := by
  interval_cases i <;> rfl

/-- The inverse of slot `i`. -/
def slotInv (i : Nat) : Nat := (MxxIR.selectInt (Int.ofNat i) slotInvList).toNat

theorem slotInv_cast (i : Nat) (hi : i < 128) :
    ((slotInv i : Nat) : Int) = MxxIR.selectInt (Int.ofNat i) slotInvList := by
  interval_cases i <;> rfl

theorem slotInv_eq (i : Nat) (hi : i < 128) : slotInv i = hIndex ((128 - i) % 128) := by
  interval_cases i <;> rfl

/-- The pairing row of pair `p = 37 i + k`. -/
def pairRow (p : Nat) : Nat := (MxxIR.selectInt (Int.ofNat p) pairList).toNat

set_option maxRecDepth 200000 in
theorem pairList_nonneg : ∀ x ∈ pairList, 0 ≤ x := by decide

theorem pairRow_cast (p : Nat) :
    ((pairRow p : Nat) : Int) = MxxIR.selectInt (Int.ofNat p) pairList := by
  apply Int.toNat_of_nonneg
  unfold MxxIR.selectInt
  cases h : pairList[(Int.ofNat p).toNat]? with
  | none => simp
  | some x =>
    simp only [Option.getD_some]
    exact pairList_nonneg x (List.mem_of_getElem? h)

set_option maxRecDepth 200000 in
theorem pairList_lt : ∀ x ∈ pairList, x < 128 := by decide

theorem pairRow_lt (p : Nat) : pairRow p < 128 := by
  have h := pairRow_cast p
  unfold MxxIR.selectInt at h
  cases hx : pairList[(Int.ofNat p).toNat]? with
  | none => rw [hx] at h; simp at h; omega
  | some x =>
    rw [hx] at h
    simp only [Option.getD_some] at h
    have := pairList_lt x (List.mem_of_getElem? hx)
    omega

/-- The automorphism of slot `i`. -/
def slotAut (i : Nat) : Nat := (MxxIR.selectInt (Int.ofNat i) slotList).toNat

theorem slotAut_eq (i : Nat) (hi : i < 128) : slotAut i = hIndex i := by
  interval_cases i <;> rfl

theorem slotAut_odd (i : Fin 128) : Odd (slotAut i) := by
  rw [slotAut_eq i i.isLt]; exact hIndex_odd i

theorem slotInv_odd (i : Fin 128) : Odd (slotInv i) := by
  rw [slotInv_eq i i.isLt]; exact hIndex_odd _

theorem routing_slot {i : Nat} (hi : i < 128) {rows columns : Nat} {x y : ExactMatrix Q N rows columns}
    (h : ringAutomorphismRuns (MxxIR.selectInt (Int.ofNat i) slotList) x y) :
    y = substituteMatrix (slotAut i) (slotAut_odd ⟨i, hi⟩) x := by
  obtain ⟨hodd, hy⟩ := ringAutomorphismRuns_eq hQ hN h
  rw [hy]
  rfl

theorem routing_slotInv {i : Nat} (hi : i < 128) {rows columns : Nat} {x y : ExactMatrix Q N rows columns}
    (h : ringAutomorphismRuns (MxxIR.selectInt (Int.ofNat i) slotInvList) x y) :
    y = substituteMatrix (slotInv i) (slotInv_odd ⟨i, hi⟩) x := by
  obtain ⟨hodd, hy⟩ := ringAutomorphismRuns_eq hQ hN h
  rw [hy]
  rfl

/-- The joined row `[g | 0]`. -/
noncomputable def gZero : ExactMatrix Q N 1 88 := joinRow ![g0, 0]

/-- The helper term of pair `(i, k)` in row `i`: `σ_i(H_k^(1)) v_(i,k) - G^(1) v_(i k^-1, k)`. -/
noncomputable def helperTerm (model : HashModel) (key : ByteArray) (v : Fin 4736 → ExactMatrix Q N 88 1)
    (i : Fin 128) (k : Fin 37) : ExactMatrix Q N 1 1 :=
  substituteMatrix (slotAut i) (slotAut_odd i) (joinRow (helperKey model key (kHelp k) 0)) *
      v ⟨37 * i + k, by omega⟩ -
    gZero * v ⟨k + 37 * pairRow (37 * i + k), by have := pairRow_lt (37 * i + k); omega⟩

set_option maxHeartbeats 8000000 in
/-- One iteration `k` of the helper loop of slot `i` adds the helper term of pair `(i, k)`. -/
theorem helperStep {model : HashModel} {tape : SampleTape} {path : List Nat}
    {params : Stage_keygen.Params} {key : ByteArray} {v : Fin 4736 → ExactMatrix Q N 88 1}
    {i k : Nat} (hi : i < 128) (hk : k < 37) {s t : ExactMatrix Q N 1 1}
    (h : Stage_keygen.sequential_parallel_generatedRoot_23_8 Backend.backend model tape path params i k
      (s, (key, (v, (gZero, ())))) t) :
    t = s + helperTerm model key v ⟨i, hi⟩ ⟨k, hk⟩ := by
  obtain ⟨w2, w3, w4, w5, w8, w13, -, -, h2, -, -, h3, h4, -, -, h5, -, -, h8, -, -, -, -, h13, hout⟩ := h
  have hc := kHelp_cast k hk
  rw [← hc] at h2 h3
  have e2 : w2 = helperKey model key (kHelp k) 0 0 := helperKey_read (c := 0) (by norm_num) h2
  have e3 : w3 = helperKey model key (kHelp k) 0 1 := helperKey_read (c := 1) (by norm_num) h3
  rw [e2, e3] at h4
  have e4 : w4 = joinRow (helperKey model key (kHelp k) 0) := concat_joinRow (r := helperKey model key (kHelp k) 0) h4
  have e5 := routing_slot hi h5
  have hp : (37 * Int.ofNat i + Int.ofNat k) = Int.ofNat (37 * i + k) := by
    simp only [Int.ofNat_eq_natCast]; push_cast; ring
  rw [hp] at h8
  obtain ⟨_, e8⟩ := familyGet_eq h8
  have hq : Int.ofNat k + 37 * MxxIR.selectInt (Int.ofNat (37 * i + k)) pairList =
      Int.ofNat (k + 37 * pairRow (37 * i + k)) := by
    rw [← pairRow_cast]; simp only [Int.ofNat_eq_natCast]; push_cast; ring
  rw [hp, hq] at h13
  obtain ⟨_, e13⟩ := familyGet_eq h13
  subst hout e4 e5 e8 e13
  simp only [helperTerm, matrixAdd, matrixSub, matrixMul]
  abel

