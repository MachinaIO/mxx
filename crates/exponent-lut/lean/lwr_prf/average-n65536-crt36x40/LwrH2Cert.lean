/-- The average-case correctness claim under H2. -/
theorem certificateH2 (hH2 : LwrH2) : GeneratedClaim.CorrectnessClaim := by
  classical
  intro model external
  by_cases hrun : ∃ t e, GeneratedClaim.Runs model external t e
  swap
  · have hempty : {t | ∃ execution, GeneratedClaim.Runs model external t execution ∧
        ¬ execution.«stage_5» = execution.«ideal»} = ∅ := by
      ext t
      simp only [Set.mem_setOf_eq, Set.mem_empty_iff_false, iff_false]
      rintro ⟨e, hr, -⟩
      exact hrun ⟨t, e, hr⟩
    rw [hempty, MeasureTheory.measure_empty]
    exact zero_le _
  obtain ⟨t0, e0, hr0⟩ := hrun
  have hF := finalDigits_of_runs hr0
  have hsub : {t | ∃ execution, GeneratedClaim.Runs model external t execution ∧
      ¬ execution.«stage_5» = execution.«ideal»} ⊆
      {t | h2Threshold ≤ |remainder model external.input_0 external t +
        ∑ j, siteG model external.input_0 external j t * (siteRho model external.input_0 external j t : ℝ)|} := by
    rintro t ⟨e, hr, hne⟩
    simp only [Set.mem_setOf_eq]
    by_contra hlt
    push_neg at hlt
    rw [← decomposition model external.input_0 external t (divisible_of_runs hr)] at hlt
    exact hne (correct_of_small hr hlt)
  refine (MeasureTheory.measure_mono hsub).trans ?_
  refine (h2_tail siteIdx_injective (hH2 model external)
    (remainder_le model external.input_0 external hF) (by rw [h2Threshold]; norm_num) siteKeys
    (fun j ↦ residue_not_site _ _) (siteG_dependsOn model external.input_0 external)
    (energyRow_le model external.input_0 external hF) [1, 0] preKeys (fun k ↦ mask_not_pre _)
    (fun x ↦ uKey_dependsOn model external.input_0 external x)
    (fun x t ↦ keyForm model external.input_0 external t x)
    (τ := 14) (by norm_num) (energyKey_le model external.input_0 external hF) (by norm_num)).trans ?_
  have hcard : Fintype.card KeySite = 37146329088 := by
    simp only [KeySite, Fintype.card_sum, Fintype.card_prod, Fintype.card_fin, N]
  rw [hcard]
  refine ennreal_tail_le (by positivity) (by positivity) ?_
  have h1 : 2 * Real.exp (-(14 : ℝ) ^ 2 / 2) ≤ 2 * (10 / 27 : ℝ) ^ 98 := by
    have := exp_le_of_le_neg_nat 98 (x := -(14 : ℝ) ^ 2 / 2) (by norm_num)
    linarith
  have h2 : 2 * Real.exp (-(h2Threshold - (102738144 : ℝ)) ^ 2 / (2 * (((8759931 : ℝ) / 8) + (14063798059008 : ℝ)))) ≤
      2 * (10 / 27 : ℝ) ^ 71 := by
    have := exp_le_of_le_neg_nat 71
      (x := -(h2Threshold - (102738144 : ℝ)) ^ 2 / (2 * (((8759931 : ℝ) / 8) + (14063798059008 : ℝ))))
      (by rw [h2Threshold]; norm_num)
    linarith
  calc (37146329088 : ℕ) * (2 * Real.exp (-(14 : ℝ) ^ 2 / 2)) +
        2 * Real.exp (-(h2Threshold - (102738144 : ℝ)) ^ 2 / (2 * (((8759931 : ℝ) / 8) + (14063798059008 : ℝ))))
      ≤ (37146329088 : ℕ) * (2 * (10 / 27 : ℝ) ^ 98) + 2 * (10 / 27 : ℝ) ^ 71 := by
        gcongr
    _ ≤ (1 / 2 : ℝ) ^ 100 := by norm_num

