/-- The numerator `A v` of the alignment of a member of `a`: its error after the digits `H`, minus
the row residue, plus the mask-weighted key residues. -/
noncomputable def alignNumer16 (sm : ErrorPoly N) (mk : Fin 2 → Fin 2 → ExactMatrix Q36 N 1 144)
    (ea : Fin 2 → ErrorMatrix N 1 144) (row : Fin 2 → ExactMatrix Q36 N 1 144) (j : Fin 2) :
    ErrorMatrix N 1 80 :=
  ea j * liftMatrix alignDigits16 - downResidue A20 (row j * alignDigits16) +
    sm • downResidue A20 (mk 0 j * alignDigits16) + downResidue A20 (mk 1 j * alignDigits16)

/-- The numerator `p v` of a block-1 cell. -/
noncomputable def cellNumer16 (sm : ErrorPoly N) (mk : Fin 2 → Fin 2 → ExactMatrix Q36 N 1 144)
    (va : Fin 2 → ErrorMatrix N 1 80) (es : Fin 2 → ErrorMatrix N 1 76) (α : ErrorPoly N)
    (As : Fin 2 → Fin 2 → ExactMatrix Q20 N 1 76) (top bot : Fin 2 → ExactMatrix Q19 N 1 72)
    (crow : Fin 2 → ExactMatrix Q20 N 1 80) (cs : Fin 2 → ExactMatrix Q20 N 1 76)
    (pay : ExactMatrix Q20 N 1 1) (j : Fin 2) : ErrorMatrix N 1 72 :=
  pairMul (fun j' ↦ pairMul va (liftMatrix (pubDigits16 As j')) + α • es j')
      (liftMatrix (rhsDigits16 top bot j)) -
    downResidue P20 (pairMul (fun j' ↦ pairMul crow (pubDigits16 As j') +
      matrixMulScalarRight (cs j') pay) (rhsDigits16 top bot j)) +
    sm • downResidue P20 (cellKeyUp16 mk As top bot 0 j) + downResidue P20 (cellKeyUp16 mk As top bot 1 j)

