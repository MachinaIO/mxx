import LwrH2Model

/-!
# The bounds of the H2 decomposition

Generated by `generator/gen_h2_bounds.py`. On every tape: the `l1` norms of the weights entering
every block, the remainder of the decoded coefficient, the energy of the row sites, and the mask
forms of the key sites with their energy. The finalization digits enter through `FinalDigits`,
which every run establishes.
-/

namespace LwrProof

open Mxx.Primitives MxxRuntime MxxExponentLut

/-- The finalization digits `G⁻¹(k)` have column `l1` norm at most `(1048576 : ℝ)`. -/
def FinalDigits : Prop :=
  ∀ c, ∑ l, ∑ j, |(((finalDigits l c).coeff j : ℤ) : ℝ)| ≤ (1048576 : ℝ)

theorem abs_add_bound {x y bx by' : ℝ} (hx : |x| ≤ bx) (hy : |y| ≤ by') : |x + y| ≤ bx + by' :=
  (abs_add_le x y).trans (add_le_add hx hy)

section H2Bounds

variable (model : HashModel) (key : ByteArray) (ext : GeneratedClaim.ExternalInputs)

