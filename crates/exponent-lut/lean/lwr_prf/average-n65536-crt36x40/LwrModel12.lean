/-- The numerator `A v` of the alignment of a member of `a`: its error after the digits `H`, minus
the row residue, plus the mask-weighted key residues. -/
noncomputable def alignNumer12 (sm : ErrorPoly N) (mk : Fin 2 → Fin 2 → ExactMatrix Q36 N 1 144)
    (ea : Fin 2 → ErrorMatrix N 1 144) (row : Fin 2 → ExactMatrix Q36 N 1 144) (j : Fin 2) :
    ErrorMatrix N 1 96 :=
  ea j * liftMatrix alignDigits12 - downResidue A24 (row j * alignDigits12) +
    sm • downResidue A24 (mk 0 j * alignDigits12) + downResidue A24 (mk 1 j * alignDigits12)

/-- The numerator `p v` of a block-1 cell. -/
noncomputable def cellNumer12 (sm : ErrorPoly N) (mk : Fin 2 → Fin 2 → ExactMatrix Q36 N 1 144)
    (va : Fin 2 → ErrorMatrix N 1 96) (es : Fin 2 → ErrorMatrix N 1 92) (α : ErrorPoly N)
    (As : Fin 2 → Fin 2 → ExactMatrix Q24 N 1 92) (top bot : Fin 2 → ExactMatrix Q23 N 1 88)
    (crow : Fin 2 → ExactMatrix Q24 N 1 96) (cs : Fin 2 → ExactMatrix Q24 N 1 92)
    (pay : ExactMatrix Q24 N 1 1) (j : Fin 2) : ErrorMatrix N 1 88 :=
  pairMul (fun j' ↦ pairMul va (liftMatrix (pubDigits12 As j')) + α • es j')
      (liftMatrix (rhsDigits12 top bot j)) -
    downResidue P24 (pairMul (fun j' ↦ pairMul crow (pubDigits12 As j') +
      matrixMulScalarRight (cs j') pay) (rhsDigits12 top bot j)) +
    sm • downResidue P24 (cellKeyUp12 mk As top bot 0 j) + downResidue P24 (cellKeyUp12 mk As top bot 1 j)

