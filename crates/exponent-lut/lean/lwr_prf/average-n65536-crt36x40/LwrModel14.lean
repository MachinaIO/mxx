/-- The numerator `A v` of the alignment of a member of `a`: its error after the digits `H`, minus
the row residue, plus the mask-weighted key residues. -/
noncomputable def alignNumer14 (sm : ErrorPoly N) (mk : Fin 2 → Fin 2 → ExactMatrix Q36 N 1 144)
    (ea : Fin 2 → ErrorMatrix N 1 144) (row : Fin 2 → ExactMatrix Q36 N 1 144) (j : Fin 2) :
    ErrorMatrix N 1 88 :=
  ea j * liftMatrix alignDigits14 - downResidue A22 (row j * alignDigits14) +
    sm • downResidue A22 (mk 0 j * alignDigits14) + downResidue A22 (mk 1 j * alignDigits14)

/-- The numerator `p v` of a block-1 cell. -/
noncomputable def cellNumer14 (sm : ErrorPoly N) (mk : Fin 2 → Fin 2 → ExactMatrix Q36 N 1 144)
    (va : Fin 2 → ErrorMatrix N 1 88) (es : Fin 2 → ErrorMatrix N 1 84) (α : ErrorPoly N)
    (As : Fin 2 → Fin 2 → ExactMatrix Q22 N 1 84) (top bot : Fin 2 → ExactMatrix Q21 N 1 80)
    (crow : Fin 2 → ExactMatrix Q22 N 1 88) (cs : Fin 2 → ExactMatrix Q22 N 1 84)
    (pay : ExactMatrix Q22 N 1 1) (j : Fin 2) : ErrorMatrix N 1 80 :=
  pairMul (fun j' ↦ pairMul va (liftMatrix (pubDigits14 As j')) + α • es j')
      (liftMatrix (rhsDigits14 top bot j)) -
    downResidue P22 (pairMul (fun j' ↦ pairMul crow (pubDigits14 As j') +
      matrixMulScalarRight (cs j') pay) (rhsDigits14 top bot j)) +
    sm • downResidue P22 (cellKeyUp14 mk As top bot 0 j) + downResidue P22 (cellKeyUp14 mk As top bot 1 j)

