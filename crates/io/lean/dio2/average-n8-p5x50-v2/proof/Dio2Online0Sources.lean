noncomputable def row3 {q n columns : Nat} (matrix : ExactMatrix q n 3 columns)
    (row : Fin 3) : ExactMatrix q n 1 columns := fun _ column ↦ matrix row column

noncomputable def stateKeys {model : HashModel} {params : Params}
    (online : generatedRoot.Ctx Backend.backend model params) :
    Fin 2 → Fin 2 → ExactMatrix modulus_0 8 1 25 :=
  fun key component ↦ ![
      ![(generatedRoot.w_160_2 online) + row3 ((generatedRoot.w_170_0 online) * (generatedRoot.w_188_0 online)) 1,
        (generatedRoot.w_160_4 online) + row3 ((generatedRoot.w_170_0 online) * (generatedRoot.w_188_0 online)) 2],
      ![(generatedRoot.w_160_3 online) + row3 ((generatedRoot.w_170_0 online) * (generatedRoot.w_208_0 online)) 1,
        (generatedRoot.w_160_5 online) + row3 ((generatedRoot.w_170_0 online) * (generatedRoot.w_208_0 online)) 2]] component key

/-- All computed source relations under the same retained initial mask. -/
structure Relations {model : HashModel} {params : Params}
    (online : generatedRoot.Ctx Backend.backend model params)
    (anchor : ExactMatrix modulus_0 8 2 54)
    (old payload next result : ErrorPoly 8)
    (fresh : Fin 900 → ErrorPoly 8)
    (smudge : Fin 4500 → ErrorPoly 8) : Prop where
  next_small : polyNorm next ≤ 1
  fresh_small : ∀ cell, polyNorm (fresh cell) ≤ 8
  smudge_odd : ∀ cell coefficient,
    Odd ((smudge cell).coeff coefficient)
  smudge_support : ∀ cell coefficient,
    |(smudge cell).coeff coefficient| ≤ (8 : Int) - 1
  gadget : gadgetMatrixRuns Backend.backend 4096 25 (generatedRoot.w_57_0 online)
  hint : ∃ error : ErrorMatrix 8 1 54, CoeffBound error 1 ∧
    (generatedRoot.w_0_0 online) = maskPart (reducePoly modulus_0 8 old) (rowOf anchor) +
      reduceMatrix modulus_0 8 1 54 error
  sigma : EncRel old (sigmaRows online)
    (fun component ↦ reducePoly modulus_0 8
      (next * unitPair payload component) • (generatedRoot.w_57_0 online))
    Dio2NoiseCertificate.b1_packed
  g : ∃ error : ErrorMatrix 8 1 25,
    CoeffBound error Dio2NoiseCertificate.b1_g ∧
    (generatedRoot.w_63_0 online) = maskPart (reducePoly modulus_0 8 old) (sigmaKey online) -
      reducePoly modulus_0 8 next • (generatedRoot.w_57_0 online) +
        reduceMatrix modulus_0 8 1 25 error
  one : ∃ error : ErrorMatrix 8 1 25,
    CoeffBound error Dio2NoiseCertificate.b1_one ∧
    (generatedRoot.w_70_0 online) = maskPart (reducePoly modulus_0 8 old) (oneKey online) -
      (generatedRoot.w_57_0 online) + reduceMatrix modulus_0 8 1 25 error
  state : Rel old (stateKeys online)
    (fun component ↦ reducePoly modulus_0 8
      (result * unitPair payload component) • (generatedRoot.w_72_0 online))
    ![(generatedRoot.w_193_0 online), (generatedRoot.w_213_0 online)] Dio2NoiseCertificate.b1_state
  fresh : ∀ cell : Fin 900, EncRel old (blkT (m := 25) (C := 900) (freshRows online) cell)
    (fun component ↦ reducePoly modulus_0 8
      (fresh cell * unitPair payload component) • (generatedRoot.w_57_0 online))
    Dio2NoiseCertificate.b1_packed
  smudge : ∀ cell : Fin 4500, EncRel old (blkT (m := 25) (C := 4500) (smudgeRows online) cell)
    (fun component ↦ reducePoly modulus_0 8
      (smudge cell * unitPair payload component) • (generatedRoot.w_57_0 online))
    Dio2NoiseCertificate.b1_packed

end Online0Sources

/-- Computed targets of the actual run, retaining its State0 context. -/
def Online0SourceTargets (model : HashModel) (external : GeneratedClaim.ExternalInputs)
    (execution : GeneratedClaim.Execution) (state bit : Nat) : Prop :=
  ∃ initial : State0Witness model external execution (Xe (n := 8) (2 * state)),
    ∃ (next : ErrorPoly 8) (fresh : Fin 900 → ErrorPoly 8)
      (smudge : Fin 4500 → ErrorPoly 8),
      Online0Sources.Relations initial.context.online (execution.«stage_2».1)
        initial.mask initial.payload next
        (Xe (n := 8) (2 * (entry table0 ((state + bit : Nat) : Int)).toNat))
        fresh smudge

end Dio2Proof
