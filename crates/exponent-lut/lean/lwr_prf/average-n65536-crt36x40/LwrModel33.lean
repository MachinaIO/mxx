/-- The numerator `A v` of the alignment of a member of `a`: its error after the digits `H`, minus
the row residue, plus the mask-weighted key residues. -/
noncomputable def alignNumer33 (sm : ErrorPoly N) (mk : Fin 2 → Fin 2 → ExactMatrix Q36 N 1 144)
    (ea : Fin 2 → ErrorMatrix N 1 144) (row : Fin 2 → ExactMatrix Q36 N 1 144) (j : Fin 2) :
    ErrorMatrix N 1 12 :=
  ea j * liftMatrix alignDigits33 - downResidue A3 (row j * alignDigits33) +
    sm • downResidue A3 (mk 0 j * alignDigits33) + downResidue A3 (mk 1 j * alignDigits33)

/-- The numerator `p v` of a block-1 cell. -/
noncomputable def cellNumer33 (sm : ErrorPoly N) (mk : Fin 2 → Fin 2 → ExactMatrix Q36 N 1 144)
    (va : Fin 2 → ErrorMatrix N 1 12) (es : Fin 2 → ErrorMatrix N 1 8) (α : ErrorPoly N)
    (As : Fin 2 → Fin 2 → ExactMatrix Q3 N 1 8) (top bot : Fin 2 → ExactMatrix Q2 N 1 4)
    (crow : Fin 2 → ExactMatrix Q3 N 1 12) (cs : Fin 2 → ExactMatrix Q3 N 1 8)
    (pay : ExactMatrix Q3 N 1 1) (j : Fin 2) : ErrorMatrix N 1 4 :=
  pairMul (fun j' ↦ pairMul va (liftMatrix (pubDigits33 As j')) + α • es j')
      (liftMatrix (rhsDigits33 top bot j)) -
    downResidue P3 (pairMul (fun j' ↦ pairMul crow (pubDigits33 As j') +
      matrixMulScalarRight (cs j') pay) (rhsDigits33 top bot j)) +
    sm • downResidue P3 (cellKeyUp33 mk As top bot 0 j) + downResidue P3 (cellKeyUp33 mk As top bot 1 j)

