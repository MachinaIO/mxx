      F.c3.h49_0 F.c3.h50_0 F.c3.h52_0 F.c3.h53_0) F.c3.h55_3
    have S20 := PreSum0.sumLeaf (model := model) (tape := tape) (path := path) (params := params) (member_init (n := 13) F.c3.h57_0 F.c3.h58_0 F.c3.h60_0 F.c3.h61_0 F.c3.h63_0 F.c3.h64_0 F.c3.h66_0 F.c3.h67_0) F.c3.h69_3
    have S21 := PreSum0.sumLeafG1 (model := model) (tape := tape) (path := path) (params := params) (member_init (n := 13) F.c3.h71_0 F.c3.h72_0 F.c3.h74_0 F.c3.h75_0 F.c3.h77_0 F.c4.h78_0 F.c4.h80_0 F.c4.h81_0) F.c4.h83_3
