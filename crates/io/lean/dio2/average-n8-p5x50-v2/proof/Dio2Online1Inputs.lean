noncomputable def online1Labels (external : GeneratedClaim.ExternalInputs)
    (member : Fin 2) : ErrorPoly 8 :=
  message (external.input_11 member) (external.input_12 member)

/-- Imported root relations under a common mask and gadget. No computed LUT or PRF is assumed. -/
structure Online1Roots {model : HashModel} {params : Params}
    (online : generatedRoot.Ctx Backend.backend model params)
    (anchor : ExactMatrix modulus_0 8 2 54)
    (sm sp value : ErrorPoly 8) (labelValue : Fin 2 → ErrorPoly 8)
    (gadget : ExactMatrix modulus_0 8 1 25) : Prop where
  labels : ∀ member : Fin 2, MxxExponentLut.Rel sm
    (labelKeysG model (generatedRoot.w_14_0 online) modulus_0 25
      online1PrfLabelPre member)
    (fun port ↦ reducePoly modulus_0 8 (labelValue member * unitPair sm port) • gadget)
    ![generatedRoot.w_16_0 online member, generatedRoot.w_27_0 online member] (8 + 2)
  payload : ∀ member, generatedRoot.w_47_0 online member =
    fun _ _ ↦ reducePoly modulus_0 8 (labelValue member)
  state : Rel sm
    (keyPairG model (generatedRoot.w_14_0 online) modulus_0 25 online1_statePre [])
    (fun port ↦ reducePoly modulus_0 8 (value * unitPair sp port) • gadget)
    ![generatedRoot.w_46_0 online, generatedRoot.w_63_0 online] (8 + 2)
  privateUnit : Rel sm
    ![![generatedRoot.w_141_0 online, generatedRoot.w_144_0 online],
      ![generatedRoot.w_142_0 online, generatedRoot.w_145_0 online]]
    (fun port ↦ reducePoly modulus_0 8 (unitPair sp port) • gadget)
    ![generatedRoot.w_143_0 online, generatedRoot.w_146_0 online] (8 + 2)
  stateHelpers : ∀ branch, Rel sm
    (keyPairG model (generatedRoot.w_14_0 online) modulus_0 25 online1HelperPre
      [.integer (sigmaOf sigmas4 branch)])
    (fun port ↦ reducePoly modulus_0 8
      (unitPair (substitution (sigmaOf sigmas4 branch).toNat
        (sigmas4_odd branch) sm) port) • gadget)
    ![generatedRoot.w_13_0 online branch, generatedRoot.w_15_0 online branch] (8 + 2)
  smudgeHelpers : ∀ branch, Rel sm
    (keyPairG model (generatedRoot.w_14_0 online) modulus_0 25 online1PrfHelperPre
      [.integer (sigmaOf online1Sigmas branch)])
    (fun port ↦ reducePoly modulus_0 8
      (unitPair (substitution (sigmaOf online1Sigmas branch).toNat
        (online1Sigmas_odd branch) sm) port) • gadget)
    ![generatedRoot.w_137_0 online branch, generatedRoot.w_138_0 online branch] (8 + 2)
  hint : ∃ error : ErrorMatrix 8 1 54,
    CoeffBound error (8 + 2) ∧ generatedRoot.w_0_0 online =
      maskPart (reducePoly modulus_0 8 sm) (rowOf anchor) +
        reduceMatrix modulus_0 8 1 54 error

/-- The refreshed state invariant, quantified over compatible online witnesses.
Preprocessing and public selector/Walsh semantics are discharged separately. -/
def State1 (model : HashModel) (external : GeneratedClaim.ExternalInputs)
    (execution : GeneratedClaim.Execution) (state : ErrorPoly 8) : Prop :=
  ∃ (sm sp : ErrorPoly 8) (gadget : ExactMatrix modulus_0 8 1 25),
    polyNorm sm ≤ 1 ∧ polyNorm sp ≤ 1 ∧ gadgetMatrixRuns Backend.backend 4096 25 gadget ∧
    execution.«stage_0» = (fun _ _ ↦ reducePoly modulus_0 8 sp) ∧
    ∀ online : generatedRoot.Ctx Backend.backend model W_GeneratedClaim.stage_17_params,
      online.inputs = online1ClaimInputs external execution →
      generatedRoot.Facts online execution.«stage_17» →
      Online1Roots online execution.«stage_1».2.2.1 sm sp state
        (online1Labels external) gadget

end Dio2Proof
