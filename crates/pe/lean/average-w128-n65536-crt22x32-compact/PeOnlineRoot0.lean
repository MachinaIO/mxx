        (1 + (leafIndex parent member).val % 15) % 4, by omega⟩
      ⟨(leafIndex parent member).val / 15, by omega⟩ = leafFamilies0_0 ctx parent.succ member
    have hs : (⟨4 * ((1 + (leafIndex parent member).val % 15) / 4) +
        (1 + (leafIndex parent member).val % 15) % 4, by omega⟩ : Fin 16) = parent.succ :=
      Fin.ext (by simp only [leafIndex_mod, Fin.val_succ]; omega)
    have hm : (⟨(leafIndex parent member).val / 15, by omega⟩ : Fin 7) = member :=
      Fin.ext (leafIndex_div parent member)
