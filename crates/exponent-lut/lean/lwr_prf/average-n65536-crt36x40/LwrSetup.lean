theorem sigma_mod (i : Fin 128) : (sigma i).toNat % 256 = 1 + 2 * (sigmaResidue i).val := by
  fin_cases i <;> decide

/-- The LUT variable `Y = X^512` of stride `512`; `Y^128 = -1`. -/
noncomputable abbrev Y (q : Nat) : ExactPoly q N := X q ^ 512

theorem Y_pow_128 {q : Nat} : Y q ^ 128 = -1 := by
  rw [Y, ← pow_mul]
  exact Negacyclic.root_pow_n

/-- The half-integer readout value `2 τ(k) - 1`, `τ(k) = ⌊16 k / 128⌋ + 1`, as a constant. -/
noncomputable def readoutPoly (q : Nat) (k : Fin 128) : ExactPoly q N :=
  ((MxxExponentLutLwr.halfIntegerReadout 16 128 k.val : Nat) : ExactPoly q N)

/-- The coefficient `C_σ = W⁻¹ Σ_k (2 τ(k) - 1) σ(Y^(-k))` of the readout LUT. -/
noncomputable def lutCoefficient (q inverse : Nat) (σ : Nat) : ExactPoly q N :=
  lutFourierCoefficient 128 (Y q) (inverse : ExactPoly q N) (readoutPoly q) σ

set_option maxHeartbeats 4000000 in
/-- The readout LUT on every exponent `z`:
`Σ_i σ_i(Y^z) C_i = Y^(z - z mod 128) (2 τ(z mod 128) - 1)`. -/
theorem lut_walsh {q inverse : Nat}
    (hinverse : (inverse : ExactPoly q N) * ((128 : Nat) : ExactPoly q N) = 1) (z : Nat) :
    ∑ i : Fin 128, Y q ^ ((sigma i).toNat * z) * lutCoefficient q inverse (sigma i).toNat =
      Y q ^ (z - z % 128) * readoutPoly q ⟨z % 128, Nat.mod_lt _ (by norm_num)⟩ := by
  have h := lut_fourier_interpolation (R := ExactPoly q N) 7 128 1 z (Y q) (inverse : ExactPoly q N)
    (readoutPoly q) (by norm_num) (by norm_num) Y_pow_128 hinverse
    (fun i ↦ (sigma i).toNat) sigmaResidue (fun i ↦ by simpa using sigma_mod i)
  simpa [lutCoefficient] using h

/-- `X^(131072 k) = 1`. -/
theorem X_pow_period {q : Nat} (k : Nat) : X (n := N) q ^ (131072 * k) = 1 := by
  have hroot : X (n := N) q ^ 65536 = -1 := Negacyclic.root_pow_n
  rw [pow_mul, show X (n := N) q ^ 131072 = (X q ^ 65536) ^ 2 by rw [← pow_mul], hroot]
  simp

set_option maxHeartbeats 4000000 in
/-- The coefficient in the form the graph computes it: `σ(Y^0) = 1` and
`σ(Y^(-k)) = σ(-X^(65536 - 512k)) = -X^(σ (65536 - 512k))`. -/
theorem lutCoefficient_eq {q inverse σ : Nat} (hσ : Odd σ) :
    lutCoefficient q inverse σ = (inverse : ExactPoly q N) *
      ∑ k : Fin 128, readoutPoly q k * (if k.val = 0 then 1 else -X q ^ (σ * (65536 - 512 * k.val))) := by
  unfold lutCoefficient lutFourierCoefficient
  congr 1
  apply Finset.sum_congr rfl
  intro k _
  congr 1
  rw [Y, ← pow_mul]
  split
  · rename_i hk
    rw [hk, show 512 * (σ * (2 * 128 - 0)) = 131072 * σ by ring, X_pow_period]
  · have hsplit : 512 * (σ * (2 * 128 - k.val)) = σ * (65536 - 512 * k.val) + 65536 * σ := by
      have := k.isLt
      rw [Nat.mul_comm 65536 σ, ← Nat.mul_add, Nat.mul_left_comm]
      congr 1
      omega
    have hroot : X (n := N) q ^ 65536 = -1 := Negacyclic.root_pow_n
    rw [hsplit, pow_add, pow_mul (X q) 65536 σ, hroot, hσ.neg_one_pow]
    ring

/-- `lutCoefficient_eq` as a sum over `Finset.range 128`, whose terms have literal indices once
expanded. -/
theorem lutCoefficient_range {q inverse σ : Nat} (hσ : Odd σ) :
    lutCoefficient q inverse σ = (inverse : ExactPoly q N) *
      ∑ k ∈ Finset.range 128, ((MxxExponentLutLwr.halfIntegerReadout 16 128 k : Nat) : ExactPoly q N) *
        (if k = 0 then 1 else -X q ^ (σ * (65536 - 512 * k))) := by
  rw [lutCoefficient_eq hσ, ← Fin.sum_univ_eq_sum_range (fun k ↦
    ((MxxExponentLutLwr.halfIntegerReadout 16 128 k : Nat) : ExactPoly q N) *
      (if k = 0 then 1 else -X q ^ (σ * (65536 - 512 * k)))) 128]
  rfl

theorem polyNorm_substitution_Xe (i : Fin 128) (k : Nat) :
    polyNorm (substitution (sigma i).toNat (sigma_odd i) (Xe (n := N) k)) ≤ 1 := by
  rw [substitution_root_pow]
  exact polyNorm_Xe hN1 _

/-- The half-integer readout of the exponent `z`: `(-1)^⌊z / 128⌋ (2 τ(z mod 128) - 1)`. -/
noncomputable def lutValue (z : Nat) : ErrorPoly N :=
  (((-1 : Int) ^ (z / 128) * (MxxExponentLutLwr.halfIntegerReadout 16 128 (z % 128) : Int) : Int) :
    ErrorPoly N)

set_option maxHeartbeats 4000000 in
/-- The readout LUT on the state `X^(512z)`. -/
theorem lut_walsh_value {q inverse : Nat}
    (hinverse : (inverse : ExactPoly q N) * ((128 : Nat) : ExactPoly q N) = 1) (z : Nat) :
    ∑ i : Fin 128, reducePoly q N (substitution (sigma i).toNat (sigma_odd i) (Xe (512 * z))) *
        lutCoefficient q inverse (sigma i).toNat = reducePoly q N (lutValue z) := by
  have h := lut_walsh hinverse z
  have hY : Y q ^ (z - z % 128) = (-1) ^ (z / 128) := by
    rw [show z - z % 128 = 128 * (z / 128) by have := Nat.div_add_mod z 128; omega, pow_mul, Y_pow_128]
  rw [hY] at h
  have hvalue : reducePoly q N (lutValue z) =
      (-1) ^ (z / 128) * readoutPoly q ⟨z % 128, Nat.mod_lt _ (by norm_num)⟩ := by
    simp [lutValue, readoutPoly]
  rw [hvalue, ← h]
  apply Finset.sum_congr rfl
  intro i _
  rw [substitution_root_pow, reducePoly_Xe, Y, ← pow_mul]
  congr 2
  ring

/-- The inverse of the LUT width `128` modulo `Q1`. -/
abbrev inverse1 : Nat := 1090920132609

theorem inverse1_mul : (inverse1 : ExactPoly Q1 N) * ((128 : Nat) : ExactPoly Q1 N) = 1 :=
  inverse_mul (k := 127) (by norm_num)

