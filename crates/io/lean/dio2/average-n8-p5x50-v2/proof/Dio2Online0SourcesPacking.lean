theorem online0_source_targets {model : HashModel} {external : GeneratedClaim.ExternalInputs}
    {execution : GeneratedClaim.Execution}
    (hrun : W_GeneratedClaim.Runs model external execution)
    (state bit : Nat) (hstate : state ≤ 1) (hbit : bit ≤ 1)
    (hinput : State0 model external execution (Xe (n := 8) (2 * state)))
    (hlabel : Label model external execution 0 (Xe (n := 8) (2 * bit))) :
    Online0SourceTargets model external execution state bit := by
  obtain ⟨initial⟩ := hinput
  obtain ⟨next, hnext, hsigma⟩ := Online0Sources.sigma_source hrun initial
  obtain ⟨fresh, hfresh, hfreshRelation⟩ := Online0Sources.cbd_source hrun initial
  obtain ⟨smudge, ⟨hodd, hsupport⟩, hsmudge⟩ := Online0Sources.smudge_source hrun initial
  exact ⟨initial, next, fresh, smudge, {
    next_small := hnext
    fresh_small := hfresh
    smudge_odd := hodd
    smudge_support := hsupport
    gadget := Online0Sources.actual_gadget initial
    hint := Online0Sources.actual_hint hrun initial
    sigma := hsigma
    g := Online0Sources.g_source initial hsigma
    one := Online0Sources.one_source hrun initial
    state := Online0Sources.state_source hrun state bit hstate hbit initial hlabel
    fresh := hfreshRelation
    smudge := hsmudge }⟩

end Dio2Proof
