import LwrModelBase
import LwrBlockE0

/-!
# The model of block 0

Generated by `generator/gen_model.py`: the numerators of block `0`, `block0E` with its errors as
their divisions, and the keys, rows and errors of the model that block `0` produces.
-/

namespace LwrProof

open Mxx.Primitives MxxRuntime MxxExponentLut

variable {tape : SampleTape} {path : List Nat}

/-! ## Cell numerators -/

/-- The numerator `p v` of a block-0 cell: the member error and the state error after the public
digits, after the private digits, minus the row residue, plus the mask-weighted key residues. -/
noncomputable def cellNumer0 (sm : ErrorPoly N) (mk : Fin 2 → Fin 2 → ExactMatrix Q7 N 1 14)
    (ea : Fin 2 → ErrorMatrix N 1 14) (es : Fin 2 → ErrorMatrix N 1 12) (α : ErrorPoly N)
    (As : Fin 2 → Fin 2 → ExactMatrix Q7 N 1 12) (top bot : Fin 2 → ExactMatrix Q6 N 1 10)
    (crow : Fin 2 → ExactMatrix Q7 N 1 14) (cs : Fin 2 → ExactMatrix Q7 N 1 12)
    (pay : ExactMatrix Q7 N 1 1) (j : Fin 2) : ErrorMatrix N 1 10 :=
  pairMul (fun j' ↦ pairMul ea (liftMatrix (pubDigits0 As j')) + α • es j')
      (liftMatrix (rhsDigits0 top bot j)) -
    downResidue P7 (pairMul (fun j' ↦ pairMul crow (pubDigits0 As j') +
      matrixMulScalarRight (cs j') pay) (rhsDigits0 top bot j)) +
    sm • downResidue P7 (cellKeyUp0 mk As top bot 0 j) + downResidue P7 (cellKeyUp0 mk As top bot 1 j)

set_option maxHeartbeats 16000000 in
set_option maxRecDepth 100000 in
/-- `block0E` with the cell errors as divisions of their numerators. -/
theorem block0M {model : HashModel} {key : ByteArray}
    {s0 s1 s2 s3 : Fin 16 → ExactMatrix Q1 N 1 2} {k0 k1 : Fin 16 → ExactMatrix Q2 N 1 2}
    {ca0 ca1 : Fin 17 → ExactMatrix Q7 N 1 14} {cs0 cs1 : ExactMatrix Q7 N 1 12}
    {apay : Fin 17 → ExactMatrix Q7 N 1 1}
    {r00 r01 : Fin 14 → ExactMatrix Q6 N 1 10} {r10 r11 : Fin 14 → ExactMatrix Q5 N 1 8}
    {r20 r21 : Fin 14 → ExactMatrix Q4 N 1 6} {r30 r31 : Fin 14 → ExactMatrix Q3 N 1 4}
    {r40 r41 : Fin 14 → ExactMatrix Q2 N 1 2} {outputs} {w : Stage_online_eval.generatedRoot.Witness}
    (hb : Stage_online_eval.generatedRoot.body Backend.backend model tape path GeneratedClaim.stage_4_params
      (s0, s1, s2, s3, k0, key, k1, ca0, ca1, cs0, apay, cs1, r00, r01, r10, r11, r20, r21, r30, r31,
        r40, r41, ()) outputs w)
    {sm sp μ : ErrorPoly N} {α : Fin 17 → ErrorPoly N} {ν : Fin 14 → ErrorPoly N}
    {G : ExactMatrix Q7 N 1 14} (hG : gadgetMatrixRuns Backend.backend 1048576 14 G)
    {g' : ExactMatrix Q6 N 1 12} {g : ExactMatrix Q7 N 1 12}
    (hg' : gadgetMatrixRuns Backend.backend 1048576 12 g') (hg : centeredRebaseRuns g' g)
    {h : ExactMatrix Q6 N 1 10}
    {ea : Fin 17 → Fin 2 → ErrorMatrix N 1 14}
    (ha : ∀ k : Fin 17, RelE sm (memberKey model key k)
      (fun j ↦ reducePoly Q7 N (α k * unitPair sm j) • G) ![ca0 k, ca1 k] (ea k))
    (hpay : ∀ k : Fin 17, apay k = fun _ _ ↦ reducePoly Q7 N (α k))
    {es : Fin 2 → ErrorMatrix N 1 12}
    (hs : RelE sm (stateKey model key)
      (fun j ↦ reducePoly Q7 N (((P7 : Nat) : Int) * μ * unitPair sp j) • g) ![cs0, cs1] es)
    {eB : Fin 14 → Fin 2 → ErrorMatrix N 1 10}
    (hrhs : ∀ i : Fin 14, ∀ j,
      reducePoly Q6 N sp • rhsTop model key Q6 10 rhsPrefix0 i j + ![r00 i, r01 i] j =
        reducePoly Q6 N (((P6 : Nat) : Int) * ν i * unitPair sp j) • h + reduceMatrix Q6 N 1 10 (eB i j)) :
    (![![w.w_42_0, w.w_42_1], ![w.w_42_2, w.w_42_3]] = ∑ i : Fin 14, fun k j ↦
      theOutput (blockModSwitchRuns [1099511626049, 1099511625409, 1099511623297, 1099511622593, 1099511622529, 1099511621249, 1099511619841] 1)
        (cellKeyUp0 (memberKey model key ((coords 0 i : Nat) : Int)) (stateKey model key)
          (rhsTop model key Q6 10 rhsPrefix0 i) ![r00 i, r01 i] k j)) ∧
      (∀ i j row column, (cellNumer0 sm (memberKey model key ((coords 0 i : Nat) : Int))
            (ea ⟨coords 0 i, coords_lt 0 i⟩) es
            (α ⟨coords 0 i, coords_lt 0 i⟩) (stateKey model key)
            (rhsTop model key Q6 10 rhsPrefix0 i) ![r00 i, r01 i]
            ![ca0 ⟨coords 0 i, coords_lt 0 i⟩, ca1 ⟨coords 0 i, coords_lt 0 i⟩]
            ![cs0, cs1] (apay ⟨coords 0 i, coords_lt 0 i⟩) j) row column =
        ((P7 : Int) : ErrorPoly N) * divInt P7 (cellNumer0 sm (memberKey model key ((coords 0 i : Nat) : Int))
            (ea ⟨coords 0 i, coords_lt 0 i⟩) es
            (α ⟨coords 0 i, coords_lt 0 i⟩) (stateKey model key)
            (rhsTop model key Q6 10 rhsPrefix0 i) ![r00 i, r01 i]
            ![ca0 ⟨coords 0 i, coords_lt 0 i⟩, ca1 ⟨coords 0 i, coords_lt 0 i⟩]
            ![cs0, cs1] (apay ⟨coords 0 i, coords_lt 0 i⟩) j) row column) ∧
      RelE sm ![![w.w_42_0, w.w_42_1], ![w.w_42_2, w.w_42_3]]
        (∑ i : Fin 14, fun j ↦ reducePoly Q6 N (((P6 : Nat) : Int) *
          (α ⟨coords 0 i, coords_lt 0 i⟩ * μ * ν i) * unitPair sp j) • h)
        ![w.w_42_4, w.w_42_5]
        (∑ i : Fin 14, fun j ↦ divInt P7 (cellNumer0 sm (memberKey model key ((coords 0 i : Nat) : Int))
            (ea ⟨coords 0 i, coords_lt 0 i⟩) es
            (α ⟨coords 0 i, coords_lt 0 i⟩) (stateKey model key)
            (rhsTop model key Q6 10 rhsPrefix0 i) ![r00 i, r01 i]
            ![ca0 ⟨coords 0 i, coords_lt 0 i⟩, ca1 ⟨coords 0 i, coords_lt 0 i⟩]
            ![cs0, cs1] (apay ⟨coords 0 i, coords_lt 0 i⟩) j) - (α ⟨coords 0 i, coords_lt 0 i⟩ * μ) • eB i j) := by
  obtain ⟨hk, v, hv, hid⟩ := block0E hb hG hg' hg ha hpay hs hrhs
  have hvM : ∀ i, v i = fun j ↦ divInt P7 (cellNumer0 sm (memberKey model key ((coords 0 i : Nat) : Int))
            (ea ⟨coords 0 i, coords_lt 0 i⟩) es
            (α ⟨coords 0 i, coords_lt 0 i⟩) (stateKey model key)
            (rhsTop model key Q6 10 rhsPrefix0 i) ![r00 i, r01 i]
            ![ca0 ⟨coords 0 i, coords_lt 0 i⟩, ca1 ⟨coords 0 i, coords_lt 0 i⟩]
            ![cs0, cs1] (apay ⟨coords 0 i, coords_lt 0 i⟩) j) := by
    intro i
    funext j
    exact div_of_identity (by norm_num) (fun row column ↦ hid i j row column)
  refine ⟨hk, fun i j row column ↦ ?_, ?_⟩
  · have h := hid i j row column
    rw [hvM i] at h
    exact h
  · simp only [hvM] at hv
    exact hv

section Model0

variable (model : HashModel) (key : ByteArray) (ext : GeneratedClaim.ExternalInputs)

/-! ## Block 0 -/

/-- The state target at `Q7`. -/
noncomputable def stateTarget0 (tape : SampleTape) (j : Fin 2) : ExactMatrix Q7 N 1 12 :=
  reducePoly Q7 N (((P7 : Nat) : Int) * muOf ext 0 * unitPair (payloadM tape) j) • gReb Q7 Q6 12

/-- The target of member `k` of `a`. -/
noncomputable def memberTarget (tape : SampleTape) (k : Fin 17) (j : Fin 2) : ExactMatrix Q7 N 1 14 :=
  reducePoly Q7 N (alphaOf ext k * unitPair (maskM tape) j) • gadgetOf Q7 14

/-- The rows of the state input. -/
noncomputable def stateRow0 (tape : SampleTape) : Fin 2 → ExactMatrix Q7 N 1 12 :=
  encRow (maskM tape) (stateKey model key) (stateTarget0 ext tape) (stateError tape [3])

/-- The rows of member `k` of `a`. -/
noncomputable def memberRow (tape : SampleTape) (k : Fin 17) : Fin 2 → ExactMatrix Q7 N 1 14 :=
  encRow (maskM tape) (memberKey model key k) (memberTarget ext tape k) (memberError tape [3] k)

/-- The selector RHS bottoms of block `0`. -/
noncomputable def bot0 (tape : SampleTape) (i : Fin 14) (j : Fin 2) : ExactMatrix Q6 N 1 10 :=
  reducePoly Q6 N (((P6 : Nat) : Int) * nuOf ext 0 i * unitPair (payloadM tape) j) • gReb Q6 Q5 10 +
    reduceMatrix Q6 N 1 10 (rhsError0 tape [2] i j) -
    reducePoly Q6 N (payloadM tape) • rhsTop model key Q6 10 rhsPrefix0 i j

/-- The keys entering block `1`. -/
noncomputable def key1 (tape : SampleTape) : Fin 2 → Fin 2 → ExactMatrix Q6 N 1 10 :=
  ∑ i : Fin 14, fun k j ↦ theOutput (blockModSwitchRuns [1099511626049, 1099511625409, 1099511623297, 1099511622593, 1099511622529, 1099511621249, 1099511619841] 1)
    (cellKeyUp0 (memberKey model key ((coords 0 i : Nat) : Int)) (stateKey model key)
      (rhsTop model key Q6 10 rhsPrefix0 i) (bot0 model key ext tape i) k j)

/-- The numerator of cell `i` of block `0` in the model. -/
noncomputable def numerM0 (tape : SampleTape) (i : Fin 14) (j : Fin 2) : ErrorMatrix N 1 10 :=
  cellNumer0 (maskM tape)
      (memberKey model key ((coords 0 i : Nat) : Int)) (memberError tape [3] ⟨coords 0 i, coords_lt 0 i⟩)
      (stateError tape [3]) (alphaOf ext ⟨coords 0 i, coords_lt 0 i⟩) (stateKey model key)
      (rhsTop model key Q6 10 rhsPrefix0 i) (bot0 model key ext tape i)
      (memberRow model key ext tape ⟨coords 0 i, coords_lt 0 i⟩) (stateRow0 model key ext tape)
      (fun _ _ ↦ reducePoly Q7 N (alphaOf ext ⟨coords 0 i, coords_lt 0 i⟩)) j

/-- The error entering block `1`. -/
noncomputable def err1 (tape : SampleTape) : Fin 2 → ErrorMatrix N 1 10 :=
  ∑ i : Fin 14, fun j ↦ divInt P7 (numerM0 model key ext tape i j) -
    (alphaOf ext ⟨coords 0 i, coords_lt 0 i⟩ * muOf ext 0) • rhsError0 tape [2] i j

/-- The numerators of block `0` are divisible by the dropped factor. -/
def div0 (tape : SampleTape) : Prop :=
  ∀ i j row column, numerM0 model key ext tape i j row column =
    ((P7 : Int) : ErrorPoly N) * divInt P7 (numerM0 model key ext tape i j) row column

/-- The state target of block `1` at `Q6`. -/
noncomputable def stateTarget1 (tape : SampleTape) (j : Fin 2) : ExactMatrix Q6 N 1 10 :=
  reducePoly Q6 N (((P6 : Nat) : Int) * muOf ext 1 * unitPair (payloadM tape) j) • gReb Q6 Q5 10

end Model0



end LwrProof
