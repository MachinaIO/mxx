import Generated.Identity
import Generated.Identity.Run.run

/-!
# The correctness claim of the identity example, proved on its proof image

`Generated.Identity.CorrectnessClaim` (written by `mxx_core::claims` from the image the core
flattened for the identity program) states that running the image on an input of 8 bytes
returns that input with probability 1.

The run is `Generated.Identity.Run.run.halts`, generated by `mxx_core::compose` from the image's
straight-line glue (a query, a window copied by the copy routine, and the staged output): the
image halts with the payload `u64 8 ++ x`. This file only decodes the payload.
-/

namespace MxxCore.Proofs.Identity

open MathcalA MxxCore RiscvZkvm.Rv64

abbrev P : Prog := Generated.Identity.Progs.run

theorem decode (x : Bytes) (hx : x.length = 8) :
    decodeOutputs (Bytes.u64s [8] ++ x) = some [x] := by
  have hl : Bytes.leToNat (Bytes.u64 8) = 8 := by decide
  have hnil : decodeOutputs [] = some [] := by rw [decodeOutputs]; simp
  have h8 : (Bytes.u64 8).length = 8 := Mem.length_u64 8
  rw [show Bytes.u64s [8] ++ x = Bytes.u64 8 ++ x by simp [Bytes.u64s], decodeOutputs]
  simp [h8, hx, hl, List.take_left' h8, List.drop_left' h8,
    List.drop_eq_nil_of_le (show x.length ≤ 8 by omega), hnil]

/-- The generated correctness claim of the identity example holds. -/
theorem correctness : Generated.Identity.CorrectnessClaim := by
  intro x hx
  have hx' : x.length = 8 := hx
  have P_len := Generated.Identity.Run.run.P_len
  have P_mem := Generated.Identity.Run.run.P_mem
  have hrun : (simulateQ (inputGame [x]).impl
      (runBinary Generated.Identity.Images.run ⟨113, 69672, 264⟩)).run () =
      pure (.halted (Bytes.u64s [8] ++ x), ()) :=
    P.runBinary_eq (b := ⟨113, 69672, 264⟩) (by rw [P_len]) rfl (by rw [P_len, P_mem]; norm_num)
      (by rw [P_mem]; norm_num [BASE]) le_rfl (Generated.Identity.Run.run.halts [x] hx')
  have hcomp : Generated.Identity.impl.run.run [x] = pure (some [x]) := by
    simp only [Algorithm.run, Generated.Identity.impl, hrun]
    erw [pure_bind]
    simp [decode x hx']
  rw [hcomp, prEvent_pure]
  simp

end MxxCore.Proofs.Identity
