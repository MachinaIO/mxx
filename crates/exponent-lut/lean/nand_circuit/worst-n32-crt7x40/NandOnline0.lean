      (fun j ↦ reducePoly Q7 N (((P7 : Nat) : Int) *
        unitPair (substitution (sigma i).toNat (sigma_odd i) sm) j) • g) ![h0 i, h1 i] 26)
    {fam : Fin 2 → Fin 2 → Fin 16 → ExactMatrix Q6 N 1 12} {count : Nat} (hcount : count ≤ 15)
    {final : LoopState Q7 Q6 12}
    (hruns : MxxIR.IterRuns (fun (i : Nat) (current next : LoopState Q7 Q6 12) ↦
      Stage_online.sequential_generatedRoot_72 Backend.backend model GeneratedClaim.stage_4_params i
        (current.1, current.2.1, current.2.2.1, current.2.2.2.1, current.2.2.2.2.1,
