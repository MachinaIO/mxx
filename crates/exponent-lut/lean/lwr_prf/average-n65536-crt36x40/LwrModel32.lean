variable (model : HashModel) (key : ByteArray) (ext : GeneratedClaim.ExternalInputs)

/-- The state rows entering block `32`. -/
noncomputable def stateRow32 (tape : SampleTape) : Fin 2 → ExactMatrix Q4 N 1 12 :=
  encRow (maskM tape) (key32 model key ext tape) (stateTarget32 ext tape) (err32 model key ext tape)

/-- The selector RHS bottoms of block `32`. -/
noncomputable def bot32 (tape : SampleTape) (i : Fin 113) (j : Fin 2) : ExactMatrix Q3 N 1 8 :=
  reducePoly Q3 N (((P3 : Nat) : Int) * nuOf ext 32 i * unitPair (payloadM tape) j) • gReb Q3 Q2 8 +
    reduceMatrix Q3 N 1 8 (rhsError32 tape [2] i j) -
    reducePoly Q3 N (payloadM tape) • rhsTop model key Q3 8 rhsPrefix32 i j

/-- The keys entering block `33`. -/
noncomputable def key33 (tape : SampleTape) : Fin 2 → Fin 2 → ExactMatrix Q3 N 1 8 :=
  ∑ i : Fin 113, fun k j ↦ theOutput (blockModSwitchRuns [1099510054913, 1099507695617, 1099506515969, 1099504549889] 1)
    (cellKeyUp32 (memberKey model key ((coords 32 i : Nat) : Int)) (key32 model key ext tape)
      (rhsTop model key Q3 8 rhsPrefix32 i) (bot32 model key ext tape i) k j)

/-- The alignment numerator of the member of cell `i` of block `32` in the model. -/
noncomputable def alignM32 (tape : SampleTape) (i : Fin 113) (j : Fin 2) : ErrorMatrix N 1 16 :=
  alignNumer32 (maskM tape) (memberKey model key ((coords 32 i : Nat) : Int))
    (memberError tape [3] ⟨coords 32 i, coords_lt 32 i⟩) (memberRow model key ext tape ⟨coords 32 i, coords_lt 32 i⟩) j

