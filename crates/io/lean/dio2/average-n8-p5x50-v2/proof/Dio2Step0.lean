/-- **The refreshed hint**: the first anchor-width columns of the zero-plaintext anchor
parts are the next anchor masked by the next mask, with their certified fresh errors. -/
theorem hint {model : HashModel} {co : Step0Rows.OnlineCtx model} {outputs : _}
    (F : generatedRoot.Facts co outputs) {A : ExactMatrix modulus_0 8 2 54}
    (hA : generatedRoot.w_860_0 co = A) {next : ErrorPoly 8} {target : Fin 36 → ErrorPoly 8}
    (hz : ∀ part : Fin 36, 32 ≤ part.val → target part = 0)
    (h16 : MxxExponentLut.Rel next
      (fun r c ↦ MxxExponentLut.rowOf (generatedRoot.w_872_3 co (StepTransition.partIndex ⟨16, by decide⟩ c)) r)
      (fun c ↦ reducePoly modulus_0 8 (target (StepTransition.partIndex ⟨16, by decide⟩ c)) • generatedRoot.w_57_0 co)
      (StepTransition.nextRows co ⟨16, by decide⟩) 8)
    (h17 : MxxExponentLut.Rel next
      (fun r c ↦ MxxExponentLut.rowOf (generatedRoot.w_872_3 co (StepTransition.partIndex ⟨17, by decide⟩ c)) r)
      (fun c ↦ reducePoly modulus_0 8 (target (StepTransition.partIndex ⟨17, by decide⟩ c)) • generatedRoot.w_57_0 co)
      (StepTransition.nextRows co ⟨17, by decide⟩) 8) :
    ∃ e : ErrorMatrix 8 1 54, CoeffBound e (8 + 2) ∧
      generatedRoot.w_997_0 co =
        maskPart (reducePoly modulus_0 8 next) (MxxExponentLut.rowOf A) + reduceMatrix modulus_0 8 1 54 e := by
  obtain ⟨e16, he16, r16⟩ := h16
  obtain ⟨e17, he17, r17⟩ := h17
  have k16 : ∀ c r, MxxExponentLut.rowOf (generatedRoot.w_872_3 co (StepTransition.partIndex ⟨16, by decide⟩ c)) r =
      MxxExponentLut.rowOf (generatedRoot.w_871_0 co (Step0Targets.pairIndex 11 (by decide) c)) r := by
    intro c r
    rw [target_nonlabel_key co F _ 11 (by decide) c (by simp only [StepTransition.partIndex]; omega)
      (by simp only [StepTransition.partIndex]; omega)]
  have k17 : ∀ c r, MxxExponentLut.rowOf (generatedRoot.w_872_3 co (StepTransition.partIndex ⟨17, by decide⟩ c)) r =
      MxxExponentLut.rowOf (generatedRoot.w_871_0 co (Step0Targets.pairIndex 12 (by decide) c)) r := by
    intro c r
    rw [target_nonlabel_key co F _ 12 (by decide) c (by simp only [StepTransition.partIndex]; omega)
      (by simp only [StepTransition.partIndex]; omega)]
  have part : ∀ (t : Fin 18) (c : Fin 2) (e : Fin 2 → ErrorMatrix 8 1 25)
      (ht : 16 ≤ t.val) (ttp : Nat) (htp : ttp < 13) (hk : ∀ c r,
        MxxExponentLut.rowOf (generatedRoot.w_872_3 co (StepTransition.partIndex t c)) r =
        MxxExponentLut.rowOf (generatedRoot.w_871_0 co (Step0Targets.pairIndex ttp htp c)) r)
      (hr : ∀ j, StepTransition.nextRows co t j =
        reducePoly modulus_0 8 next •
          (fun r c ↦ MxxExponentLut.rowOf (generatedRoot.w_872_3 co (StepTransition.partIndex t c)) r) 0 j +
        (fun r c ↦ MxxExponentLut.rowOf (generatedRoot.w_872_3 co (StepTransition.partIndex t c)) r) 1 j -
        (fun c ↦ reducePoly modulus_0 8 (target (StepTransition.partIndex t c)) • generatedRoot.w_57_0 co) j +
        reduceMatrix modulus_0 8 1 25 (e j)) (col : Fin 25),
      generatedRoot.w_991_0 co (StepTransition.partIndex t c) 0 col =
        reducePoly modulus_0 8 next * generatedRoot.w_871_0 co (Step0Targets.pairIndex ttp htp c) 0 col +
          generatedRoot.w_871_0 co (Step0Targets.pairIndex ttp htp c) 1 col +
          reducePoly modulus_0 8 (e c 0 col) := by
    intro t c e ht ttp htp hk hr col
    have h := congrFun (congrFun (hr c) 0) col
    simp only at h
    rw [hk, hk, hz _ (by simp only [StepTransition.partIndex]; omega)] at h
    change generatedRoot.w_991_0 co (StepTransition.partIndex t c) 0 col = _ at h
    rw [h]
    simp [MxxExponentLut.rowOf, reduceMatrix]
  let e : ErrorMatrix 8 1 54 := fun _ c ↦
    if h1 : c.val < 25 then e16 0 0 ⟨c.val, by omega⟩
    else     if h2 : c.val < 50 then e16 1 0 ⟨c.val - 25, by omega⟩
    else e17 0 0 ⟨c.val - 50, by omega⟩
  refine ⟨e, fun r c k ↦ ?_, ?_⟩
  · simp only [e]
    split_ifs
    · exact (he16 _ _ _ _).trans (by norm_num)
    · exact (he16 _ _ _ _).trans (by norm_num)
    · exact (he17 _ _ _ _).trans (by norm_num)
  funext r c
  have hr : r = 0 := Subsingleton.elim _ _
  subst hr
  have hc := c.isLt
  have p0 := Step0Targets.family_get F.c38.h992_0 ⟨32, by decide⟩ rfl
  have p1 := Step0Targets.family_get F.c38.h993_0 ⟨33, by decide⟩ rfl
  have p2 := Step0Targets.family_get F.c38.h994_0 ⟨34, by decide⟩ rfl
  have hslice : generatedRoot.w_997_0 co 0 c = generatedRoot.w_996_0 co 0 ⟨c.val, by omega⟩ := by
    obtain ⟨-, -, -, -, -, -, -, -, hs⟩ := F.c38.h997_0
    rw [hs 0 c (by simp) (by simp; omega)]
    congr 1
    apply Fin.ext
    simp
  rw [hslice, F.c38.h996_0, dif_pos (show c.val < 75 by omega)]
  simp only [Matrix.add_apply, maskPart, Matrix.smul_apply, MxxExponentLut.rowOf, smul_eq_mul,
    reduceMatrix, e]
  by_cases hc1 : c.val < 25
  · rw [F.c38.h994_0_1, dif_pos (show c.val < 50 by omega), F.c38.h993_0_1, dif_pos (show c.val < 25 by omega), p0, dif_pos (show c.val < 25 by omega)]
    rw [show (⟨32, by decide⟩ : Fin 36) = StepTransition.partIndex ⟨16, by decide⟩ 0 from rfl,
      part ⟨16, by decide⟩ 0 e16 (by decide) 11 (by decide) k16 r16]
    simp only [Fin.val_mk]
    rw [anchor_key0 F hA 0 ⟨c.val, by omega⟩ c (by simp <;> omega), anchor_key0 F hA 1 ⟨c.val, by omega⟩ c (by simp <;> omega)]
  · by_cases hc2 : c.val < 50
    · rw [F.c38.h994_0_1, dif_pos (show c.val < 50 by omega), F.c38.h993_0_1, dif_neg (show ¬ c.val < 25 by omega), p1, dif_neg (show ¬ c.val < 25 by omega), dif_pos (show c.val < 50 by omega)]
      rw [show (⟨33, by decide⟩ : Fin 36) = StepTransition.partIndex ⟨16, by decide⟩ 1 from rfl,
        part ⟨16, by decide⟩ 1 e16 (by decide) 11 (by decide) k16 r16]
      simp only [Fin.val_mk]
      rw [anchor_key1 F hA 0 ⟨c.val - 25, by omega⟩ c (by simp <;> omega), anchor_key1 F hA 1 ⟨c.val - 25, by omega⟩ c (by simp <;> omega)]
    · rw [F.c38.h994_0_1, dif_neg (show ¬ c.val < 50 by omega), p2, dif_neg (show ¬ c.val < 25 by omega), dif_neg (show ¬ c.val < 50 by omega)]
      rw [show (⟨34, by decide⟩ : Fin 36) = StepTransition.partIndex ⟨17, by decide⟩ 0 from rfl,
        part ⟨17, by decide⟩ 0 e17 (by decide) 12 (by decide) k17 r17]
      simp only [Fin.val_mk]
      rw [anchor_key2 F hA 0 ⟨c.val - 50, by omega⟩ c (by simp <;> omega), anchor_key2 F hA 1 ⟨c.val - 50, by omega⟩ c (by simp <;> omega)]

theorem substitution_one {n : Nat} (h : Odd 1) (x : ErrorPoly n) :
    substitution (n := n) (R := Int) 1 h x = x := by
  have e : substitution (n := n) (R := Int) 1 h = RingHom.id _ := by
    apply AdjoinRoot.ringHom_ext
    · ext r
      simp [substitution]
    · simp [substitution]
  rw [e]; rfl

theorem substitution_one_of {n k : Nat} (hk : Odd k) (h : k = 1) (x : ErrorPoly n) :
    substitution (n := n) (R := Int) k hk x = x := by
  subst h
  exact substitution_one hk x

theorem dynamic_route {f : Fin 36 → ExactMatrix modulus_0 8 1 25} {index : Int}
    {value : ExactMatrix modulus_0 8 1 25} (part : Fin 36) (hindex : (part.val : Int) = index)
    (h : familyGetDynamic f index value) : value = f part :=
  Online0Labels.read_at part hindex h

