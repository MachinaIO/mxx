        (∑ i : Fin 14, fun j ↦ reducePoly Q4 N (((P4 : Nat) : Int) *
          (α ⟨coords 2 i, coords_lt 2 i⟩ * μ * ν i) * unitPair sp j) • h)
        ![w.w_86_4, w.w_86_5]
        (∑ i : Fin 14, fun j ↦ divInt P5 (cellNumer2 sm (memberKey model key ((coords 2 i : Nat) : Int))
            (fun j' ↦ divInt A5 (alignNumer2 sm (memberKey model key ((coords 2 i : Nat) : Int))
              (ea ⟨coords 2 i, coords_lt 2 i⟩) ![ca0 ⟨coords 2 i, coords_lt 2 i⟩, ca1 ⟨coords 2 i, coords_lt 2 i⟩] j')) es
            (α ⟨coords 2 i, coords_lt 2 i⟩) ![![w.w_64_0, w.w_64_1], ![w.w_64_2, w.w_64_3]]
