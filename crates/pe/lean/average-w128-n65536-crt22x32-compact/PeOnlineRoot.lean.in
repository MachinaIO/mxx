import PeOnlineGlue
import PeOnlineStep«k»

/-!
# Online step «k» at the root

Generated by `gen_online_root.py` from `PeOnlineRoot.lean.in`. The state rows of the previous step
under the preprocessed key `A`, the product with the attribute ciphertext of position «k», and the
128 branches with table «k».
-/

namespace PeProof

open Mxx.Primitives MxxRuntime MxxExponentLut MxxPe Stage_online_eval

variable {model : HashModel} {tape : SampleTape} {path : List Nat} {params : Params}

/-- The first-depth branch data of step «k». -/
noncomputable def data1_«k» (ctx : generatedRoot.Ctx Backend.backend model tape path params) : BranchData :=
  ⟨generatedRoot.w_55_0 ctx, generatedRoot.w_56_0 ctx, generatedRoot.w_«T0»_0 ctx, generatedRoot.w_«T1»_0 ctx,
    generatedRoot.w_11_0 ctx, generatedRoot.w_«h0»_0 ctx, generatedRoot.w_«h1»_0 ctx, generatedRoot.w_«lut»_0 ctx⟩

/-- The second-depth leaf data of step «k». -/
noncomputable def data2_«k» (ctx : generatedRoot.Ctx Backend.backend model tape path params) : Leaf2Data :=
  ⟨generatedRoot.w_55_0 ctx, generatedRoot.w_56_0 ctx, generatedRoot.w_«T0»_0 ctx, generatedRoot.w_«T1»_0 ctx,
    generatedRoot.w_11_0 ctx, generatedRoot.w_«int»_0 ctx, generatedRoot.w_«int»_1 ctx, generatedRoot.w_«lut2»_0 ctx⟩

/-- The preprocessed product key of step «k». -/
noncomputable def mKey_«k» (ctx : generatedRoot.Ctx Backend.backend model tape path params) :
    Fin 2 → Fin 2 → ExactMatrix Q N 1 44 :=
  ![![generatedRoot.w_«m00»_0 ctx, generatedRoot.w_«m01»_0 ctx],
    ![generatedRoot.w_«m10»_0 ctx, generatedRoot.w_«m11»_0 ctx]]

/-- The preprocessed key of the state rows entering step «k». -/
noncomputable def aKey_«k» (ctx : generatedRoot.Ctx Backend.backend model tape path params) :
    Fin 2 → Fin 2 → ExactMatrix Q N 1 44 :=
  ![![generatedRoot.w_«a00»_0 ctx, generatedRoot.w_«a01»_0 ctx],
    ![generatedRoot.w_«a10»_0 ctx, generatedRoot.w_«a11»_0 ctx]]

set_option maxRecDepth 200000 in
set_option maxHeartbeats 0 in
theorem online_root«k» {ctx : generatedRoot.Ctx Backend.backend model tape path params}
    {outputs : ExactMatrix Q N 1 44 × ExactMatrix Q N 1 44 × ExactMatrix Q N 1 44 × ExactMatrix Q N 1 44 ×
      ExactMatrix Q N 1 44 × ExactMatrix Q N 1 44 × Unit}
    (F : generatedRoot.Facts ctx outputs)
    {s : ErrorPoly N} (hs : polyNorm s ≤ 1) {v B : Nat}
    (henc : Rel s (aKey_«k» ctx)
      (fun j ↦ reducePoly Q N ((((1 : Nat) : Int) : ErrorPoly N) * Xe v * unitPair s j) • g0)
      ![generatedRoot.w_«r0» ctx, generatedRoot.w_«r1» ctx] B)
    (p : Fin 4) (hp : generatedRoot.w_13_0 ctx «k» = p) {xv : Nat} {eB : Fin 2 → ErrorMatrix N 1 44}
    (hrhs : ∀ j, reducePoly Q N s • ![rhsTop model (generatedRoot.w_11_0 ctx) p 0,
        rhsTop model (generatedRoot.w_11_0 ctx) p 1] j +
      ![generatedRoot.w_18_0 ctx p, generatedRoot.w_20_0 ctx p] j =
      reducePoly Q N (Xe xv * unitPair s j) • g0 + reduceMatrix Q N 1 44 (eB j))
    (heB : ∀ j, CoeffBound (eB j) 31)
    {ez0 : Fin 15488 → Fin 2 → ErrorMatrix N 1 1}
    (hcomp0 : ∀ i : Fin 15488,
      RelE s (rhsCompKey model (generatedRoot.w_11_0 ctx) ((i / 3872 : Nat) : Int) ((i % 88 : Nat) : Int)
          ((44 + (i / 88) % 44 : Nat) : Int))
        (fun j _ _ ↦ reducePoly PQ N (((P : Nat) : Int) *
          (entryDigit (joinedEntry ![generatedRoot.w_18_0 ctx ⟨i / 3872, by omega⟩,
              generatedRoot.w_20_0 ctx ⟨i / 3872, by omega⟩] ⟨i % 88, by omega⟩)
            ⟨(i / 88) % 44, by omega⟩ * unitPair s j)))
        ![generatedRoot.w_25_0 ctx i, generatedRoot.w_26_0 ctx i] (ez0 i) ∧ ∀ j, CoeffBound (ez0 i j) 31)
    (hM : ∀ r (j : Fin 2) (l : Fin 44), mKey_«k» ctx r j 0 l =
      ∑ a, keyCompanionSum model (generatedRoot.w_11_0 ctx) p (aKey_«k» ctx) r ⟨44 * (j : Nat) + l, by omega⟩ a +
      ∑ a : Fin 44, aKey_«k» ctx r 0 0 a *
        rowDigits (joinRow ![rhsTop model (generatedRoot.w_11_0 ctx) p 0,
          rhsTop model (generatedRoot.w_11_0 ctx) p 1]) a ⟨44 * (j : Nat) + l, by omega⟩)
    (hhelp : ∀ (i : Fin 37) (k : Nat) (hk : Odd k), kHelp i = k →
      Rel s (helperKey model (generatedRoot.w_11_0 ctx) k)
        (fun j ↦ reducePoly Q N ((((1 : Nat) : Int) : ErrorPoly N) * unitPair (substitution k hk s) j) • g0)
        ![generatedRoot.w_55_0 ctx i, generatedRoot.w_56_0 ctx i] 31)
    {ez : Fin 85184 → Fin 2 → ErrorMatrix N 1 1}
    (hcomp : ∀ i : Fin 85184,
      RelE (substitution (kSw (i / 3872)) (kSw_odd ⟨i / 3872, by omega⟩) s)
        (lutCompKey model (generatedRoot.w_11_0 ctx) (kSw (i / 3872)) ((i % 88 : Nat) : Int)
          ((44 + (i / 88) % 44 : Nat) : Int))
        (fun j _ _ ↦ reducePoly PQ N (((P : Nat) : Int) *
          (entryDigit (joinedEntry ![switchBot model (generatedRoot.w_11_0 ctx) (generatedRoot.w_55_0 ctx)
                (generatedRoot.w_56_0 ctx) ⟨i / 3872, by omega⟩ 0,
              switchBot model (generatedRoot.w_11_0 ctx) (generatedRoot.w_55_0 ctx)
                (generatedRoot.w_56_0 ctx) ⟨i / 3872, by omega⟩ 1] ⟨i % 88, by omega⟩)
            ⟨(i / 88) % 44, by omega⟩ *
            unitPair (substitution (kSw (i / 3872)) (kSw_odd ⟨i / 3872, by omega⟩) s) j)))
        ![generatedRoot.w_60_0 ctx i, generatedRoot.w_61_0 ctx i] (ez i) ∧ ∀ j, CoeffBound (ez i j) 31)
    (hT1 : ∀ (b : Fin 22) r jj, ![(data1_«k» ctx).Tb0 b b.isLt, (data1_«k» ctx).Tb1 b b.isLt] r 0 jj =
      ∑ a, lutKeyCompanionSum model (generatedRoot.w_11_0 ctx) b (mKey_«k» ctx) r jj a +
      ∑ a : Fin 44, substitution (kSw b) (kSw_odd b) (mKey_«k» ctx r 0 0 a) *
        rowDigits (switchTopRow model (generatedRoot.w_11_0 ctx) b) a jj)
    (hT2 : ∀ (l : Fin 105) r jj, ![(data2_«k» ctx).Tb0 l l.isLt, (data2_«k» ctx).Tb1 l l.isLt] r 0 jj =
      ∑ a, lutKeyCompanionSum model (generatedRoot.w_11_0 ctx) (member2 l l.isLt)
        ((data1_«k» ctx).key1 model ⟨l % 15, by omega⟩) r jj a +
      ∑ a : Fin 44, substitution (kSw (15 + l / 15)) (kSw_odd (member2 l l.isLt))
        ((data1_«k» ctx).key1 model ⟨l % 15, by omega⟩ r 0 0 a) *
        rowDigits (switchTopRow model (generatedRoot.w_11_0 ctx) (member2 l l.isLt)) a jj)
    (ht : ∀ j : Fin 128, 0 ≤ generatedRoot.w_38_0 ctx ⟨«off» + j, by omega⟩ ∧ --MONO
      generatedRoot.w_38_0 ctx ⟨«off» + j, by omega⟩ < 2 * N) --MONO
    (he : v + xv < 128) :
    Rel s (stepKey model (mKey_«k» ctx) (data1_«k» ctx) (data2_«k» ctx)
        (fun k ↦ branchCoef«C_» (generatedRoot.w_38_0 ctx) «off» k (by norm_num)))
      (fun j ↦ (reducePoly Q N (unitPair s j) *
        «table» (generatedRoot.w_38_0 ctx) «off» (by norm_num) ⟨v + xv, he⟩) • g0)
      ![generatedRoot.w_«leaf2»_0 ctx, generatedRoot.w_«leaf2»_1 ctx]
      (stepBound (productBound B companionBound) (bound1 (productBound B companionBound))
        (bound2 (productBound B companionBound))) := by
  -- The position of the step.
  have hw14 : generatedRoot.w_«pos»_0 ctx = ((p : Nat) : Int) := by
    obtain ⟨q, hq, hout⟩ := @@h«pos»_0@@
    have hk : ((«k» : Fin 4) : Nat) = «k» := rfl
    rw [hout, ← hp, Fin.ext (by omega : (q : Nat) = («k» : Fin 4))]
  have getp : ∀ {α : Type} {f : Fin 4 → α} {o : α}, familyGetDynamic f (generatedRoot.w_«pos»_0 ctx) o →
      o = f p := by
    intro α f o ⟨q, hq, ho⟩
    rw [ho, Fin.ext (by omega : (q : Nat) = p)]
  -- The public top row and the bottom row of the attribute ciphertext.
  obtain ⟨a12, b12, h12a, h12b, h12o⟩ := F.c0.h12_1 p
  simp only [Prod.mk.injEq] at h12o
  have hw15 : generatedRoot.w_«t0»_0 ctx = rhsTop model (generatedRoot.w_11_0 ctx) p 0 := by
    rw [getp @@h«t0»_0@@, h12o.1]; exact hashSample_eq h12a
  have hw16 : generatedRoot.w_«t1»_0 ctx = rhsTop model (generatedRoot.w_11_0 ctx) p 1 := by
    rw [getp @@h«t1»_0@@, h12o.2.1]; exact hashSample_eq h12b
  have hw17 : generatedRoot.w_«top»_0 ctx = joinRow ![rhsTop model (generatedRoot.w_11_0 ctx) p 0,
      rhsTop model (generatedRoot.w_11_0 ctx) p 1] := by
    have h := @@h«top»_0@@
    rw [hw15, hw16] at h
    exact concat_joinRow (r := ![_, _]) h
  have hw22 : generatedRoot.w_«bot»_0 ctx =
      joinRow ![generatedRoot.w_18_0 ctx p, generatedRoot.w_20_0 ctx p] := by
    have h := @@h«bot»_0@@
    rw [getp @@h«y0»_0@@, getp @@h«y1»_0@@] at h
    exact concat_joinRow (r := ![_, _]) h
  -- The product.
  have hcol := fun jj ↦ Step«k».colLoop0 @@h«col»_0@@ jj
  rw [hw17, hw22] at hcol
  have h33 := @@h«mul»_0@@
  rw [hw14] at h33
  have hmul := fun jj ↦ Step«k».mulLoop0 (A := aKey_«k» ctx) @@h«A0»_0@@ @@h«A1»_0@@ h33 jj
  have hprod := product_glue hs @@h«C»_0@@ henc p hrhs heB hcol (zc0 := generatedRoot.w_25_0 ctx)
    (zc1 := generatedRoot.w_26_0 ctx) (ez := ez0) (fun i hi ↦ by
      have e : (⟨(i : Nat) / 3872, by omega⟩ : Fin 4) = p := Fin.ext hi
      have h := hcomp0 i
      rw [e] at h
      exact h) hmul hM
  have hw35 : generatedRoot.w_«h0»_0 ctx = rowWindow 44 0 (by omega) (generatedRoot.w_«P»_0 ctx) :=
    sliceMatrix_window 0 @@h«h0»_0@@ rfl (by omega)
  have hw45 : generatedRoot.w_«h1»_0 ctx = rowWindow 44 44 (by omega) (generatedRoot.w_«P»_0 ctx) :=
    sliceMatrix_window 44 @@h«h1»_0@@ rfl (by omega)
  have hP : Rel s (mKey_«k» ctx)
      (fun j ↦ reducePoly Q N ((((1 : Nat) : Int) : ErrorPoly N) * Xe (v + xv) * unitPair s j) • g0)
      ![(data1_«k» ctx).c0, (data1_«k» ctx).c1] (productBound B companionBound) := by
    show Rel s _ _ ![generatedRoot.w_«h0»_0 ctx, generatedRoot.w_«h1»_0 ctx] _
    rw [hw35, hw45]
    exact hprod
  -- The identity coefficient and its scalar.
  have hc39 := Step«k».coefLoop0 @@h«coef»_0@@
  have hV : generatedRoot.w_«V»_0 ctx =
      scalarV (branchCoef«C_» (generatedRoot.w_38_0 ctx) «off» 1 (by norm_num)) := by
    refine scalarV_eq @@h«g»_0@@ ?_
    have h43 := @@h«V»_0@@
    change gadgetDecomposeRuns _ _ _ (matrixMulScalarLeft (matrixMulScalarLeft winvPoly
      (generatedRoot.w_«coef»_0 ctx)) (generatedRoot.w_«g»_0 ctx)) _ at h43
    rw [hc39] at h43
    exact h43
  -- The branches.
  have hint : ∀ b : Fin 15, (data1_«k» ctx).Runs model b (by omega) ∧
      (∀ j, ![generatedRoot.w_«int»_0 ctx b, generatedRoot.w_«int»_1 ctx b] j =
        (data1_«k» ctx).row model b (by omega) j) ∧
      ∀ r j, ![![generatedRoot.w_«int»_2 ctx b, generatedRoot.w_«int»_3 ctx b],
        ![generatedRoot.w_«int»_4 ctx b, generatedRoot.w_«int»_5 ctx b]] r j =
        (data1_«k» ctx).key1 model ⟨b, by omega⟩ r j := fun b ↦ by
    obtain ⟨r1, r2, r3, r4⟩ := Step«k».internalBranch0 b.isLt (@@h«int»_5@@ b)
    exact ⟨⟨r1, r2⟩, r3, r4⟩
  obtain ⟨hleaf1, h67⟩ := Step«k».leafLoop67 (data1_«k» ctx) @@h«leaf»_5@@
  obtain ⟨hleaf2, h70⟩ := Step«k».leafLoop70 (data2_«k» ctx) @@h«leaf2»_5@@
  have h66 := Step«k».sumLoop66 @@h«sum»_5@@
  simp only [Prod.mk.injEq] at h66 h67 h70
  have hR : ∀ j, ![generatedRoot.w_«leaf2»_0 ctx, generatedRoot.w_«leaf2»_1 ctx] j =
      ![(data1_«k» ctx).c0, (data1_«k» ctx).c1] j *
        scalarV (branchCoef«C_» (generatedRoot.w_38_0 ctx) «off» 1 (by norm_num)) +
      ∑ b : Fin 15, ![generatedRoot.w_«int»_0 ctx b, generatedRoot.w_«int»_1 ctx b] j *
        scalarV (branchCoef«C_» (generatedRoot.w_38_0 ctx) «off» (kSw b) (by norm_num)) +
      ∑ i : Fin 7, (data1_«k» ctx).row model (15 + i) (by omega) j *
        scalarV (branchCoef«C_» (generatedRoot.w_38_0 ctx) «off» (kSw (15 + i)) (by norm_num)) +
      ∑ l : Fin 105, (data2_«k» ctx).row model l l.isLt j *
        scalarV (branchCoef«C_» (generatedRoot.w_38_0 ctx) «off» (kLeaf2 l) (by norm_num)) := by
    intro j
    fin_cases j
    · simp only [Fin.zero_eta, Fin.isValue, Matrix.cons_val_zero]
      rw [h70.1, h67.1, h66.1, ← hV]
      rfl
    · simp only [Fin.mk_one, Fin.isValue, Matrix.cons_val_one]
      rw [h70.2.1, h67.2.1, h66.2.1, ← hV]
      rfl
  refine online_step hs he (data1_«k» ctx) (data2_«k» ctx) hP hhelp hcomp ?_ hT1 hint hleaf1 rfl ⟨rfl, rfl⟩
    ⟨rfl, rfl⟩ ?_ hT2 hleaf2 («table» (generatedRoot.w_38_0 ctx) «off» (by norm_num)) _ ?_ hR
  · exact fun q ↦ Step«k».lutLoop0 @@h«M0»_0@@ @@h«M1»_0@@ @@h«lut»_0@@ q
  · exact fun q ↦ Step«k».lutLoop2 @@h«lut2»_0@@ q
  · exact fun k hk ↦ branchCoef_fourier _ «off» (by norm_num) ht k hk --MONO
  · exact fun k hk ↦ branchCoefC_fourier _ «off» (by norm_num) k hk --CONST

end PeProof
