    ((A11 : Int) : ErrorPoly N) * divInt A11 (alignM25 model key ext tape i j) row column) ∧
  ∀ i j row column, numerM25 model key ext tape i j row column =
    ((P11 : Int) : ErrorPoly N) * divInt P11 (numerM25 model key ext tape i j) row column

