import Dio2RunFacts
import Dio2Online1Inputs
import Dio2Step0
import Dio2Online1Finish

/-! Claim assembly generated by gen_c.py. Initial and label fields are proved
from actual runs in Dio2RunFacts. RemainingTransitions states exactly the two
online-step obligations: no decoded-output or numerical-margin assumption.
Without both supplied step theorems, the assembly is explicitly conditional.
Pass --step0-theorem and --step1-theorem only after those declarations build
to generate the unconditional dio2_correctness_claim. -/

namespace Dio2Proof.Complete

open Mxx.Primitives MxxRuntime MxxExponentLut

/-- Owned by s0 (step0) and s1 (step1), not assumed by the run contracts. -/
structure RemainingTransitions : Prop where
  step0 : ∀ {model external execution}, W_GeneratedClaim.Runs model external execution →
    ∀ (state bit : Nat), state ≤ 1 → bit ≤ 1 →
    Label model external execution 0 (Xe (n := 8) (2 * bit)) →
    State0 model external execution (Xe (n := 8) (2 * state)) →
    State1 model external execution
      (Xe (n := 8) (2 * (entry table0 ((state + bit : Nat) : Int)).toNat))
  step1 : ∀ {model external execution}, W_GeneratedClaim.Runs model external execution →
    ∀ (state bit : Nat), state ≤ 1 → bit ≤ 1 →
    Label model external execution 1 (Xe (n := 8) (2 * bit)) →
    State1 model external execution (Xe (n := 8) (2 * state)) →
    FinalOutput execution
      (Xe (n := 8) (2 * (entry table1 ((state + 1 + bit : Nat) : Int)).toNat))

def correctInputs (transitions : RemainingTransitions) : CorrectInputs where
  State0 := Dio2Proof.State0
  State1 := Dio2Proof.State1
  Label := Dio2Proof.Label
  initial := initial
  labels := labels
  step0 := transitions.step0
  step1 := transitions.step1

theorem dio2_correctness_claim_of_transitions (transitions : RemainingTransitions) :
    GeneratedClaim.CorrectnessClaim := certificate (correctInputs transitions)

theorem remainingTransitions : RemainingTransitions where
  step0 := Dio2Proof.Complete.step0_transition
  step1 := Dio2Proof.Online1Closure.step1

theorem dio2_correctness_claim : GeneratedClaim.CorrectnessClaim :=
  certificate (correctInputs remainingTransitions)

end Dio2Proof.Complete
