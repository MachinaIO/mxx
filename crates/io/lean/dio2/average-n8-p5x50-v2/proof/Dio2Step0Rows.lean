          parallel_generatedRoot_991.w_221_0 local_ +
        reduceMatrix modulus_0 8 1 25 ex := by
    rw [input_w_13_0 local_ hin, gadgetLift, Nat.cast_one, Int.cast_one, one_mul]; exact hcx
  have hbL : parallel_generatedRoot_991.w_0_0 local_ =
      maskPart (reducePoly modulus_0 8 old) (rowOf anchor) +
