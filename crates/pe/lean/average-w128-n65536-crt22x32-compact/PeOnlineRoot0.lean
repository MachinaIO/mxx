/-- A static family read is the member. -/
theorem familyStatic_read {α : Type} {count : Nat} {f : Fin count → α} {o : α} {k : Nat}
    (hk : k < count) (h : familyGetStatic f (k : Int) o) : o = f ⟨k, hk⟩ := by
  obtain ⟨q, hq, ho⟩ := h
  have e : q = ⟨k, hk⟩ := Fin.ext (by simp only; omega)
  rw [ho, e]

