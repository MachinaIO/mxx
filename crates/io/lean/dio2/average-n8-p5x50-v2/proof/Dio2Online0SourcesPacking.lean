import Dio2Online0SourcesMembers

/-!
# Closed step-zero source packing

Generated by gen_s0a.py. The actual placement witnesses select the member
plaintexts; no canonical gather-index assumption is needed. Column and
coefficient indices remain quantified. Every final ciphertext bound is checked
against Dio2NoiseCertificate.b1_packed rather than accepted as an assumption.
-/

set_option maxHeartbeats 32000000
set_option maxRecDepth 16384
set_option Elab.async false

namespace Dio2Proof.Online0Sources
open Mxx.Primitives MxxRuntime MxxExponentLut Mxx.ExponentLut.Refresh
  RefreshTopProof.Gen RefreshTopProof.GenIface RefreshTopProof.GenInst
  RefreshTopProof.GenFinal W_Stage_online_0 Dio2Proof.LutKey
open scoped BigOperators

theorem packed_target {count : Nat} (value : Fin count → ErrorPoly 8)
    (payload : ErrorPoly 8) (gadget : ExactMatrix modulus_0 8 1 25) :
    (∑ index : Fin count, fun component ↦ reducePoly modulus_0 8
      (Xe (n := 8) index * value index * unitPair payload component) • gadget) =
    (fun component ↦ reducePoly modulus_0 8
      ((∑ index : Fin count, Xe (n := 8) index * value index) *
        unitPair payload component) • gadget) := by
  funext component
  simp only [Finset.sum_apply, Finset.sum_mul, map_sum, Finset.sum_smul]


theorem sigma_source {model : HashModel} {external : GeneratedClaim.ExternalInputs}
    {execution : GeneratedClaim.Execution} {state : Nat}
    (hrun : W_GeneratedClaim.Runs model external execution)
    (initial : State0Witness model external execution (Xe (n := 8) (2 * state))) :
    ∃ next : ErrorPoly 8, (polyNorm next ≤ 1) ∧
      EncRel initial.mask (sigmaRows initial.context.online)
        (fun component ↦ reducePoly modulus_0 8
          (next * unitPair initial.payload component) • (generatedRoot.w_57_0 initial.context.online))
        Dio2NoiseCertificate.b1_packed := by
  classical
  obtain ⟨exponent, hreadout⟩ := sigma_readout_members hrun initial

  let next : ErrorPoly 8 :=
    ∑ member : Fin 8, Xe (n := 8) member * samplerValue (exponent member)
  have hplaced (member : Fin 8) : EncRel initial.mask
      ((generatedRoot.w_37_0 initial.context.online) member, ((generatedRoot.w_37_1 initial.context.online) member, ((generatedRoot.w_37_2 initial.context.online) member, ((generatedRoot.w_37_3 initial.context.online) member, ((generatedRoot.w_37_4 initial.context.online) member, ((generatedRoot.w_37_5 initial.context.online) member, ()))))))
      (fun component ↦ reducePoly modulus_0 8 (Xe (n := 8) member) •
        (reducePoly modulus_0 8
          (samplerValue (exponent member) * unitPair initial.payload component) • (generatedRoot.w_57_0 initial.context.online)))
      (sourceLutBudget 8 (sourceLutBudget 8 (sourcePrfBudget 2 (sourcePrfBudget 2 1)))) := by
    have relation := monomial_place_rel (by decide : 1 < 8)
      (o := member.val) (by have := member.isLt; omega)
      (parallel_generatedRoot_37.sem (initial.context.online_facts.c0.h37_5 member))
      (hreadout member)
    exact relation
  have total := online0_sigma_total_graph initial.context.online
    initial.context.online_facts hplaced
  have htarget : (∑ member : Fin 8, fun component ↦
      reducePoly modulus_0 8 (Xe (n := 8) member) •
        (reducePoly modulus_0 8 (samplerValue (exponent member) *
          unitPair initial.payload component) • (generatedRoot.w_57_0 initial.context.online))) =
      (fun component ↦ reducePoly modulus_0 8
        (next * unitPair initial.payload component) • (generatedRoot.w_57_0 initial.context.online)) := by
    simp only [smul_smul, ← map_mul, ← mul_assoc]
    exact packed_target _ _ _
  refine ⟨next, sampler_packed_small exponent, ?_⟩
  apply (total.target_eq htarget).mono
  norm_num [sourceLutBudget, sourcePrfBudget, Dio2NoiseCertificate.F,
    Dio2NoiseCertificate.b1_packed]


theorem cbd_source {model : HashModel} {external : GeneratedClaim.ExternalInputs}
    {execution : GeneratedClaim.Execution} {state : Nat}
    (hrun : W_GeneratedClaim.Runs model external execution)
    (initial : State0Witness model external execution (Xe (n := 8) (2 * state))) :
    ∃ fresh : Fin 900 → ErrorPoly 8, (∀ cell, polyNorm (fresh cell) ≤ 8) ∧
      ∀ cell, EncRel initial.mask (blkT (m := 25) (C := 900) (freshRows initial.context.online) cell)
        (fun component ↦ reducePoly modulus_0 8
          (fresh cell * unitPair initial.payload component) • (generatedRoot.w_57_0 initial.context.online))
        Dio2NoiseCertificate.b1_packed := by
  classical
  obtain ⟨exponent, hreadout⟩ := cbd_readout_members hrun initial

  have hexists (member : Fin 7200) :=
    parallel_generatedRoot_898.placement_rel
      (initial.context.online_facts.c35.h898_5 member) hreadout
  choose selected hplaced using hexists
  let values (member : Fin 7200) : ErrorPoly 8 := (sigmaReadoutValue) (exponent (selected member))
  let fresh (cell : Fin 900) : ErrorPoly 8 :=
    ∑ coefficient : Fin 8, Xe (n := 8) coefficient * values
      ⟨8 * cell.val + coefficient.val, by have := cell.isLt; have := coefficient.isLt; omega⟩
  have htarget (cell : Fin 900) :
      (∑ coefficient : Fin 8, fun component ↦ reducePoly modulus_0 8
        (Xe (n := 8) ((8 * cell.val + coefficient.val) % 8)) •
          (reducePoly modulus_0 8 (values
            ⟨8 * cell.val + coefficient.val, by have := cell.isLt; have := coefficient.isLt; omega⟩ *
              unitPair initial.payload component) • (generatedRoot.w_57_0 initial.context.online))) =
      (fun component ↦ reducePoly modulus_0 8
        (fresh cell * unitPair initial.payload component) • (generatedRoot.w_57_0 initial.context.online)) := by
    have hindex (coefficient : Fin 8) :
        (8 * cell.val + coefficient.val) % 8 = coefficient.val := by omega
    simp only [hindex, smul_smul, ← map_mul, ← mul_assoc]
    exact packed_target _ _ _
  have hrelation (cell : Fin 900) : EncRel initial.mask (blkT (m := 25) (C := 900) (freshRows initial.context.online) cell)
      (fun component ↦ reducePoly modulus_0 8
        (fresh cell * unitPair initial.payload component) • (generatedRoot.w_57_0 initial.context.online))
      Dio2NoiseCertificate.b1_packed := by
    have total := online0_fresh_row
      initial.context.online initial.context.online_facts hplaced cell
    apply (total.target_eq (htarget cell)).mono
    norm_num [sourceLutBudget, sourcePrfBudget, Dio2NoiseCertificate.F,
      Dio2NoiseCertificate.b1_packed]

  refine ⟨fresh, ?_, hrelation⟩
  intro cell
  apply (polyNorm_sum_le _ _).trans
  calc
    (∑ coefficient : Fin 8, polyNorm (Xe (n := 8) coefficient * values
      ⟨8 * cell.val + coefficient.val, by have := cell.isLt; have := coefficient.isLt; omega⟩)) ≤
        ∑ _coefficient : Fin 8, 1 := by
      apply Finset.sum_le_sum
      intro coefficient _
      dsimp only [values]
      rw [sigmaReadout_monomial]
      simpa only [Xe, ← pow_add] using polyNorm_Xe (n := 8) (by decide) _
    _ = 8 := by simp


theorem smudge_source {model : HashModel} {external : GeneratedClaim.ExternalInputs}
    {execution : GeneratedClaim.Execution} {state : Nat}
    (hrun : W_GeneratedClaim.Runs model external execution)
    (initial : State0Witness model external execution (Xe (n := 8) (2 * state))) :
    ∃ smudge : Fin 4500 → ErrorPoly 8, ((∀ cell coefficient, Odd ((smudge cell).coeff coefficient)) ∧
      (∀ cell coefficient, |(smudge cell).coeff coefficient| ≤ (8 : Int) - 1)) ∧
      ∀ cell, EncRel initial.mask (blkT (m := 25) (C := 4500) (smudgeRows initial.context.online) cell)
        (fun component ↦ reducePoly modulus_0 8
          (smudge cell * unitPair initial.payload component) • (generatedRoot.w_57_0 initial.context.online))
        Dio2NoiseCertificate.b1_packed := by
  classical
  obtain ⟨exponent, hreadout⟩ := smudge_readout_members hrun initial

  have hexists (member : Fin 36000) :=
    parallel_generatedRoot_952.placement_rel
      (initial.context.online_facts.c37.h952_5 member) hreadout
  choose selected hplaced using hexists
  let values (member : Fin 36000) : ErrorPoly 8 := (fun exponent ↦ (smudgeDigit exponent : ErrorPoly 8)) (exponent (selected member))
  let smudge (cell : Fin 4500) : ErrorPoly 8 :=
    ∑ coefficient : Fin 8, Xe (n := 8) coefficient * values
      ⟨8 * cell.val + coefficient.val, by have := cell.isLt; have := coefficient.isLt; omega⟩
  have htarget (cell : Fin 4500) :
      (∑ coefficient : Fin 8, fun component ↦ reducePoly modulus_0 8
        (Xe (n := 8) ((8 * cell.val + coefficient.val) % 8)) •
          (reducePoly modulus_0 8 (values
            ⟨8 * cell.val + coefficient.val, by have := cell.isLt; have := coefficient.isLt; omega⟩ *
              unitPair initial.payload component) • (generatedRoot.w_57_0 initial.context.online))) =
      (fun component ↦ reducePoly modulus_0 8
        (smudge cell * unitPair initial.payload component) • (generatedRoot.w_57_0 initial.context.online)) := by
    have hindex (coefficient : Fin 8) :
        (8 * cell.val + coefficient.val) % 8 = coefficient.val := by omega
    simp only [hindex, smul_smul, ← map_mul, ← mul_assoc]
    exact packed_target _ _ _
  have hrelation (cell : Fin 4500) : EncRel initial.mask (blkT (m := 25) (C := 4500) (smudgeRows initial.context.online) cell)
      (fun component ↦ reducePoly modulus_0 8
        (smudge cell * unitPair initial.payload component) • (generatedRoot.w_57_0 initial.context.online))
      Dio2NoiseCertificate.b1_packed := by
    have total := online0_smudge_row
      initial.context.online initial.context.online_facts hplaced cell
    apply (total.target_eq (htarget cell)).mono
    norm_num [sourceLutBudget, sourcePrfBudget, Dio2NoiseCertificate.F,
      Dio2NoiseCertificate.b1_packed]

  have hpoly (cell : Fin 4500) : smudge cell =
      smudgePacked (fun member ↦ exponent (selected member)) cell := by
    simp only [smudge, values, smudgePacked, intPoly, Xe, mul_comm]
  refine ⟨smudge, ⟨?_, ?_⟩, hrelation⟩
  · intro cell coefficient
    rw [hpoly]
    exact smudge_packed_odd _ _ _
  · intro cell coefficient
    rw [hpoly]
    exact smudge_packed_support _ _ _


end Dio2Proof.Online0Sources

