import PePreGlue
import PePreSum«s»
import PePreInt«s»
import PePreLut«s»
import PePreLut2_«s»
import PePreKey«s»_0
import PePreKey«s»_1
import PePreKey«s»_2
import PePreKey«s»_3

/-!
# Preprocessing step «s» at the root

Generated by `gen_pre_root.py` from `PePreRoot.lean.in`. From the incoming key `A`: the product
key of the position of step «s», the first- and second-depth LUT key rows, and the output key.
-/

namespace PeProof

open Mxx.Primitives MxxRuntime MxxExponentLut MxxPe Stage_preprocess

variable {model : HashModel} {tape : SampleTape} {path : List Nat} {params : Params}

/-- The product key of preprocessing step «s». -/
noncomputable def preM_«s» (ctx : generatedRoot.Ctx Backend.backend model tape path params) :
    Fin 2 → Fin 2 → ExactMatrix Q N 1 44 :=
  ![![generatedRoot.w_«m00»_0 ctx, generatedRoot.w_«m01»_0 ctx],
    ![generatedRoot.w_«m10»_0 ctx, generatedRoot.w_«m11»_0 ctx]]

set_option maxRecDepth 200000 in
set_option maxHeartbeats 0 in
theorem pre_root«s» {ctx : generatedRoot.Ctx Backend.backend model tape path params}
    {outputs : _} (F : generatedRoot.Facts ctx outputs)
    {A : Fin 2 → Fin 2 → ExactMatrix Q N 1 44}
    (hA0 : concatColumns (A 0 0) (A 0 1) (generatedRoot.w_«A0»_0 ctx))
    (hA1 : concatColumns (A 1 0) (A 1 1) (generatedRoot.w_«A1»_0 ctx))
    (p : Fin 4) (hp : generatedRoot.w_0_0 ctx «s» = p) :
    (∀ r (j : Fin 2) (l : Fin 44), preM_«s» ctx r j 0 l =
      ∑ a, keyCompanionSum model (generatedRoot.w_3_0 ctx) p A r ⟨44 * (j : Nat) + l, by omega⟩ a +
      ∑ a : Fin 44, A r 0 0 a *
        rowDigits (joinRow ![rhsTop model (generatedRoot.w_3_0 ctx) p 0,
          rhsTop model (generatedRoot.w_3_0 ctx) p 1]) a ⟨44 * (j : Nat) + l, by omega⟩) ∧
    (∀ d1 : BranchData, d1.key = generatedRoot.w_3_0 ctx → d1.T0 = generatedRoot.w_«T0»_0 ctx →
      d1.T1 = generatedRoot.w_«T1»_0 ctx →
      ∀ (b : Fin 22) r jj, ![d1.Tb0 b b.isLt, d1.Tb1 b b.isLt] r 0 jj =
        ∑ a, lutKeyCompanionSum model (generatedRoot.w_3_0 ctx) b (preM_«s» ctx) r jj a +
        ∑ a : Fin 44, substitution (kSw b) (kSw_odd b) (preM_«s» ctx r 0 0 a) *
          rowDigits (switchTopRow model (generatedRoot.w_3_0 ctx) b) a jj) ∧
    (∀ (d1 : BranchData) (d2 : Leaf2Data), d1.key = generatedRoot.w_3_0 ctx →
      d1.T0 = generatedRoot.w_«T0»_0 ctx → d1.T1 = generatedRoot.w_«T1»_0 ctx →
      d2.key = generatedRoot.w_3_0 ctx → d2.T0 = generatedRoot.w_«T0»_0 ctx →
      d2.T1 = generatedRoot.w_«T1»_0 ctx →
      (∀ (l : Fin 105) r jj, ![d2.Tb0 l l.isLt, d2.Tb1 l l.isLt] r 0 jj =
        ∑ a, lutKeyCompanionSum model (generatedRoot.w_3_0 ctx) (member2 l l.isLt)
          (d1.key1 model ⟨l % 15, by omega⟩) r jj a +
        ∑ a : Fin 44, substitution (kSw (15 + l / 15)) (kSw_odd (member2 l l.isLt))
          (d1.key1 model ⟨l % 15, by omega⟩ r 0 0 a) *
          rowDigits (switchTopRow model (generatedRoot.w_3_0 ctx) (member2 l l.isLt)) a jj) ∧
      keyOf (generatedRoot.w_«sL2»_0 ctx, generatedRoot.w_«sL2»_1 ctx, generatedRoot.w_«sL2»_2 ctx,
          generatedRoot.w_«sL2»_3 ctx, ()) =
        stepKey model (preM_«s» ctx) d1 d2
          (fun k ↦ branchCoef«C_» (generatedRoot.w_54_0 ctx) «off» k (by norm_num))) := by
  -- The position of the step.
  have hw1 : generatedRoot.w_«posW»_0 ctx = ((p : Nat) : Int) := by
    rw [familyStatic_four (k := «s») (by norm_num) @@h«posW»_0@@, ← hp]
    rfl
@@POS@@
  -- The product key at row `r`, block `j` of each position.
  have P«q» : ∀ r (j : Fin 2) (l : Fin 44),
      ![![generatedRoot.w_«sa»_0 ctx, generatedRoot.w_«sb»_0 ctx],
        ![generatedRoot.w_«sc»_0 ctx, generatedRoot.w_«sd»_0 ctx]] r j 0 l =
      ∑ a, keyCompanionSum model (generatedRoot.w_3_0 ctx) «q» A r ⟨44 * (j : Nat) + l, by omega⟩ a +
      ∑ a : Fin 44, A r 0 0 a *
        rowDigits (joinRow ![rhsTop model (generatedRoot.w_3_0 ctx) «q» 0,
          rhsTop model (generatedRoot.w_3_0 ctx) «q» 1]) a ⟨44 * (j : Nat) + l, by omega⟩ := by
    have R := pos_rows hA0 hA1
      (comp := fun k jj a ↦ keyCompanionSum model (generatedRoot.w_3_0 ctx) «q» A k jj a)
      (X := joinRow ![rhsTop model (generatedRoot.w_3_0 ctx) «q» 0, rhsTop model (generatedRoot.w_3_0 ctx) «q» 1])
      (fun r w ↦ PreKey«s»_«q».topStep (by norm_num) (iter_one @@h«top»_1@@) r w)
      (fun k jj ↦ PreKey«s»_«q».keyLoop hA0 hA1 @@h«key»_1@@ k jj)
    intro r j l
    have ea := sliceMatrix_window 0 @@h«sa»_0@@ rfl (by omega)
    have eb := sliceMatrix_window 44 @@h«sb»_0@@ rfl (by omega)
    have ec := sliceMatrix_window 0 @@h«sc»_0@@ rfl (by omega)
    have ed := sliceMatrix_window 44 @@h«sd»_0@@ rfl (by omega)
    have hR := R r ⟨44 * (j : Nat) + l, by omega⟩
    fin_cases r <;> fin_cases j
    · rw [ea]; exact hR
    · rw [eb]; exact hR
    · rw [ec]; exact hR
    · rw [ed]; exact hR
@@ENDPOS@@
  have hM : ∀ r (j : Fin 2) (l : Fin 44), preM_«s» ctx r j 0 l =
      ∑ a, keyCompanionSum model (generatedRoot.w_3_0 ctx) p A r ⟨44 * (j : Nat) + l, by omega⟩ a +
      ∑ a : Fin 44, A r 0 0 a *
        rowDigits (joinRow ![rhsTop model (generatedRoot.w_3_0 ctx) p 0,
          rhsTop model (generatedRoot.w_3_0 ctx) p 1]) a ⟨44 * (j : Nat) + l, by omega⟩ := by
    intro r j l
    unfold preM_«s»
    rw [select_four @@h«m00»_0@@ hw1, select_four @@h«m01»_0@@ hw1, select_four @@h«m10»_0@@ hw1,
      select_four @@h«m11»_0@@ hw1]
    fin_cases p
    · exact P0 r j l
    · exact P1 r j l
    · exact P2 r j l
    · exact P3 r j l
  -- The LUT key rows.
  have hM0 : concatColumns (preM_«s» ctx 0 0) (preM_«s» ctx 0 1) (generatedRoot.w_«M0»_0 ctx) := @@h«M0»_0@@
  have hM1 : concatColumns (preM_«s» ctx 1 0) (preM_«s» ctx 1 1) (generatedRoot.w_«M1»_0 ctx) := @@h«M1»_0@@
  have hT1 := lut_T1 (model := model) hM0 hM1 rfl (fun r q ↦ PreLut«s».lutTopLoop @@h«lt»_1@@ r q)
    (fun r q ↦ PreLut«s».lutKeyLoop hM0 hM1 @@h«lk»_1@@ r q)
  have hint := fun b : Fin 15 ↦ PreInt«s».internalKey b.isLt (@@h«int»_3@@ b)
  refine ⟨hM, fun d1 hk h0 h1 b r jj ↦ ?_, fun d1 d2 hk1 h10 h11 hk2 h20 h21 ↦ ⟨fun l r jj ↦ ?_, ?_⟩⟩
  · have e : ![d1.Tb0 b b.isLt, d1.Tb1 b b.isLt] r 0 jj =
        ![generatedRoot.w_«lk»_0 ctx, generatedRoot.w_«lk»_1 ctx] r 0 ⟨88 * (b : Nat) + jj, by omega⟩ := by
      fin_cases r
      · show d1.T0 0 ⟨88 * (b : Nat) + jj, by omega⟩ = _
        rw [h0]
        exact concat_left @@h«T0»_0@@ _ _
      · show d1.T1 0 ⟨88 * (b : Nat) + jj, by omega⟩ = _
        rw [h1]
        exact concat_left @@h«T1»_0@@ _ _
    rw [e]
    exact hT1 b r jj
  · have hK : ∀ e : Fin 15, parentKeys (generatedRoot.w_«int»_0 ctx) (generatedRoot.w_«int»_1 ctx)
        (generatedRoot.w_«int»_2 ctx) (generatedRoot.w_«int»_3 ctx) e = d1.key1 model ⟨e, by omega⟩ := by
      intro e
      funext r j
      have := (hint e).1 r j
      unfold BranchData.key1 BranchData.Tb0 BranchData.Tb1
      rw [hk1, h10, h11, rowBlock_concat_left @@h«T0»_0@@ e (by omega),
        rowBlock_concat_left @@h«T1»_0@@ e (by omega), ← this]
      fin_cases r <;> fin_cases j <;> rfl
    have hT2 := lut_T2 (model := model) (key := generatedRoot.w_3_0 ctx) hK rfl
      (fun r q ↦ PreLut2_«s».lut2TopLoop @@h«l2t»_1@@ r q)
      (fun r q ↦ PreLut2_«s».lut2KeyLoop @@h«l2k»_1@@ r q)
    have e : ![d2.Tb0 l l.isLt, d2.Tb1 l l.isLt] r 0 jj =
        ![generatedRoot.w_«l2k»_0 ctx, generatedRoot.w_«l2k»_1 ctx] r 0 ⟨88 * (l : Nat) + jj, by omega⟩ := by
      have c0 := concat_right @@h«T0»_0@@ (88 * (l : Nat) + jj) (by omega)
      have c1 := concat_right @@h«T1»_0@@ (88 * (l : Nat) + jj) (by omega)
      fin_cases r
      · show d2.T0 0 ⟨88 * (22 + (l : Nat)) + jj, by omega⟩ =
          generatedRoot.w_«l2k»_0 ctx 0 ⟨88 * (l : Nat) + jj, by omega⟩
        rw [h20, ← c0]
        exact congrArg (generatedRoot.w_«T0»_0 ctx 0) (Fin.ext (by simp only; omega))
      · show d2.T1 0 ⟨88 * (22 + (l : Nat)) + jj, by omega⟩ =
          generatedRoot.w_«l2k»_1 ctx 0 ⟨88 * (l : Nat) + jj, by omega⟩
        rw [h21, ← c1]
        exact congrArg (generatedRoot.w_«T1»_0 ctx 0) (Fin.ext (by simp only; omega))
    rw [e]
    exact hT2 l r jj
  · -- The output key.
    have hc := PreSum«s».coefLoopId @@h«coef»_0@@
    have hV : generatedRoot.w_«V»_0 ctx =
        scalarV (branchCoef«C_» (generatedRoot.w_54_0 ctx) «off» 1 (by norm_num)) := by
      refine scalarV_eq @@h«g»_0@@ ?_
      have h59 := @@h«V»_0@@
      change gadgetDecomposeRuns _ _ _ (matrixMulScalarLeft (matrixMulScalarLeft winvPoly
        (generatedRoot.w_«coef»_0 ctx)) (generatedRoot.w_«g»_0 ctx)) _ at h59
      rw [hc] at h59
      exact h59
    have hs1 := PreSum«s».keySumInt @@h«sI»_3@@
    have hs2 := (PreSum«s».keySumLeaf @@h«sL»_3@@).1
    have hs3 := (PreSum«s».keySumLeaf2 @@h«sL2»_3@@).1
    refine pre_sum (key := generatedRoot.w_3_0 ctx) d1 d2 _ hk1 (h10 ▸ @@h«T0»_0@@) (h11 ▸ @@h«T1»_0@@)
      hk2 (h20 ▸ @@h«T0»_0@@) (h21 ▸ @@h«T1»_0@@) (fun b r j ↦ (hint b).1 r j) ?_ hs1 hs2 hs3
    intro r j
    rw [← hV]
    fin_cases r <;> fin_cases j <;> rfl

end PeProof
