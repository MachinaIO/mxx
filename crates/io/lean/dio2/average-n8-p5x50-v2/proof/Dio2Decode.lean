import W_Stage_decode

/-!
# The exported decode stage

Generated by `gen_correct.py`. The loop invariant quantifies over coefficients;
it does not enumerate the ring. On the monomial at exponent 2 * z the
coefficient sum is 2 * z, and the exported final division returns z.
-/

namespace Dio2Proof

open W_Stage_decode

/-- A zero/one coefficient contributes its index times its value. -/
theorem decode_step (params : Params) (index : Nat) (hindex : index < 8)
    (current next : Int) (family : Fin 8 → Int)
    (hcoeff : family ⟨index, hindex⟩ = 0 ∨ family ⟨index, hindex⟩ = 1)
    (hrun : sequential_generatedRoot_3 params index (current, (family, ())) next) :
    next = current + index * family ⟨index, hindex⟩ := by
  obtain ⟨value, hconstraints⟩ := hrun
  simp only [sequential_generatedRoot_3.constraints_0] at hconstraints
  obtain ⟨-, -, ⟨position, hposition, hvalue⟩, -, -, -, hnext⟩ := hconstraints
  have hposition' : position = ⟨index, hindex⟩ := by
    apply Fin.ext
    have hcast : ((position.val : Nat) : Int) = (index : Int) := by
      simpa using hposition
    exact_mod_cast hcast
  subst hposition'
  rw [hnext, hvalue]
  rcases hcoeff with hzero | hone
  · rw [hzero]; norm_num
  · rw [hone]; norm_num

/-- The actual decoder returns the encoded in-range monomial exponent divided by its stride. -/
theorem decode_monomial (params : Params)
    (plaintext : Mxx.Primitives.ExactMatrix modulus_0 8 1 1)
    (value : Nat) (hvalue : 2 * value < 8)
    (hcoeff : ∀ index : Fin 8, (((plaintext 0 0).coeff index).val : Int) =
      if index.val = 2 * value then 1 else 0)
    (output : Int) (hrun : generatedRoot params plaintext output) : output = value := by
  obtain ⟨witness, hbody⟩ := hrun
  simp only [generatedRoot.body, generatedRoot.constraints_0] at hbody
  obtain ⟨hvalues, -, hiter, -, hout⟩ := hbody
  simp only [MxxRuntime.polynomialValues, Bool.false_eq_true, ↓reduceIte] at hvalues
  have hfamily : ∀ index : Fin 8,
      witness.w_2_0 index = if index.val = 2 * value then 1 else 0 := by
    intro index
    rw [hvalues index, hcoeff index]
  have hsum := MxxIR.IterRuns.invariant
    (Invariant := fun index (total : Int) ↦ index ≤ 8 →
      total = if 2 * value < index then (2 * value : Int) else 0)
    (by intro _; simp)
    (by
      intro index current next hinvariant hstep hle
      have hindex : index < 8 := by omega
      have hcell := hfamily ⟨index, hindex⟩
      have hnext := decode_step params index hindex current next witness.w_2_0
        (by rw [hcell]; split_ifs <;> simp) hstep
      rw [hnext, hinvariant (by omega), hcell]
      by_cases hequal : index = 2 * value
      · subst hequal; simp
      · simp only [hequal, if_false]; split_ifs <;> omega)
    hiter
  have hcount : Int.toNat 8 = 8 := rfl
  rw [hcount] at hsum
  have hfinal := hsum le_rfl
  rw [hout, hfinal, if_pos hvalue]
  omega

end Dio2Proof
