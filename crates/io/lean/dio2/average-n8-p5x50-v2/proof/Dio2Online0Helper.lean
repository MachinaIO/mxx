theorem online0_aut_target (member : Fin 7) :
    online0_aut_claims.get ⟨member.val, by simpa only [online0_aut_claims, List.length_cons,
      List.length_nil] using member.isLt⟩ := by
  have allClaims : List.Forall id online0_aut_claims := ⟨@online0_aut_3, ⟨@online0_aut_5, ⟨@online0_aut_7, ⟨@online0_aut_9, ⟨@online0_aut_11, ⟨@online0_aut_13, @online0_aut_15⟩⟩⟩⟩⟩⟩
