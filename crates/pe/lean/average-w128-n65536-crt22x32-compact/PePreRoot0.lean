theorem preLeafT_leaf_0 (ctx : generatedRoot.Ctx Backend.backend model tape path params)
    (leaf : Fin 105) (r : Fin 2) :
    groupedPreLeafRows (preLeafT_0 ctx) r leaf =
      preLeafGroups_0 ctx ⟨(1 + leaf.val % 15) / 4, by omega⟩
        ⟨(1 + leaf.val % 15) % 4, by omega⟩ r ⟨leaf.val / 15, by omega⟩ := by
  unfold groupedPreLeafRows
  rw [← preLeafT_chunk_0]
  congr 1
  apply Fin.ext
  simp only
  omega

