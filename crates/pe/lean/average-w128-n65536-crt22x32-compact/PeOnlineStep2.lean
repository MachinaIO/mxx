        (current.1, (current.2.1, (f0, (f1, ())))) next) (Int.toNat 5)
      (f0 0 + f0 1, (f1 0 + f1 1, ())) final) :
    final = (∑ b, f0 b, (∑ b, f1 b, ())) := by
