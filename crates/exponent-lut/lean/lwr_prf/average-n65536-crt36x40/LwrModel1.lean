/-- The alignment numerator of the member of cell `i` of block `1` in the model. -/
noncomputable def alignM1 (tape : SampleTape) (i : Fin 113) (j : Fin 2) : ErrorMatrix N 1 140 :=
  alignNumer1 (maskM tape) (memberKey model key ((coords 1 i : Nat) : Int))
    (memberError tape [3] ⟨coords 1 i, coords_lt 1 i⟩) (memberRow model key ext tape ⟨coords 1 i, coords_lt 1 i⟩) j

/-- The numerator of cell `i` of block `1` in the model. -/
noncomputable def numerM1 (tape : SampleTape) (i : Fin 113) (j : Fin 2) : ErrorMatrix N 1 132 :=
  cellNumer1 (maskM tape)
      (memberKey model key ((coords 1 i : Nat) : Int))
      (fun j' ↦ divInt A35 (alignM1 model key ext tape i j'))
      (err1 model key ext tape) (alphaOf ext ⟨coords 1 i, coords_lt 1 i⟩) (key1 model key ext tape)
      (rhsTop model key Q34 132 rhsPrefix1 i) (bot1 model key ext tape i)
      (fun j' ↦ theOutput (blockModSwitchRuns [1099510054913, 1099507695617, 1099506515969, 1099504549889, 1099503894529, 1099503370241, 1099502714881, 1099500617729, 1099499569153, 1099499175937, 1099498258433, 1099490000897, 1099489607681, 1099488428033, 1099486855169, 1099484889089, 1099484495873, 1099482923009, 1099480956929, 1099479121921, 1099469684737, 1099468767233, 1099468505089, 1099467194369, 1099465359361, 1099463786497, 1099461820417, 1099460902913, 1099460640769, 1099457495041, 1099455004673, 1099454218241, 1099453431809, 1099451465729, 1099451072513, 1099450810369] 1) (memberRow model key ext tape ⟨coords 1 i, coords_lt 1 i⟩ j' * alignDigits1))
      (stateRow1 model key ext tape) (fun _ _ ↦ reducePoly Q35 N (alphaOf ext ⟨coords 1 i, coords_lt 1 i⟩)) j

/-- The error entering block `2`. -/
noncomputable def err2 (tape : SampleTape) : Fin 2 → ErrorMatrix N 1 132 :=
  ∑ i : Fin 113, fun j ↦ divInt P35 (numerM1 model key ext tape i j) -
    (alphaOf ext ⟨coords 1 i, coords_lt 1 i⟩ * muOf ext 1) • rhsError1 tape [2] i j

/-- The alignment and cell numerators of block `1` are divisible by their dropped factors. -/
def div1 (tape : SampleTape) : Prop :=
  (∀ i j row column, alignM1 model key ext tape i j row column =
    ((A35 : Int) : ErrorPoly N) * divInt A35 (alignM1 model key ext tape i j) row column) ∧
  ∀ i j row column, numerM1 model key ext tape i j row column =
    ((P35 : Int) : ErrorPoly N) * divInt P35 (numerM1 model key ext tape i j) row column

/-- The state target of block `2` at `Q34`. -/
noncomputable def stateTarget2 (tape : SampleTape) (j : Fin 2) : ExactMatrix Q34 N 1 132 :=
  reducePoly Q34 N (((P34 : Nat) : Int) * muOf ext 2 * unitPair (payloadM tape) j) • gReb Q34 Q33 132

