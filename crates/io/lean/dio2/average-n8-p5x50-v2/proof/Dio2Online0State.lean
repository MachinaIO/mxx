    {Δ' ν : ErrorPoly n} {gq : ExactMatrix q n 1 m'} {C : Fin W → ExactPoly q n} {BB : Nat}
    (hswitch : ∀ i : Fin W, ∃ e : Fin 2 → ErrorMatrix n 1 m', (∀ j, CoeffBound (e j) BB) ∧ ∀ j,
