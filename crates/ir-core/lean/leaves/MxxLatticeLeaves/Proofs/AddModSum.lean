import Generated.AddModSum
import Generated.AddModSum.Run.run

/-!
# The correctness claim of the AddModSum example, proved on its proof image

`Generated.AddModSum.CorrectnessClaim` (written by `mxx_ir_core`'s
`test_generated_claim_of_the_add_mod_sum_example` from the image of one `lattice.add_mod` call on
two queried vectors) states that the image returns the coordinatewise sum modulo `q` of two
vectors of 4 residues below `q`, with probability 1.

The run itself is `Generated.AddModSum.Run.run.halts`, generated by `mxx_core::compose` from the
image's glue and the leaf's byte-level specification (`MxxLatticeLeaves.AddMod.byteSpec`): the
image halts with `u64 32 ++ f [4, q] [A, B]`, given the inputs' lengths and the leaf's domain,
output lengths, and step budget. This file discharges those hypotheses for the leaf, identifies
the leaf's function with `sum`, and decodes the payload.
-/

namespace MxxLatticeLeaves.Proofs.AddModSum

open MathcalA MxxCore MxxCore.Leaf RiscvZkvm.Rv64 MxxLatticeLeaves.Examples.AddModSum

abbrev P : Prog := Generated.AddModSum.Progs.run

/-- The modulus of the example. -/
abbrev q : Nat := 2305843009213693951

theorem words_of (A : List Nat) (hA : ∀ a ∈ A, a < q) : words (Bytes.u64s A) = A :=
  Compose.words_u64s A fun a ha => lt_trans (hA a ha) (by norm_num)

theorem sum_eq (A B : List Nat) (hA : A.length = 4) (hB : B.length = 4) :
    (List.range 4).map (fun k => (A.getD k 0 + B.getD k 0) % q) = sum q A B := by
  apply List.ext_getElem (by simp [sum, hA, hB])
  intro k h1 h2
  simp only [List.length_map, List.length_range] at h1
  simp [sum, List.getD_eq_getElem?_getD, List.getElem?_eq_getElem (show k < A.length by omega),
    List.getElem?_eq_getElem (show k < B.length by omega)]

/-- The whole run on two vectors of 4 residues below `q`. -/
theorem run (A B : List Nat) (hA : A.length = 4) (hB : B.length = 4) (hAq : ∀ a ∈ A, a < q)
    (hBq : ∀ b ∈ B, b < q) :
    P.Runs (inputGame [Bytes.u64s A, Bytes.u64s B]) 0 P.init () 281
      (pure (.halted (Bytes.u64 32 ++ Bytes.u64s (sum q A B)), ())) := by
  have lA : (Bytes.u64s A).length = 32 := by rw [Mem.length_u64s, hA]
  have lB : (Bytes.u64s B).length = 32 := by rw [Mem.length_u64s, hB]
  have h := Generated.AddModSum.Run.run.halts [Bytes.u64s A, Bytes.u64s B] lA lB
    (show MxxLatticeLeaves.AddMod.bytesDom [4, q] [Bytes.u64s A, Bytes.u64s B] from
      ⟨4, q, _, _, rfl, rfl, lA, lB, by norm_num, by rw [words_of A hAq]; exact hAq,
        by rw [words_of B hBq]; exact hBq⟩)
    (by show [Bytes.u64s _].map List.length = [32]; simp [Mem.length_u64s])
    (by show 7 + 12 * 4 ≤ 64; norm_num)
  have h' : P.Runs (inputGame [Bytes.u64s A, Bytes.u64s B]) 0 P.init () 281
      (pure (.halted (Bytes.u64s [32] ++ Bytes.u64s ((List.range 4).map fun k =>
        ((words (Bytes.u64s A)).getD k 0 + (words (Bytes.u64s B)).getD k 0) % q)), ())) := h
  rw [words_of A hAq, words_of B hBq, sum_eq A B hA hB] at h'
  simpa [Bytes.u64s] using h'

theorem decode (v : Bytes) (hv : v.length = 32) :
    decodeOutputs (Bytes.u64 32 ++ v) = some [v] := by
  have hl : Bytes.leToNat (Bytes.u64 32) = 32 := by decide
  have hnil : decodeOutputs [] = some [] := by rw [decodeOutputs]; simp
  have h8 : (Bytes.u64 32).length = 8 := Mem.length_u64 32
  rw [decodeOutputs]
  simp [h8, hv, hl, List.take_left' h8, List.drop_left' h8, List.drop_eq_nil_of_le (show v.length ≤ 32 by omega), hnil]

/-- The generated correctness claim of the example holds. -/
theorem correctness : Generated.AddModSum.CorrectnessClaim := by
  intro A B hA hB hAq hBq
  have hA' : A.length = 4 := hA
  have hB' : B.length = 4 := hB
  have P_len := Generated.AddModSum.Run.run.P_len
  have P_mem := Generated.AddModSum.Run.run.P_mem
  have hrun : (simulateQ (inputGame [Bytes.u64s A, Bytes.u64s B]).impl
      (runBinary Generated.AddModSum.Images.run ⟨281, 69776, 440⟩)).run () =
      pure (.halted (Bytes.u64 32 ++ Bytes.u64s (sum q A B)), ()) :=
    P.runBinary_eq (b := ⟨281, 69776, 440⟩) (by rw [P_len]) rfl (by rw [P_len, P_mem]; norm_num)
      (by rw [P_mem]; norm_num [BASE]) le_rfl (run A B hA' hB' hAq hBq)
  have hlen : (Bytes.u64s (sum q A B)).length = 32 := by
    rw [Mem.length_u64s]; simp [sum, hA', hB']
  have hcomp : Generated.AddModSum.impl.run.run [Bytes.u64s A, Bytes.u64s B] =
      pure (some [Bytes.u64s (sum q A B)]) := by
    simp only [Algorithm.run, Generated.AddModSum.impl, hrun]
    erw [pure_bind]
    simp [decode _ hlen]
  rw [hcomp, prEvent_pure]
  simp [Generated.AddModSum.params]

end MxxLatticeLeaves.Proofs.AddModSum
