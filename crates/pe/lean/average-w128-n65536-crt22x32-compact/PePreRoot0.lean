          generatedRoot.w_49_0 ctx 0 ⟨88 * (l : Nat) + jj, by omega⟩
        rw [h20, ← c0]
        exact congrArg (generatedRoot.w_50_0 ctx 0) (Fin.ext (by simp only; omega))
      · show d2.T1 0 ⟨88 * (22 + (l : Nat)) + jj, by omega⟩ =
