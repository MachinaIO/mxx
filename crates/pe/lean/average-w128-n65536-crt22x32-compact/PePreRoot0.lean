    intro r j l
    have ea := sliceMatrix_window 0 F.c1.h24_0 rfl (by omega)
    have eb := sliceMatrix_window 44 F.c2.h29_0 rfl (by omega)
    have ec := sliceMatrix_window 0 F.c3.h34_0 rfl (by omega)
    have ed := sliceMatrix_window 44 F.c4.h39_0 rfl (by omega)
    have hR := R r ⟨44 * (j : Nat) + l, by omega⟩
    fin_cases r <;> fin_cases j
