/-- The numerator `A v` of the alignment of a member of `a`: its error after the digits `H`, minus
the row residue, plus the mask-weighted key residues. -/
noncomputable def alignNumer23 (sm : ErrorPoly N) (mk : Fin 2 → Fin 2 → ExactMatrix Q36 N 1 144)
    (ea : Fin 2 → ErrorMatrix N 1 144) (row : Fin 2 → ExactMatrix Q36 N 1 144) (j : Fin 2) :
    ErrorMatrix N 1 52 :=
  ea j * liftMatrix alignDigits23 - downResidue A13 (row j * alignDigits23) +
    sm • downResidue A13 (mk 0 j * alignDigits23) + downResidue A13 (mk 1 j * alignDigits23)

/-- The numerator `p v` of a block-1 cell. -/
noncomputable def cellNumer23 (sm : ErrorPoly N) (mk : Fin 2 → Fin 2 → ExactMatrix Q36 N 1 144)
    (va : Fin 2 → ErrorMatrix N 1 52) (es : Fin 2 → ErrorMatrix N 1 48) (α : ErrorPoly N)
    (As : Fin 2 → Fin 2 → ExactMatrix Q13 N 1 48) (top bot : Fin 2 → ExactMatrix Q12 N 1 44)
    (crow : Fin 2 → ExactMatrix Q13 N 1 52) (cs : Fin 2 → ExactMatrix Q13 N 1 48)
    (pay : ExactMatrix Q13 N 1 1) (j : Fin 2) : ErrorMatrix N 1 44 :=
  pairMul (fun j' ↦ pairMul va (liftMatrix (pubDigits23 As j')) + α • es j')
      (liftMatrix (rhsDigits23 top bot j)) -
    downResidue P13 (pairMul (fun j' ↦ pairMul crow (pubDigits23 As j') +
      matrixMulScalarRight (cs j') pay) (rhsDigits23 top bot j)) +
    sm • downResidue P13 (cellKeyUp23 mk As top bot 0 j) + downResidue P13 (cellKeyUp23 mk As top bot 1 j)

