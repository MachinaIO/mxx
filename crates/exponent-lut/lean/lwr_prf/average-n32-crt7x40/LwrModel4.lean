variable {tape : SampleTape} {path : List Nat}

/-- The numerator `A v` of the alignment of a member of `a`: its error after the digits `H`, minus
the row residue, plus the mask-weighted key residues. -/
noncomputable def alignNumer4 (sm : ErrorPoly N) (mk : Fin 2 → Fin 2 → ExactMatrix Q7 N 1 14)
    (ea : Fin 2 → ErrorMatrix N 1 14) (row : Fin 2 → ExactMatrix Q7 N 1 14) (j : Fin 2) :
    ErrorMatrix N 1 6 :=
  ea j * liftMatrix alignDigits4 - downResidue A3 (row j * alignDigits4) +
    sm • downResidue A3 (mk 0 j * alignDigits4) + downResidue A3 (mk 1 j * alignDigits4)

/-- The numerator `p v` of a block-1 cell. -/
noncomputable def cellNumer4 (sm : ErrorPoly N) (mk : Fin 2 → Fin 2 → ExactMatrix Q7 N 1 14)
    (va : Fin 2 → ErrorMatrix N 1 6) (es : Fin 2 → ErrorMatrix N 1 4) (α : ErrorPoly N)
    (As : Fin 2 → Fin 2 → ExactMatrix Q3 N 1 4) (top bot : Fin 2 → ExactMatrix Q2 N 1 2)
    (crow : Fin 2 → ExactMatrix Q3 N 1 6) (cs : Fin 2 → ExactMatrix Q3 N 1 4)
    (pay : ExactMatrix Q3 N 1 1) (j : Fin 2) : ErrorMatrix N 1 2 :=
  pairMul (fun j' ↦ pairMul va (liftMatrix (pubDigits4 As j')) + α • es j')
      (liftMatrix (rhsDigits4 top bot j)) -
    downResidue P3 (pairMul (fun j' ↦ pairMul crow (pubDigits4 As j') +
      matrixMulScalarRight (cs j') pay) (rhsDigits4 top bot j)) +
    sm • downResidue P3 (cellKeyUp4 mk As top bot 0 j) + downResidue P3 (cellKeyUp4 mk As top bot 1 j)

set_option maxHeartbeats 16000000 in
set_option maxRecDepth 100000 in
