import Generated.Columns
import Generated.Columns.Run.run
import MxxLatticeLeaves.Proofs.AddModSum

/-!
# The AddModSum claim on 12 residues, proved on an image with a loop

`Generated.Columns.CorrectnessClaim` states the AddModSum specification for vectors of
`n = 12` residues, implemented by a loop of three `lattice.add_mod` calls, one per column of four
residues (`mxx_ir_core`'s `test_generated_claim_of_the_columns_example`). The run, loop
included, is `Generated.Columns.Run.run.halts`, generated by `mxx_core::compose`: the image halts
with `u64 96` and the concatenation over the columns `i < 3` of the leaf's function on the
column slices of both inputs. This file discharges the leaf's hypotheses for every column, and
shows that the concatenation of the columns' sums is the sum.
-/

namespace MxxLatticeLeaves.Proofs.Columns

open MathcalA MxxCore MxxCore.Leaf RiscvZkvm.Rv64 MxxLatticeLeaves.Examples.AddModSum
open MxxLatticeLeaves.Proofs.AddModSum (q words_of sum_eq)

abbrev P : Prog := Generated.Columns.Progs.run

theorem u64s_append (l₁ l₂ : List Nat) :
    Bytes.u64s (l₁ ++ l₂) = Bytes.u64s l₁ ++ Bytes.u64s l₂ := by
  simp [Bytes.u64s]

theorem u64s_drop : ∀ (l : List Nat) (k : Nat), (Bytes.u64s l).drop (8 * k) = Bytes.u64s (l.drop k)
  | l, 0 => by simp
  | [], k + 1 => by simp [Bytes.u64s]
  | a :: l, k + 1 => by
    rw [Mem.u64s_cons, show 8 * (k + 1) = 8 + 8 * k by ring, ← List.drop_drop,
      List.drop_left' (Mem.length_u64 a), List.drop_succ_cons]
    exact u64s_drop l k

theorem u64s_take : ∀ (l : List Nat) (k : Nat), (Bytes.u64s l).take (8 * k) = Bytes.u64s (l.take k)
  | l, 0 => by simp [Bytes.u64s]
  | [], k + 1 => by simp [Bytes.u64s]
  | a :: l, k + 1 => by
    rw [Mem.u64s_cons, show 8 * (k + 1) = (Bytes.u64 a).length + 8 * k by
        rw [Mem.length_u64]; ring, List.take_append, List.take_of_length_le (by omega),
      Nat.add_sub_cancel_left, List.take_succ_cons, Mem.u64s_cons, u64s_take l k]

/-- Column `i` of the bytes of a vector: four residues. -/
theorem column (A : List Nat) (i : Nat) :
    ((Bytes.u64s A).drop (0 + 32 * i)).take 32 = Bytes.u64s ((A.drop (4 * i)).take 4) := by
  rw [show 0 + 32 * i = 8 * (4 * i) by ring, u64s_drop, show (32 : Nat) = 8 * 4 from rfl,
    u64s_take]

theorem column_length (A : List Nat) (hA : A.length = 12) (i : Nat) (hi : i < 3) :
    ((A.drop (4 * i)).take 4).length = 4 := by
  simp [hA]; omega

theorem column_lt (A : List Nat) (hA : ∀ a ∈ A, a < q) (i : Nat) :
    ∀ a ∈ (A.drop (4 * i)).take 4, a < q :=
  fun a ha => hA a (List.mem_of_mem_drop (List.mem_of_mem_take ha))

/-- A vector of 12 residues as its three columns. -/
theorem chunks (C : List Nat) (hC : C.length = 12) :
    C = (C.drop (4 * 0)).take 4 ++ ((C.drop (4 * 1)).take 4 ++ (C.drop (4 * 2)).take 4) := by
  apply List.ext_getElem (by simp [hC])
  intro k h1 h2
  rw [hC] at h1
  interval_cases k <;> simp [List.getElem_take, List.getElem_drop, hC]

/-- The three columns' sums are the sum. -/
theorem sum_columns (A B : List Nat) (hA : A.length = 12) (hB : B.length = 12) :
    (List.range 3).flatMap (fun i => sum q ((A.drop (4 * i)).take 4) ((B.drop (4 * i)).take 4)) =
      sum q A B := by
  have l : ∀ (C : List Nat), C.length = 12 → ∀ i < 3, ((C.drop (4 * i)).take 4).length = 4 :=
    fun C hC i hi => by simp [hC]; omega
  conv_rhs => rw [chunks A hA, chunks B hB]
  rw [sum, List.zipWith_append (by rw [l A hA 0 (by omega), l B hB 0 (by omega)]),
    List.zipWith_append (by rw [l A hA 1 (by omega), l B hB 1 (by omega)])]
  simp only [show List.range 3 = [0, 1, 2] from rfl, List.flatMap_cons, List.flatMap_nil,
    List.append_nil, sum]

theorem u64s_flatMap (l : List Nat) (S : Nat → List Nat) :
    (l.flatMap fun i => Bytes.u64s (S i)) = Bytes.u64s (l.flatMap S) := by
  induction l with
  | nil => simp [Bytes.u64s]
  | cons a l ih => rw [List.flatMap_cons, List.flatMap_cons, ih, u64s_append]

/-- The whole run on two vectors of 12 residues below `q`. -/
theorem run (A B : List Nat) (hA : A.length = 12) (hB : B.length = 12) (hAq : ∀ a ∈ A, a < q)
    (hBq : ∀ b ∈ B, b < q) :
    P.Runs (inputGame [Bytes.u64s A, Bytes.u64s B]) 0 P.init () 2939
      (pure (.halted (Bytes.u64 96 ++ Bytes.u64s (sum q A B)), ())) := by
  have lA : (Bytes.u64s A).length = 96 := by rw [Mem.length_u64s, hA]
  have lB : (Bytes.u64s B).length = 96 := by rw [Mem.length_u64s, hB]
  have dom : ∀ i < 3, MxxLatticeLeaves.AddMod.bytesDom [4, q]
      [((Bytes.u64s A).drop (0 + 32 * i)).take 32, ((Bytes.u64s B).drop (0 + 32 * i)).take 32] := by
    intro i hi
    rw [column, column]
    refine ⟨4, q, _, _, rfl, rfl, ?_, ?_, by norm_num, ?_, ?_⟩
    · rw [Mem.length_u64s, column_length A hA i hi]
    · rw [Mem.length_u64s, column_length B hB i hi]
    · rw [words_of _ (column_lt A hAq i)]; exact column_lt A hAq i
    · rw [words_of _ (column_lt B hBq i)]; exact column_lt B hBq i
  have h := Generated.Columns.Run.run.halts [Bytes.u64s A, Bytes.u64s B] lA lB dom
    (fun i hi => by show [Bytes.u64s _].map List.length = [32]; simp [Mem.length_u64s])
    (fun i hi => by show 7 + 12 * 4 ≤ 64; norm_num)
  have hcol : ∀ i < 3, (MxxLatticeLeaves.AddMod.bytesF [4, q]
      [((Bytes.u64s A).drop (0 + 32 * i)).take 32,
        ((Bytes.u64s B).drop (0 + 32 * i)).take 32]).getD 0 [] =
      Bytes.u64s (sum q ((A.drop (4 * i)).take 4) ((B.drop (4 * i)).take 4)) := by
    intro i hi
    rw [column, column]
    show Bytes.u64s ((List.range 4).map fun k =>
      ((words (Bytes.u64s _)).getD k 0 + (words (Bytes.u64s _)).getD k 0) % q) = _
    rw [words_of _ (column_lt A hAq i), words_of _ (column_lt B hBq i),
      sum_eq _ _ (column_length A hA i hi) (column_length B hB i hi)]
  have hpay : Bytes.u64s [96] ++ (List.range 3).flatMap (fun i =>
      (MxxLatticeLeaves.AddMod.bytesF [4, q]
        [((Bytes.u64s A).drop (0 + 32 * i)).take 32,
          ((Bytes.u64s B).drop (0 + 32 * i)).take 32]).getD 0 []) =
      Bytes.u64 96 ++ Bytes.u64s (sum q A B) := by
    rw [List.flatMap_congr (fun i hi => hcol i (List.mem_range.1 hi)), u64s_flatMap,
      sum_columns A B hA hB]
    simp [Bytes.u64s]
  exact hpay ▸ h

theorem decode (v : Bytes) (hv : v.length = 96) :
    decodeOutputs (Bytes.u64 96 ++ v) = some [v] := by
  have hl : Bytes.leToNat (Bytes.u64 96) = 96 := by decide
  have hnil : decodeOutputs [] = some [] := by rw [decodeOutputs]; simp
  have h8 : (Bytes.u64 96).length = 8 := Mem.length_u64 96
  rw [decodeOutputs]
  simp [h8, hv, hl, List.take_left' h8, List.drop_left' h8, List.drop_eq_nil_of_le (show v.length ≤ 96 by omega), hnil]

/-- The generated correctness claim holds. -/
theorem correctness : Generated.Columns.CorrectnessClaim := by
  intro A B hA hB hAq hBq
  have hA' : A.length = 12 := hA
  have hB' : B.length = 12 := hB
  have P_len := Generated.Columns.Run.run.P_len
  have P_mem := Generated.Columns.Run.run.P_mem
  have hrun : (simulateQ (inputGame [Bytes.u64s A, Bytes.u64s B]).impl
      (runBinary Generated.Columns.Images.run ⟨2939, 70144, 696⟩)).run () =
      pure (.halted (Bytes.u64 96 ++ Bytes.u64s (sum q A B)), ()) :=
    P.runBinary_eq (b := ⟨2939, 70144, 696⟩) (by rw [P_len]) rfl (by rw [P_len, P_mem]; norm_num)
      (by rw [P_mem]; norm_num [BASE]) le_rfl (run A B hA' hB' hAq hBq)
  have hlen : (Bytes.u64s (sum q A B)).length = 96 := by
    rw [Mem.length_u64s]; simp [sum, hA', hB']
  have hcomp : Generated.Columns.impl.run.run [Bytes.u64s A, Bytes.u64s B] =
      pure (some [Bytes.u64s (sum q A B)]) := by
    simp only [Algorithm.run, Generated.Columns.impl, hrun]
    erw [pure_bind]
    simp [decode _ hlen]
  rw [hcomp, prEvent_pure]
  simp [Generated.Columns.params]

end MxxLatticeLeaves.Proofs.Columns
