section Model0

variable (model : HashModel) (key : ByteArray) (ext : GeneratedClaim.ExternalInputs)

/-! ## Block 0 -/

/-- The state target at `Q36`. -/
noncomputable def stateTarget0 (tape : SampleTape) (j : Fin 2) : ExactMatrix Q36 N 1 140 :=
  reducePoly Q36 N (((P36 : Nat) : Int) * muOf ext 0 * unitPair (payloadM tape) j) • gReb Q36 Q35 140

/-- The target of member `k` of `a`. -/
noncomputable def memberTarget (tape : SampleTape) (k : Fin 1025) (j : Fin 2) : ExactMatrix Q36 N 1 144 :=
  reducePoly Q36 N (alphaOf ext k * unitPair (maskM tape) j) • gadgetOf Q36 144

/-- The rows of the state input. -/
noncomputable def stateRow0 (tape : SampleTape) : Fin 2 → ExactMatrix Q36 N 1 140 :=
  encRow (maskM tape) (stateKey model key) (stateTarget0 ext tape) (stateError tape [3])

/-- The rows of member `k` of `a`. -/
noncomputable def memberRow (tape : SampleTape) (k : Fin 1025) : Fin 2 → ExactMatrix Q36 N 1 144 :=
  encRow (maskM tape) (memberKey model key k) (memberTarget ext tape k) (memberError tape [3] k)

/-- The selector RHS bottoms of block `0`. -/
noncomputable def bot0 (tape : SampleTape) (i : Fin 113) (j : Fin 2) : ExactMatrix Q35 N 1 136 :=
  reducePoly Q35 N (((P35 : Nat) : Int) * nuOf ext 0 i * unitPair (payloadM tape) j) • gReb Q35 Q34 136 +
    reduceMatrix Q35 N 1 136 (rhsError0 tape [2] i j) -
    reducePoly Q35 N (payloadM tape) • rhsTop model key Q35 136 rhsPrefix0 i j

/-- The keys entering block `1`. -/
noncomputable def key1 (tape : SampleTape) : Fin 2 → Fin 2 → ExactMatrix Q35 N 1 136 :=
  ∑ i : Fin 113, fun k j ↦ theOutput (blockModSwitchRuns [1099510054913, 1099507695617, 1099506515969, 1099504549889, 1099503894529, 1099503370241, 1099502714881, 1099500617729, 1099499569153, 1099499175937, 1099498258433, 1099490000897, 1099489607681, 1099488428033, 1099486855169, 1099484889089, 1099484495873, 1099482923009, 1099480956929, 1099479121921, 1099469684737, 1099468767233, 1099468505089, 1099467194369, 1099465359361, 1099463786497, 1099461820417, 1099460902913, 1099460640769, 1099457495041, 1099455004673, 1099454218241, 1099453431809, 1099451465729, 1099451072513, 1099450810369] 1)
    (cellKeyUp0 (memberKey model key ((coords 0 i : Nat) : Int)) (stateKey model key)
      (rhsTop model key Q35 136 rhsPrefix0 i) (bot0 model key ext tape i) k j)

/-- The numerator of cell `i` of block `0` in the model. -/
noncomputable def numerM0 (tape : SampleTape) (i : Fin 113) (j : Fin 2) : ErrorMatrix N 1 136 :=
  cellNumer0 (maskM tape)
      (memberKey model key ((coords 0 i : Nat) : Int)) (memberError tape [3] ⟨coords 0 i, coords_lt 0 i⟩)
      (stateError tape [3]) (alphaOf ext ⟨coords 0 i, coords_lt 0 i⟩) (stateKey model key)
      (rhsTop model key Q35 136 rhsPrefix0 i) (bot0 model key ext tape i)
      (memberRow model key ext tape ⟨coords 0 i, coords_lt 0 i⟩) (stateRow0 model key ext tape)
      (fun _ _ ↦ reducePoly Q36 N (alphaOf ext ⟨coords 0 i, coords_lt 0 i⟩)) j

/-- The error entering block `1`. -/
noncomputable def err1 (tape : SampleTape) : Fin 2 → ErrorMatrix N 1 136 :=
  ∑ i : Fin 113, fun j ↦ divInt P36 (numerM0 model key ext tape i j) -
    (alphaOf ext ⟨coords 0 i, coords_lt 0 i⟩ * muOf ext 0) • rhsError0 tape [2] i j

/-- The numerators of block `0` are divisible by the dropped factor. -/
def div0 (tape : SampleTape) : Prop :=
  ∀ i j row column, numerM0 model key ext tape i j row column =
    ((P36 : Int) : ErrorPoly N) * divInt P36 (numerM0 model key ext tape i j) row column

/-- The state target of block `1` at `Q35`. -/
noncomputable def stateTarget1 (tape : SampleTape) (j : Fin 2) : ExactMatrix Q35 N 1 136 :=
  reducePoly Q35 N (((P35 : Nat) : Int) * muOf ext 1 * unitPair (payloadM tape) j) • gReb Q35 Q34 136

