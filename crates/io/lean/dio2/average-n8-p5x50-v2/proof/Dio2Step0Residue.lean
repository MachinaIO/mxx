/-- Prime 0: the symbolic fresh action fits the exact certificate
envelope. The numerical comparison is proved, not supplied as a premise. -/
theorem online0_part_fresh0_budgeted {backend : BackendContext} {hashModel : HashModel}
    {params : W_Stage_online_0.Params} {part : Nat}
    (ctx : parallel_generatedRoot_991.Ctx backend hashModel params part) {outputs : _}
    (F : parallel_generatedRoot_991.Facts ctx outputs) (hi : part < 36)
    (hq : 1 < modulus_0) (L : RegularLayout modulus_0)
    (hL : backend.regularLayout modulus_0 8 = some L) (hLx : L.droppedModuli = 0)
    (hG : gadgetMatrixRuns backend 4096 25 (parallel_generatedRoot_991.w_31_0 ctx))
    {s : ExactPoly modulus_0 8}
    {K : Fin 900 → Fin 2 → ExactMatrix modulus_0 8 1 25}
    {t : Fin 900 → ErrorPoly 8}
    {error : Fin 900 → ErrorMatrix 8 1 25}
    (hz : ∀ cell, blk (C := 900) (m := 25) (parallel_generatedRoot_991.w_29_0 ctx) cell =
      maskPart s (K cell) - reducePoly modulus_0 8 (t cell) • (parallel_generatedRoot_991.w_31_0 ctx) +
        reduceMatrix modulus_0 8 1 25 (error cell))
    (he : ∀ cell, CoeffBound (error cell) b1_packed) :
    ∃ ef : ErrorMatrix 8 1 25,
      CoeffBound ef b1_fresh ∧
      (parallel_generatedRoot_991.w_45_0 ctx) = maskPart s (fun component _ column ↦
        (blk (C := 25) (m := 25)
          (cellsKey (fun cell : Fin 25 ↦ K ⟨25 * part + cell.val, by omega⟩)
            component * (parallel_generatedRoot_991.w_37_0 ctx))
          (RefreshTopProof.GenFinal.colOf (C := 25) column) * (parallel_generatedRoot_991.w_42_0 ctx)) 0 0) -
        ((1606938044254428791916078459060479968194539524630727034176641 : Int) : ExactPoly modulus_0 8) •
          reduceMatrix modulus_0 8 1 25
            (fun _ column ↦ t ⟨25 * part + column.val, by omega⟩) +
        reduceMatrix modulus_0 8 1 25 ef := by
  obtain ⟨error, herror, hrow⟩ := online0_part_fresh0 ctx F hi hq L hL hLx hG hz he
  refine ⟨error, fun row column coefficient ↦ (herror row column coefficient).trans ?_, hrow⟩
  norm_num [b1_fresh, b1_packed]

