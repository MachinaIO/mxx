/-- The numerator `A v` of the alignment of a member of `a`: its error after the digits `H`, minus
the row residue, plus the mask-weighted key residues. -/
noncomputable def alignNumer30 (sm : ErrorPoly N) (mk : Fin 2 → Fin 2 → ExactMatrix Q36 N 1 144)
    (ea : Fin 2 → ErrorMatrix N 1 144) (row : Fin 2 → ExactMatrix Q36 N 1 144) (j : Fin 2) :
    ErrorMatrix N 1 24 :=
  ea j * liftMatrix alignDigits30 - downResidue A6 (row j * alignDigits30) +
    sm • downResidue A6 (mk 0 j * alignDigits30) + downResidue A6 (mk 1 j * alignDigits30)

/-- The numerator `p v` of a block-1 cell. -/
noncomputable def cellNumer30 (sm : ErrorPoly N) (mk : Fin 2 → Fin 2 → ExactMatrix Q36 N 1 144)
    (va : Fin 2 → ErrorMatrix N 1 24) (es : Fin 2 → ErrorMatrix N 1 20) (α : ErrorPoly N)
    (As : Fin 2 → Fin 2 → ExactMatrix Q6 N 1 20) (top bot : Fin 2 → ExactMatrix Q5 N 1 16)
    (crow : Fin 2 → ExactMatrix Q6 N 1 24) (cs : Fin 2 → ExactMatrix Q6 N 1 20)
    (pay : ExactMatrix Q6 N 1 1) (j : Fin 2) : ErrorMatrix N 1 16 :=
  pairMul (fun j' ↦ pairMul va (liftMatrix (pubDigits30 As j')) + α • es j')
      (liftMatrix (rhsDigits30 top bot j)) -
    downResidue P6 (pairMul (fun j' ↦ pairMul crow (pubDigits30 As j') +
      matrixMulScalarRight (cs j') pay) (rhsDigits30 top bot j)) +
    sm • downResidue P6 (cellKeyUp30 mk As top bot 0 j) + downResidue P6 (cellKeyUp30 mk As top bot 1 j)

