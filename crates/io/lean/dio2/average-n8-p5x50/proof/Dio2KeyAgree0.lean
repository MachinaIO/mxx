/-- A packed family is determined by its list. -/
theorem familyPack_eq {α : Type} {size : Nat} {c c' : Int} {l l' : List α} {f f' : Fin size → α}
    (h : familyPack c l f) (h' : familyPack c' l' f') (hl : l = l') : f = f' := by
  subst hl
  funext i
  obtain ⟨-, -, h⟩ := h
  obtain ⟨-, -, h'⟩ := h'
  obtain ⟨p, hp, e⟩ := h i
  obtain ⟨p', hp', e'⟩ := h' i
  rw [e, e']
  congr 1
  exact Fin.ext (by omega)

