      (keyPartG4 keyCtx component * topRows (keyPartDigits4 keyCtx component) +
        keyPartC14 keyCtx component * bottomRows (keyPartDigits4 keyCtx component) -
        keyPartCx4 keyCtx component * keyPartY4 keyCtx component) +
        keyPartFresh4 keyCtx component + keyPartSmudge4 keyCtx component := by
  rw [F.c2.hout]
  change rowOf (W_Stage_keys_online_0_0.parallel_generatedRoot_988.w_94_0 keyCtx) component = _
  obtain ⟨leftRow, rightRow⟩ := concatRows_two F.c2.h94_0
  fin_cases component
  · calc
      _ = (W_Stage_keys_online_0_0.parallel_generatedRoot_988.w_49_0 keyCtx) := leftRow
      _ = _ := by
        have split := concatColumns_mul F.c0.h2_0 (W_Stage_keys_online_0_0.parallel_generatedRoot_988.w_7_0 keyCtx)
        exact congrArg (fun product ↦ product - (W_Stage_keys_online_0_0.parallel_generatedRoot_988.w_9_0 keyCtx) * (W_Stage_keys_online_0_0.parallel_generatedRoot_988.w_21_0 keyCtx) +
