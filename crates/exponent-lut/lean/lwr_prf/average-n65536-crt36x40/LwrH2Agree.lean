import LwrH2Bounds

/-!
# The keys read by the H2 coefficients

Generated by `generator/gen_h2_cert.py`. The weights depend on the tape only through the payload
secret, the selector RHS errors and the LUT switching errors (`preKeys`); the key-site coefficients
also read the mask (`siteKeys`). Neither set holds a mask key or a replacement coordinate of H2
respectively.
-/

namespace LwrProof

open Mxx.Primitives MxxRuntime MxxExponentLut

set_option maxRecDepth 100000

/-- The keys of the payload secret and of the preprocessing samples. -/
irreducible_def preKeys : Finset SampleKey :=
  sampleUniverse [0, 2] 6 1024 1 144 N [.interval (-1) 1, .gaussian (4/1) 26]

/-- The keys of the mask. -/
irreducible_def maskKeys : Finset SampleKey :=
  Finset.univ.image fun k : Fin N ↦ maskKey [1, 0] k.val

/-- The keys read by the coefficients of the H2 sites. -/
irreducible_def siteKeys : Finset SampleKey := preKeys ∪ maskKeys

theorem vec2_congr {α : Type} {a b a' b' : α} (ha : a = a') (hb : b = b') : ![a, b] = ![a', b'] := by
  rw [ha, hb]

/-- Every key of a sample of the payload or of the preprocessing lies in `preKeys`. -/
macro "pre_keys" : tactic =>
  `(tactic| (apply siteKeysIn_of_eq preKeys_def <;> simp <;> omega))

theorem head_of_mem_pre {k : SampleKey} (hk : k ∈ preKeys) : k.site.head? ∈ [0, 2].map some :=
  head_of_mem_eq preKeys_def hk

theorem mask_not_pre (k : Nat) : maskKey [1, 0] k ∉ preKeys := fun hk ↦ by
  have := head_of_mem_pre hk
  simp [maskKey] at this

theorem residue_not_site (h j : Nat) : residueKey h j ∉ siteKeys := by
  intro hk
  rw [siteKeys_def] at hk
  rcases Finset.mem_union.mp hk with hk | hk
  · have := head_of_mem_pre hk
    simp [residueKey, residueSite] at this
  · rw [maskKeys_def] at hk
    obtain ⟨k, -, hk⟩ := Finset.mem_image.mp hk
    have := congrArg SampleKey.site hk
    simp [residueKey, residueSite, maskKey] at this

section Agree

variable (model : HashModel) (key : ByteArray) (ext : GeneratedClaim.ExternalInputs)
  {t t' : SampleTape}

theorem payloadM_agree (h : ∀ k ∈ (preKeys : Set SampleKey), t k = t' k) : payloadM t = payloadM t' := by
  unfold payloadM
  rw [clampedWitness_eq_of_agree h (site := [0, 0]) (law := .interval (-1) 1) (rows := 1) (columns := 1)
    (by pre_keys)]

theorem maskM_agree (h : ∀ k ∈ (siteKeys : Set SampleKey), t k = t' k) : maskM t = maskM t' := by
  have hS : SiteKeysIn siteKeys [1, 0] (.interval (-1) 1) 1 1 N := by
    intro r c k
    obtain rfl : r = 0 := Subsingleton.elim _ _
    obtain rfl : c = 0 := Subsingleton.elim _ _
    rw [siteKeys_def, maskKeys_def]
    refine Finset.mem_union_right _ (Finset.mem_image.mpr ⟨k, Finset.mem_univ _, ?_⟩)
    rfl
  unfold maskM
  rw [clampedWitness_eq_of_agree h hS]

theorem switchError_agree (h : ∀ k ∈ (preKeys : Set SampleKey), t k = t' k) :
    switchError t [2] = switchError t' [2] := by
  funext i
  unfold switchError
  exact vec2_congr (clampedWitness_eq_of_agree h (by pre_keys) _ _)
    (clampedWitness_eq_of_agree h (by pre_keys) _ _)

