/-- The generated block-22 sum adds cells `2, ..., count + 1` to its initial state. -/
theorem sum22 {model : HashModel} {f0 f1 f2 f3 f4 f5 : Fin 113 → ExactMatrix Q13 N 1 48} {count : Nat}
    {init final : SumState Q13 48}
    (hruns : MxxIR.IterRuns (fun (i : Nat) (current next : SumState Q13 48) ↦
      Stage_online_eval.sequential_generatedRoot_526 Backend.backend model tape (loopPaths i) GeneratedClaim.stage_4_params i
        (current.1, current.2.1, current.2.2.1, current.2.2.2.1, current.2.2.2.2.1,
          current.2.2.2.2.2.1, f0, f1, f2, f3, f4, f5, ()) next) count init final) :
    final = addCells init f0 f1 f2 f3 f4 f5 count := by
  refine MxxIR.IterRuns.invariant
    (Invariant := fun k (s : SumState Q13 48) ↦ s = addCells init f0 f1 f2 f3 f4 f5 k) ?_ ?_ hruns
  · simp [addCells]
  · intro i current next hcur hbody
    rw [sum22_step hbody, hcur]
    simp only [addCells, Finset.sum_range_succ, add_assoc]


