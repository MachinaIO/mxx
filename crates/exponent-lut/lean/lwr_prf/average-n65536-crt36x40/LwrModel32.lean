/-- The numerator `A v` of the alignment of a member of `a`: its error after the digits `H`, minus
the row residue, plus the mask-weighted key residues. -/
noncomputable def alignNumer32 (sm : ErrorPoly N) (mk : Fin 2 → Fin 2 → ExactMatrix Q36 N 1 144)
    (ea : Fin 2 → ErrorMatrix N 1 144) (row : Fin 2 → ExactMatrix Q36 N 1 144) (j : Fin 2) :
    ErrorMatrix N 1 16 :=
  ea j * liftMatrix alignDigits32 - downResidue A4 (row j * alignDigits32) +
    sm • downResidue A4 (mk 0 j * alignDigits32) + downResidue A4 (mk 1 j * alignDigits32)

/-- The numerator `p v` of a block-1 cell. -/
noncomputable def cellNumer32 (sm : ErrorPoly N) (mk : Fin 2 → Fin 2 → ExactMatrix Q36 N 1 144)
    (va : Fin 2 → ErrorMatrix N 1 16) (es : Fin 2 → ErrorMatrix N 1 12) (α : ErrorPoly N)
    (As : Fin 2 → Fin 2 → ExactMatrix Q4 N 1 12) (top bot : Fin 2 → ExactMatrix Q3 N 1 8)
    (crow : Fin 2 → ExactMatrix Q4 N 1 16) (cs : Fin 2 → ExactMatrix Q4 N 1 12)
    (pay : ExactMatrix Q4 N 1 1) (j : Fin 2) : ErrorMatrix N 1 8 :=
  pairMul (fun j' ↦ pairMul va (liftMatrix (pubDigits32 As j')) + α • es j')
      (liftMatrix (rhsDigits32 top bot j)) -
    downResidue P4 (pairMul (fun j' ↦ pairMul crow (pubDigits32 As j') +
      matrixMulScalarRight (cs j') pay) (rhsDigits32 top bot j)) +
    sm • downResidue P4 (cellKeyUp32 mk As top bot 0 j) + downResidue P4 (cellKeyUp32 mk As top bot 1 j)

