import Dio2Online0SourcesTables
import Dio2SmudgeValues

/-!
# Step-zero signed smudge digits

Generated by gen_s0a.py. Every coefficient and cell is quantified. The
actual encrypted table has an odd bounded signed readout at arbitrary
exponents; packing preserves those exact coefficients without expansion.
-/

set_option maxHeartbeats 16000000
set_option maxRecDepth 16384
set_option Elab.async false

namespace Dio2Proof.Online0Sources

open Mxx.Primitives MxxRuntime MxxExponentLut Mxx.ExponentLut.Refresh
  RefreshTopProof.Gen RefreshTopProof.GenIface RefreshTopProof.GenInst RefreshTopProof.GenFinal
  RefreshTopProof.GenFinal Dio2Proof.LutKey
open scoped BigOperators


open W_Stage_online_0 RefreshTopProof.GenIface RefreshTopProof.GenInst

def smudgeIndex (branch : Fin 8) : Fin 8 :=
  ⟨(sigmaOf Preprocess.smudgeSigmas branch).toNat % (2 * 8) / 2, by
    have := Nat.mod_lt (sigmaOf Preprocess.smudgeSigmas branch).toNat (by decide : 0 < 2 * 8)
    omega⟩

noncomputable def smudgePermutation : Fin 8 ≃ Fin 8 :=
  Equiv.ofBijective smudgeIndex (by decide)

theorem smudge_index (branch : Fin 8) :
    (sigmaOf Preprocess.smudgeSigmas branch).toNat % (2 * 8) =
      1 + 2 * 1 * (smudgePermutation branch).val := by
  change (sigmaOf Preprocess.smudgeSigmas branch).toNat % (2 * 8) =
    1 + 2 * 1 * (smudgeIndex branch).val
  exact (by decide : ∀ branch : Fin 8,
    (sigmaOf Preprocess.smudgeSigmas branch).toNat % (2 * 8) =
      1 + 2 * 1 * (smudgeIndex branch).val) branch

def smudgeDigit (exponent : Nat) : Int :=
  (-1) ^ (exponent / 8) * readoutVal (8 / 2) 8 (exponent % 8)

theorem smudge_digit_range (exponent : Nat) :
    smudgeDigit exponent % 2 = 1 ∧ |smudgeDigit exponent| ≤ (8 : Int) - 1 := by
  have hodd := readoutVal_odd (8 / 2) 8 (exponent % 8)
  have hlt := readoutVal_lt (p' := 8 / 2) (by decide)
    (Nat.mod_lt exponent (by decide : 0 < 8))
  have hsign : (-1 : Int) ^ (exponent / 8) = 1 ∨
      (-1 : Int) ^ (exponent / 8) = -1 := neg_one_pow_eq_or Int _
  rcases hsign with hsign | hsign <;>
    simp only [smudgeDigit, hsign, one_mul, neg_one_mul] <;> constructor
  · omega
  · rw [abs_of_nonneg (by positivity)]; omega
  · omega
  · rw [abs_neg, abs_of_nonneg (by positivity)]; omega

theorem smudge_walsh {message : ErrorPoly 8} (exponent : Nat)
    (hmessage : message = Xe (n := 8) (1 * exponent)) :
    (∑ branch : Fin 8, reducePoly modulus_0 8
      (substitution (sigmaOf Preprocess.smudgeSigmas branch).toNat (Preprocess.smudgeOdd branch) message) *
        Preprocess.smudgeCoefficients branch) =
      reducePoly modulus_0 8 (smudgeDigit exponent : ErrorPoly 8) := by
  have hinverse : (1583094970036445026219027198948556596896692349152872186330380835483706951869 : ExactPoly modulus_0 8) *
      (8 : ExactPoly modulus_0 8) = 1 :=
    cast_inverse (by norm_num [modulus_0]) (by norm_num [modulus_0])
  have htable : ∀ index : Fin 8, MxxIR.selectInt (Int.ofNat index) [1, 1, 3, 3, 5, 5, 7, 7] =
      ((readoutVal (8 / 2) 8 index : Nat) : Int) := by decide
  have hw := PreprocessSwitch.coefficient_walsh (q := modulus_0) (n := 8)
    (inverse := 1583094970036445026219027198948556596896692349152872186330380835483706951869) (stride := 1) (log := 3)
    (by norm_num [modulus_0]) (by decide) (by decide)
    (fun index : Fin 8 ↦ MxxIR.selectInt (Int.ofNat index) [1, 1, 3, 3, 5, 5, 7, 7])
    hinverse (sigmaOf Preprocess.smudgeSigmas) Preprocess.smudgeOdd smudgePermutation smudge_index
    exponent (congrArg (reducePoly modulus_0 8) hmessage)
  have hvalue : MxxIR.selectInt (Int.ofNat (exponent % 8)) [1, 1, 3, 3, 5, 5, 7, 7] =
      ((readoutVal (8 / 2) 8 (exponent % 8) : Nat) : Int) :=
    htable ⟨exponent % 8, Nat.mod_lt _ (by decide)⟩
  simpa only [Preprocess.smudgeCoefficients, Preprocess.smudgeSigmas,
    Preprocess.smudgeSigmas, show 2 ^ 3 = 8 from rfl, htable, hvalue, smudgeDigit,
    Int.cast_mul, Int.cast_pow, Int.cast_neg, Int.cast_one, Int.cast_natCast,
    Nat.cast_ofNat, Int.cast_ofNat] using hw



noncomputable def smudgePacked
    (exponent : Fin (8 * 4500) → Nat)
    (cell : Fin 4500) : ErrorPoly 8 :=
  intPoly fun coefficient ↦ smudgeDigit (exponent
    ⟨8 * cell.val + coefficient.val, by
      have := cell.isLt
      have := coefficient.isLt
      omega⟩)

theorem smudge_packed_coeff
    (exponent : Fin (8 * 4500) → Nat)
    (cell : Fin 4500) (coefficient : Fin 8) :
    (smudgePacked exponent cell).coeff coefficient = smudgeDigit (exponent
      ⟨8 * cell.val + coefficient.val, by
        have := cell.isLt
        have := coefficient.isLt
        omega⟩) := by
  exact intPoly_coeff (by decide) _ coefficient

theorem smudge_packed_odd
    (exponent : Fin (8 * 4500) → Nat)
    (cell : Fin 4500) (coefficient : Fin 8) :
    Odd ((smudgePacked exponent cell).coeff coefficient) := by
  rw [smudge_packed_coeff]
  exact Int.odd_iff.mpr (smudge_digit_range _).1

theorem smudge_packed_support
    (exponent : Fin (8 * 4500) → Nat)
    (cell : Fin 4500) (coefficient : Fin 8) :
    |(smudgePacked exponent cell).coeff coefficient| ≤ (8 : Int) - 1 := by
  rw [smudge_packed_coeff]
  exact (smudge_digit_range _).2

end Dio2Proof.Online0Sources
