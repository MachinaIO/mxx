/-- The numerator `A v` of the alignment of a member of `a`: its error after the digits `H`, minus
the row residue, plus the mask-weighted key residues. -/
noncomputable def alignNumer4 (sm : ErrorPoly N) (mk : Fin 2 → Fin 2 → ExactMatrix Q36 N 1 144)
    (ea : Fin 2 → ErrorMatrix N 1 144) (row : Fin 2 → ExactMatrix Q36 N 1 144) (j : Fin 2) :
    ErrorMatrix N 1 128 :=
  ea j * liftMatrix alignDigits4 - downResidue A32 (row j * alignDigits4) +
    sm • downResidue A32 (mk 0 j * alignDigits4) + downResidue A32 (mk 1 j * alignDigits4)

/-- The numerator `p v` of a block-1 cell. -/
noncomputable def cellNumer4 (sm : ErrorPoly N) (mk : Fin 2 → Fin 2 → ExactMatrix Q36 N 1 144)
    (va : Fin 2 → ErrorMatrix N 1 128) (es : Fin 2 → ErrorMatrix N 1 124) (α : ErrorPoly N)
    (As : Fin 2 → Fin 2 → ExactMatrix Q32 N 1 124) (top bot : Fin 2 → ExactMatrix Q31 N 1 120)
    (crow : Fin 2 → ExactMatrix Q32 N 1 128) (cs : Fin 2 → ExactMatrix Q32 N 1 124)
    (pay : ExactMatrix Q32 N 1 1) (j : Fin 2) : ErrorMatrix N 1 120 :=
  pairMul (fun j' ↦ pairMul va (liftMatrix (pubDigits4 As j')) + α • es j')
      (liftMatrix (rhsDigits4 top bot j)) -
    downResidue P32 (pairMul (fun j' ↦ pairMul crow (pubDigits4 As j') +
      matrixMulScalarRight (cs j') pay) (rhsDigits4 top bot j)) +
    sm • downResidue P32 (cellKeyUp4 mk As top bot 0 j) + downResidue P32 (cellKeyUp4 mk As top bot 1 j)

