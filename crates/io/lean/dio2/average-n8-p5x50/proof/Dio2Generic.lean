/-! ## 3. The decode loop and the output residues for any ring dimension -/

/-- **The decode loop on a one-hot family**, for any number `N` of coefficients (the ring
dimension `n`, e.g. `2^16`). If each loop step adds `k · family k` on a `0`/`1` coefficient
(`decode_step` for the toy's generated step) and the family is one-hot at `e < N`, the loop
started at `0` ends at `e`; `decode_monomial` is this with `N = 8`, `e = 2 z`. -/
theorem decode_onehot_loop {N e : Nat} {body : Nat → Int → Int → Prop} (family : Fin N → Int)
    (hfamily : ∀ i : Fin N, family i = if i.val = e then 1 else 0)
    (hstep : ∀ (k : Nat) (hk : k < N) (current next : Int),
      (family ⟨k, hk⟩ = 0 ∨ family ⟨k, hk⟩ = 1) → body k current next →
        next = current + k * family ⟨k, hk⟩)
    {initial final : Int} (hinit : initial = 0) (hiter : MxxIR.IterRuns body N initial final)
    (he : e < N) : final = e := by
  have hsum := MxxIR.IterRuns.invariant
    (Invariant := fun i (s : Int) => i ≤ N → s = if e < i then (e : Int) else 0)
    (by intro _; simp [hinit])
    (by
      intro i current next hinv hstep' hi
      have hiN : i < N := by omega
      have hc := hfamily ⟨i, hiN⟩
      have hnext := hstep i hiN current next (by rw [hc]; split_ifs <;> simp) hstep'
      rw [hnext, hinv (by omega), hc]
      by_cases hie : i = e
      · subst hie; simp
      · simp only [hie, if_false]; split_ifs <;> omega)
    hiter
  rw [hsum le_rfl, if_pos he]

/-- Monomials multiply by adding exponents, in any ring dimension (`Xe_mul_Xe'` is `n = 8`). -/
theorem Xe_mul_Xe_gen (a b : Nat) : Xe (n := n) a * Xe (n := n) b = Xe (n := n) (a + b) :=
  (pow_add _ a b).symm

/-- **The output residues of a monomial** `X^e` (`e < n`), reduced modulo `q₀` and read modulo
`q₁`, are its `0`/`1` coefficients, in any ring dimension; `coeff_val_Xe` is `n = 8`,
`e = 2 t`. -/
theorem coeff_val_Xe_gen {q0 q1 : Nat} (hn : 0 < n) (hq0 : 1 < q0) (hq1 : 1 < q1) {e : Nat}
    (he : e < n) (i : Fin n) :
    ((((reducePoly q0 n ((1 : ErrorPoly n) * Xe (n := n) e)).coeff i).val : ZMod q1).val : Int) =
      if i.val = e then 1 else 0 := by
  haveI : Fact (1 < q0) := ⟨hq0⟩
  haveI : Fact (1 < q1) := ⟨hq1⟩
  have hc : (Xe (n := n) e).coeff i = if (⟨e, he⟩ : Fin n) = i then 1 else 0 :=
    Negacyclic.coeff_root_pow (R := Int) (n := n) hn ⟨e, he⟩ i
  rw [one_mul, reducePoly_coeff hq0 hn, hc]
  by_cases hi : i.val = e
  · have : (⟨e, he⟩ : Fin n) = i := Fin.ext hi.symm
    simp [this, hi, ZMod.val_one]
  · have : ¬ (⟨e, he⟩ : Fin n) = i := fun h ↦ hi (by rw [← h])
    simp [this, hi]

/-! ## 4. CRT basis hypotheses from a kernel-checked certificate -/

/-- The check of one ordered pair `(i, j)` of a CRT basis: on the diagonal `1 < q_i` and
`K_i ≡ 1 (mod q_i)`; off it `K_i ≡ 0 (mod q_j)` and `gcd(q_i, q_j) = 1`. Every operation is a
kernel-accelerated `Nat`/`Int` operation on the stated numbers; no product is unfolded. -/
def crtPairOk {k : Nat} (q : Fin k → Nat) (K : Fin k → Int) (i j : Fin k) : Bool :=
  if i = j then decide (1 < q i) && decide ((K i - 1) % (q j : Int) = 0)
  else decide (K i % (q j : Int) = 0) && (Nat.gcd (q i) (q j) == 1)

/-- The CRT certificate: every ordered pair passes `crtPairOk`. For `k` primes this is `k²` pair
checks, evaluated once by `decide +kernel`. -/
def crtCertificate {k : Nat} (q : Fin k → Nat) (K : Fin k → Int) : Bool :=
  (List.finRange k).all fun i ↦ (List.finRange k).all fun j ↦ crtPairOk q K i j

/-- What one passed pair check gives. -/
theorem crtPairOk_spec {k : Nat} {q : Fin k → Nat} {K : Fin k → Int} {i j : Fin k}
    (h : crtPairOk q K i j = true) :
    (i = j → 1 < q i) ∧ K i ≡ (if i = j then 1 else 0) [ZMOD (q j : Int)] ∧
      (i ≠ j → Nat.Coprime (q i) (q j)) := by
  unfold crtPairOk at h
  by_cases hij : i = j
  · rw [if_pos hij] at h
    simp only [Bool.and_eq_true, decide_eq_true_eq] at h
    refine ⟨fun _ ↦ h.1, ?_, fun h' ↦ absurd hij h'⟩
    rw [if_pos hij]
    exact (Int.modEq_iff_dvd.mpr (Int.dvd_of_emod_eq_zero h.2)).symm
  · rw [if_neg hij] at h
    simp only [Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq] at h
    refine ⟨fun h' ↦ absurd h' hij, ?_, fun _ ↦ h.2⟩
    rw [if_neg hij]
    show K i % (q j : Int) = 0 % (q j : Int)
    rw [h.1, Int.zero_emod]

/-- **The hypotheses of `crt_terms_sum` from per-pair checks**, stated as `∀ i j` facts so that
each pair can be discharged on its own (e.g. one `decide +kernel` per pair). -/
theorem crt_hyps_of_pairs {k : Nat} {q : Fin k → Nat} {K : Fin k → Int}
    (h : ∀ i j, crtPairOk q K i j = true) :
    (∀ i, 1 < q i) ∧ (∀ i j, K i ≡ (if i = j then 1 else 0) [ZMOD (q j : Int)]) ∧
      (∀ i j, i ≠ j → Nat.Coprime (q i) (q j)) :=
  ⟨fun i ↦ (crtPairOk_spec (h i i)).1 rfl, fun i j ↦ (crtPairOk_spec (h i j)).2.1,
    fun i j ↦ (crtPairOk_spec (h i j)).2.2⟩

/-- **The hypotheses of `crt_terms_sum` from one certificate** `crtCertificate q K = true`, to be
proven by `decide +kernel` once for all `k²` pairs (27 primes: 729 small checks). -/
theorem crt_hyps_of_certificate {k : Nat} {q : Fin k → Nat} {K : Fin k → Int}
    (h : crtCertificate q K = true) :
    (∀ i, 1 < q i) ∧ (∀ i j, K i ≡ (if i = j then 1 else 0) [ZMOD (q j : Int)]) ∧
      (∀ i j, i ≠ j → Nat.Coprime (q i) (q j)) := by
  apply crt_hyps_of_pairs
  intro i j
  unfold crtCertificate at h
  rw [List.all_eq_true] at h
  have hi := h i (List.mem_finRange i)
  rw [List.all_eq_true] at hi
  exact hi j (List.mem_finRange j)

/-- The product of the primes as a list product, so that `Q = ∏ q_i` is one kernel evaluation
(`Q = (List.ofFn q).prod` by `decide +kernel`) instead of `Fin.prod_univ_five`-style unfolding. -/
theorem prod_eq_listProd {k : Nat} (q : Fin k → Nat) : ∏ i, q i = (List.ofFn q).prod :=
  (List.prod_ofFn (f := q)).symm

/-- The toy's CRT basis of `Q_0` passes the certificate (a check of the generic route). -/
theorem crt0_certificate : crtCertificate primes0 crt0 = true := by decide +kernel

/-- The toy's `Q_0 = ∏ q_i` through the list product (a check of the generic route). -/
theorem primes0_prod_list : W_Stage_online_0.modulus_0 = ∏ i, primes0 i := by
  rw [prod_eq_listProd]
  decide +kernel

/-- The toy's part row through the generic route: `part_row_gen` at `k + 1 = 5` with the CRT
hypotheses from `crt0_certificate`. -/
theorem part_row_five_of_certificate {m : Nat} {v : ExactMatrix W_Stage_online_0.modulus_0 8 1 m}
    {t : Fin 5 → ExactMatrix W_Stage_online_0.modulus_0 8 1 m}
    (ht : ∀ i, TermOf (primes0 i) (crt0 i) (t i) v) :
    matrixAdd (matrixAdd (matrixAdd (matrixAdd (t 0) (t 1)) (t 2)) (t 3)) (t 4) = v := by
  obtain ⟨hq, hK, hcop⟩ := crt_hyps_of_certificate crt0_certificate
  rw [← chainSum_five]
  exact part_row_gen (by norm_num) (by norm_num [W_Stage_online_0.modulus_0]) primes0 hq crt0 hK
    hcop primes0_prod_list ht

/-! ## 5. Readout packing, smudge/fresh values and part indices for any parameters -/

/-- The member index of coefficient `j` in one packed column of `n` coefficients
(`readoutMember` is `n = 8`). -/
def readoutMemberN {columns : Nat} (column : Fin columns) (coefficient : Fin n) :
    Fin (n * columns) :=
  ⟨n * column.val + coefficient.val, by
    have hc := column.isLt
    have hj := coefficient.isLt
    calc n * column.val + coefficient.val < n * column.val + n := by omega
      _ = n * (column.val + 1) := by ring
      _ ≤ n * columns := Nat.mul_le_mul_left _ hc⟩

theorem readoutMemberN_eight {columns : Nat} (column : Fin columns) (coefficient : Fin 8) :
    readoutMemberN (n := 8) column coefficient = readoutMember column coefficient := rfl

/-- The packed member's position modulo `n` is its coefficient. -/
theorem readoutMemberN_mod {columns : Nat} (column : Fin columns) (coefficient : Fin n) :
    (readoutMemberN column coefficient).val % n = coefficient.val := by
  show (n * column.val + coefficient.val) % n = coefficient.val
  rw [Nat.mul_add_mod, Nat.mod_eq_of_lt coefficient.isLt]

/-- `n` placed LUT readouts in one column (`placedReadout` is `n = 8`). -/
noncomputable def placedReadoutN {columns : Nat} (ν : Fin (n * columns) → ErrorPoly n)
    (column : Fin columns) : ErrorPoly n :=
  ∑ coefficient : Fin n,
    Xe (n := n) ((readoutMemberN column coefficient).val % n) *
      ν (readoutMemberN column coefficient)

theorem placedReadoutN_eight {columns : Nat} (ν : Fin (8 * columns) → ErrorPoly 8)
    (column : Fin columns) : placedReadoutN (n := 8) ν column = placedReadout ν column := rfl

/-- Modular LUT values identify a packed column's representative, for any `n`. -/
theorem placedReadoutN_reduce {q columns : Nat} (ν : Fin (n * columns) → ErrorPoly n)
    (value : Fin (n * columns) → Int)
    (hν : ∀ member, reducePoly q n (ν member) = reducePoly q n (value member : ErrorPoly n))
    (column : Fin columns) :
    reducePoly q n (placedReadoutN ν column) =
      reducePoly q n (intPoly (fun coefficient ↦ value (readoutMemberN column coefficient))) := by
  simp only [placedReadoutN, intPoly, map_sum, map_mul]
  apply Finset.sum_congr rfl
  intro coefficient _
  rw [hν, readoutMemberN_mod]
  exact mul_comm _ _

/-- Exact LUT lifts give exactly the packed integer polynomial, for any `n`. -/
theorem placedReadoutN_eq {columns : Nat} (ν : Fin (n * columns) → ErrorPoly n)
    (value : Fin (n * columns) → Int) (hν : ∀ member, ν member = (value member : ErrorPoly n))
    (column : Fin columns) :
    placedReadoutN ν column =
      intPoly (fun coefficient ↦ value (readoutMemberN column coefficient)) := by
  simp only [placedReadoutN, intPoly]
  apply Finset.sum_congr rfl
  intro coefficient _
  rw [hν, readoutMemberN_mod]
  exact mul_comm _ _

/-- Scalar-offset smudge witnesses of a packed column slice, for any `n`
(`online0_smudge_values` is `n = 8`). -/
theorem smudge_values_gen {q P columns : Nat} (hn : 0 < n) (hP : P % 2 = 0) {half : Int}
    (hhalf : ((2 * half : Int) : ZMod q) = 1)
    (ν : Fin (n * columns) → ErrorPoly n) (digit : Fin (n * columns) → Int)
    (hν : ∀ member, reducePoly q n (ν member) = reducePoly q n (digit member : ErrorPoly n))
    (hodd : ∀ member, digit member % 2 = 1)
    (hbound : ∀ member, |digit member| ≤ (P : Int) - 1)
    {width : Nat} (select : Fin width → Fin columns) :
    ∃ noise : ErrorMatrix n 1 width, CoeffBound noise (P / 2 + half.natAbs) ∧
      Matrix.of (fun (_ : Fin 1) column ↦
        reducePoly q n (placedReadoutN ν (select column)) * (half : ExactPoly q n)) -
          Matrix.of (fun (_ : Fin 1) (_ : Fin width) ↦ (half : ExactPoly q n)) =
            reduceMatrix q n 1 width noise := by
  refine ⟨fun _ column ↦ centeredSmudge (fun coefficient ↦
    digit (readoutMemberN (select column) coefficient)) + scalarHalfResidual n half, ?_, ?_⟩
  · intro _ column coefficient
    exact smudge_scalar_offset_bound hn hP half _ (fun _ ↦ hodd _) (fun _ ↦ hbound _) coefficient
  · funext row column
    change reducePoly q n (placedReadoutN ν (select column)) * half - half = _
    rw [placedReadoutN_reduce ν digit hν]
    exact smudge_scalar_offset hn hhalf _ (fun _ ↦ hodd _)

/-- Coefficientwise half-offset smudge witnesses bounded by `P / 2`, for any `n`
(`smudge_half_values` is `n = 8`). -/
theorem smudge_half_values_gen {q P columns : Nat} (hn : 0 < n) (hP : P % 2 = 0) {half : Int}
    (hhalf : ((2 * half : Int) : ZMod q) = 1)
    (ν : Fin (n * columns) → ErrorPoly n) (digit : Fin (n * columns) → Int)
    (hν : ∀ member, reducePoly q n (ν member) = reducePoly q n (digit member : ErrorPoly n))
    (hodd : ∀ member, digit member % 2 = 1)
    (hbound : ∀ member, |digit member| ≤ (P : Int) - 1)
    {width : Nat} (select : Fin width → Fin columns) :
    ∃ noise : ErrorMatrix n 1 width, CoeffBound noise (P / 2) ∧
      Matrix.of (fun (_ : Fin 1) column ↦
        reducePoly q n (placedReadoutN ν (select column)) * (half : ExactPoly q n)) -
          allCoefficients half = reduceMatrix q n 1 width noise := by
  refine ⟨fun _ column ↦ centeredSmudge (fun coefficient ↦
    digit (readoutMemberN (select column) coefficient)), ?_, ?_⟩
  · intro _ column coefficient
    exact centeredSmudge_bound hn hP _ (fun _ ↦ hodd _) (fun _ ↦ hbound _) coefficient
  · rw [allCoefficients_reduce]
    funext row column
    change reducePoly q n (placedReadoutN ν (select column)) * half -
      reducePoly q n (intPoly (fun _ ↦ half)) = _
    rw [placedReadoutN_reduce ν digit hν]
    exact smudge_coefficientwise_offset hhalf _ (fun _ ↦ hodd _)

/-- The centered interval of one odd smudge digit `|δ| ≤ P - 1` (`P` even):
`-(P / 2) ≤ (δ - 1) / 2 ≤ P / 2 - 1` (`smudge_half_digit_range` is `P = 8`). -/
theorem smudge_half_digit_range_gen {P : Nat} (hP : P % 2 = 0) (digit : Int)
    (hodd : digit % 2 = 1) (hbound : |digit| ≤ (P : Int) - 1) :
    -((P / 2 : Nat) : Int) ≤ (digit - 1) / 2 ∧ (digit - 1) / 2 ≤ ((P / 2 : Nat) : Int) - 1 := by
  have := abs_le.mp hbound
  have := smudge_one_digit_two_mul hP digit hodd
  omega

/-- CBD fresh values packed into columns keep coefficient bound one, for any `n`
(`online0_fresh_values` is `n = 8`). -/
theorem fresh_values_gen {columns : Nat} (hn : 0 < n) (ν : Fin (n * columns) → ErrorPoly n)
    (value : Fin (n * columns) → Int) (hν : ∀ member, ν member = (value member : ErrorPoly n))
    (hbound : ∀ member, (value member).natAbs ≤ 1)
    {width : Nat} (select : Fin width → Fin columns) :
    CoeffBound (fun _ column ↦ placedReadoutN ν (select column) : ErrorMatrix n 1 width) 1 := by
  intro row column coefficient
  change ((placedReadoutN ν (select column)).coeff coefficient).natAbs ≤ 1
  rw [placedReadoutN_eq ν value hν, intPoly_coeff hn]
  exact hbound _

/-- Modular CBD fresh outputs admit representatives of bound one, for any `n`
(`online0_fresh_value_representatives` is `n = 8`). -/
theorem fresh_value_representatives_gen {q columns : Nat} (hn : 0 < n)
    (ν : Fin (n * columns) → ErrorPoly n) (value : Fin (n * columns) → Int)
    (hν : ∀ member, reducePoly q n (ν member) = reducePoly q n (value member : ErrorPoly n))
    (hbound : ∀ member, (value member).natAbs ≤ 1)
    {width : Nat} (select : Fin width → Fin columns) :
    ∃ noise : ErrorMatrix n 1 width, CoeffBound noise 1 ∧
      (fun _ column ↦ reducePoly q n (placedReadoutN ν (select column))) =
        reduceMatrix q n 1 width noise := by
  refine ⟨fun _ column ↦ intPoly (fun coefficient ↦
    value (readoutMemberN (select column) coefficient)), ?_, ?_⟩
  · intro row column coefficient
    rw [intPoly_coeff hn]
    exact hbound _
  · funext row column
    exact placedReadoutN_reduce ν value hν (select column)

/-- The plaintext of cell `cc` of a column total over the members `n cc + j`, for any `n`
(`cellVal` is `n = 8`). -/
noncomputable def cellValN {F C : Nat} (hF : n * C ≤ F) (Δ : ErrorPoly n)
    (ν : Fin F → ErrorPoly n) (cc : Fin C) : ErrorPoly n :=
  ∑ j : Fin n, Xe (n := n) (j : Nat) * (Δ * ν ⟨n * cc + j, by
    have hc := cc.isLt
    have hj := j.isLt
    calc n * cc.val + j.val < n * cc.val + n := by omega
      _ = n * (cc.val + 1) := by ring
      _ ≤ n * C := Nat.mul_le_mul_left _ hc
      _ ≤ F := hF⟩)

theorem cellValN_eight {F C : Nat} (hF : 8 * C ≤ F) (Δ : ErrorPoly 8) (ν : Fin F → ErrorPoly 8)
    (cc : Fin C) : cellValN (n := 8) hF Δ ν cc = cellVal hF Δ ν cc := rfl

/-- A unit-scale cell is the packed readout, for any `n` (`cellVal_one_placedReadout` is
`n = 8`). -/
theorem cellValN_one_placedReadout {columns : Nat} (ν : Fin (n * columns) → ErrorPoly n)
    (column : Fin columns) :
    cellValN (le_refl (n * columns)) 1 ν column = placedReadoutN ν column := by
  unfold cellValN placedReadoutN
  apply Finset.sum_congr rfl
  intro coefficient _
  simp only [one_mul, readoutMemberN_mod]
  rfl

/-- Part `(target, component)` at position `2 target + component` of the `2 T`-part loop
(`StepTransition.partIndex` is `T = 18`). -/
def partIndexGen {T : Nat} (target : Fin T) (component : Fin 2) : Fin (2 * T) :=
  ⟨2 * target.val + component.val, by have := target.isLt; have := component.isLt; omega⟩

theorem partIndexGen_val_toy (target : Fin 18) (component : Fin 2) :
    (partIndexGen target component).val = (StepTransition.partIndex target component).val := rfl

/-- The smudge column `k m · part + m · prime + column` of part `part`, prime `prime` and column
`column` (`k` primes, `m` columns per row; `smudgePartColumn` is `parts = 36`, `k = 5`,
`m = 25`). -/
def smudgePartColumnGen {parts k m : Nat} (part : Fin parts) (prime : Fin k) (column : Fin m) :
    Fin (parts * (k * m)) :=
  ⟨k * m * part.val + m * prime.val + column.val, by
    have h1 : m * prime.val + column.val < m * k := by
      have := column.isLt
      calc m * prime.val + column.val < m * prime.val + m := by omega
        _ = m * (prime.val + 1) := by ring
        _ ≤ m * k := Nat.mul_le_mul_left _ prime.isLt
    calc k * m * part.val + m * prime.val + column.val < k * m * part.val + m * k := by omega
      _ = (part.val + 1) * (k * m) := by ring
      _ ≤ parts * (k * m) := Nat.mul_le_mul_right _ part.isLt⟩

theorem smudgePartColumnGen_val_toy (part : Fin 36) (prime : Fin 5) (column : Fin 25) :
    (smudgePartColumnGen part prime column).val = (smudgePartColumn part prime column).val := by
  simp only [smudgePartColumnGen, smudgePartColumn]

/-- The fresh column `m · part + column` of part `part` (`freshPartColumn` is `parts = 36`,
`m = 25`). -/
def freshPartColumnGen {parts m : Nat} (part : Fin parts) (column : Fin m) : Fin (parts * m) :=
  ⟨m * part.val + column.val, by
    have := column.isLt
    calc m * part.val + column.val < m * part.val + m := by omega
      _ = (part.val + 1) * m := by ring
      _ ≤ parts * m := Nat.mul_le_mul_right _ part.isLt⟩

theorem freshPartColumnGen_val_toy (part : Fin 36) (column : Fin 25) :
    (freshPartColumnGen part column).val = (freshPartColumn part column).val := rfl

end Dio2Proof
