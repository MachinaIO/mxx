theorem pre_root0 {ctx : generatedRoot.Ctx Backend.backend model tape path params}
    {outputs : _} (F : generatedRoot.Facts ctx outputs)
    {A : Fin 2 → Fin 2 → ExactMatrix Q N 1 30}
    (hA0 : concatColumns (A 0 0) (A 0 1) (generatedRoot.w_6_0 ctx))
    (hA1 : concatColumns (A 1 0) (A 1 1) (generatedRoot.w_9_0 ctx))
    (p : Fin 2) (hp : generatedRoot.w_0_0 ctx 0 = p) :
    (∀ r (j : Fin 2) (l : Fin 30), preM_0 ctx r j 0 l =
      ∑ a, keyCompanionSum model (generatedRoot.w_3_0 ctx) p A r ⟨30 * (j : Nat) + l, by omega⟩ a +
      ∑ a : Fin 30, A r 0 0 a *
        rowDigits (joinRow ![rhsTop model (generatedRoot.w_3_0 ctx) p 0,
          rhsTop model (generatedRoot.w_3_0 ctx) p 1]) a ⟨30 * (j : Nat) + l, by omega⟩) ∧
    (∀ d1 : BranchData, d1.key = generatedRoot.w_3_0 ctx →
      d1.TI0 = generatedRoot.w_30_0 ctx → d1.TI1 = generatedRoot.w_30_1 ctx →
      d1.TL0 = generatedRoot.w_31_0 ctx → d1.TL1 = generatedRoot.w_31_1 ctx →
      ∀ (b : Fin 30) r jj, ![d1.Tb0 b b.isLt, d1.Tb1 b b.isLt] r 0 jj =
        ∑ a, lutKeyCompanionSum model (generatedRoot.w_3_0 ctx) b (preM_0 ctx) r jj a +
        ∑ a : Fin 30, substitution (kSw b) (kSw_odd b) (preM_0 ctx r 0 0 a) *
          rowDigits (switchTopRow model (generatedRoot.w_3_0 ctx) b) a jj) ∧
    (∀ (d1 : BranchData) (d2 : Leaf2Data), d1.key = generatedRoot.w_3_0 ctx →
      d1.TI0 = generatedRoot.w_30_0 ctx → d1.TI1 = generatedRoot.w_30_1 ctx →
      d1.TL0 = generatedRoot.w_31_0 ctx → d1.TL1 = generatedRoot.w_31_1 ctx →
      d2.key = generatedRoot.w_3_0 ctx → d2.T0 = groupedPreLeafRows (preLeafT_0 ctx) 0 →
      d2.T1 = groupedPreLeafRows (preLeafT_0 ctx) 1 →
      (∀ (l : Fin 225) r jj, ![d2.Tb0 l l.isLt, d2.Tb1 l l.isLt] r 0 jj =
        ∑ a, lutKeyCompanionSum model (generatedRoot.w_3_0 ctx) (member2 l l.isLt)
          (d1.key1 model ⟨l % 15, by omega⟩) r jj a +
        ∑ a : Fin 30, substitution (kSw (15 + l / 15)) (kSw_odd (member2 l l.isLt))
          (d1.key1 model ⟨l % 15, by omega⟩ r 0 0 a) *
          rowDigits (switchTopRow model (generatedRoot.w_3_0 ctx) (member2 l l.isLt)) a jj) ∧
      keyOf (generatedRoot.w_112_0 ctx, generatedRoot.w_118_0 ctx, generatedRoot.w_124_0 ctx,
          generatedRoot.w_130_0 ctx, ()) =
        stepKey model (preM_0 ctx) d1 d2
          (fun k ↦ branchCoef (generatedRoot.w_29_0 ctx) 0 k (by norm_num))) := by
  -- The position of the step.
  have hw1 : generatedRoot.w_1_0 ctx = ((p : Nat) : Int) := by
    rw [familyStatic_four (k := 0) (by norm_num) F.c0.h1_0, ← hp]
    rfl
  -- The product key at row `r`, block `j` of each position.
  have P0 : ∀ r (j : Fin 2) (l : Fin 30),
      ![![generatedRoot.w_12_0 ctx, generatedRoot.w_18_0 ctx],
        ![generatedRoot.w_21_0 ctx, generatedRoot.w_24_0 ctx]] r j 0 l =
      ∑ a, keyCompanionSum model (generatedRoot.w_3_0 ctx) 0 A r ⟨30 * (j : Nat) + l, by omega⟩ a +
      ∑ a : Fin 30, A r 0 0 a *
        rowDigits (joinRow ![rhsTop model (generatedRoot.w_3_0 ctx) 0 0,
          rhsTop model (generatedRoot.w_3_0 ctx) 0 1]) a ⟨30 * (j : Nat) + l, by omega⟩ := by
    have R := pos_rows hA0 hA1
      (comp := fun k jj a ↦ keyCompanionSum model (generatedRoot.w_3_0 ctx) 0 A k jj a)
      (X := joinRow ![rhsTop model (generatedRoot.w_3_0 ctx) 0 0, rhsTop model (generatedRoot.w_3_0 ctx) 0 1])
