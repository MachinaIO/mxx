/-- The numerator `A v` of the alignment of a member of `a`: its error after the digits `H`, minus
the row residue, plus the mask-weighted key residues. -/
noncomputable def alignNumer29 (sm : ErrorPoly N) (mk : Fin 2 → Fin 2 → ExactMatrix Q36 N 1 144)
    (ea : Fin 2 → ErrorMatrix N 1 144) (row : Fin 2 → ExactMatrix Q36 N 1 144) (j : Fin 2) :
    ErrorMatrix N 1 28 :=
  ea j * liftMatrix alignDigits29 - downResidue A7 (row j * alignDigits29) +
    sm • downResidue A7 (mk 0 j * alignDigits29) + downResidue A7 (mk 1 j * alignDigits29)

/-- The numerator `p v` of a block-1 cell. -/
noncomputable def cellNumer29 (sm : ErrorPoly N) (mk : Fin 2 → Fin 2 → ExactMatrix Q36 N 1 144)
    (va : Fin 2 → ErrorMatrix N 1 28) (es : Fin 2 → ErrorMatrix N 1 24) (α : ErrorPoly N)
    (As : Fin 2 → Fin 2 → ExactMatrix Q7 N 1 24) (top bot : Fin 2 → ExactMatrix Q6 N 1 20)
    (crow : Fin 2 → ExactMatrix Q7 N 1 28) (cs : Fin 2 → ExactMatrix Q7 N 1 24)
    (pay : ExactMatrix Q7 N 1 1) (j : Fin 2) : ErrorMatrix N 1 20 :=
  pairMul (fun j' ↦ pairMul va (liftMatrix (pubDigits29 As j')) + α • es j')
      (liftMatrix (rhsDigits29 top bot j)) -
    downResidue P7 (pairMul (fun j' ↦ pairMul crow (pubDigits29 As j') +
      matrixMulScalarRight (cs j') pay) (rhsDigits29 top bot j)) +
    sm • downResidue P7 (cellKeyUp29 mk As top bot 0 j) + downResidue P7 (cellKeyUp29 mk As top bot 1 j)

