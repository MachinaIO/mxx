  · calc
      _ = (W_Stage_keys_online_0_0.parallel_generatedRoot_985.w_49_0 keyCtx) := leftRow
      _ = _ := by
        have split := concatColumns_mul F.c0.h2_0 (W_Stage_keys_online_0_0.parallel_generatedRoot_985.w_7_0 keyCtx)
        exact congrArg (fun product ↦ product - (W_Stage_keys_online_0_0.parallel_generatedRoot_985.w_9_0 keyCtx) * (W_Stage_keys_online_0_0.parallel_generatedRoot_985.w_21_0 keyCtx) +
