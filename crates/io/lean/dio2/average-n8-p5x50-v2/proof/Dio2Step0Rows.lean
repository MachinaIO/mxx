/-- Every actual refresh part returns its common CRT row. -/
theorem rows {model : HashModel} {ctx : OnlineCtx model} {outputs : _}
    (facts : generatedRoot.Facts ctx outputs)
    {kctx : KeyCtx model} {koutputs : _}
    (kfacts : W_Stage_keys_online_0_0.generatedRoot.Facts kctx koutputs)
    (links : KeyLinks ctx kctx)
    {anchor : ExactMatrix modulus_0 8 2 54} {old payload next result : ErrorPoly 8}
    {fresh : Fin 900 → ErrorPoly 8} {smudge : Fin 4500 → ErrorPoly 8}
    (R : Online0Sources.Relations ctx anchor old payload next result fresh smudge)
    (solved0 : ∀ part : Fin 36, SolvedPreimage anchor
      (W_Stage_keys_online_0_0.generatedRoot.w_984_0 kctx part) (generatedRoot.w_1_0 ctx part) cutoff)
    (solved1 : ∀ part : Fin 36, SolvedPreimage anchor
      (W_Stage_keys_online_0_0.generatedRoot.w_985_0 kctx part) (generatedRoot.w_987_0 ctx part) cutoff)
    (solved2 : ∀ part : Fin 36, SolvedPreimage anchor
      (W_Stage_keys_online_0_0.generatedRoot.w_986_0 kctx part) (generatedRoot.w_988_0 ctx part) cutoff)
    (solved3 : ∀ part : Fin 36, SolvedPreimage anchor
      (W_Stage_keys_online_0_0.generatedRoot.w_987_0 kctx part) (generatedRoot.w_989_0 ctx part) cutoff)
    (solved4 : ∀ part : Fin 36, SolvedPreimage anchor
      (W_Stage_keys_online_0_0.generatedRoot.w_988_0 kctx part) (generatedRoot.w_990_0 ctx part) cutoff)
    {target : Fin 36 → ErrorPoly 8} (targets : TargetRows ctx old target) :
    ∀ part, generatedRoot.w_991_0 ctx part =
      rowValue ctx next target fresh part :=
  StepTransition.part_family ctx facts _ fun part local_ hin pf prime ↦ by
    fin_cases prime
    exacts [part_term0 facts kfacts links R solved0 targets part local_ hin pf, part_term1 facts kfacts links R solved1 targets part local_ hin pf, part_term2 facts kfacts links R solved2 targets part local_ hin pf, part_term3 facts kfacts links R solved3 targets part local_ hin pf, part_term4 facts kfacts links R solved4 targets part local_ hin pf]

end Step0Rows

