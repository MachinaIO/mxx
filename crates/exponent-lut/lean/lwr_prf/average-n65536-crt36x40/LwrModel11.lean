/-- The numerator `A v` of the alignment of a member of `a`: its error after the digits `H`, minus
the row residue, plus the mask-weighted key residues. -/
noncomputable def alignNumer11 (sm : ErrorPoly N) (mk : Fin 2 → Fin 2 → ExactMatrix Q36 N 1 144)
    (ea : Fin 2 → ErrorMatrix N 1 144) (row : Fin 2 → ExactMatrix Q36 N 1 144) (j : Fin 2) :
    ErrorMatrix N 1 100 :=
  ea j * liftMatrix alignDigits11 - downResidue A25 (row j * alignDigits11) +
    sm • downResidue A25 (mk 0 j * alignDigits11) + downResidue A25 (mk 1 j * alignDigits11)

/-- The numerator `p v` of a block-1 cell. -/
noncomputable def cellNumer11 (sm : ErrorPoly N) (mk : Fin 2 → Fin 2 → ExactMatrix Q36 N 1 144)
    (va : Fin 2 → ErrorMatrix N 1 100) (es : Fin 2 → ErrorMatrix N 1 96) (α : ErrorPoly N)
    (As : Fin 2 → Fin 2 → ExactMatrix Q25 N 1 96) (top bot : Fin 2 → ExactMatrix Q24 N 1 92)
    (crow : Fin 2 → ExactMatrix Q25 N 1 100) (cs : Fin 2 → ExactMatrix Q25 N 1 96)
    (pay : ExactMatrix Q25 N 1 1) (j : Fin 2) : ErrorMatrix N 1 92 :=
  pairMul (fun j' ↦ pairMul va (liftMatrix (pubDigits11 As j')) + α • es j')
      (liftMatrix (rhsDigits11 top bot j)) -
    downResidue P25 (pairMul (fun j' ↦ pairMul crow (pubDigits11 As j') +
      matrixMulScalarRight (cs j') pay) (rhsDigits11 top bot j)) +
    sm • downResidue P25 (cellKeyUp11 mk As top bot 0 j) + downResidue P25 (cellKeyUp11 mk As top bot 1 j)

