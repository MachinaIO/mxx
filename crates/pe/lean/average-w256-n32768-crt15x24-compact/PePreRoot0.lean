    have hs' : ∀ r j, keyOf (generatedRoot.w_112_0 ctx, generatedRoot.w_118_0 ctx,
        generatedRoot.w_124_0 ctx, generatedRoot.w_130_0 ctx, ()) r j =
        preM_0 ctx r j * generatedRoot.w_41_0 ctx +
        keyOf (generatedRoot.w_55_0 ctx, generatedRoot.w_55_1 ctx, generatedRoot.w_55_2 ctx,
