section Model4

variable (model : HashModel) (key : ByteArray) (ext : GeneratedClaim.ExternalInputs)

/-- The state rows entering block `4`. -/
noncomputable def stateRow4 (tape : SampleTape) : Fin 2 → ExactMatrix Q3 N 1 4 :=
  encRow (maskM tape) (key4 model key ext tape) (stateTarget4 ext tape) (err4 model key ext tape)

/-- The selector RHS bottoms of block `4`. -/
noncomputable def bot4 (tape : SampleTape) (i : Fin 14) (j : Fin 2) : ExactMatrix Q2 N 1 2 :=
  reducePoly Q2 N (((P2 : Nat) : Int) * nuOf ext 4 i * unitPair (payloadM tape) j) • gReb Q2 Q1 2 +
    reduceMatrix Q2 N 1 2 (rhsError4 tape [2] i j) -
    reducePoly Q2 N (payloadM tape) • rhsTop model key Q2 2 rhsPrefix4 i j

/-- The keys entering block `5`. -/
noncomputable def key5 (tape : SampleTape) : Fin 2 → Fin 2 → ExactMatrix Q2 N 1 2 :=
  ∑ i : Fin 14, fun k j ↦ theOutput (blockModSwitchRuns [1099511626049, 1099511625409, 1099511623297] 1)
    (cellKeyUp4 (memberKey model key ((coords 4 i : Nat) : Int)) (key4 model key ext tape)
      (rhsTop model key Q2 2 rhsPrefix4 i) (bot4 model key ext tape i) k j)

/-- The alignment numerator of the member of cell `i` of block `4` in the model. -/
noncomputable def alignM4 (tape : SampleTape) (i : Fin 14) (j : Fin 2) : ErrorMatrix N 1 6 :=
  alignNumer4 (maskM tape) (memberKey model key ((coords 4 i : Nat) : Int))
    (memberError tape [3] ⟨coords 4 i, coords_lt 4 i⟩) (memberRow model key ext tape ⟨coords 4 i, coords_lt 4 i⟩) j

/-- The numerator of cell `i` of block `4` in the model. -/
noncomputable def numerM4 (tape : SampleTape) (i : Fin 14) (j : Fin 2) : ErrorMatrix N 1 2 :=
  cellNumer4 (maskM tape)
      (memberKey model key ((coords 4 i : Nat) : Int))
      (fun j' ↦ divInt A3 (alignM4 model key ext tape i j'))
      (err4 model key ext tape) (alphaOf ext ⟨coords 4 i, coords_lt 4 i⟩) (key4 model key ext tape)
      (rhsTop model key Q2 2 rhsPrefix4 i) (bot4 model key ext tape i)
      (fun j' ↦ theOutput (blockModSwitchRuns [1099511626049, 1099511625409, 1099511623297, 1099511622593, 1099511622529, 1099511621249, 1099511619841] 1) (memberRow model key ext tape ⟨coords 4 i, coords_lt 4 i⟩ j' * alignDigits4))
      (stateRow4 model key ext tape) (fun _ _ ↦ reducePoly Q3 N (alphaOf ext ⟨coords 4 i, coords_lt 4 i⟩)) j

/-- The error entering block `5`. -/
noncomputable def err5 (tape : SampleTape) : Fin 2 → ErrorMatrix N 1 2 :=
  ∑ i : Fin 14, fun j ↦ divInt P3 (numerM4 model key ext tape i j) -
    (alphaOf ext ⟨coords 4 i, coords_lt 4 i⟩ * muOf ext 4) • rhsError4 tape [2] i j

/-- The alignment and cell numerators of block `4` are divisible by their dropped factors. -/
def div4 (tape : SampleTape) : Prop :=
  (∀ i j row column, alignM4 model key ext tape i j row column =
    ((A3 : Int) : ErrorPoly N) * divInt A3 (alignM4 model key ext tape i j) row column) ∧
  ∀ i j row column, numerM4 model key ext tape i j row column =
    ((P3 : Int) : ErrorPoly N) * divInt P3 (numerM4 model key ext tape i j) row column

/-- The state target of block `5` at `Q2`. -/
noncomputable def stateTarget5 (tape : SampleTape) (j : Fin 2) : ExactMatrix Q2 N 1 2 :=
  reducePoly Q2 N (((P2 : Nat) : Int) * muOf ext 5 * unitPair (payloadM tape) j) • gReb Q2 Q1 2

end Model4


