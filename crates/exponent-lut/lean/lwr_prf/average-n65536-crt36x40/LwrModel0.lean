/-! ## Cell numerators -/

/-- The numerator `p v` of a block-0 cell: the member error and the state error after the public
digits, after the private digits, minus the row residue, plus the mask-weighted key residues. -/
noncomputable def cellNumer0 (sm : ErrorPoly N) (mk : Fin 2 → Fin 2 → ExactMatrix Q36 N 1 144)
    (ea : Fin 2 → ErrorMatrix N 1 144) (es : Fin 2 → ErrorMatrix N 1 140) (α : ErrorPoly N)
    (As : Fin 2 → Fin 2 → ExactMatrix Q36 N 1 140) (top bot : Fin 2 → ExactMatrix Q35 N 1 136)
    (crow : Fin 2 → ExactMatrix Q36 N 1 144) (cs : Fin 2 → ExactMatrix Q36 N 1 140)
    (pay : ExactMatrix Q36 N 1 1) (j : Fin 2) : ErrorMatrix N 1 136 :=
  pairMul (fun j' ↦ pairMul ea (liftMatrix (pubDigits0 As j')) + α • es j')
      (liftMatrix (rhsDigits0 top bot j)) -
    downResidue P36 (pairMul (fun j' ↦ pairMul crow (pubDigits0 As j') +
      matrixMulScalarRight (cs j') pay) (rhsDigits0 top bot j)) +
    sm • downResidue P36 (cellKeyUp0 mk As top bot 0 j) + downResidue P36 (cellKeyUp0 mk As top bot 1 j)

set_option maxHeartbeats 16000000 in
set_option maxRecDepth 100000 in
