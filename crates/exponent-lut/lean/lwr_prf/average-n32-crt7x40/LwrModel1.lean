section Model1

variable (model : HashModel) (key : ByteArray) (ext : GeneratedClaim.ExternalInputs)

/-- The state rows entering block `1`. -/
noncomputable def stateRow1 (tape : SampleTape) : Fin 2 → ExactMatrix Q6 N 1 10 :=
  encRow (maskM tape) (key1 model key ext tape) (stateTarget1 ext tape) (err1 model key ext tape)

/-- The selector RHS bottoms of block `1`. -/
noncomputable def bot1 (tape : SampleTape) (i : Fin 14) (j : Fin 2) : ExactMatrix Q5 N 1 8 :=
  reducePoly Q5 N (((P5 : Nat) : Int) * nuOf ext 1 i * unitPair (payloadM tape) j) • gReb Q5 Q4 8 +
    reduceMatrix Q5 N 1 8 (rhsError1 tape [2] i j) -
    reducePoly Q5 N (payloadM tape) • rhsTop model key Q5 8 rhsPrefix1 i j

/-- The keys entering block `2`. -/
noncomputable def key2 (tape : SampleTape) : Fin 2 → Fin 2 → ExactMatrix Q5 N 1 8 :=
  ∑ i : Fin 14, fun k j ↦ theOutput (blockModSwitchRuns [1099511626049, 1099511625409, 1099511623297, 1099511622593, 1099511622529, 1099511621249] 1)
    (cellKeyUp1 (memberKey model key ((coords 1 i : Nat) : Int)) (key1 model key ext tape)
      (rhsTop model key Q5 8 rhsPrefix1 i) (bot1 model key ext tape i) k j)

/-- The alignment numerator of the member of cell `i` of block `1` in the model. -/
noncomputable def alignM1 (tape : SampleTape) (i : Fin 14) (j : Fin 2) : ErrorMatrix N 1 12 :=
  alignNumer1 (maskM tape) (memberKey model key ((coords 1 i : Nat) : Int))
    (memberError tape [3] ⟨coords 1 i, coords_lt 1 i⟩) (memberRow model key ext tape ⟨coords 1 i, coords_lt 1 i⟩) j

/-- The numerator of cell `i` of block `1` in the model. -/
noncomputable def numerM1 (tape : SampleTape) (i : Fin 14) (j : Fin 2) : ErrorMatrix N 1 8 :=
  cellNumer1 (maskM tape)
      (memberKey model key ((coords 1 i : Nat) : Int))
      (fun j' ↦ divInt A6 (alignM1 model key ext tape i j'))
      (err1 model key ext tape) (alphaOf ext ⟨coords 1 i, coords_lt 1 i⟩) (key1 model key ext tape)
      (rhsTop model key Q5 8 rhsPrefix1 i) (bot1 model key ext tape i)
      (fun j' ↦ theOutput (blockModSwitchRuns [1099511626049, 1099511625409, 1099511623297, 1099511622593, 1099511622529, 1099511621249, 1099511619841] 1) (memberRow model key ext tape ⟨coords 1 i, coords_lt 1 i⟩ j' * alignDigits1))
      (stateRow1 model key ext tape) (fun _ _ ↦ reducePoly Q6 N (alphaOf ext ⟨coords 1 i, coords_lt 1 i⟩)) j

/-- The error entering block `2`. -/
noncomputable def err2 (tape : SampleTape) : Fin 2 → ErrorMatrix N 1 8 :=
  ∑ i : Fin 14, fun j ↦ divInt P6 (numerM1 model key ext tape i j) -
    (alphaOf ext ⟨coords 1 i, coords_lt 1 i⟩ * muOf ext 1) • rhsError1 tape [2] i j

/-- The alignment and cell numerators of block `1` are divisible by their dropped factors. -/
def div1 (tape : SampleTape) : Prop :=
  (∀ i j row column, alignM1 model key ext tape i j row column =
    ((A6 : Int) : ErrorPoly N) * divInt A6 (alignM1 model key ext tape i j) row column) ∧
  ∀ i j row column, numerM1 model key ext tape i j row column =
    ((P6 : Int) : ErrorPoly N) * divInt P6 (numerM1 model key ext tape i j) row column

/-- The state target of block `2` at `Q5`. -/
noncomputable def stateTarget2 (tape : SampleTape) (j : Fin 2) : ExactMatrix Q5 N 1 8 :=
  reducePoly Q5 N (((P5 : Nat) : Int) * muOf ext 2 * unitPair (payloadM tape) j) • gReb Q5 Q4 8

end Model1


