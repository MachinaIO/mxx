    have rebaseEq := centeredRebaseRuns_unique lc11 rc11
    change gadgetDecomposeRuns backend 4096 25
      (matrixMulScalarRight leftrebased (matrixPolynomial [1])) leftraw at lc12
    rw [rebaseEq] at lc12
    have rawEq := gadgetDecomposeRuns_unique lc12 rc12
    rw [rawEq] at lc13
    have actionEq := compactCenteredRebaseRuns_unique lc13 rc13
    have sliceFact0 := lc20
    have sliceFact1 := lc27
    change sliceMatrix (W_Stage_keys_online_0_0.parallel_generatedRoot_987.w_46_0 keyCtx) 0 1 _ _ leftslice0 at sliceFact0
    change sliceMatrix (W_Stage_keys_online_0_0.parallel_generatedRoot_987.w_47_0 keyCtx) 0 1 _ _ leftslice1 at sliceFact1
    rw [key0Eq] at sliceFact0
    rw [key1Eq] at sliceFact1
    have sliceEq0 := sliceMatrix_unique sliceFact0 rc20
    have sliceEq1 := sliceMatrix_unique sliceFact1 rc27
    have previous0 := congrArg Prod.fst previous
    have previous1 := congrArg Prod.snd previous
    change lc.2.1 = rc.2.1 at previous0
    change lc.2.2.1 = rc.2.2.1 at previous1
    rw [lc28, rc28]
    change (lc.2.1 + leftslice0 * leftaction, lc.2.2.1 + leftslice1 * leftaction) =
      (rc.2.1 + rightslice0 * rightaction, rc.2.2.1 + rightslice1 * rightaction)
    rw [previous0, previous1, sliceEq0, sliceEq1, actionEq]
  intro component
  fin_cases component
  · exact congrArg Prod.fst loopEq0
  · exact congrArg Prod.snd loopEq1

