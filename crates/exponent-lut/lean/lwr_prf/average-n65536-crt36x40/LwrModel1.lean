/-- The selector RHS bottoms of block `1`. -/
noncomputable def bot1 (tape : SampleTape) (i : Fin 113) (j : Fin 2) : ExactMatrix Q34 N 1 132 :=
  reducePoly Q34 N (((P34 : Nat) : Int) * nuOf ext 1 i * unitPair (payloadM tape) j) • gReb Q34 Q33 132 +
    reduceMatrix Q34 N 1 132 (rhsError1 tape [2] i j) -
    reducePoly Q34 N (payloadM tape) • rhsTop model key Q34 132 rhsPrefix1 i j

/-- The keys entering block `2`. -/
