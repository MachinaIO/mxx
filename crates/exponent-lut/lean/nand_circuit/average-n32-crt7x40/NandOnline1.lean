/-- Branch `i` of the round-1 LUT, zero past the sixteen branches. -/
noncomputable def branchTarget1 (μ sp : ErrorPoly N)
    (fam : Fin 2 → Fin 2 → Fin 16 → ExactMatrix Q5 N 1 10) (i : Nat) : Fin 2 → ExactMatrix Q6 N 1 10 :=
  if h : i < 16 then branchTarget (q := Q6) (p := P6) μ sp fam ⟨i, h⟩ else 0

/-- The generated round-1 loop accumulates the first fifteen branches and carries the switching
ciphertext of branch `15`. -/
theorem loop1 {model : HashModel} {key : ByteArray} {sm sp μ : ErrorPoly N}
    (hsm : polyNorm sm ≤ 1)
    {g' : ExactMatrix Q5 N 1 10} {g : ExactMatrix Q6 N 1 10}
    (hg' : gadgetMatrixRuns Backend.backend 1048576 10 g') (hg : centeredRebaseRuns g' g)
    {c : Fin 2 → ExactMatrix Q6 N 1 10} {A : Fin 2 → Fin 2 → ExactMatrix Q6 N 1 10} {B : Nat}
    (henc : Rel sm A (fun j ↦ reducePoly Q6 N (((P6 : Nat) : Int) * μ * unitPair sp j) • g) c B)
    {h0 h1 : Fin 16 → ExactMatrix Q6 N 1 10}
    (hhelp : ∀ i : Fin 16, Rel sm (lutA model key Q6 10 3 (sigma i))
      (fun j ↦ reducePoly Q6 N (((P6 : Nat) : Int) *
        unitPair (substitution (sigma i).toNat (sigma_odd i) sm) j) • g) ![h0 i, h1 i] 26)
    {fam : Fin 2 → Fin 2 → Fin 16 → ExactMatrix Q5 N 1 10} {count : Nat} (hcount : count ≤ 15)
    {final : LoopState Q6 Q5 10}
    (hruns : MxxIR.IterRuns (fun (i : Nat) (current next : LoopState Q6 Q5 10) ↦
      Stage_online.sequential_generatedRoot_159 Backend.backend model tape (loopPaths i) GeneratedClaim.stage_4_params i
        (current.1, current.2.1, current.2.2.1, current.2.2.2.1, current.2.2.2.2.1,
