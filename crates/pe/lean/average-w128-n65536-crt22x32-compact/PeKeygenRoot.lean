/-- The extension samples of key generation. -/
theorem keygen_samples {model : HashModel} {tape : SampleTape} {path : List Nat}
    {ctx : Stage_keygen.generatedRoot.Ctx Backend.backend model tape path GeneratedClaim.stage_6_params}
    {o : KeygenOutputs} (F : Stage_keygen.generatedRoot.Facts ctx o) :
    (∀ i : Fin 4736, Stage_keygen.generatedRoot.w_10_0 ctx i =
      reduceMatrix Q N 88 1 (keySample tape (path ++ [10, (i : Nat)] ++ [0])) ∧
      Stage_keygen.generatedRoot.w_10_1 ctx i = Stage_keygen.generatedRoot.w_10_0 ctx i ∧
      CoeffBound (keySample (rows := 88) tape (path ++ [10, (i : Nat)] ++ [0])) keyCutoff) ∧
    (∀ i : Fin 128, Stage_keygen.generatedRoot.w_21_0 ctx i =
      reduceMatrix Q N 44 1 (keySample tape (path ++ [21, (i : Nat)] ++ [0])) ∧
      Stage_keygen.generatedRoot.w_21_1 ctx i = Stage_keygen.generatedRoot.w_21_0 ctx i ∧
      CoeffBound (keySample (rows := 44) tape (path ++ [21, (i : Nat)] ++ [0])) keyCutoff) ∧
    (∀ i : Fin 128, Stage_keygen.generatedRoot.w_22_0 ctx i =
      reduceMatrix Q N 1 1 (keySample tape (path ++ [22, (i : Nat)] ++ [0])) ∧
      Stage_keygen.generatedRoot.w_22_1 ctx i = Stage_keygen.generatedRoot.w_22_0 ctx i ∧
      CoeffBound (keySample (rows := 1) tape (path ++ [22, (i : Nat)] ++ [0])) keyCutoff) := by
  refine ⟨fun i ↦ ?_, fun i ↦ ?_, fun i ↦ ?_⟩
  · obtain ⟨x, hx, hout⟩ := F.c0.h10_1 i
    obtain ⟨ex, bx⟩ := key_sample hx
    simp only [Prod.mk.injEq] at hout
    obtain ⟨o0, o1, -⟩ := hout
    refine ⟨o0.trans ex, ?_, bx⟩
    rw [o1, o0, matrixMul_eq_mul, Matrix.one_mul]
  · obtain ⟨x, hx, hout⟩ := F.c0.h21_1 i
    obtain ⟨ex, bx⟩ := key_sample hx
    simp only [Prod.mk.injEq] at hout
    obtain ⟨o0, o1, -⟩ := hout
    refine ⟨o0.trans ex, ?_, bx⟩
    rw [o1, o0, matrixMul_eq_mul, Matrix.one_mul]
  · obtain ⟨x, hx, hout⟩ := F.c0.h22_1 i
    obtain ⟨ex, bx⟩ := key_sample hx
    simp only [Prod.mk.injEq] at hout
    obtain ⟨o0, o1, -⟩ := hout
    refine ⟨o0.trans ex, ?_, bx⟩
    rw [o1, o0, matrixMulScalarLeft_eq, Matrix.one_apply_eq, one_smul]

