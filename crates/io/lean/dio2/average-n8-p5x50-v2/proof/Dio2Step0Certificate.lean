/-- A complete label forest uses the certified sharp budget for each member. -/
theorem online0_label_target_certified {backend : BackendContext} {hashModel : HashModel} {params : Params}
    (member : Fin 5) (ctx : parallel_generatedRoot_660.Ctx backend hashModel params member.val)
    {outputs : _} (F : parallel_generatedRoot_660.Facts ctx outputs)
    {sm : ErrorPoly 8}  {ts : Fin 2 → ExactMatrix modulus_0 8 1 25}
    (hn : 0 < 8) (hq : 1 < modulus_0) (layout : RegularLayout modulus_0)
    (hlayout : backend.regularLayout modulus_0 8 = some layout) (hexact : layout.droppedModuli = 0)
    (hG : gadgetMatrixRuns backend 4096 25 (parallel_generatedRoot_660.w_35_0 ctx))
    (hleaves : ∀ index : Fin 4, Online0Labels.Node sm (parallel_generatedRoot_660.w_35_0 ctx) 1 (parallel_generatedRoot_660.w_31_0 ctx index) (parallel_generatedRoot_660.w_31_1 ctx index) (parallel_generatedRoot_660.w_31_2 ctx index) (parallel_generatedRoot_660.w_31_3 ctx index) (parallel_generatedRoot_660.w_31_4 ctx index) (parallel_generatedRoot_660.w_31_5 ctx index) (parallel_generatedRoot_660.w_31_6 ctx index))
    (hs : Rel sm ![![parallel_generatedRoot_660.w_42_0 ctx, parallel_generatedRoot_660.w_55_0 ctx], ![parallel_generatedRoot_660.w_47_0 ctx, parallel_generatedRoot_660.w_58_0 ctx]]
      ts ![parallel_generatedRoot_660.w_52_0 ctx, parallel_generatedRoot_660.w_62_0 ctx] b1_public) :
    ∃ α : ErrorPoly 8, parallel_generatedRoot_660.w_51_0 ctx = (fun _ _ ↦ reducePoly modulus_0 8 α) ∧ SmulGain α 1 ∧
      Rel sm ![![outputs.2.2.1, outputs.2.2.2.1], ![outputs.2.2.2.2.1, outputs.2.2.2.2.2.1]]
        (fun j ↦ reducePoly modulus_0 8 α • ts j) ![outputs.1, outputs.2.1] b1_label := by
  obtain ⟨plaintext, hpayload, hgain, hrel⟩ :=
