  obtain ⟨freshErr, hfreshErr, hfreshRows⟩ := cell_rows R.fresh
  obtain ⟨smudgeErr, hsmudgeErr, hsmudgeRows⟩ := cell_rows R.smudge
  obtain ⟨kwitness, kbody⟩ := kfacts.c38.h988_0 part
  let kpart : W_Stage_keys_online_0_0.parallel_generatedRoot_988.Ctx Backend.backend model
      W_GeneratedClaim.stage_8_params part.val := ⟨keyPartInputs kctx part, kwitness⟩
  have kpf := W_Stage_keys_online_0_0.parallel_generatedRoot_988.facts kpart kbody
  have hzf : ∀ cell, blk (C := 900) (m := 25) (parallel_generatedRoot_991.w_29_0 local_) cell =
      maskPart (reducePoly modulus_0 8 old) (cellKey (C := 900) (Online0Sources.freshRows ctx) cell) -
        reducePoly modulus_0 8 (fresh cell) • parallel_generatedRoot_991.w_31_0 local_ +
        reduceMatrix modulus_0 8 1 25 (freshErr cell) := by
    intro cell
    rw [input_w_29_0 local_ hin, gadgetIn]
    exact hfreshRows cell
  obtain ⟨ef, hef, hf⟩ := online0_part_fresh4_budgeted local_ pf part.isLt hq Backend.layout0
    Online0Claim.layout_some Online0Claim.layout_exact (gadgetIn ▸ R.gadget) hzf hfreshErr
  have hzs : ∀ cell, blk (C := 4500) (m := 25) (parallel_generatedRoot_991.w_48_0 local_) cell =
      maskPart (reducePoly modulus_0 8 old) (cellKey (C := 4500) (Online0Sources.smudgeRows ctx) cell) -
        reducePoly modulus_0 8 (smudge cell) • generatedRoot.w_57_0 ctx +
        reduceMatrix modulus_0 8 1 25 (smudgeErr cell) := by
    intro cell
    rw [input_w_48_0 local_ hin]
    exact hsmudgeRows cell
  obtain ⟨es, hes, hs⟩ := online0_part_smudge4_budgeted local_ pf part.isLt hq Backend.layout0
    Online0Claim.layout_some Online0Claim.layout_exact R.gadget hzs hsmudgeErr
    ((input_w_50_0 local_ hin).trans
      (cellsKey_cellKey0 (C := 4500) (Online0Sources.smudgeRows ctx)).symm)
    ((input_w_51_0 local_ hin).trans
      (cellsKey_cellKey1 (C := 4500) (Online0Sources.smudgeRows ctx)).symm)
  obtain ⟨M, hM, hTH⟩ := online0_part_smudge_residue4 ctx facts part local_ hin smudge
    (fun cell coefficient ↦ Int.odd_iff.mp (R.smudge_odd cell coefficient))
    R.smudge_support
  have hKg : ∀ component, keyPartG4 kpart component = Online0Sources.sigmaKey ctx component := by
    intro component
    fin_cases component
    · exact links.g0
    · exact links.g1
  have hK1 : ∀ component, keyPartC14 kpart component = Online0Sources.oneKey ctx component := by
    intro component
    fin_cases component
    · exact links.one0
    · exact links.one1
  have hKx : ∀ component, keyPartCx4 kpart component =
      ![generatedRoot.w_872_1 ctx part, generatedRoot.w_872_2 ctx part] component := by
    intro component
    fin_cases component
    · exact congrFun links.cx0 part
    · exact congrFun links.cx1 part
  have freshSources : ∀ component,
      ![W_Stage_keys_online_0_0.parallel_generatedRoot_988.w_25_0 kpart, W_Stage_keys_online_0_0.parallel_generatedRoot_988.w_74_0 kpart] component =
        cellsKey (cellKey (C := 900) (Online0Sources.freshRows ctx)) component := by
    intro component
    fin_cases component
    · exact links.fresh0.trans (cellsKey_cellKey0 (C := 900) (Online0Sources.freshRows ctx)).symm
    · exact links.fresh1.trans (cellsKey_cellKey1 (C := 900) (Online0Sources.freshRows ctx)).symm
  have targetEq : W_Stage_keys_online_0_0.parallel_generatedRoot_988.w_4_0 kpart = parallel_generatedRoot_991.w_8_0 local_ :=
    (congrFun links.refresh part).trans (input_w_8_0 local_ hin).symm
  have gadgetEq : W_Stage_keys_online_0_0.parallel_generatedRoot_988.w_27_0 kpart = parallel_generatedRoot_991.w_31_0 local_ :=
    (gadgetMatrixRuns_unique kfacts.c1.h55_0 R.gadget).trans gadgetIn.symm
  have weightsEq : W_Stage_keys_online_0_0.parallel_generatedRoot_988.w_45_0 kpart = parallel_generatedRoot_991.w_49_0 local_ :=
    links.weights.trans (input_w_49_0 local_ hin).symm
  have key0Eq : W_Stage_keys_online_0_0.parallel_generatedRoot_988.w_46_0 kpart = parallel_generatedRoot_991.w_50_0 local_ :=
    links.smudge0.trans (input_w_50_0 local_ hin).symm
  have key1Eq : W_Stage_keys_online_0_0.parallel_generatedRoot_988.w_47_0 kpart = parallel_generatedRoot_991.w_51_0 local_ :=
    links.smudge1.trans (input_w_51_0 local_ hin).symm
  have solvedLocal : anchor * parallel_generatedRoot_991.w_211_0 local_ =
