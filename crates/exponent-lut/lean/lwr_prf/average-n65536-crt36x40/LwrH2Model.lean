/-- Every ModDown numerator of the model is divisible by its dropped factor. -/
def Divisible (tape : SampleTape) : Prop :=
  div0 model key ext tape ∧ div1 model key ext tape ∧ div2 model key ext tape ∧ div3 model key ext tape ∧ div4 model key ext tape ∧ div5 model key ext tape ∧ div6 model key ext tape ∧ div7 model key ext tape ∧ div8 model key ext tape ∧ div9 model key ext tape ∧ div10 model key ext tape ∧ div11 model key ext tape ∧ div12 model key ext tape ∧ div13 model key ext tape ∧ div14 model key ext tape ∧ div15 model key ext tape ∧ div16 model key ext tape ∧ div17 model key ext tape ∧ div18 model key ext tape ∧ div19 model key ext tape ∧ div20 model key ext tape ∧ div21 model key ext tape ∧ div22 model key ext tape ∧ div23 model key ext tape ∧ div24 model key ext tape ∧ div25 model key ext tape ∧ div26 model key ext tape ∧ div27 model key ext tape ∧ div28 model key ext tape ∧ div29 model key ext tape ∧ div30 model key ext tape ∧ div31 model key ext tape ∧ div32 model key ext tape ∧ div33 model key ext tape ∧ divLut model key ext tape

/-- The decoded coefficient of the model. -/
noncomputable def estar (tape : SampleTape) : ℝ := pairing Wfin (finalErr model key ext tape 1)

/-- The remainder of the members of block `0`. -/
noncomputable def memberRem0 (tape : SampleTape) : ℝ :=
  (∑ i, ∑ k, pairing (U0 model key ext tape i k) (eaB0 tape i k)) / (((P36 : Nat) : ℤ) : ℝ)

theorem step0 (tape : SampleTape) (hd : div0 model key ext tape) :
