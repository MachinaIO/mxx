/-- Prime 4: part-level `hpre` from shared public/source inputs and a solved preimage.
The fresh and weighted-smudge key computations are proved here, not assumed as final-row equalities. -/
theorem part_agree4 {backend : BackendContext} {hashModel : HashModel}
    {params : W_Stage_online_0.Params} {keyParams : W_Stage_keys_online_0_0.Params}
    {part : Nat} (hi : part < 36)
    (ctx : W_Stage_online_0.parallel_generatedRoot_991.Ctx backend hashModel params part)
    (keyCtx : W_Stage_keys_online_0_0.parallel_generatedRoot_988.Ctx backend hashModel keyParams part)
    {onlineOutputs keyOutputs : _}
    (Fo : W_Stage_online_0.parallel_generatedRoot_991.Facts ctx onlineOutputs)
    (Fk : W_Stage_keys_online_0_0.parallel_generatedRoot_988.Facts keyCtx keyOutputs)
    {anchor : ExactMatrix modulus_0 8 2 54}
    (solved : anchor * (parallel_generatedRoot_991.w_211_0 ctx) = keyOutputs)
    (targetEq : (W_Stage_keys_online_0_0.parallel_generatedRoot_988.w_4_0 keyCtx) = (parallel_generatedRoot_991.w_8_0 ctx))
    (gadgetEq : (W_Stage_keys_online_0_0.parallel_generatedRoot_988.w_27_0 keyCtx) = (parallel_generatedRoot_991.w_31_0 ctx))
    {Kg K₁ Kx : Fin 2 → ExactMatrix modulus_0 8 1 25}
    (hg : ∀ component, keyPartG4 keyCtx component = Kg component)
    (hc : ∀ component, keyPartC14 keyCtx component = K₁ component)
    (hx : ∀ component, keyPartCx4 keyCtx component = Kx component)
    {K : Fin 900 → Fin 2 → ExactMatrix modulus_0 8 1 25}
    (freshSources : ∀ component, ![(W_Stage_keys_online_0_0.parallel_generatedRoot_988.w_25_0 keyCtx), (W_Stage_keys_online_0_0.parallel_generatedRoot_988.w_74_0 keyCtx)] component = cellsKey K component)
    (weightsEq : (W_Stage_keys_online_0_0.parallel_generatedRoot_988.w_45_0 keyCtx) = (parallel_generatedRoot_991.w_49_0 ctx))
    (key0Eq : (W_Stage_keys_online_0_0.parallel_generatedRoot_988.w_46_0 keyCtx) = (parallel_generatedRoot_991.w_50_0 ctx))
    (key1Eq : (W_Stage_keys_online_0_0.parallel_generatedRoot_988.w_47_0 keyCtx) = (parallel_generatedRoot_991.w_51_0 ctx)) :
    ∀ component, rowOf anchor component * (parallel_generatedRoot_991.w_211_0 ctx) =
      (Kg component * topRows (parallel_generatedRoot_991.w_218_0 ctx) +
        K₁ component * bottomRows (parallel_generatedRoot_991.w_218_0 ctx) -
        Kx component * (parallel_generatedRoot_991.w_231_0 ctx)) + freshPartKey4 ctx hi K component +
        ![(parallel_generatedRoot_991.w_252_1 ctx), (parallel_generatedRoot_991.w_252_2 ctx)] component := by
  exact online0_hpre4_full ctx keyCtx Fo Fk solved targetEq hg hc hx
    (fresh_part_keys_agree4 hi ctx keyCtx Fo Fk gadgetEq freshSources)
    (smudge_part_keys_agree4 ctx keyCtx Fo Fk weightsEq key0Eq key1Eq)

