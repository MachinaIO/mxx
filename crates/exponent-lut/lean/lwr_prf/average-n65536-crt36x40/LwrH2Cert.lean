/-!
# The average-case certificate under H2

Generated by `generator/gen_h2_cert.py`. A run whose decoded coefficient is below the threshold
decodes the ideal output; the decoded coefficient is the remainder plus the sum over the H2 sites;
under H2 (`LwrH2`), the tail of that form at the threshold is below `2^-100`.
-/

namespace LwrProof

open Mxx.Primitives MxxRuntime MxxExponentLut

set_option maxRecDepth 1000000

/-- The threshold of the decoded coefficient. -/
def h2Threshold : ℝ := 147426616

/-- The numbering of the H2 sites. -/
noncomputable def siteIdx (j : Site) : ℕ := (Fintype.equivFin Site j).val

theorem siteIdx_injective : Function.Injective siteIdx :=
  Fin.val_injective.comp (Fintype.equivFin Site).injective

/-- H2 for `lwr_prf`: replacing the residues of the H2 sites by independent uniforms does not
decrease the tail of the decoded coefficient at the threshold. -/
def LwrH2 : Prop :=
  ∀ (model : HashModel) (external : GeneratedClaim.ExternalInputs),
    ResidueReplacement siteIdx (fun j tape ↦ siteRho model external.input_0 external j tape) siteH
      (remainder model external.input_0 external)
      (fun j tape ↦ siteG model external.input_0 external j tape) h2Threshold

