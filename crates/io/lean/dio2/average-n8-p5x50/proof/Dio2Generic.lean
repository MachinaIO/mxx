variable {n : Nat}

/-! ## 1. The CRT recombination for any number of primes -/

/-- The left-nested `matrixAdd` chain `((t₀ + t₁) + …) + t_k` of `k + 1` rows, the shape of the
exported CRT sum of a refresh part (the chain is never empty). -/
noncomputable def chainSum {Q m : Nat} : (k : Nat) → (Fin (k + 1) → ExactMatrix Q n 1 m) → ExactMatrix Q n 1 m
  | 0, t => t 0
  | k + 1, t => matrixAdd (chainSum k (fun i ↦ t (Fin.castSucc i))) (t (Fin.last (k + 1)))

/-- The left-nested chain is the `Finset` sum. -/
theorem chainSum_eq_sum {Q m : Nat} : ∀ (k : Nat) (t : Fin (k + 1) → ExactMatrix Q n 1 m),
    chainSum k t = ∑ i, t i
  | 0, t => by simp [chainSum]
  | k + 1, t => by
    rw [Fin.sum_univ_castSucc, chainSum, chainSum_eq_sum k]
    rfl

/-- The toy's five-term chain is `chainSum 4`. -/
theorem chainSum_five {Q m : Nat} (t : Fin 5 → ExactMatrix Q n 1 m) :
    chainSum 4 t = matrixAdd (matrixAdd (matrixAdd (matrixAdd (t 0) (t 1)) (t 2)) (t 3)) (t 4) :=
  rfl

/-- **The part's row for any number of primes.** The left-nested chain of the CRT terms of `v`
for the `k + 1` primes of `Q = ∏ q_i` (pairwise coprime, CRT basis `K`) is `v`; `part_row` is the
case `k + 1 = 5` (`chainSum_five`). -/
theorem part_row_gen (hn : 0 < n) {Q m k : Nat} (hQ : 1 < Q) (q : Fin (k + 1) → Nat)
    (hq : ∀ i, 1 < q i) (K : Fin (k + 1) → Int)
    (hK : ∀ i j, K i ≡ (if i = j then 1 else 0) [ZMOD (q j : Int)])
    (hcop : ∀ i j, i ≠ j → Nat.Coprime (q i) (q j)) (hprod : Q = ∏ i, q i)
    {v : ExactMatrix Q n 1 m} {t : Fin (k + 1) → ExactMatrix Q n 1 m}
    (ht : ∀ i, TermOf (q i) (K i) (t i) v) :
    chainSum k t = v := by
  rw [chainSum_eq_sum, crt_terms_sum hn hQ q hq K hK hcop hprod ht]

/-! ## 2. The dynamic state read for any bucket width -/

/-- **A dynamic family read at `⌊i / W⌋`** is the member `i / W`, for any width `w = W` (also
`W = 0`, where both sides read member `0`); `familyGetDynamic_half` is `W = 2`. The width is an
integer literal in the export, hence the equation `hw`. -/
theorem familyGetDynamic_div {α : Type} {M W : Nat} {w : Int} (hw : w = (W : Int))
    {f : Fin M → α} {i : Nat} {x : α}
    (h : familyGetDynamic f (Int.fdiv (Int.ofNat i) w) x) (hi : i / W < M) :
    x = f ⟨i / W, hi⟩ := by
  obtain ⟨pos, hpos, rfl⟩ := h
  congr 1
  apply Fin.ext
  have e : Int.fdiv (Int.ofNat i) w = ((i / W : Nat) : Int) := by
    subst hw
    rw [Int.fdiv_eq_ediv_of_nonneg _ (by positivity), Int.ofNat_eq_natCast]
    push_cast
    rfl
  simp only []
  omega

end Dio2Proof

