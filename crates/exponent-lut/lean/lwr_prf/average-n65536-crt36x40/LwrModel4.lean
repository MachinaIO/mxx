section Model4

variable (model : HashModel) (key : ByteArray) (ext : GeneratedClaim.ExternalInputs)

/-- The state rows entering block `4`. -/
noncomputable def stateRow4 (tape : SampleTape) : Fin 2 → ExactMatrix Q32 N 1 124 :=
  encRow (maskM tape) (key4 model key ext tape) (stateTarget4 ext tape) (err4 model key ext tape)

/-- The selector RHS bottoms of block `4`. -/
noncomputable def bot4 (tape : SampleTape) (i : Fin 113) (j : Fin 2) : ExactMatrix Q31 N 1 120 :=
  reducePoly Q31 N (((P31 : Nat) : Int) * nuOf ext 4 i * unitPair (payloadM tape) j) • gReb Q31 Q30 120 +
    reduceMatrix Q31 N 1 120 (rhsError4 tape [2] i j) -
    reducePoly Q31 N (payloadM tape) • rhsTop model key Q31 120 rhsPrefix4 i j

/-- The keys entering block `5`. -/
noncomputable def key5 (tape : SampleTape) : Fin 2 → Fin 2 → ExactMatrix Q31 N 1 120 :=
  ∑ i : Fin 113, fun k j ↦ theOutput (blockModSwitchRuns [1099510054913, 1099507695617, 1099506515969, 1099504549889, 1099503894529, 1099503370241, 1099502714881, 1099500617729, 1099499569153, 1099499175937, 1099498258433, 1099490000897, 1099489607681, 1099488428033, 1099486855169, 1099484889089, 1099484495873, 1099482923009, 1099480956929, 1099479121921, 1099469684737, 1099468767233, 1099468505089, 1099467194369, 1099465359361, 1099463786497, 1099461820417, 1099460902913, 1099460640769, 1099457495041, 1099455004673, 1099454218241] 1)
    (cellKeyUp4 (memberKey model key ((coords 4 i : Nat) : Int)) (key4 model key ext tape)
      (rhsTop model key Q31 120 rhsPrefix4 i) (bot4 model key ext tape i) k j)

/-- The alignment numerator of the member of cell `i` of block `4` in the model. -/
noncomputable def alignM4 (tape : SampleTape) (i : Fin 113) (j : Fin 2) : ErrorMatrix N 1 128 :=
  alignNumer4 (maskM tape) (memberKey model key ((coords 4 i : Nat) : Int))
    (memberError tape [3] ⟨coords 4 i, coords_lt 4 i⟩) (memberRow model key ext tape ⟨coords 4 i, coords_lt 4 i⟩) j

/-- The numerator of cell `i` of block `4` in the model. -/
noncomputable def numerM4 (tape : SampleTape) (i : Fin 113) (j : Fin 2) : ErrorMatrix N 1 120 :=
  cellNumer4 (maskM tape)
      (memberKey model key ((coords 4 i : Nat) : Int))
      (fun j' ↦ divInt A32 (alignM4 model key ext tape i j'))
      (err4 model key ext tape) (alphaOf ext ⟨coords 4 i, coords_lt 4 i⟩) (key4 model key ext tape)
      (rhsTop model key Q31 120 rhsPrefix4 i) (bot4 model key ext tape i)
      (fun j' ↦ theOutput (blockModSwitchRuns [1099510054913, 1099507695617, 1099506515969, 1099504549889, 1099503894529, 1099503370241, 1099502714881, 1099500617729, 1099499569153, 1099499175937, 1099498258433, 1099490000897, 1099489607681, 1099488428033, 1099486855169, 1099484889089, 1099484495873, 1099482923009, 1099480956929, 1099479121921, 1099469684737, 1099468767233, 1099468505089, 1099467194369, 1099465359361, 1099463786497, 1099461820417, 1099460902913, 1099460640769, 1099457495041, 1099455004673, 1099454218241, 1099453431809, 1099451465729, 1099451072513, 1099450810369] 1) (memberRow model key ext tape ⟨coords 4 i, coords_lt 4 i⟩ j' * alignDigits4))
      (stateRow4 model key ext tape) (fun _ _ ↦ reducePoly Q32 N (alphaOf ext ⟨coords 4 i, coords_lt 4 i⟩)) j

/-- The error entering block `5`. -/
noncomputable def err5 (tape : SampleTape) : Fin 2 → ErrorMatrix N 1 120 :=
  ∑ i : Fin 113, fun j ↦ divInt P32 (numerM4 model key ext tape i j) -
    (alphaOf ext ⟨coords 4 i, coords_lt 4 i⟩ * muOf ext 4) • rhsError4 tape [2] i j

/-- The alignment and cell numerators of block `4` are divisible by their dropped factors. -/
def div4 (tape : SampleTape) : Prop :=
  (∀ i j row column, alignM4 model key ext tape i j row column =
    ((A32 : Int) : ErrorPoly N) * divInt A32 (alignM4 model key ext tape i j) row column) ∧
  ∀ i j row column, numerM4 model key ext tape i j row column =
    ((P32 : Int) : ErrorPoly N) * divInt P32 (numerM4 model key ext tape i j) row column

/-- The state target of block `5` at `Q31`. -/
noncomputable def stateTarget5 (tape : SampleTape) (j : Fin 2) : ExactMatrix Q31 N 1 120 :=
  reducePoly Q31 N (((P31 : Nat) : Int) * muOf ext 5 * unitPair (payloadM tape) j) • gReb Q31 Q30 120

