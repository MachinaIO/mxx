theorem rel_congr {next : ErrorPoly 8} {K K' : Fin 2 → Fin 2 → ExactMatrix modulus_0 8 1 25}
    {t t' c c' : Fin 2 → ExactMatrix modulus_0 8 1 25} {B B' : Nat}
    (h : MxxExponentLut.Rel next K t c B) (hK : ∀ r j, K r j = K' r j) (ht : ∀ j, t j = t' j)
    (hc : ∀ j, c j = c' j) (hB : B ≤ B') : MxxExponentLut.Rel next K' t' c' B' := by
  have e1 : K = K' := funext fun r ↦ funext fun j ↦ hK r j
  have e2 : t = t' := funext ht
  have e3 : c = c' := funext hc
  subst e1 e2 e3
  exact h.mono hB

/-- The refreshed pair of exported target 0 under its actual root key. -/
theorem root_0 {model : HashModel} {co : Step0Rows.OnlineCtx model} {outputs : _}
    (F : generatedRoot.Facts co outputs) {key : ByteArray} (hseed : generatedRoot.w_755_0 co = key)
    {next : ErrorPoly 8} {target : Fin 36 → ErrorPoly 8} {value : Fin 2 → ErrorPoly 8}
    (hv : ∀ c, target (StepTransition.partIndex ⟨0, by decide⟩ c) = value c)
    (hp : MxxExponentLut.Rel next
      (fun r c ↦ MxxExponentLut.rowOf (generatedRoot.w_872_3 co (StepTransition.partIndex ⟨0, by decide⟩ c)) r)
      (fun c ↦ reducePoly modulus_0 8 (target (StepTransition.partIndex ⟨0, by decide⟩ c)) • generatedRoot.w_57_0 co)
      (StepTransition.nextRows co ⟨0, by decide⟩) 8) :
    MxxExponentLut.Rel next (keyPairG model key modulus_0 25 [114, 110, 115, 45, 98, 103, 103, 47, 114, 111, 111, 116, 45, 105, 110, 112, 117, 116, 47, 100, 105, 111, 50, 47, 111, 110, 101, 45, 112, 114, 105, 118, 97, 116, 101] [])
      (fun c ↦ reducePoly modulus_0 8 (value c) • generatedRoot.w_57_0 co)
      (StepTransition.nextRows co ⟨0, by decide⟩) 8 := by
  refine rel_congr hp (fun r j ↦ ?_) (fun j ↦ by rw [hv]) (fun _ ↦ rfl) le_rfl
  rw [target_nonlabel_key co F _ 0 (by decide) j (by simp only [StepTransition.partIndex]; omega)
    (by simp only [StepTransition.partIndex]; omega)]
  fin_cases j <;> fin_cases r <;> simp only [Fin.zero_eta, Fin.mk_one, Fin.isValue, Step0Targets.pairIndex]
  · rw [Step0Targets.familyPack_entry F.c35.h871_0 _ 0 (by simp) rfl]
    simp only [List.get_eq_getElem, List.getElem_cons_zero, List.getElem_cons_succ]
    rw [modulusReduce_same (by decide) F.c31.h759_0, (concatRows_two F.c31.h758_0).1,
      MxxExponentLut.hashSample_eq F.c31.h756_0, hseed]
    rfl
  · rw [Step0Targets.familyPack_entry F.c35.h871_0 _ 0 (by simp) rfl]
    simp only [List.get_eq_getElem, List.getElem_cons_zero, List.getElem_cons_succ]
    rw [modulusReduce_same (by decide) F.c31.h759_0, (concatRows_two F.c31.h758_0).2,
      MxxExponentLut.hashSample_eq F.c31.h757_0, hseed]
    rfl
  · rw [Step0Targets.familyPack_entry F.c35.h871_0 _ 1 (by simp) rfl]
    simp only [List.get_eq_getElem, List.getElem_cons_zero, List.getElem_cons_succ]
    rw [modulusReduce_same (by decide) F.c31.h763_0, (concatRows_two F.c31.h762_0).1,
      MxxExponentLut.hashSample_eq F.c31.h760_0, hseed]
    rfl
  · rw [Step0Targets.familyPack_entry F.c35.h871_0 _ 1 (by simp) rfl]
    simp only [List.get_eq_getElem, List.getElem_cons_zero, List.getElem_cons_succ]
    rw [modulusReduce_same (by decide) F.c31.h763_0, (concatRows_two F.c31.h762_0).2,
      MxxExponentLut.hashSample_eq F.c31.h761_0, hseed]
    rfl

/-- The refreshed pair of exported target 1 under its actual root key. -/
theorem root_1 {model : HashModel} {co : Step0Rows.OnlineCtx model} {outputs : _}
    (F : generatedRoot.Facts co outputs) {key : ByteArray} (hseed : generatedRoot.w_755_0 co = key)
    {next : ErrorPoly 8} {target : Fin 36 → ErrorPoly 8} {value : Fin 2 → ErrorPoly 8}
