/-- The numerator `A v` of the alignment of a member of `a`: its error after the digits `H`, minus
the row residue, plus the mask-weighted key residues. -/
noncomputable def alignNumer21 (sm : ErrorPoly N) (mk : Fin 2 → Fin 2 → ExactMatrix Q36 N 1 144)
    (ea : Fin 2 → ErrorMatrix N 1 144) (row : Fin 2 → ExactMatrix Q36 N 1 144) (j : Fin 2) :
    ErrorMatrix N 1 60 :=
  ea j * liftMatrix alignDigits21 - downResidue A15 (row j * alignDigits21) +
    sm • downResidue A15 (mk 0 j * alignDigits21) + downResidue A15 (mk 1 j * alignDigits21)

/-- The numerator `p v` of a block-1 cell. -/
noncomputable def cellNumer21 (sm : ErrorPoly N) (mk : Fin 2 → Fin 2 → ExactMatrix Q36 N 1 144)
    (va : Fin 2 → ErrorMatrix N 1 60) (es : Fin 2 → ErrorMatrix N 1 56) (α : ErrorPoly N)
    (As : Fin 2 → Fin 2 → ExactMatrix Q15 N 1 56) (top bot : Fin 2 → ExactMatrix Q14 N 1 52)
    (crow : Fin 2 → ExactMatrix Q15 N 1 60) (cs : Fin 2 → ExactMatrix Q15 N 1 56)
    (pay : ExactMatrix Q15 N 1 1) (j : Fin 2) : ErrorMatrix N 1 52 :=
  pairMul (fun j' ↦ pairMul va (liftMatrix (pubDigits21 As j')) + α • es j')
      (liftMatrix (rhsDigits21 top bot j)) -
    downResidue P15 (pairMul (fun j' ↦ pairMul crow (pubDigits21 As j') +
      matrixMulScalarRight (cs j') pay) (rhsDigits21 top bot j)) +
    sm • downResidue P15 (cellKeyUp21 mk As top bot 0 j) + downResidue P15 (cellKeyUp21 mk As top bot 1 j)

