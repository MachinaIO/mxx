            ![w.w_86_4, w.w_86_5] (fun _ _ ↦ reducePoly Q4 N (α ⟨coords 3 i, coords_lt 3 i⟩)) j) := by
    intro i
    funext j
    have h := fun row column ↦ hid i j row column
    simp only [hvaM] at h
    exact div_of_identity (by norm_num) h
  refine ⟨hk, fun i j row column ↦ ?_, fun i j row column ↦ ?_, ?_⟩
  · have h := hva i j row column
    rw [hvaM i] at h
    exact h
  · have h := hid i j row column
    simp only [hvaM] at h
    rw [hvM i] at h
    exact h
  · simp only [hvM] at hv
