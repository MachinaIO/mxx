/-!
# Preprocessing step 0 at the root

Generated by `gen_pre_root.py` from `PePreRoot.lean.in`. From the incoming key `A`: the product
key of the position of step 0, the key rows of every first-depth branch (lanes
`parallel_generatedRoot_30` and grouped `parallel_generatedRoot_31`), and the output key
from the member sums. Group zero slot zero is a first-depth leaf. Second-depth leaf `l`
uses group `(1 + l % 15) / 4`, local slot `(1 + l % 15) % 4`, and member `l / 15`.
The sixteen-slot view below flattens these four consecutive groups.
-/

set_option maxRecDepth 200000

namespace PeProof

open Mxx.Primitives MxxRuntime MxxExponentLut MxxPe Stage_preprocess

variable {model : HashModel} {tape : SampleTape} {path : List Nat} {params : Params}

/-- The product key of preprocessing step 0. -/
noncomputable def preM_0 (ctx : generatedRoot.Ctx Backend.backend model tape path params) :
    Fin 2 → Fin 2 → ExactMatrix Q N 1 30 :=
  ![![generatedRoot.w_17_0 ctx, generatedRoot.w_20_0 ctx],
    ![generatedRoot.w_23_0 ctx, generatedRoot.w_26_0 ctx]]

/-- Published T families, indexed by flattened slot, row, then member. -/
def preLeafT_0 (ctx : generatedRoot.Ctx Backend.backend model tape path params) :
    Fin 16 → Fin 2 → Fin 15 → ExactMatrix Q N 1 60 :=
  fun slot r member ↦ (![![generatedRoot.w_31_0 ctx member, generatedRoot.w_31_1 ctx member], ![generatedRoot.w_31_2 ctx member, generatedRoot.w_31_3 ctx member], ![generatedRoot.w_31_4 ctx member, generatedRoot.w_31_5 ctx member], ![generatedRoot.w_31_6 ctx member, generatedRoot.w_31_7 ctx member], ![generatedRoot.w_32_0 ctx member, generatedRoot.w_32_1 ctx member], ![generatedRoot.w_32_2 ctx member, generatedRoot.w_32_3 ctx member], ![generatedRoot.w_32_4 ctx member, generatedRoot.w_32_5 ctx member], ![generatedRoot.w_32_6 ctx member, generatedRoot.w_32_7 ctx member], ![generatedRoot.w_33_0 ctx member, generatedRoot.w_33_1 ctx member], ![generatedRoot.w_33_2 ctx member, generatedRoot.w_33_3 ctx member], ![generatedRoot.w_33_4 ctx member, generatedRoot.w_33_5 ctx member], ![generatedRoot.w_33_6 ctx member, generatedRoot.w_33_7 ctx member], ![generatedRoot.w_34_0 ctx member, generatedRoot.w_34_1 ctx member], ![generatedRoot.w_34_2 ctx member, generatedRoot.w_34_3 ctx member], ![generatedRoot.w_34_4 ctx member, generatedRoot.w_34_5 ctx member], ![generatedRoot.w_34_6 ctx member, generatedRoot.w_34_7 ctx member]]) slot r

/-- The physical group/local-slot/row/member artifact layout. -/
def preLeafGroups_0 (ctx : generatedRoot.Ctx Backend.backend model tape path params) :
    Fin 4 → Fin 4 → Fin 2 → Fin 15 → ExactMatrix Q N 1 60 :=
  fun group slot r member ↦ (![![![generatedRoot.w_31_0 ctx member, generatedRoot.w_31_1 ctx member], ![generatedRoot.w_31_2 ctx member, generatedRoot.w_31_3 ctx member], ![generatedRoot.w_31_4 ctx member, generatedRoot.w_31_5 ctx member], ![generatedRoot.w_31_6 ctx member, generatedRoot.w_31_7 ctx member]], ![![generatedRoot.w_32_0 ctx member, generatedRoot.w_32_1 ctx member], ![generatedRoot.w_32_2 ctx member, generatedRoot.w_32_3 ctx member], ![generatedRoot.w_32_4 ctx member, generatedRoot.w_32_5 ctx member], ![generatedRoot.w_32_6 ctx member, generatedRoot.w_32_7 ctx member]], ![![generatedRoot.w_33_0 ctx member, generatedRoot.w_33_1 ctx member], ![generatedRoot.w_33_2 ctx member, generatedRoot.w_33_3 ctx member], ![generatedRoot.w_33_4 ctx member, generatedRoot.w_33_5 ctx member], ![generatedRoot.w_33_6 ctx member, generatedRoot.w_33_7 ctx member]], ![![generatedRoot.w_34_0 ctx member, generatedRoot.w_34_1 ctx member], ![generatedRoot.w_34_2 ctx member, generatedRoot.w_34_3 ctx member], ![generatedRoot.w_34_4 ctx member, generatedRoot.w_34_5 ctx member], ![generatedRoot.w_34_6 ctx member, generatedRoot.w_34_7 ctx member]]]) group slot r

theorem preLeafT_chunk_0 (ctx : generatedRoot.Ctx Backend.backend model tape path params)
    (group slot : Fin 4) (r : Fin 2) (member : Fin 15) :
    preLeafT_0 ctx ⟨4 * group.val + slot.val, by omega⟩ r member =
      preLeafGroups_0 ctx group slot r member := by
  exact Fin.cases (Fin.cases (rfl) (Fin.cases (rfl) (Fin.cases (rfl) (Fin.cases (rfl) ((by intro index; exact Fin.elim0 index)))))) (Fin.cases (Fin.cases (rfl) (Fin.cases (rfl) (Fin.cases (rfl) (Fin.cases (rfl) ((by intro index; exact Fin.elim0 index)))))) (Fin.cases (Fin.cases (rfl) (Fin.cases (rfl) (Fin.cases (rfl) (Fin.cases (rfl) ((by intro index; exact Fin.elim0 index)))))) (Fin.cases (Fin.cases (rfl) (Fin.cases (rfl) (Fin.cases (rfl) (Fin.cases (rfl) ((by intro index; exact Fin.elim0 index)))))) ((by intro index; exact Fin.elim0 index))))) group slot

theorem preLeafT_leaf_0 (ctx : generatedRoot.Ctx Backend.backend model tape path params)
    (leaf : Fin 225) (r : Fin 2) :
    groupedPreLeafRows (preLeafT_0 ctx) r leaf =
      preLeafGroups_0 ctx ⟨(1 + leaf.val % 15) / 4, by omega⟩
        ⟨(1 + leaf.val % 15) % 4, by omega⟩ r ⟨leaf.val / 15, by omega⟩ := by
  unfold groupedPreLeafRows
  rw [← preLeafT_chunk_0]
  congr 1
  apply Fin.ext
  simp only
  omega

/-- The sum of the four group outputs for one member. -/
noncomputable def preLeafKey_0 (ctx : generatedRoot.Ctx Backend.backend model tape path params)
    (r j : Fin 2) (member : Fin 15) : ExactMatrix Q N 1 30 :=
    keyOf (generatedRoot.w_31_8 ctx member, generatedRoot.w_31_9 ctx member, generatedRoot.w_31_10 ctx member, generatedRoot.w_31_11 ctx member, ()) r j +
    keyOf (generatedRoot.w_32_8 ctx member, generatedRoot.w_32_9 ctx member, generatedRoot.w_32_10 ctx member, generatedRoot.w_32_11 ctx member, ()) r j +
    keyOf (generatedRoot.w_33_8 ctx member, generatedRoot.w_33_9 ctx member, generatedRoot.w_33_10 ctx member, generatedRoot.w_33_11 ctx member, ()) r j +
    keyOf (generatedRoot.w_34_8 ctx member, generatedRoot.w_34_9 ctx member, generatedRoot.w_34_10 ctx member, generatedRoot.w_34_11 ctx member, ()) r j

