/-- Common exported inputs prove both key-source links; no key equality is assumed. -/
theorem source_links {model : HashModel} {external : GeneratedClaim.ExternalInputs}
    {execution : GeneratedClaim.Execution}
    (online : W_Stage_online_1.generatedRoot.Ctx Backend.backend model W_GeneratedClaim.stage_17_params)
    (keys : W_Stage_keys_online_1_1.generatedRoot.Ctx Backend.backend model W_GeneratedClaim.stage_14_params)
    (hon : online.inputs = onlineInputs external execution)
    (hkeys : keys.inputs = keysInputs external execution) :
    StateLink1 online keys ∧ SmudgeLink1 online keys := by
  rcases online with ⟨onInputs, onWitness⟩
  rcases keys with ⟨keyInputs, keyWitness⟩
  change onInputs = onlineInputs external execution at hon
  change keyInputs = keysInputs external execution at hkeys
  subst onInputs
  subst keyInputs
  exact ⟨⟨rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl⟩, ⟨rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl⟩⟩

/-- The sampled claim preimage is the exact preimage used by this online context. -/
theorem preimage {model : HashModel} {external : GeneratedClaim.ExternalInputs}
    {execution : GeneratedClaim.Execution} (C : Context model external execution)
    (hrun : W_GeneratedClaim.Runs model external execution) :
    SolvedPreimage execution.«stage_1».2.2.1
      (W_Stage_keys_online_1_1.generatedRoot.w_178_0 C.keys)
      (W_Stage_online_1.generatedRoot.w_1_0 C.online) Dio2NoiseCertificate.cutoff := by
  have hon : W_Stage_online_1.generatedRoot.w_1_0 C.online = execution.«stage_15» := by
    change C.online.inputs.2.1 = _
    rw [C.online_inputs]
    rfl
  have hout := congrArg Prod.fst C.keys_facts.c9.hout
  change execution.«stage_14».1 = W_Stage_keys_online_1_1.generatedRoot.w_178_0 C.keys at hout
  obtain ⟨hsolve, error, herror, hbound⟩ := (claim_preimages hrun).2
  rw [hon]
  refine ⟨hsolve.trans hout, error, herror, ?_⟩
  simpa [Dio2NoiseCertificate.cutoff] using hbound

/-- The common-input key links and solved preimage give the unmasking key equation. -/
theorem hpre {model : HashModel} {external : GeneratedClaim.ExternalInputs}
    {execution : GeneratedClaim.Execution} (C : Context model external execution)
    (hrun : W_GeneratedClaim.Runs model external execution) :
    ∀ port : Fin 2, rowOf execution.«stage_1».2.2.1 port *
      W_Stage_online_1.generatedRoot.w_1_0 C.online =
        stateKey1 C.online port * W_Stage_online_1.generatedRoot.w_130_0 C.online +
        smudgeKeyS1 C.online port := by
  obtain ⟨stateLink, smudgeLink⟩ := source_links C.online C.keys C.online_inputs C.keys_inputs
  exact online1_root_hpre C.online_facts C.keys_facts stateLink smudgeLink
    (by norm_num [W_Stage_online_1.modulus_0]) Backend.layout0
    (by unfold Backend.backend; simp) rfl (preimage C hrun).1

/-- Specialize the imported invariant to the actual claim witness. -/
theorem imported_roots {model : HashModel} {external : GeneratedClaim.ExternalInputs}
    {execution : GeneratedClaim.Execution} (C : Context model external execution)
    {state : ErrorPoly 8}
    (hstate : State1 model external execution state) :
    ∃ (sm sp : ErrorPoly 8)
      (gadget : ExactMatrix W_Stage_online_1.modulus_0 8 1 25),
      polyNorm sm ≤ 1 ∧ polyNorm sp ≤ 1 ∧
      gadgetMatrixRuns Backend.backend 4096 25 gadget ∧
      execution.«stage_0» = (fun _ _ ↦ reducePoly W_Stage_online_1.modulus_0 8 sp) ∧
      Online1Roots C.online execution.«stage_1».2.2.1 sm sp state
        (online1Labels external) gadget := by
  obtain ⟨sm, sp, gadget, hsm, hsp, hG, hpayload, roots⟩ := hstate
  exact ⟨sm, sp, gadget, hsm, hsp, hG, hpayload,
    roots C.online C.online_inputs C.online_facts⟩

