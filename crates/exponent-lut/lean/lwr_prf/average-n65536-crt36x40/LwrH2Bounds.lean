theorem HB1_column (c : Fin 140) :
    ∑ l, ∑ j, |(((HB1 l c).coeff j : ℤ) : ℝ)| ≤ 144 * N * 512 := by
  have h : CoeffBound HB1 ((1024 : ℤ).toNat / 2) := by
    unfold HB1 alignDigits1
    exact coeffBound_lift_decompose (by norm_num) hN (by decide) _
  rw [show ((1024 : ℤ).toNat / 2) = 512 from rfl] at h
  simpa using column_l1_le h c

