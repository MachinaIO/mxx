variable {tape : SampleTape} {path : List Nat}

/-- The numerator `A v` of the alignment of a member of `a`: its error after the digits `H`, minus
the row residue, plus the mask-weighted key residues. -/
noncomputable def alignNumer2 (sm : ErrorPoly N) (mk : Fin 2 → Fin 2 → ExactMatrix Q7 N 1 14)
    (ea : Fin 2 → ErrorMatrix N 1 14) (row : Fin 2 → ExactMatrix Q7 N 1 14) (j : Fin 2) :
    ErrorMatrix N 1 10 :=
  ea j * liftMatrix alignDigits2 - downResidue A5 (row j * alignDigits2) +
    sm • downResidue A5 (mk 0 j * alignDigits2) + downResidue A5 (mk 1 j * alignDigits2)

/-- The numerator `p v` of a block-1 cell. -/
noncomputable def cellNumer2 (sm : ErrorPoly N) (mk : Fin 2 → Fin 2 → ExactMatrix Q7 N 1 14)
    (va : Fin 2 → ErrorMatrix N 1 10) (es : Fin 2 → ErrorMatrix N 1 8) (α : ErrorPoly N)
    (As : Fin 2 → Fin 2 → ExactMatrix Q5 N 1 8) (top bot : Fin 2 → ExactMatrix Q4 N 1 6)
    (crow : Fin 2 → ExactMatrix Q5 N 1 10) (cs : Fin 2 → ExactMatrix Q5 N 1 8)
    (pay : ExactMatrix Q5 N 1 1) (j : Fin 2) : ErrorMatrix N 1 6 :=
  pairMul (fun j' ↦ pairMul va (liftMatrix (pubDigits2 As j')) + α • es j')
      (liftMatrix (rhsDigits2 top bot j)) -
    downResidue P5 (pairMul (fun j' ↦ pairMul crow (pubDigits2 As j') +
      matrixMulScalarRight (cs j') pay) (rhsDigits2 top bot j)) +
    sm • downResidue P5 (cellKeyUp2 mk As top bot 0 j) + downResidue P5 (cellKeyUp2 mk As top bot 1 j)

set_option maxHeartbeats 16000000 in
set_option maxRecDepth 100000 in
