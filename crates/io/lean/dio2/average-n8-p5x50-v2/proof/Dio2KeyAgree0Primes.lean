No semantic encoding or noise hypothesis is required for this algebraic conclusion. -/
theorem online0_hpre0 {backend : BackendContext} {hashModel : HashModel}
    {params : W_Stage_online_0.Params} {keyParams : W_Stage_keys_online_0_0.Params}
    {part : Nat}
