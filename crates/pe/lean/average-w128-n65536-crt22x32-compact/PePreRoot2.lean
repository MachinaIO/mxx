variable {model : HashModel} {tape : SampleTape} {path : List Nat} {params : Params}

/-- The product key of preprocessing step 2. -/
noncomputable def preM_2 (ctx : generatedRoot.Ctx Backend.backend model tape path params) :
    Fin 2 → Fin 2 → ExactMatrix Q N 1 44 :=
  ![![generatedRoot.w_302_0 ctx, generatedRoot.w_307_0 ctx],
    ![generatedRoot.w_312_0 ctx, generatedRoot.w_317_0 ctx]]

/-- Published T families, indexed by flattened slot, row, then member. -/
def preLeafT_2 (ctx : generatedRoot.Ctx Backend.backend model tape path params) :
