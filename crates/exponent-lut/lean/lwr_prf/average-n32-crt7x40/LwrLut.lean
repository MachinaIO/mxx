/-- Branch `i` of the readout LUT, zero past the sixteen branches. -/
noncomputable def lutBranchTarget (μ sp : ErrorPoly N)
    (fam : Fin 2 → Fin 2 → Fin 16 → ExactMatrix Q1 N 1 1) (i : Nat) : Fin 2 → ExactMatrix Q2 N 1 1 :=
  if h : i < 16 then branchTarget (q := Q2) (p := P2) μ sp fam ⟨i, h⟩ else 0

/-- The generated readout loop accumulates the first fifteen branches and carries the switching
ciphertext of branch `15`. -/
theorem lutLoop {model : HashModel} {key : ByteArray} {sm sp μ : ErrorPoly N}
    (hsm : polyNorm sm ≤ 1)
    {g' : ExactMatrix Q1 N 1 2} {g : ExactMatrix Q2 N 1 2}
    (hg' : gadgetMatrixRuns Backend.backend 1048576 2 g') (hg : centeredRebaseRuns g' g)
    {c : Fin 2 → ExactMatrix Q2 N 1 2} {A : Fin 2 → Fin 2 → ExactMatrix Q2 N 1 2} {B : Nat}
    (henc : Rel sm A (fun j ↦ reducePoly Q2 N (((P2 : Nat) : Int) * μ * unitPair sp j) • g) c B)
    {h0 h1 : Fin 16 → ExactMatrix Q2 N 1 2}
    (hhelp : ∀ i : Fin 16, Rel sm (lutA model key Q2 2 5 (sigma i))
      (fun j ↦ reducePoly Q2 N (((P2 : Nat) : Int) *
        unitPair (substitution (sigma i).toNat (sigma_odd i) sm) j) • g) ![h0 i, h1 i] 26)
    {fam : Fin 2 → Fin 2 → Fin 16 → ExactMatrix Q1 N 1 1} {count : Nat} (hcount : count ≤ 15)
    {final : LoopState Q2 Q1 1}
    (hruns : MxxIR.IterRuns (fun (i : Nat) (current next : LoopState Q2 Q1 1) ↦
      Stage_online_eval.sequential_generatedRoot_131 Backend.backend model tape (loopPaths i) GeneratedClaim.stage_4_params i
        (current.1, current.2.1, current.2.2.1, current.2.2.2.1, current.2.2.2.2.1,
          current.2.2.2.2.2.1, current.2.2.2.2.2.2.1, current.2.2.2.2.2.2.2.1,
          current.2.2.2.2.2.2.2.2.1, current.2.2.2.2.2.2.2.2.2.1, h0, key, h1, c 0, A 0 0, A 1 0,
          c 1, A 0 1, A 1 1, fam 0 0, fam 0 1, fam 1 0, fam 1 1, ()) next) count
      (0, 0, 0, 0, 0, 0, fam 0 0 0, fam 0 1 0, fam 1 0 0, fam 1 1 0, ()) final) :
    Rel sm final.key (∑ i ∈ Finset.range count, lutBranchTarget μ sp fam i) final.row
        (count * lutBranchBound B) ∧
      final.switch = fun k j ↦ fam k j ⟨count, by omega⟩ := by
  refine MxxIR.IterRuns.invariant
    (Invariant := fun k (s : LoopState Q2 Q1 1) ↦ ∀ hk : k ≤ 15,
      Rel sm s.key (∑ i ∈ Finset.range k, lutBranchTarget μ sp fam i) s.row (k * lutBranchBound B) ∧
        s.switch = fun k' j ↦ fam k' j ⟨k, by omega⟩) ?_ ?_ hruns hcount
  · intro _
    refine ⟨?_, ?_⟩
    · rw [Finset.range_zero, Finset.sum_empty, zero_mul]
      have hrow : (![0, 0] : Fin 2 → ExactMatrix Q2 N 1 1) = 0 := by
        funext j
        fin_cases j <;> rfl
      simp only [LoopState.key, LoopState.row, hrow]
      exact Rel.zero
    · funext k j
      fin_cases k <;> fin_cases j <;> rfl
  · intro i current next hinv hbody hk
    obtain ⟨hrel, hsw⟩ := hinv (by omega)
    obtain ⟨hrel', hsw'⟩ := lutLoop_step hsm hg' hg henc hhelp (by omega) hsw hrel hbody
    refine ⟨?_, hsw'⟩
    rw [Finset.sum_range_succ, lutBranchTarget, dif_pos (by omega), add_mul, one_mul]
    exact hrel'

