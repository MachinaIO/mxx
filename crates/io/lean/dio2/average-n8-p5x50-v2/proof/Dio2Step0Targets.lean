/-- Plaintexts of the exported non-label target pairs. -/
noncomputable def nonlabelValue (payload next result : ErrorPoly 8) : Nat → Fin 2 → ErrorPoly 8
  | 0 => unitPair payload
  | 1 => unitPair next
  | 2 => fun j ↦ result * unitPair payload j
  | 3 => unitPair next
  | 4 => unitPair (substitution 3 (⟨1, rfl⟩ : Odd 3) next)
  | 5 => unitPair (substitution 5 (⟨2, rfl⟩ : Odd 5) next)
  | 6 => unitPair (substitution 7 (⟨3, rfl⟩ : Odd 7) next)
  | 7 => unitPair (substitution 9 (⟨4, rfl⟩ : Odd 9) next)
  | 8 => unitPair (substitution 11 (⟨5, rfl⟩ : Odd 11) next)
  | 9 => unitPair (substitution 13 (⟨6, rfl⟩ : Odd 13) next)
  | 10 => unitPair (substitution 15 (⟨7, rfl⟩ : Odd 15) next)
  | 11 => fun _ ↦ 0
  | 12 => fun _ ↦ 0
  | _ => fun _ ↦ 0

/-- The exported target of non-label pair `t`. -/
def nonlabelTarget (t : Nat) : Nat := if t < 3 then t else t + 5

/-- Plaintext of every refresh part: label parts carry the forest plaintext. -/
noncomputable def stepTarget (payload next result : ErrorPoly 8) (label : Fin 5 → ErrorPoly 8)
    (part : Fin 36) : ErrorPoly 8 :=
  if h : 3 ≤ part.val / 2 ∧ part.val / 2 < 8 then
    label ⟨part.val / 2 - 3, by omega⟩ * unitPair next ⟨part.val % 2, Nat.mod_lt _ (by decide)⟩
  else
    nonlabelValue payload next result (if part.val / 2 < 3 then part.val / 2 else part.val / 2 - 5)
      ⟨part.val % 2, Nat.mod_lt _ (by decide)⟩

