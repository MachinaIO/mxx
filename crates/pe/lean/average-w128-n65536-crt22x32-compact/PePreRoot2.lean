    · rw [eb]; exact hR
    · rw [ec]; exact hR
    · rw [ed]; exact hR
  have hM : ∀ r (j : Fin 2) (l : Fin 44), preM_2 ctx r j 0 l =
      ∑ a, keyCompanionSum model (generatedRoot.w_3_0 ctx) p A r ⟨44 * (j : Nat) + l, by omega⟩ a +
      ∑ a : Fin 44, A r 0 0 a *
        rowDigits (joinRow ![rhsTop model (generatedRoot.w_3_0 ctx) p 0,
          rhsTop model (generatedRoot.w_3_0 ctx) p 1]) a ⟨44 * (j : Nat) + l, by omega⟩ := by
    intro r j l
    unfold preM_2
    rw [select_four F.c12.h146_0 hw1, select_four F.c13.h151_0 hw1, select_four F.c14.h156_0 hw1,
      select_four F.c15.h161_0 hw1]
