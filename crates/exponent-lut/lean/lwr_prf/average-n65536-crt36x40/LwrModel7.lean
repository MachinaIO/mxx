/-- The numerator `A v` of the alignment of a member of `a`: its error after the digits `H`, minus
the row residue, plus the mask-weighted key residues. -/
noncomputable def alignNumer7 (sm : ErrorPoly N) (mk : Fin 2 → Fin 2 → ExactMatrix Q36 N 1 144)
    (ea : Fin 2 → ErrorMatrix N 1 144) (row : Fin 2 → ExactMatrix Q36 N 1 144) (j : Fin 2) :
    ErrorMatrix N 1 116 :=
  ea j * liftMatrix alignDigits7 - downResidue A29 (row j * alignDigits7) +
    sm • downResidue A29 (mk 0 j * alignDigits7) + downResidue A29 (mk 1 j * alignDigits7)

/-- The numerator `p v` of a block-1 cell. -/
noncomputable def cellNumer7 (sm : ErrorPoly N) (mk : Fin 2 → Fin 2 → ExactMatrix Q36 N 1 144)
    (va : Fin 2 → ErrorMatrix N 1 116) (es : Fin 2 → ErrorMatrix N 1 112) (α : ErrorPoly N)
    (As : Fin 2 → Fin 2 → ExactMatrix Q29 N 1 112) (top bot : Fin 2 → ExactMatrix Q28 N 1 108)
    (crow : Fin 2 → ExactMatrix Q29 N 1 116) (cs : Fin 2 → ExactMatrix Q29 N 1 112)
    (pay : ExactMatrix Q29 N 1 1) (j : Fin 2) : ErrorMatrix N 1 108 :=
  pairMul (fun j' ↦ pairMul va (liftMatrix (pubDigits7 As j')) + α • es j')
      (liftMatrix (rhsDigits7 top bot j)) -
    downResidue P29 (pairMul (fun j' ↦ pairMul crow (pubDigits7 As j') +
      matrixMulScalarRight (cs j') pay) (rhsDigits7 top bot j)) +
    sm • downResidue P29 (cellKeyUp7 mk As top bot 0 j) + downResidue P29 (cellKeyUp7 mk As top bot 1 j)

