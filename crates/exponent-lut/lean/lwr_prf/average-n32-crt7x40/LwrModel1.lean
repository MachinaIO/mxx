        (∑ i : Fin 14, fun j ↦ reducePoly Q5 N (((P5 : Nat) : Int) *
          (α ⟨coords 1 i, coords_lt 1 i⟩ * μ * ν i) * unitPair sp j) • h)
        ![w.w_64_4, w.w_64_5]
        (∑ i : Fin 14, fun j ↦ divInt P6 (cellNumer1 sm (memberKey model key ((coords 1 i : Nat) : Int))
