/-- **Step zero, from the actual source targets.** Every refreshed export of online
zero is a certified encoding under the next mask with the next root keys; the label
plaintexts are the requirement's next external labels, and import one carries them
into the shared step-one invariant. -/
theorem Complete.step0_transition_of {model : HashModel} {external : GeneratedClaim.ExternalInputs}
    {execution : GeneratedClaim.Execution} (hrun : W_GeneratedClaim.Runs model external execution)
    (state bit : Nat) (hsrc : Online0SourceTargets model external execution state bit) :
    State1 model external execution
      (Xe (n := 8) (2 * (entry table0 ((state + bit : Nat) : Int)).toNat)) := by
  obtain ⟨initial, next, fresh, smudge, R⟩ := hsrc
  obtain ⟨label, hbridge, hp⟩ := refreshed_pairs hrun initial R
  have F := initial.context.online_facts
  have hseed : generatedRoot.w_755_0 initial.context.online = external.input_3 := by
    rw [generatedRoot.w_755_0, initial.context.online_inputs]; rfl
  have hA : generatedRoot.w_860_0 initial.context.online = execution.«stage_1».2.2.1 := by
    rw [generatedRoot.w_860_0, initial.context.online_inputs]; exact (anchor_public hrun).2
  have hout := F.c51.hout
  refine state1_of_refreshed_roots hrun (sm := next) (sp := initial.payload)
    (gadget := generatedRoot.w_57_0 initial.context.online) R.next_small initial.payload_small
    R.gadget (Complete.payload_matrix_eq initial.payload_eq) ?_
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro m
    rw [hout]
    by_cases hm : m.val = 1
    · have hm' : m = 1 := Fin.ext hm
      subst hm'
      have h := root_1 F hseed
        (value := fun c ↦ online1Labels external 1 * unitPair next c)
        (fun c ↦ by
          simp only [show online1Labels external 1 = 1 from Complete.label1_last_payload hrun, one_mul]
          fin_cases c <;> rfl)
        (hp ⟨1, by decide⟩)
      refine rel_congr h (fun r j ↦ rfl) (fun _ ↦ rfl) (fun j ↦ ?_) (by norm_num)
      fin_cases j
      · exact (dynamic_route _ (by simp [MxxIR.selectInt, StepTransition.partIndex])
          (StepTransition.route_rns_bgg_root_row_dio2_label_0_0 initial.context.online F 1)).symm
      · exact (dynamic_route _ (by simp [MxxIR.selectInt, StepTransition.partIndex])
          (StepTransition.route_rns_bgg_root_row_dio2_label_0_1 initial.context.online F 1)).symm
    · have hlt : m.val * 5 < 5 := by omega
      let fm : Fin 5 := ⟨m.val * 5, hlt⟩
      let t : Fin 18 := ⟨3 + m.val * 5, by omega⟩
      refine rel_congr (hp t) (fun r j ↦ ?_) (fun j ↦ ?_) (fun j ↦ ?_) (by norm_num)
      · rw [target_label0_key initial.context.online F _ fm j
          (by simp only [StepTransition.partIndex, t, fm]; omega)
          (by simp only [StepTransition.partIndex, t]; omega)
          (by simp only [fm]; omega) r, hseed]
        congr 2
        simp only [fm]; omega
      · show reducePoly modulus_0 8 (Step0Targets.stepTarget initial.payload next (Xe (n := 8) (2 * (entry table0 ((state + bit : Nat) : Int)).toNat)) label
          (StepTransition.partIndex t j)) • _ = _
        have hv : Step0Targets.stepTarget initial.payload next (Xe (n := 8) (2 * (entry table0 ((state + bit : Nat) : Int)).toNat)) label (StepTransition.partIndex t j) =
            label fm * unitPair next j := by
          unfold Step0Targets.stepTarget
          rw [dif_pos (by simp only [StepTransition.partIndex, t]; omega)]
          congr 2
          · apply Fin.ext; simp only [StepTransition.partIndex, t, fm]; omega
          · apply Fin.ext; simp only [StepTransition.partIndex, t]; omega
        rw [hv, map_mul, map_mul, hbridge m fm hm rfl]
      · fin_cases j
        · exact (dynamic_route _ (by simp [MxxIR.selectInt, StepTransition.partIndex, t, hm]; omega)
            (StepTransition.route_rns_bgg_root_row_dio2_label_0_0 initial.context.online F m)).symm
        · exact (dynamic_route _ (by simp [MxxIR.selectInt, StepTransition.partIndex, t, hm]; omega)
            (StepTransition.route_rns_bgg_root_row_dio2_label_0_1 initial.context.online F m)).symm
  · rw [hout]
    have h := root_2 F hseed (value := fun c ↦ (Xe (n := 8) (2 * (entry table0 ((state + bit : Nat) : Int)).toNat)) * unitPair initial.payload c)
      (fun c ↦ by fin_cases c <;> rfl) (hp ⟨2, by decide⟩)
    refine rel_congr h (fun r j ↦ rfl) (fun _ ↦ rfl) (fun j ↦ ?_) (by norm_num)
    fin_cases j
    · exact (StepTransition.route_rns_bgg_root_row_dio2_state_0 initial.context.online F).symm
    · exact (StepTransition.route_rns_bgg_root_row_dio2_state_1 initial.context.online F).symm
  · rw [hout]
    have h := root_0 F hseed (value := fun c ↦ unitPair initial.payload c)
      (fun c ↦ by fin_cases c <;> rfl) (hp ⟨0, by decide⟩)
    refine rel_congr h (fun r j ↦ ?_) (fun _ ↦ rfl) (fun j ↦ ?_) (by norm_num)
    · fin_cases r <;> fin_cases j <;> rfl
