    ((A25 : Int) : ErrorPoly N) * divInt A25 (alignM11 model key ext tape i j) row column) ∧
  ∀ i j row column, numerM11 model key ext tape i j row column =
    ((P25 : Int) : ErrorPoly N) * divInt P25 (numerM11 model key ext tape i j) row column

/-- The state target of block `12` at `Q24`. -/
