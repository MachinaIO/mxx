theorem pre_root1 {ctx : generatedRoot.Ctx Backend.backend model tape path params}
    {outputs : _} (F : generatedRoot.Facts ctx outputs)
    {A : Fin 2 → Fin 2 → ExactMatrix Q N 1 30}
    (hA0 : concatColumns (A 0 0) (A 0 1) (generatedRoot.w_133_0 ctx))
    (hA1 : concatColumns (A 1 0) (A 1 1) (generatedRoot.w_134_0 ctx))
    (p : Fin 2) (hp : generatedRoot.w_0_0 ctx 1 = p) :
    (∀ r (j : Fin 2) (l : Fin 30), preM_1 ctx r j 0 l =
      ∑ a, keyCompanionSum model (generatedRoot.w_3_0 ctx) p A r ⟨30 * (j : Nat) + l, by omega⟩ a +
      ∑ a : Fin 30, A r 0 0 a *
