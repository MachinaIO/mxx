/-- The numerator `A v` of the alignment of a member of `a`: its error after the digits `H`, minus
the row residue, plus the mask-weighted key residues. -/
noncomputable def alignNumer19 (sm : ErrorPoly N) (mk : Fin 2 → Fin 2 → ExactMatrix Q36 N 1 144)
    (ea : Fin 2 → ErrorMatrix N 1 144) (row : Fin 2 → ExactMatrix Q36 N 1 144) (j : Fin 2) :
    ErrorMatrix N 1 68 :=
  ea j * liftMatrix alignDigits19 - downResidue A17 (row j * alignDigits19) +
    sm • downResidue A17 (mk 0 j * alignDigits19) + downResidue A17 (mk 1 j * alignDigits19)

/-- The numerator `p v` of a block-1 cell. -/
noncomputable def cellNumer19 (sm : ErrorPoly N) (mk : Fin 2 → Fin 2 → ExactMatrix Q36 N 1 144)
    (va : Fin 2 → ErrorMatrix N 1 68) (es : Fin 2 → ErrorMatrix N 1 64) (α : ErrorPoly N)
    (As : Fin 2 → Fin 2 → ExactMatrix Q17 N 1 64) (top bot : Fin 2 → ExactMatrix Q16 N 1 60)
    (crow : Fin 2 → ExactMatrix Q17 N 1 68) (cs : Fin 2 → ExactMatrix Q17 N 1 64)
    (pay : ExactMatrix Q17 N 1 1) (j : Fin 2) : ErrorMatrix N 1 60 :=
  pairMul (fun j' ↦ pairMul va (liftMatrix (pubDigits19 As j')) + α • es j')
      (liftMatrix (rhsDigits19 top bot j)) -
    downResidue P17 (pairMul (fun j' ↦ pairMul crow (pubDigits19 As j') +
      matrixMulScalarRight (cs j') pay) (rhsDigits19 top bot j)) +
    sm • downResidue P17 (cellKeyUp19 mk As top bot 0 j) + downResidue P17 (cellKeyUp19 mk As top bot 1 j)

