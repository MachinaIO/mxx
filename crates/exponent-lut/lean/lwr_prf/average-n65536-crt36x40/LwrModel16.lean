/-- The error entering block `17`. -/
noncomputable def err17 (tape : SampleTape) : Fin 2 → ErrorMatrix N 1 72 :=
  ∑ i : Fin 113, fun j ↦ divInt P20 (numerM16 model key ext tape i j) -
    (alphaOf ext ⟨coords 16 i, coords_lt 16 i⟩ * muOf ext 16) • rhsError16 tape [2] i j

/-- The alignment and cell numerators of block `16` are divisible by their dropped factors. -/
def div16 (tape : SampleTape) : Prop :=
  (∀ i j row column, alignM16 model key ext tape i j row column =
    ((A20 : Int) : ErrorPoly N) * divInt A20 (alignM16 model key ext tape i j) row column) ∧
  ∀ i j row column, numerM16 model key ext tape i j row column =
    ((P20 : Int) : ErrorPoly N) * divInt P20 (numerM16 model key ext tape i j) row column

/-- The state target of block `17` at `Q19`. -/
