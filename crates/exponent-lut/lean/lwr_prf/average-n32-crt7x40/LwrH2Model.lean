noncomputable def αB1 (i : Fin 14) : ErrorPoly N := alphaOf ext ⟨coords 1 i, coords_lt 1 i⟩

noncomputable def DrB1 (tape : SampleTape) (i : Fin 14) (j : Fin 2) : ErrorMatrix N (10 + 10) 8 :=
  liftMatrix (rhsDigits1 (rhsTop model key Q5 8 rhsPrefix1 i) (bot1 model key ext tape i) j)

noncomputable def XB1 (tape : SampleTape) (i : Fin 14) (j : Fin 2) : ErrorMatrix N 1 8 :=
  downResidue P6 (pairMul (fun j' ↦ pairMul (fun j' ↦ theOutput (blockModSwitchRuns [1099511626049, 1099511625409, 1099511623297, 1099511622593, 1099511622529, 1099511621249, 1099511619841] 1) (memberRow model key ext tape ⟨coords 1 i, coords_lt 1 i⟩ j' * alignDigits1))
      (pubDigits1 (key1 model key ext tape) j') +
    matrixMulScalarRight (stateRow1 model key ext tape j')
      (fun _ _ ↦ reducePoly Q6 N (alphaOf ext ⟨coords 1 i, coords_lt 1 i⟩)))
    (rhsDigits1 (rhsTop model key Q5 8 rhsPrefix1 i) (bot1 model key ext tape i) j))

noncomputable def M0B1 (tape : SampleTape) (i : Fin 14) (j : Fin 2) : ErrorMatrix N 1 8 :=
  downResidue P6 (cellKeyUp1 (memberKey model key ((coords 1 i : Nat) : Int)) (key1 model key ext tape)
