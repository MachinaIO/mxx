      (rhsTop model key Q3 8 rhsPrefix32 i) (bot32 model key ext tape i)
      (fun j' ↦ theOutput (blockModSwitchRuns [1099510054913, 1099507695617, 1099506515969, 1099504549889, 1099503894529, 1099503370241, 1099502714881, 1099500617729, 1099499569153, 1099499175937, 1099498258433, 1099490000897, 1099489607681, 1099488428033, 1099486855169, 1099484889089, 1099484495873, 1099482923009, 1099480956929, 1099479121921, 1099469684737, 1099468767233, 1099468505089, 1099467194369, 1099465359361, 1099463786497, 1099461820417, 1099460902913, 1099460640769, 1099457495041, 1099455004673, 1099454218241, 1099453431809, 1099451465729, 1099451072513, 1099450810369] 1) (memberRow model key ext tape ⟨coords 32 i, coords_lt 32 i⟩ j' * alignDigits32))
      (stateRow32 model key ext tape) (fun _ _ ↦ reducePoly Q4 N (alphaOf ext ⟨coords 32 i, coords_lt 32 i⟩)) j

/-- The error entering block `33`. -/
noncomputable def err33 (tape : SampleTape) : Fin 2 → ErrorMatrix N 1 8 :=
  ∑ i : Fin 113, fun j ↦ divInt P4 (numerM32 model key ext tape i j) -
    (alphaOf ext ⟨coords 32 i, coords_lt 32 i⟩ * muOf ext 32) • rhsError32 tape [2] i j

/-- The alignment and cell numerators of block `32` are divisible by their dropped factors. -/
def div32 (tape : SampleTape) : Prop :=
  (∀ i j row column, alignM32 model key ext tape i j row column =
    ((A4 : Int) : ErrorPoly N) * divInt A4 (alignM32 model key ext tape i j) row column) ∧
  ∀ i j row column, numerM32 model key ext tape i j row column =
    ((P4 : Int) : ErrorPoly N) * divInt P4 (numerM32 model key ext tape i j) row column

/-- The state target of block `33` at `Q3`. -/
noncomputable def stateTarget33 (tape : SampleTape) (j : Fin 2) : ExactMatrix Q3 N 1 8 :=
  reducePoly Q3 N (((P3 : Nat) : Int) * muOf ext 33 * unitPair (payloadM tape) j) • gReb Q3 Q2 8

