/-- The packed non-label pair `t` encodes `x` with error at most `B` in both components. -/
def NonLabelRow (initial : State0Witness model external execution value) (t : Nat)
    (ht : t < 13) (x : Fin 2 → ErrorPoly 8) (B : Nat) : Prop :=
  ∀ j : Fin 2, EntryRow (reducePoly modulus_0 8 initial.mask)
    (generatedRoot.w_635_0 initial.context.online (pairIndex t ht j))
    (generatedRoot.w_707_0 initial.context.online (pairIndex t ht j))
    (generatedRoot.w_754_0 initial.context.online (pairIndex t ht j))
    (generatedRoot.w_57_0 initial.context.online) (x j) B

/-- Exported target 0 (private). -/
theorem target_0 (hrun : W_GeneratedClaim.Runs model external execution) {state : Nat}
    (initial : State0Witness model external execution (Xe (n := 8) (2 * state)))
    {anchor : ExactMatrix modulus_0 8 2 54} {next result : ErrorPoly 8}
    {fresh : Fin 900 → ErrorPoly 8} {smudge : Fin 4500 → ErrorPoly 8}
    (R : Online0Sources.Relations initial.context.online anchor initial.mask initial.payload
      next result fresh smudge) :
    NonLabelRow initial 0 (by decide) (unitPair initial.payload) b1_private := by
  have F := initial.context.online_facts
  have hGG : generatedRoot.w_72_0 initial.context.online = generatedRoot.w_57_0 initial.context.online :=
    gadgetMatrixRuns_unique F.c1.h72_0 F.c1.h57_0
  have seed : generatedRoot.w_7_0 initial.context.online = (Claim0.initialInputs external execution).2.2.1 := by
    change initial.context.online.inputs.2.2.2.2.2.2.2.1 = _
    rw [initial.context.online_inputs]; rfl
  have hpriv := Online0Claim.imported_rel_row_dio2_one_private_0 hrun initial F.c1.h72_0
  have row := online0_target_priv initial.context.online F (by decide) Backend.layout0 Online0Claim.layout_some Online0Claim.layout_exact hpriv
  intro j
