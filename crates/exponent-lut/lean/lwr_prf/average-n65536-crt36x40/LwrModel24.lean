/-- The numerator `A v` of the alignment of a member of `a`: its error after the digits `H`, minus
the row residue, plus the mask-weighted key residues. -/
noncomputable def alignNumer24 (sm : ErrorPoly N) (mk : Fin 2 → Fin 2 → ExactMatrix Q36 N 1 144)
    (ea : Fin 2 → ErrorMatrix N 1 144) (row : Fin 2 → ExactMatrix Q36 N 1 144) (j : Fin 2) :
    ErrorMatrix N 1 48 :=
  ea j * liftMatrix alignDigits24 - downResidue A12 (row j * alignDigits24) +
    sm • downResidue A12 (mk 0 j * alignDigits24) + downResidue A12 (mk 1 j * alignDigits24)

/-- The numerator `p v` of a block-1 cell. -/
noncomputable def cellNumer24 (sm : ErrorPoly N) (mk : Fin 2 → Fin 2 → ExactMatrix Q36 N 1 144)
    (va : Fin 2 → ErrorMatrix N 1 48) (es : Fin 2 → ErrorMatrix N 1 44) (α : ErrorPoly N)
    (As : Fin 2 → Fin 2 → ExactMatrix Q12 N 1 44) (top bot : Fin 2 → ExactMatrix Q11 N 1 40)
    (crow : Fin 2 → ExactMatrix Q12 N 1 48) (cs : Fin 2 → ExactMatrix Q12 N 1 44)
    (pay : ExactMatrix Q12 N 1 1) (j : Fin 2) : ErrorMatrix N 1 40 :=
  pairMul (fun j' ↦ pairMul va (liftMatrix (pubDigits24 As j')) + α • es j')
      (liftMatrix (rhsDigits24 top bot j)) -
    downResidue P12 (pairMul (fun j' ↦ pairMul crow (pubDigits24 As j') +
      matrixMulScalarRight (cs j') pay) (rhsDigits24 top bot j)) +
    sm • downResidue P12 (cellKeyUp24 mk As top bot 0 j) + downResidue P12 (cellKeyUp24 mk As top bot 1 j)

