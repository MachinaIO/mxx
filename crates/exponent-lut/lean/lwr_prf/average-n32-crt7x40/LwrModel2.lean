          (ea ⟨coords 2 i, coords_lt 2 i⟩) ![ca0 ⟨coords 2 i, coords_lt 2 i⟩, ca1 ⟨coords 2 i, coords_lt 2 i⟩] j) row column =
        ((A5 : Int) : ErrorPoly N) * divInt A5 (alignNumer2 sm (memberKey model key ((coords 2 i : Nat) : Int))
          (ea ⟨coords 2 i, coords_lt 2 i⟩) ![ca0 ⟨coords 2 i, coords_lt 2 i⟩, ca1 ⟨coords 2 i, coords_lt 2 i⟩] j) row column) ∧
      (∀ i j row column, (cellNumer2 sm (memberKey model key ((coords 2 i : Nat) : Int))
            (fun j' ↦ divInt A5 (alignNumer2 sm (memberKey model key ((coords 2 i : Nat) : Int))
              (ea ⟨coords 2 i, coords_lt 2 i⟩) ![ca0 ⟨coords 2 i, coords_lt 2 i⟩, ca1 ⟨coords 2 i, coords_lt 2 i⟩] j')) es
            (α ⟨coords 2 i, coords_lt 2 i⟩) ![![w.w_64_0, w.w_64_1], ![w.w_64_2, w.w_64_3]]
            (rhsTop model key Q4 6 rhsPrefix2 i) ![r20 i, r21 i]
            (fun j' ↦ theOutput (blockModSwitchRuns [1099511626049, 1099511625409, 1099511623297, 1099511622593, 1099511622529, 1099511621249, 1099511619841] 1) (![ca0 ⟨coords 2 i, coords_lt 2 i⟩, ca1 ⟨coords 2 i, coords_lt 2 i⟩] j' * alignDigits2))
            ![w.w_64_4, w.w_64_5] (fun _ _ ↦ reducePoly Q5 N (α ⟨coords 2 i, coords_lt 2 i⟩)) j) row column =
