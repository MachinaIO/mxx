/-- The numerator `A v` of the alignment of a member of `a`: its error after the digits `H`, minus
the row residue, plus the mask-weighted key residues. -/
noncomputable def alignNumer31 (sm : ErrorPoly N) (mk : Fin 2 → Fin 2 → ExactMatrix Q36 N 1 144)
    (ea : Fin 2 → ErrorMatrix N 1 144) (row : Fin 2 → ExactMatrix Q36 N 1 144) (j : Fin 2) :
    ErrorMatrix N 1 20 :=
  ea j * liftMatrix alignDigits31 - downResidue A5 (row j * alignDigits31) +
    sm • downResidue A5 (mk 0 j * alignDigits31) + downResidue A5 (mk 1 j * alignDigits31)

/-- The numerator `p v` of a block-1 cell. -/
noncomputable def cellNumer31 (sm : ErrorPoly N) (mk : Fin 2 → Fin 2 → ExactMatrix Q36 N 1 144)
    (va : Fin 2 → ErrorMatrix N 1 20) (es : Fin 2 → ErrorMatrix N 1 16) (α : ErrorPoly N)
    (As : Fin 2 → Fin 2 → ExactMatrix Q5 N 1 16) (top bot : Fin 2 → ExactMatrix Q4 N 1 12)
    (crow : Fin 2 → ExactMatrix Q5 N 1 20) (cs : Fin 2 → ExactMatrix Q5 N 1 16)
    (pay : ExactMatrix Q5 N 1 1) (j : Fin 2) : ErrorMatrix N 1 12 :=
  pairMul (fun j' ↦ pairMul va (liftMatrix (pubDigits31 As j')) + α • es j')
      (liftMatrix (rhsDigits31 top bot j)) -
    downResidue P5 (pairMul (fun j' ↦ pairMul crow (pubDigits31 As j') +
      matrixMulScalarRight (cs j') pay) (rhsDigits31 top bot j)) +
    sm • downResidue P5 (cellKeyUp31 mk As top bot 0 j) + downResidue P5 (cellKeyUp31 mk As top bot 1 j)

