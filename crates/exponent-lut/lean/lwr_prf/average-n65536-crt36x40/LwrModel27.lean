/-- The numerator `A v` of the alignment of a member of `a`: its error after the digits `H`, minus
the row residue, plus the mask-weighted key residues. -/
noncomputable def alignNumer27 (sm : ErrorPoly N) (mk : Fin 2 → Fin 2 → ExactMatrix Q36 N 1 144)
    (ea : Fin 2 → ErrorMatrix N 1 144) (row : Fin 2 → ExactMatrix Q36 N 1 144) (j : Fin 2) :
    ErrorMatrix N 1 36 :=
  ea j * liftMatrix alignDigits27 - downResidue A9 (row j * alignDigits27) +
    sm • downResidue A9 (mk 0 j * alignDigits27) + downResidue A9 (mk 1 j * alignDigits27)

/-- The numerator `p v` of a block-1 cell. -/
noncomputable def cellNumer27 (sm : ErrorPoly N) (mk : Fin 2 → Fin 2 → ExactMatrix Q36 N 1 144)
    (va : Fin 2 → ErrorMatrix N 1 36) (es : Fin 2 → ErrorMatrix N 1 32) (α : ErrorPoly N)
    (As : Fin 2 → Fin 2 → ExactMatrix Q9 N 1 32) (top bot : Fin 2 → ExactMatrix Q8 N 1 28)
    (crow : Fin 2 → ExactMatrix Q9 N 1 36) (cs : Fin 2 → ExactMatrix Q9 N 1 32)
    (pay : ExactMatrix Q9 N 1 1) (j : Fin 2) : ErrorMatrix N 1 28 :=
  pairMul (fun j' ↦ pairMul va (liftMatrix (pubDigits27 As j')) + α • es j')
      (liftMatrix (rhsDigits27 top bot j)) -
    downResidue P9 (pairMul (fun j' ↦ pairMul crow (pubDigits27 As j') +
      matrixMulScalarRight (cs j') pay) (rhsDigits27 top bot j)) +
    sm • downResidue P9 (cellKeyUp27 mk As top bot 0 j) + downResidue P9 (cellKeyUp27 mk As top bot 1 j)

