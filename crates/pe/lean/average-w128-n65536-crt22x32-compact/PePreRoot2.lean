namespace PeProof

open Mxx.Primitives MxxRuntime MxxExponentLut MxxPe Stage_preprocess

variable {model : HashModel} {tape : SampleTape} {path : List Nat} {params : Params}

/-- The product key of preprocessing step 2. -/
noncomputable def preM_2 (ctx : generatedRoot.Ctx Backend.backend model tape path params) :
    Fin 2 → Fin 2 → ExactMatrix Q N 1 44 :=
  ![![generatedRoot.w_146_0 ctx, generatedRoot.w_151_0 ctx],
    ![generatedRoot.w_156_0 ctx, generatedRoot.w_161_0 ctx]]

set_option maxRecDepth 200000 in
set_option maxHeartbeats 0 in
theorem pre_root2 {ctx : generatedRoot.Ctx Backend.backend model tape path params}
    {outputs : _} (F : generatedRoot.Facts ctx outputs)
    {A : Fin 2 → Fin 2 → ExactMatrix Q N 1 44}
    (hA0 : concatColumns (A 0 0) (A 0 1) (generatedRoot.w_129_0 ctx))
    (hA1 : concatColumns (A 1 0) (A 1 1) (generatedRoot.w_130_0 ctx))
    (p : Fin 4) (hp : generatedRoot.w_0_0 ctx 2 = p) :
    (∀ r (j : Fin 2) (l : Fin 44), preM_2 ctx r j 0 l =
      ∑ a, keyCompanionSum model (generatedRoot.w_3_0 ctx) p A r ⟨44 * (j : Nat) + l, by omega⟩ a +
      ∑ a : Fin 44, A r 0 0 a *
        rowDigits (joinRow ![rhsTop model (generatedRoot.w_3_0 ctx) p 0,
          rhsTop model (generatedRoot.w_3_0 ctx) p 1]) a ⟨44 * (j : Nat) + l, by omega⟩) ∧
    (∀ d1 : BranchData, d1.key = generatedRoot.w_3_0 ctx → d1.T0 = generatedRoot.w_171_0 ctx →
      d1.T1 = generatedRoot.w_172_0 ctx →
      ∀ (b : Fin 22) r jj, ![d1.Tb0 b b.isLt, d1.Tb1 b b.isLt] r 0 jj =
        ∑ a, lutKeyCompanionSum model (generatedRoot.w_3_0 ctx) b (preM_2 ctx) r jj a +
        ∑ a : Fin 44, substitution (kSw b) (kSw_odd b) (preM_2 ctx r 0 0 a) *
          rowDigits (switchTopRow model (generatedRoot.w_3_0 ctx) b) a jj) ∧
    (∀ (d1 : BranchData) (d2 : Leaf2Data), d1.key = generatedRoot.w_3_0 ctx →
      d1.T0 = generatedRoot.w_171_0 ctx → d1.T1 = generatedRoot.w_172_0 ctx →
      d2.key = generatedRoot.w_3_0 ctx → d2.T0 = generatedRoot.w_171_0 ctx →
      d2.T1 = generatedRoot.w_172_0 ctx →
      (∀ (l : Fin 105) r jj, ![d2.Tb0 l l.isLt, d2.Tb1 l l.isLt] r 0 jj =
        ∑ a, lutKeyCompanionSum model (generatedRoot.w_3_0 ctx) (member2 l l.isLt)
          (d1.key1 model ⟨l % 15, by omega⟩) r jj a +
        ∑ a : Fin 44, substitution (kSw (15 + l / 15)) (kSw_odd (member2 l l.isLt))
          (d1.key1 model ⟨l % 15, by omega⟩ r 0 0 a) *
          rowDigits (switchTopRow model (generatedRoot.w_3_0 ctx) (member2 l l.isLt)) a jj) ∧
      keyOf (generatedRoot.w_186_0 ctx, generatedRoot.w_186_1 ctx, generatedRoot.w_186_2 ctx,
          generatedRoot.w_186_3 ctx, ()) =
        stepKey model (preM_2 ctx) d1 d2
          (fun k ↦ branchCoef (generatedRoot.w_54_0 ctx) 256 k (by norm_num))) := by
  -- The position of the step.
  have hw1 : generatedRoot.w_127_0 ctx = ((p : Nat) : Int) := by
    rw [familyStatic_four (k := 2) (by norm_num) F.c10.h127_0, ← hp]
    rfl
  -- The product key at row `r`, block `j` of each position.
  have P0 : ∀ r (j : Fin 2) (l : Fin 44),
      ![![generatedRoot.w_133_0 ctx, generatedRoot.w_147_0 ctx],
        ![generatedRoot.w_152_0 ctx, generatedRoot.w_157_0 ctx]] r j 0 l =
      ∑ a, keyCompanionSum model (generatedRoot.w_3_0 ctx) 0 A r ⟨44 * (j : Nat) + l, by omega⟩ a +
      ∑ a : Fin 44, A r 0 0 a *
        rowDigits (joinRow ![rhsTop model (generatedRoot.w_3_0 ctx) 0 0,
          rhsTop model (generatedRoot.w_3_0 ctx) 0 1]) a ⟨44 * (j : Nat) + l, by omega⟩ := by
    have R := pos_rows hA0 hA1
      (comp := fun k jj a ↦ keyCompanionSum model (generatedRoot.w_3_0 ctx) 0 A k jj a)
      (X := joinRow ![rhsTop model (generatedRoot.w_3_0 ctx) 0 0, rhsTop model (generatedRoot.w_3_0 ctx) 0 1])
      (fun r w ↦ PreKey2_0.topStep (by norm_num) (iter_one F.c10.h131_1) r w)
      (fun k jj ↦ PreKey2_0.keyLoop hA0 hA1 F.c11.h132_1 k jj)
    intro r j l
    have ea := sliceMatrix_window 0 F.c11.h133_0 rfl (by omega)
    have eb := sliceMatrix_window 44 F.c12.h147_0 rfl (by omega)
    have ec := sliceMatrix_window 0 F.c13.h152_0 rfl (by omega)
    have ed := sliceMatrix_window 44 F.c14.h157_0 rfl (by omega)
    have hR := R r ⟨44 * (j : Nat) + l, by omega⟩
    fin_cases r <;> fin_cases j
    · rw [ea]; exact hR
    · rw [eb]; exact hR
    · rw [ec]; exact hR
    · rw [ed]; exact hR
  -- The product key at row `r`, block `j` of each position.
  have P1 : ∀ r (j : Fin 2) (l : Fin 44),
      ![![generatedRoot.w_137_0 ctx, generatedRoot.w_148_0 ctx],
        ![generatedRoot.w_153_0 ctx, generatedRoot.w_158_0 ctx]] r j 0 l =
      ∑ a, keyCompanionSum model (generatedRoot.w_3_0 ctx) 1 A r ⟨44 * (j : Nat) + l, by omega⟩ a +
      ∑ a : Fin 44, A r 0 0 a *
        rowDigits (joinRow ![rhsTop model (generatedRoot.w_3_0 ctx) 1 0,
          rhsTop model (generatedRoot.w_3_0 ctx) 1 1]) a ⟨44 * (j : Nat) + l, by omega⟩ := by
    have R := pos_rows hA0 hA1
      (comp := fun k jj a ↦ keyCompanionSum model (generatedRoot.w_3_0 ctx) 1 A k jj a)
      (X := joinRow ![rhsTop model (generatedRoot.w_3_0 ctx) 1 0, rhsTop model (generatedRoot.w_3_0 ctx) 1 1])
      (fun r w ↦ PreKey2_1.topStep (by norm_num) (iter_one F.c11.h135_1) r w)
      (fun k jj ↦ PreKey2_1.keyLoop hA0 hA1 F.c11.h136_1 k jj)
    intro r j l
    have ea := sliceMatrix_window 0 F.c11.h137_0 rfl (by omega)
    have eb := sliceMatrix_window 44 F.c12.h148_0 rfl (by omega)
    have ec := sliceMatrix_window 0 F.c13.h153_0 rfl (by omega)
    have ed := sliceMatrix_window 44 F.c14.h158_0 rfl (by omega)
    have hR := R r ⟨44 * (j : Nat) + l, by omega⟩
