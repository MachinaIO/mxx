/-- Every actual step-zero smudge digit uses its own exported radix power. -/
theorem online0_smudge_weights {backend : BackendContext} {hashModel : HashModel}
    {params : Params} (ctx : generatedRoot.Ctx backend hashModel params)
    {outputs : _} (facts : generatedRoot.Facts ctx outputs)
    (digit : Fin 1) :
    generatedRoot.w_985_0 ctx digit = fun _ _ ↦
      (904625697163682872125158399399175198226681342373069820760217620276403972497 : ExactPoly modulus_0 8) *
        (8 : ExactPoly modulus_0 8) ^ digit.val := by
  have equation := (facts.c38.h985_0 digit).2.2
  change generatedRoot.w_985_0 ctx digit = matrixMulScalarLeft
    (liftInteger ((8 : Int) ^ digit.val)) (MxxRuntime.matrixPolynomial [(904625697163682872125158399399175198226681342373069820760217620276403972497)] : Mxx.Primitives.ExactMatrix modulus_0 8 1 1) at equation
  rw [equation]
  funext row column
  simp only [matrixMulScalarLeft, liftInteger, matrixPolynomial_single,
    Int.cast_pow]
  ring

