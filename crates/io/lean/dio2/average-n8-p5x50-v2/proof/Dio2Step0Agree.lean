theorem select_unique {α : Type} {index : Int} {choices : List α} {x y : α}
    (hx : select index choices x) (hy : select index choices y) : x = y := by
  obtain ⟨p, hp, rfl⟩ := hx
  obtain ⟨p', hp', rfl⟩ := hy
  have : p = p' := Fin.ext (by omega)
  rw [this]

theorem familyPack_unique {α : Type} {size : Nat} {count : Int} {values : List α}
    {x y : Fin size → α} (hx : familyPack count values x) (hy : familyPack count values y) :
    x = y := by
  funext index
  obtain ⟨-, -, hx⟩ := hx
  obtain ⟨-, -, hy⟩ := hy
  obtain ⟨p, hp, ex⟩ := hx index
  obtain ⟨p', hp', ey⟩ := hy index
  have : p = p' := Fin.ext (by omega)
  rw [ex, ey, this]

theorem tensorRuns_unique {q r₁ r₂ c₁ c₂ : Nat} {left : ExactMatrix q n r₁ c₁}
    {right : ExactMatrix q n r₂ c₂} {x y : ExactMatrix q n (r₁ * r₂) (c₁ * c₂)}
    (hx : tensorRuns left right x) (hy : tensorRuns left right y) : x = y := by
  funext i j
  have hr2 : 0 < r₂ := Nat.pos_of_ne_zero (by rintro rfl; simp at i; exact i.elim0)
  have hc2 : 0 < c₂ := Nat.pos_of_ne_zero (by rintro rfl; simp at j; exact j.elim0)
  have hi : i = ⟨(i.val / r₂) * r₂ + i.val % r₂, by rw [Nat.div_add_mod']; exact i.isLt⟩ :=
    Fin.ext (Nat.div_add_mod' _ _).symm
  have hj : j = ⟨(j.val / c₂) * c₂ + j.val % c₂, by rw [Nat.div_add_mod']; exact j.isLt⟩ :=
    Fin.ext (Nat.div_add_mod' _ _).symm
  have i1 : i.val / r₂ < r₁ := (Nat.div_lt_iff_lt_mul hr2).2 i.isLt
  have j1 : j.val / c₂ < c₁ := (Nat.div_lt_iff_lt_mul hc2).2 j.isLt
  have ex := hx ⟨i.val / r₂, i1⟩ ⟨i.val % r₂, Nat.mod_lt _ hr2⟩ ⟨j.val / c₂, j1⟩
    ⟨j.val % c₂, Nat.mod_lt _ hc2⟩
  have ey := hy ⟨i.val / r₂, i1⟩ ⟨i.val % r₂, Nat.mod_lt _ hr2⟩ ⟨j.val / c₂, j1⟩
    ⟨j.val % c₂, Nat.mod_lt _ hc2⟩
  rw [hi, hj]
  exact ex.trans ey.symm

theorem blockDiagonalRuns_unique {q rows columns count : Nat}
    {block : ExactMatrix q n rows columns}
    {left right : ExactMatrix q n (rows * count) (columns * count)}
    (hl : blockDiagonalRuns count block left) (hr : blockDiagonalRuns count block right) :
    left = right := by
  funext i j
  have hrows : 0 < rows := by
    rcases Nat.eq_zero_or_pos rows with h | h
    · subst h; simp at i; exact i.elim0
    · exact h
  have hcols : 0 < columns := by
    rcases Nat.eq_zero_or_pos columns with h | h
    · subst h; simp at j; exact j.elim0
    · exact h
  exact congrFun (congrFun (Dio2Proof.blockDiagonalRuns_unique hrows hcols hl hr) i) j

/-- Rows of a slice of a side-by-side stacked product read only that row of both stacks. -/
theorem stack_slice_agree {q m m' : Nat} (k : Fin 3)
    {l0 l1 l2 r0 r1 r2 l0' l1' l2' r0' r1' r2' : ExactMatrix q n 1 m}
    {l01 r01 l01' r01' : ExactMatrix q n (1 + 1) m} {l r l' r' : ExactMatrix q n (1 + 1 + 1) m}
    {both both' : ExactMatrix q n (1 + 1 + 1) (m + m)}
    (hl01 : concatRows l0 l1 l01) (hl : concatRows l01 l2 l)
    (hr01 : concatRows r0 r1 r01) (hr : concatRows r01 r2 r) (hboth : concatColumns l r both)
    (hl01' : concatRows l0' l1' l01') (hl' : concatRows l01' l2' l')
    (hr01' : concatRows r0' r1' r01') (hr' : concatRows r01' r2' r')
    (hboth' : concatColumns l' r' both')
    (el : ![l0, l1, l2] k = ![l0', l1', l2'] k) (er : ![r0, r1, r2] k = ![r0', r1', r2'] k)
    {d d' : ExactMatrix q n (m + m) m'} (ed : d = d')
    {out out' : ExactMatrix q n 1 m'}
    (hs : sliceMatrix (both * d) k.val (k.val + 1) 0 m' out)
    (hs' : sliceMatrix (both' * d') k.val (k.val + 1) 0 m' out') : out = out' := by
  rw [sliceMatrix_row k hs, sliceMatrix_row k hs']
  obtain ⟨a0, a1, a2⟩ := stacked_row hl01 hl hr01 hr hboth d
  obtain ⟨b0, b1, b2⟩ := stacked_row hl01' hl' hr01' hr' hboth' d'
  subst ed
  fin_cases k
  · simp only [Fin.zero_eta, Matrix.cons_val_zero] at el er
    rw [show ((⟨0, by omega⟩ : Fin (1 + 1 + 1))) = 0 from rfl, a0, b0, el, er]
  · simp only [Fin.mk_one, Matrix.cons_val_one, Matrix.cons_val_zero] at el er
    rw [show ((⟨1, by omega⟩ : Fin (1 + 1 + 1))) = 1 from rfl, a1, b1, el, er]
  · simp only [Fin.reduceFinMk, Matrix.cons_val] at el er
    rw [show ((⟨2, by omega⟩ : Fin (1 + 1 + 1))) = 2 from rfl, a2, b2, el, er]

theorem sha256BitColumns_unique {seed : Blob} {rows columns indexBits : Nat}
    {packed counts packed' counts' : Fin columns → Int}
    (h : sha256BitColumns seed rows columns indexBits packed counts)
    (h' : sha256BitColumns seed rows columns indexBits packed' counts') :
    packed = packed' ∧ counts = counts' := by
  obtain ⟨-, -, -, -, -, h⟩ := h
  obtain ⟨-, -, -, -, -, h'⟩ := h'
  exact ⟨funext fun index ↦ (h index).1.trans (h' index).1.symm,
    funext fun index ↦ (h index).2.trans (h' index).2.symm⟩

theorem iterRuns_zero_eq {S : Type} {body : Nat → S → S → Prop} {c : Nat} {init final : S}
    (h : MxxIR.IterRuns body c init final) (hc : c = 0) : final = init := by
  subst hc
  cases h
  rfl

