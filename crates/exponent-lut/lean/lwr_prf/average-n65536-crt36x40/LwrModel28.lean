/-- The numerator `A v` of the alignment of a member of `a`: its error after the digits `H`, minus
the row residue, plus the mask-weighted key residues. -/
noncomputable def alignNumer28 (sm : ErrorPoly N) (mk : Fin 2 → Fin 2 → ExactMatrix Q36 N 1 144)
    (ea : Fin 2 → ErrorMatrix N 1 144) (row : Fin 2 → ExactMatrix Q36 N 1 144) (j : Fin 2) :
    ErrorMatrix N 1 32 :=
  ea j * liftMatrix alignDigits28 - downResidue A8 (row j * alignDigits28) +
    sm • downResidue A8 (mk 0 j * alignDigits28) + downResidue A8 (mk 1 j * alignDigits28)

/-- The numerator `p v` of a block-1 cell. -/
noncomputable def cellNumer28 (sm : ErrorPoly N) (mk : Fin 2 → Fin 2 → ExactMatrix Q36 N 1 144)
    (va : Fin 2 → ErrorMatrix N 1 32) (es : Fin 2 → ErrorMatrix N 1 28) (α : ErrorPoly N)
    (As : Fin 2 → Fin 2 → ExactMatrix Q8 N 1 28) (top bot : Fin 2 → ExactMatrix Q7 N 1 24)
    (crow : Fin 2 → ExactMatrix Q8 N 1 32) (cs : Fin 2 → ExactMatrix Q8 N 1 28)
    (pay : ExactMatrix Q8 N 1 1) (j : Fin 2) : ErrorMatrix N 1 24 :=
  pairMul (fun j' ↦ pairMul va (liftMatrix (pubDigits28 As j')) + α • es j')
      (liftMatrix (rhsDigits28 top bot j)) -
    downResidue P8 (pairMul (fun j' ↦ pairMul crow (pubDigits28 As j') +
      matrixMulScalarRight (cs j') pay) (rhsDigits28 top bot j)) +
    sm • downResidue P8 (cellKeyUp28 mk As top bot 0 j) + downResidue P8 (cellKeyUp28 mk As top bot 1 j)

