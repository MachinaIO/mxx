    (hx : generatedRoot.w_131_0 C.online =
      maskPart (reducePoly modulus_0 8 sm)
        (fun port ↦ stateKey1 C.online port * generatedRoot.w_130_0 C.online) -
      ((decodeQuotient : Int) : ExactPoly modulus_0 8) •
        reduceMatrix modulus_0 8 1 1 (fun _ _ ↦ message) +
      reduceMatrix modulus_0 8 1 1 ex)
    (hex : CoeffBound ex (Dio2NoiseCertificate.C * Dio2NoiseCertificate.b10_state))
    {target : ExactMatrix modulus_0 8 1 1}
    (hs : generatedRoot.w_178_0 C.online =
      maskPart (reducePoly modulus_0 8 sm) (smudgeKeyS1 C.online) - target +
      reduceMatrix modulus_0 8 1 1 es)
    (hes : CoeffBound es Dio2NoiseCertificate.b10_smudge)
    (hresidual : target - generatedRoot.w_181_0 C.online =
      reduceMatrix modulus_0 8 1 1 residual)
    (hbound : CoeffBound residual Dio2NoiseCertificate.b10_residue) :
    FinalOutput execution message := by
  obtain ⟨hintError, hHintBound, hHint⟩ := roots.hint
