  · calc
      _ = (W_Stage_keys_online_0_0.parallel_generatedRoot_985.w_93_0 keyCtx) := rightRow
      _ = _ := by
        have split := concatColumns_mul F.c1.h52_0 (W_Stage_keys_online_0_0.parallel_generatedRoot_985.w_56_0 keyCtx)
        exact congrArg (fun product ↦ product - (W_Stage_keys_online_0_0.parallel_generatedRoot_985.w_58_0 keyCtx) * (W_Stage_keys_online_0_0.parallel_generatedRoot_985.w_70_0 keyCtx) +
