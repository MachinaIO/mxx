  fun slot r member ↦ (![![generatedRoot.w_321_0 ctx member, generatedRoot.w_321_1 ctx member], ![generatedRoot.w_321_2 ctx member, generatedRoot.w_321_3 ctx member], ![generatedRoot.w_321_4 ctx member, generatedRoot.w_321_5 ctx member], ![generatedRoot.w_321_6 ctx member, generatedRoot.w_321_7 ctx member], ![generatedRoot.w_322_0 ctx member, generatedRoot.w_322_1 ctx member], ![generatedRoot.w_322_2 ctx member, generatedRoot.w_322_3 ctx member], ![generatedRoot.w_322_4 ctx member, generatedRoot.w_322_5 ctx member], ![generatedRoot.w_322_6 ctx member, generatedRoot.w_322_7 ctx member], ![generatedRoot.w_323_0 ctx member, generatedRoot.w_323_1 ctx member], ![generatedRoot.w_323_2 ctx member, generatedRoot.w_323_3 ctx member], ![generatedRoot.w_323_4 ctx member, generatedRoot.w_323_5 ctx member], ![generatedRoot.w_323_6 ctx member, generatedRoot.w_323_7 ctx member], ![generatedRoot.w_324_0 ctx member, generatedRoot.w_324_1 ctx member], ![generatedRoot.w_324_2 ctx member, generatedRoot.w_324_3 ctx member], ![generatedRoot.w_324_4 ctx member, generatedRoot.w_324_5 ctx member], ![generatedRoot.w_324_6 ctx member, generatedRoot.w_324_7 ctx member]]) slot r

/-- The physical group/local-slot/row/member artifact layout. -/
def preLeafGroups_2 (ctx : generatedRoot.Ctx Backend.backend model tape path params) :
    Fin 4 → Fin 4 → Fin 2 → Fin 7 → ExactMatrix Q N 1 88 :=
  fun group slot r member ↦ (![![![generatedRoot.w_321_0 ctx member, generatedRoot.w_321_1 ctx member], ![generatedRoot.w_321_2 ctx member, generatedRoot.w_321_3 ctx member], ![generatedRoot.w_321_4 ctx member, generatedRoot.w_321_5 ctx member], ![generatedRoot.w_321_6 ctx member, generatedRoot.w_321_7 ctx member]], ![![generatedRoot.w_322_0 ctx member, generatedRoot.w_322_1 ctx member], ![generatedRoot.w_322_2 ctx member, generatedRoot.w_322_3 ctx member], ![generatedRoot.w_322_4 ctx member, generatedRoot.w_322_5 ctx member], ![generatedRoot.w_322_6 ctx member, generatedRoot.w_322_7 ctx member]], ![![generatedRoot.w_323_0 ctx member, generatedRoot.w_323_1 ctx member], ![generatedRoot.w_323_2 ctx member, generatedRoot.w_323_3 ctx member], ![generatedRoot.w_323_4 ctx member, generatedRoot.w_323_5 ctx member], ![generatedRoot.w_323_6 ctx member, generatedRoot.w_323_7 ctx member]], ![![generatedRoot.w_324_0 ctx member, generatedRoot.w_324_1 ctx member], ![generatedRoot.w_324_2 ctx member, generatedRoot.w_324_3 ctx member], ![generatedRoot.w_324_4 ctx member, generatedRoot.w_324_5 ctx member], ![generatedRoot.w_324_6 ctx member, generatedRoot.w_324_7 ctx member]]]) group slot r

theorem preLeafT_chunk_2 (ctx : generatedRoot.Ctx Backend.backend model tape path params)
    (group slot : Fin 4) (r : Fin 2) (member : Fin 7) :
    preLeafT_2 ctx ⟨4 * group.val + slot.val, by omega⟩ r member =
      preLeafGroups_2 ctx group slot r member := by
  exact Fin.cases (Fin.cases (rfl) (Fin.cases (rfl) (Fin.cases (rfl) (Fin.cases (rfl) ((by intro index; exact Fin.elim0 index)))))) (Fin.cases (Fin.cases (rfl) (Fin.cases (rfl) (Fin.cases (rfl) (Fin.cases (rfl) ((by intro index; exact Fin.elim0 index)))))) (Fin.cases (Fin.cases (rfl) (Fin.cases (rfl) (Fin.cases (rfl) (Fin.cases (rfl) ((by intro index; exact Fin.elim0 index)))))) (Fin.cases (Fin.cases (rfl) (Fin.cases (rfl) (Fin.cases (rfl) (Fin.cases (rfl) ((by intro index; exact Fin.elim0 index)))))) ((by intro index; exact Fin.elim0 index))))) group slot

theorem preLeafT_leaf_2 (ctx : generatedRoot.Ctx Backend.backend model tape path params)
    (leaf : Fin 105) (r : Fin 2) :
    groupedPreLeafRows (preLeafT_2 ctx) r leaf =
      preLeafGroups_2 ctx ⟨(1 + leaf.val % 15) / 4, by omega⟩
        ⟨(1 + leaf.val % 15) % 4, by omega⟩ r ⟨leaf.val / 15, by omega⟩ := by
  unfold groupedPreLeafRows
  rw [← preLeafT_chunk_2]
  congr 1
  apply Fin.ext
  simp only
  omega

