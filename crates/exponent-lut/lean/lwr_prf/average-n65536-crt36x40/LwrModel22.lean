/-- The numerator `A v` of the alignment of a member of `a`: its error after the digits `H`, minus
the row residue, plus the mask-weighted key residues. -/
noncomputable def alignNumer22 (sm : ErrorPoly N) (mk : Fin 2 → Fin 2 → ExactMatrix Q36 N 1 144)
    (ea : Fin 2 → ErrorMatrix N 1 144) (row : Fin 2 → ExactMatrix Q36 N 1 144) (j : Fin 2) :
    ErrorMatrix N 1 56 :=
  ea j * liftMatrix alignDigits22 - downResidue A14 (row j * alignDigits22) +
    sm • downResidue A14 (mk 0 j * alignDigits22) + downResidue A14 (mk 1 j * alignDigits22)

/-- The numerator `p v` of a block-1 cell. -/
noncomputable def cellNumer22 (sm : ErrorPoly N) (mk : Fin 2 → Fin 2 → ExactMatrix Q36 N 1 144)
    (va : Fin 2 → ErrorMatrix N 1 56) (es : Fin 2 → ErrorMatrix N 1 52) (α : ErrorPoly N)
    (As : Fin 2 → Fin 2 → ExactMatrix Q14 N 1 52) (top bot : Fin 2 → ExactMatrix Q13 N 1 48)
    (crow : Fin 2 → ExactMatrix Q14 N 1 56) (cs : Fin 2 → ExactMatrix Q14 N 1 52)
    (pay : ExactMatrix Q14 N 1 1) (j : Fin 2) : ErrorMatrix N 1 48 :=
  pairMul (fun j' ↦ pairMul va (liftMatrix (pubDigits22 As j')) + α • es j')
      (liftMatrix (rhsDigits22 top bot j)) -
    downResidue P14 (pairMul (fun j' ↦ pairMul crow (pubDigits22 As j') +
      matrixMulScalarRight (cs j') pay) (rhsDigits22 top bot j)) +
    sm • downResidue P14 (cellKeyUp22 mk As top bot 0 j) + downResidue P14 (cellKeyUp22 mk As top bot 1 j)

