/-- Prime 0: full part-level `hpre`, with public-action equalities discharged.
The remaining hypotheses are the solved preimage, shared target and online key summaries. -/
theorem online0_hpre0_full {backend : BackendContext} {hashModel : HashModel}
    {params : W_Stage_online_0.Params} {keyParams : W_Stage_keys_online_0_0.Params}
    {part : Nat}
    (ctx : W_Stage_online_0.parallel_generatedRoot_991.Ctx backend hashModel params part)
    (keyCtx : W_Stage_keys_online_0_0.parallel_generatedRoot_984.Ctx backend hashModel keyParams part)
    {onlineOutputs keyOutputs : _}
    (Fo : W_Stage_online_0.parallel_generatedRoot_991.Facts ctx onlineOutputs)
    (Fk : W_Stage_keys_online_0_0.parallel_generatedRoot_984.Facts keyCtx keyOutputs)
    {anchor : ExactMatrix W_Stage_online_0.modulus_0 8 2 54}
    (solved : anchor * (parallel_generatedRoot_991.w_1_0 ctx) = keyOutputs)
    (targetEq : (W_Stage_keys_online_0_0.parallel_generatedRoot_984.w_4_0 keyCtx) = (parallel_generatedRoot_991.w_8_0 ctx))
    {Kg K₁ Kx Kf Ks : Fin 2 → ExactMatrix W_Stage_online_0.modulus_0 8 1 25}
    (hg : ∀ component, keyPartG0 keyCtx component = Kg component)
    (hc : ∀ component, keyPartC10 keyCtx component = K₁ component)
    (hx : ∀ component, keyPartCx0 keyCtx component = Kx component)
    (hf : ∀ component, keyPartFresh0 keyCtx component = Kf component)
    (hs : ∀ component, keyPartSmudge0 keyCtx component = Ks component) :
    ∀ component, rowOf anchor component * (parallel_generatedRoot_991.w_1_0 ctx) =
      (Kg component * topRows (parallel_generatedRoot_991.w_11_0 ctx) +
        K₁ component * bottomRows (parallel_generatedRoot_991.w_11_0 ctx) -
        Kx component * (parallel_generatedRoot_991.w_25_0 ctx)) + Kf component + Ks component := by
  have actions := part_public_agree0 ctx keyCtx Fo Fk targetEq
  exact online0_hpre0 ctx keyCtx Fk solved hg hc hx
    (fun component ↦ (actions component).1) (fun component ↦ (actions component).2) hf hs

