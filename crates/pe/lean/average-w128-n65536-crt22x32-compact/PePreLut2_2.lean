/-- The second-depth public top loop ends with the public top term of every second-depth branch. -/
theorem lut2TopLoop {model : HashModel} {tape : SampleTape} {path : List Nat}
    {params : Stage_preprocess.Params} {key : ByteArray} {K00 K01 K10 K11 : Fin 15 → ExactMatrix Q N 1 44}
    {init final : ExactMatrix Q N 1 9240 × ExactMatrix Q N 1 9240 × Unit}
    (h : MxxIR.IterRuns (fun (i : Nat) (current next : ExactMatrix Q N 1 9240 × ExactMatrix Q N 1 9240 × Unit) ↦
      Stage_preprocess.sequential_generatedRoot_169 Backend.backend model tape (path ++ [169, i]) params i
        (current.1, (current.2.1, (K00, (K01, (key, (K10, (K11, ()))))))) next) (Int.toNat 105) init final)
    (r : Fin 2) (p : Fin 9240) :
    ![final.1, final.2.1] r 0 p = ![init.1, init.2.1] r 0 p +
      ∑ a : Fin 44, substitution (kSw (15 + (p : Nat) / 88 / 15)) (kSw_odd (member2 ((p : Nat) / 88) (by omega)))
        (![K00, K10] r ⟨(p : Nat) / 88 % 15, by omega⟩ 0 a) *
        rowDigits (switchTopRow model key (member2 ((p : Nat) / 88) (by omega))) a ⟨(p : Nat) % 88, by omega⟩ := by
  have hcount : Int.toNat 105 = 105 := rfl
  rw [hcount] at h
  let G : Nat → ExactPoly Q N := fun d ↦ if hd : d < 105 then (if (p : Nat) / 88 = d then
      ∑ a : Fin 44, substitution (kSw (15 + d / 15)) (kSw_odd (member2 d hd))
        (![K00, K10] r ⟨d % 15, by omega⟩ 0 a) *
        rowDigits (switchTopRow model key (member2 d hd)) a ⟨(p : Nat) % 88, by omega⟩ else 0) else 0
  have hacc := IterRuns.accumulate (fun s : ExactMatrix Q N 1 9240 × ExactMatrix Q N 1 9240 × Unit ↦
      ![s.1, s.2.1] r 0 p) G (fun _ _ ↦ True) trivial
    (fun d s t hd _ hst ↦ ⟨by simp only [G, dif_pos hd]; exact lut2TopStep hd hst r p, trivial⟩) h
  obtain ⟨hs, -⟩ := hacc
  dsimp only at hs
  rw [hs]
  congr 1
  rw [Finset.sum_eq_single ((p : Nat) / 88)]
  · simp only [G, dif_pos (show (p : Nat) / 88 < 105 by omega)]
    simp
  · intro d _ hd
    simp only [G]
    split_ifs with h1 h2
    · exact absurd h2.symm hd
    · rfl
    · rfl
  · intro hp
    exact absurd (Finset.mem_range.mpr (by omega)) hp

