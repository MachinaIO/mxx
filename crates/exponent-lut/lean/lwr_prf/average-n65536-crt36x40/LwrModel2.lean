/-- The numerator `A v` of the alignment of a member of `a`: its error after the digits `H`, minus
the row residue, plus the mask-weighted key residues. -/
noncomputable def alignNumer2 (sm : ErrorPoly N) (mk : Fin 2 → Fin 2 → ExactMatrix Q36 N 1 144)
    (ea : Fin 2 → ErrorMatrix N 1 144) (row : Fin 2 → ExactMatrix Q36 N 1 144) (j : Fin 2) :
    ErrorMatrix N 1 136 :=
  ea j * liftMatrix alignDigits2 - downResidue A34 (row j * alignDigits2) +
    sm • downResidue A34 (mk 0 j * alignDigits2) + downResidue A34 (mk 1 j * alignDigits2)

/-- The numerator `p v` of a block-1 cell. -/
noncomputable def cellNumer2 (sm : ErrorPoly N) (mk : Fin 2 → Fin 2 → ExactMatrix Q36 N 1 144)
    (va : Fin 2 → ErrorMatrix N 1 136) (es : Fin 2 → ErrorMatrix N 1 132) (α : ErrorPoly N)
    (As : Fin 2 → Fin 2 → ExactMatrix Q34 N 1 132) (top bot : Fin 2 → ExactMatrix Q33 N 1 128)
    (crow : Fin 2 → ExactMatrix Q34 N 1 136) (cs : Fin 2 → ExactMatrix Q34 N 1 132)
    (pay : ExactMatrix Q34 N 1 1) (j : Fin 2) : ErrorMatrix N 1 128 :=
  pairMul (fun j' ↦ pairMul va (liftMatrix (pubDigits2 As j')) + α • es j')
      (liftMatrix (rhsDigits2 top bot j)) -
    downResidue P34 (pairMul (fun j' ↦ pairMul crow (pubDigits2 As j') +
      matrixMulScalarRight (cs j') pay) (rhsDigits2 top bot j)) +
    sm • downResidue P34 (cellKeyUp2 mk As top bot 0 j) + downResidue P34 (cellKeyUp2 mk As top bot 1 j)

