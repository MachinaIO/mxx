theorem deltaList_eq (i : Nat) (hi : i < 128) :
    MxxIR.selectInt (Int.ofNat i) deltaList = if i = 0 then 1 else 0 := by
  interval_cases i <;> rfl

/-- The residual of slot `i`: `δ_(i,0) y - (Σ_k helper terms + σ_i(B'') v''_i + v_ι,i)`. -/
noncomputable def slotResidual (model : HashModel) (key : ByteArray) (y : ExactMatrix Q N 1 1)
    (v : Fin 4736 → ExactMatrix Q N 88 1) (Bc : ExactMatrix Q N 1 44) (vC : ExactMatrix Q N 44 1)
    (vI : ExactMatrix Q N 1 1) (i : Fin 128) : ExactMatrix Q N 1 1 :=
  (if (i : Nat) = 0 then y else 0) - (∑ k : Fin 37, helperTerm model key v i k +
    substituteMatrix (slotAut i) (slotAut_odd i) Bc * vC + vI)

set_option maxHeartbeats 16000000 in
/-- The target of slot `i` is `σ_i^(-1)` of its residual. -/
theorem slotTarget {model : HashModel} {tape : SampleTape} {path : List Nat}
    {params : Stage_keygen.Params} {key : ByteArray} {y : ExactMatrix Q N 1 1}
    {v : Fin 4736 → ExactMatrix Q N 88 1} {Bc : ExactMatrix Q N 1 44} {vC : ExactMatrix Q N 44 1}
    {vI : ExactMatrix Q N 1 1} {i : Nat} (hi : i < 128) {out : ExactMatrix Q N 1 1}
    (h : Stage_keygen.parallel_generatedRoot_23 Backend.backend model tape path params i
      (y, key, v, gZero, Bc, vC, vI, ()) out) :
    out = substituteMatrix (slotInv i) (slotInv_odd ⟨i, hi⟩)
      (slotResidual model key y v Bc vC vI ⟨i, hi⟩) := by
  obtain ⟨w, hbody⟩ := h
  let ctx : Stage_keygen.parallel_generatedRoot_23.Ctx Backend.backend model tape path params i :=
    ⟨(y, key, v, gZero, Bc, vC, vI, ()), w⟩
  have F := Stage_keygen.parallel_generatedRoot_23.facts ctx hbody
  have hin := F.c0.h8_0
  have hcount : Int.toNat 37 = 37 := rfl
  rw [hcount] at hin
  have hacc := IterRuns.accumulate (fun x : ExactMatrix Q N 1 1 ↦ x)
    (fun k ↦ if hk : k < 37 then helperTerm model key v ⟨i, hi⟩ ⟨k, hk⟩ else 0) (fun _ _ ↦ True) trivial
    (fun k x z hk _ hb ↦ ⟨by simp only [dif_pos hk]; exact helperStep hi hk hb, trivial⟩) hin
  obtain ⟨hsum, -⟩ := hacc
  dsimp only at hsum
  have e8 : Stage_keygen.parallel_generatedRoot_23.w_8_0 ctx = ∑ k : Fin 37, helperTerm model key v ⟨i, hi⟩ k := by
    rw [hsum]
    show (0 : ExactMatrix Q N 1 1) + _ = _
    rw [zero_add, ← Fin.sum_univ_eq_sum_range (fun k ↦ if hk : k < 37 then
      helperTerm model key v ⟨i, hi⟩ ⟨k, hk⟩ else 0)]
    exact Finset.sum_congr rfl fun k _ ↦ by simp [k.isLt]
  have e10 := routing_slot hi F.c0.h10_0
  have e17 := routing_slotInv hi F.c0.h17_0
  have e0 : Stage_keygen.parallel_generatedRoot_23.w_0_0 ctx = if i = 0 then 1 else 0 :=
    deltaList_eq i hi
  rw [F.c0.hout]
  show Stage_keygen.parallel_generatedRoot_23.w_17_0 ctx = _
  rw [e17]
  refine congrArg (substituteMatrix (slotInv i) (slotInv_odd ⟨i, hi⟩)) ?_
  show matrixSub (matrixMulScalarLeft (liftInteger (Stage_keygen.parallel_generatedRoot_23.w_0_0 ctx)) y)
    (matrixAdd (matrixAdd (Stage_keygen.parallel_generatedRoot_23.w_8_0 ctx)
      (matrixMul (Stage_keygen.parallel_generatedRoot_23.w_10_0 ctx) vC)) vI) = _
  have e9 : Stage_keygen.parallel_generatedRoot_23.w_9_0 ctx = Bc := rfl
  rw [e8, e10, e0, e9]
  have hl : ∀ c : Int, matrixMulScalarLeft (liftInteger c : ExactMatrix Q N 1 1) y = (c : ExactPoly Q N) • y := by
    intro c; rfl
  unfold slotResidual
  split_ifs with h0
