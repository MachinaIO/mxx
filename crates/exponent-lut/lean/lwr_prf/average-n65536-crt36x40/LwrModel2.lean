section Model2

variable (model : HashModel) (key : ByteArray) (ext : GeneratedClaim.ExternalInputs)

/-- The state rows entering block `2`. -/
noncomputable def stateRow2 (tape : SampleTape) : Fin 2 → ExactMatrix Q34 N 1 132 :=
  encRow (maskM tape) (key2 model key ext tape) (stateTarget2 ext tape) (err2 model key ext tape)

/-- The selector RHS bottoms of block `2`. -/
noncomputable def bot2 (tape : SampleTape) (i : Fin 113) (j : Fin 2) : ExactMatrix Q33 N 1 128 :=
  reducePoly Q33 N (((P33 : Nat) : Int) * nuOf ext 2 i * unitPair (payloadM tape) j) • gReb Q33 Q32 128 +
    reduceMatrix Q33 N 1 128 (rhsError2 tape [2] i j) -
    reducePoly Q33 N (payloadM tape) • rhsTop model key Q33 128 rhsPrefix2 i j

/-- The keys entering block `3`. -/
noncomputable def key3 (tape : SampleTape) : Fin 2 → Fin 2 → ExactMatrix Q33 N 1 128 :=
  ∑ i : Fin 113, fun k j ↦ theOutput (blockModSwitchRuns [1099510054913, 1099507695617, 1099506515969, 1099504549889, 1099503894529, 1099503370241, 1099502714881, 1099500617729, 1099499569153, 1099499175937, 1099498258433, 1099490000897, 1099489607681, 1099488428033, 1099486855169, 1099484889089, 1099484495873, 1099482923009, 1099480956929, 1099479121921, 1099469684737, 1099468767233, 1099468505089, 1099467194369, 1099465359361, 1099463786497, 1099461820417, 1099460902913, 1099460640769, 1099457495041, 1099455004673, 1099454218241, 1099453431809, 1099451465729] 1)
    (cellKeyUp2 (memberKey model key ((coords 2 i : Nat) : Int)) (key2 model key ext tape)
      (rhsTop model key Q33 128 rhsPrefix2 i) (bot2 model key ext tape i) k j)

/-- The alignment numerator of the member of cell `i` of block `2` in the model. -/
noncomputable def alignM2 (tape : SampleTape) (i : Fin 113) (j : Fin 2) : ErrorMatrix N 1 136 :=
  alignNumer2 (maskM tape) (memberKey model key ((coords 2 i : Nat) : Int))
    (memberError tape [3] ⟨coords 2 i, coords_lt 2 i⟩) (memberRow model key ext tape ⟨coords 2 i, coords_lt 2 i⟩) j

/-- The numerator of cell `i` of block `2` in the model. -/
noncomputable def numerM2 (tape : SampleTape) (i : Fin 113) (j : Fin 2) : ErrorMatrix N 1 128 :=
  cellNumer2 (maskM tape)
      (memberKey model key ((coords 2 i : Nat) : Int))
      (fun j' ↦ divInt A34 (alignM2 model key ext tape i j'))
      (err2 model key ext tape) (alphaOf ext ⟨coords 2 i, coords_lt 2 i⟩) (key2 model key ext tape)
      (rhsTop model key Q33 128 rhsPrefix2 i) (bot2 model key ext tape i)
      (fun j' ↦ theOutput (blockModSwitchRuns [1099510054913, 1099507695617, 1099506515969, 1099504549889, 1099503894529, 1099503370241, 1099502714881, 1099500617729, 1099499569153, 1099499175937, 1099498258433, 1099490000897, 1099489607681, 1099488428033, 1099486855169, 1099484889089, 1099484495873, 1099482923009, 1099480956929, 1099479121921, 1099469684737, 1099468767233, 1099468505089, 1099467194369, 1099465359361, 1099463786497, 1099461820417, 1099460902913, 1099460640769, 1099457495041, 1099455004673, 1099454218241, 1099453431809, 1099451465729, 1099451072513, 1099450810369] 1) (memberRow model key ext tape ⟨coords 2 i, coords_lt 2 i⟩ j' * alignDigits2))
      (stateRow2 model key ext tape) (fun _ _ ↦ reducePoly Q34 N (alphaOf ext ⟨coords 2 i, coords_lt 2 i⟩)) j

/-- The error entering block `3`. -/
noncomputable def err3 (tape : SampleTape) : Fin 2 → ErrorMatrix N 1 128 :=
  ∑ i : Fin 113, fun j ↦ divInt P34 (numerM2 model key ext tape i j) -
    (alphaOf ext ⟨coords 2 i, coords_lt 2 i⟩ * muOf ext 2) • rhsError2 tape [2] i j

/-- The alignment and cell numerators of block `2` are divisible by their dropped factors. -/
def div2 (tape : SampleTape) : Prop :=
  (∀ i j row column, alignM2 model key ext tape i j row column =
    ((A34 : Int) : ErrorPoly N) * divInt A34 (alignM2 model key ext tape i j) row column) ∧
  ∀ i j row column, numerM2 model key ext tape i j row column =
    ((P34 : Int) : ErrorPoly N) * divInt P34 (numerM2 model key ext tape i j) row column

/-- The state target of block `3` at `Q33`. -/
noncomputable def stateTarget3 (tape : SampleTape) (j : Fin 2) : ExactMatrix Q33 N 1 128 :=
  reducePoly Q33 N (((P33 : Nat) : Int) * muOf ext 3 * unitPair (payloadM tape) j) • gReb Q33 Q32 128

