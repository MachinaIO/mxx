        ![generatedRoot.w_49_0 ctx, generatedRoot.w_49_1 ctx] r 0 ⟨88 * (l : Nat) + jj, by omega⟩ := by
      have c0 := concat_right F.c5.h50_0 (88 * (l : Nat) + jj) (by omega)
      have c1 := concat_right F.c5.h51_0 (88 * (l : Nat) + jj) (by omega)
      fin_cases r
