    rw [input_w_211_0 local_ hin]; exact hPd
  have term := online0_part_prime4_canonical local_ pf Backend.layout0
    Online0Claim.layout_some Online0Claim.layout_exact
    (s := reducePoly modulus_0 8 old) (β := reducePoly modulus_0 8 next) (x := target part)
    heg he1 hex hgL hc1L hcxL (Bk := rowOf anchor) hbL heb hPL hPdB
    (Kf := freshPartKey4 local_ part.isLt (cellKey (C := 900) (Online0Sources.freshRows ctx)))
    (Ks := ![parallel_generatedRoot_991.w_252_1 local_, parallel_generatedRoot_991.w_252_2 local_])
    hpre hf hef hs hes hTH hM part rfl (le_refl _) (le_refl _) (le_refl _) (le_refl _)
    (le_refl _) (le_refl _) (le_refl _) (by norm_num [b1_residue])
