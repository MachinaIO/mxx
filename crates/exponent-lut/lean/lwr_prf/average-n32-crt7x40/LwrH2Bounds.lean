theorem maskM_coeff (tape : SampleTape) (k : Fin N) :
    (maskM tape).coeff k = maskClamp [1, 0] tape k.val := by
  simp only [maskM, clampedWitness, intPoly_coeff hN, maskClamp, maskKey]
  rfl

theorem maskM_l1 (tape : SampleTape) : ∑ k, |(((maskM tape).coeff k : ℤ) : ℝ)| ≤ (N : ℝ) := by
  have h := sum_abs_coeff_le (x := maskM tape) (B := 1) fun k ↦ by
    rw [maskM_coeff, maskClamp]
    omega
  simpa using h

theorem sL_l1 (tape : SampleTape) (i : Fin 16) : ∑ k, |(((sL tape i).coeff k : ℤ) : ℝ)| ≤ (N : ℝ) :=
  (sum_abs_substitution_coeff_le hN _ _).trans (maskM_l1 tape)

theorem alpha_l1 (k : Fin 17) : ∑ c, |(((alphaOf ext k).coeff c : ℤ) : ℝ)| ≤ 1 :=
  sum_abs_Xe_coeff_le hN _

theorem alphaMu_l1 (k : Fin 17) (b : Nat) :
    ∑ c, |(((alphaOf ext k * muOf ext b).coeff c : ℤ) : ℝ)| ≤ 1 := by
  rw [show alphaOf ext k * muOf ext b = Xe (n := N) (2 * (ext.input_3 k).toNat + 2 * zOf ext b) by
    simp only [alphaOf, muOf, Xe, pow_add]]
  exact sum_abs_Xe_coeff_le hN _

theorem aL_l1 (i : Fin 16) : ∑ c, |(((aL ext i).coeff c : ℤ) : ℝ)| ≤ 1 :=
  (sum_abs_substitution_coeff_le hN _ _).trans (sum_abs_Xe_coeff_le hN _)

theorem sigma_coprime (i : Fin 16) : N.Coprime (σL i) := by
  have h := (Nat.coprime_two_left.mpr (sigma_odd i)).pow_left 5
  simpa [σL] using h

