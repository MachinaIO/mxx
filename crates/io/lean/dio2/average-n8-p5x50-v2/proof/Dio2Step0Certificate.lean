/-- Quotients in exactly the exported CRT-term order. -/
def primeQuotient : Fin 5 → Nat :=
  ![quotient0, quotient1, quotient2, quotient3, quotient4]

/-- The certificate bounds the error of every part at every prime. -/
theorem noise_margin (part : Fin 36) (prime : Fin 5) :
    2 * (54 * 8 * 1 * cutoff +
      (25 * 8 * b1_g * half + 25 * 8 * b1_one * half +
        25 * 8 * targetBudget part * half) + b1_fresh + b1_smudge +
      b1_residue) < primeQuotient prime := by
  fin_cases prime
  · exact noise_margin0 part
  · exact noise_margin1 part
  · exact noise_margin2 part
  · exact noise_margin3 part
  · exact noise_margin4 part

/-- Real semantic budgets need only be dominated by the checked class budgets. -/
theorem noise_margin_of_bounds (part : Fin 36) (prime : Fin 5)
    {Beb BP Beg Be1 Bex Bf Bs BM : Nat}
    (hBeb : Beb ≤ 1) (hBP : BP ≤ cutoff)
    (hBeg : Beg ≤ b1_g) (hBe1 : Be1 ≤ b1_one)
    (hBex : Bex ≤ targetBudget part) (hBf : Bf ≤ b1_fresh)
    (hBs : Bs ≤ b1_smudge) (hBM : BM ≤ b1_residue) :
    2 * (54 * 8 * Beb * BP +
      (25 * 8 * Beg * half + 25 * 8 * Be1 * half +
        25 * 8 * Bex * half) + Bf + Bs + BM) < primeQuotient prime :=
  lt_of_le_of_lt
    (noise_expression_mono part hBeb hBP hBeg hBe1 hBex hBf hBs hBM)
    (noise_margin part prime)

/-- The sharp symbolic forest/retarget bound fits the label certificate. -/
theorem label_target_budget :
    25 * 8 * (25 * 8 * online0_label_bound_2 1 * 2048) * 2048 + 25 * 8 * (25 * 8 * online0_label_bound_2 1 * 2048) * 2048 + b1_public ≤ b1_label := by
  norm_num [online0_label_bound_0, online0_label_bound_1, online0_label_bound_2, b1_label, b1_public]

