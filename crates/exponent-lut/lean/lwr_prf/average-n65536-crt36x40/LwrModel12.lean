/-- The error entering block `13`. -/
noncomputable def err13 (tape : SampleTape) : Fin 2 → ErrorMatrix N 1 88 :=
  ∑ i : Fin 113, fun j ↦ divInt P24 (numerM12 model key ext tape i j) -
    (alphaOf ext ⟨coords 12 i, coords_lt 12 i⟩ * muOf ext 12) • rhsError12 tape [2] i j

/-- The alignment and cell numerators of block `12` are divisible by their dropped factors. -/
def div12 (tape : SampleTape) : Prop :=
  (∀ i j row column, alignM12 model key ext tape i j row column =
    ((A24 : Int) : ErrorPoly N) * divInt A24 (alignM12 model key ext tape i j) row column) ∧
  ∀ i j row column, numerM12 model key ext tape i j row column =
    ((P24 : Int) : ErrorPoly N) * divInt P24 (numerM12 model key ext tape i j) row column

