        ![generatedRoot.w_154_0 ctx, generatedRoot.w_159_0 ctx]] r j 0 l =
      ∑ a, keyCompanionSum model (generatedRoot.w_3_0 ctx) 2 A r ⟨44 * (j : Nat) + l, by omega⟩ a +
      ∑ a : Fin 44, A r 0 0 a *
        rowDigits (joinRow ![rhsTop model (generatedRoot.w_3_0 ctx) 2 0,
          rhsTop model (generatedRoot.w_3_0 ctx) 2 1]) a ⟨44 * (j : Nat) + l, by omega⟩ := by
    have R := pos_rows hA0 hA1
      (comp := fun k jj a ↦ keyCompanionSum model (generatedRoot.w_3_0 ctx) 2 A k jj a)
      (X := joinRow ![rhsTop model (generatedRoot.w_3_0 ctx) 2 0, rhsTop model (generatedRoot.w_3_0 ctx) 2 1])
      (fun r w ↦ PreKey2_2.topStep (by norm_num) (iter_one F.c11.h139_1) r w)
      (fun k jj ↦ PreKey2_2.keyLoop hA0 hA1 F.c11.h140_1 k jj)
    intro r j l
    have ea := sliceMatrix_window 0 F.c11.h141_0 rfl (by omega)
    have eb := sliceMatrix_window 44 F.c13.h149_0 rfl (by omega)
    have ec := sliceMatrix_window 0 F.c14.h154_0 rfl (by omega)
    have ed := sliceMatrix_window 44 F.c15.h159_0 rfl (by omega)
    have hR := R r ⟨44 * (j : Nat) + l, by omega⟩
    fin_cases r <;> fin_cases j
    · rw [ea]; exact hR
    · rw [eb]; exact hR
    · rw [ec]; exact hR
    · rw [ed]; exact hR
  -- The product key at row `r`, block `j` of each position.
  have P3 : ∀ r (j : Fin 2) (l : Fin 44),
      ![![generatedRoot.w_145_0 ctx, generatedRoot.w_150_0 ctx],
        ![generatedRoot.w_155_0 ctx, generatedRoot.w_160_0 ctx]] r j 0 l =
      ∑ a, keyCompanionSum model (generatedRoot.w_3_0 ctx) 3 A r ⟨44 * (j : Nat) + l, by omega⟩ a +
      ∑ a : Fin 44, A r 0 0 a *
        rowDigits (joinRow ![rhsTop model (generatedRoot.w_3_0 ctx) 3 0,
          rhsTop model (generatedRoot.w_3_0 ctx) 3 1]) a ⟨44 * (j : Nat) + l, by omega⟩ := by
    have R := pos_rows hA0 hA1
      (comp := fun k jj a ↦ keyCompanionSum model (generatedRoot.w_3_0 ctx) 3 A k jj a)
      (X := joinRow ![rhsTop model (generatedRoot.w_3_0 ctx) 3 0, rhsTop model (generatedRoot.w_3_0 ctx) 3 1])
