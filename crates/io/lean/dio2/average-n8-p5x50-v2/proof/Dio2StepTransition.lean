/-- Pointwise successful CRT terms close the actual exported part loop. -/
theorem part_family {backend : BackendContext} {model : HashModel} {params : Params}
    (ctx : generatedRoot.Ctx backend model params) {outputs : _}
    (facts : generatedRoot.Facts ctx outputs)
    (value : Fin 36 → ExactMatrix modulus_0 8 1 25)
    (terms : ∀ (index : Fin 36)
      (part : parallel_generatedRoot_991.Ctx backend model params index.val),
      part.inputs = partInputs ctx index →
      parallel_generatedRoot_991.Facts part (generatedRoot.w_991_0 ctx index) →
      ∀ prime, TermOf (primes0 prime) (crt0 prime) (partTerms0 part prime) (value index)) :
    ∀ index, generatedRoot.w_991_0 ctx index = value index := by
  intro index
  obtain ⟨witness, partBody⟩ := facts.c38.h991_0 index
  let part : parallel_generatedRoot_991.Ctx backend model params index.val :=
    ⟨partInputs ctx index, witness⟩
  have partFacts := parallel_generatedRoot_991.facts part partBody
  exact partFacts.c6.hout.trans (online0_part_row part (terms index part rfl partFacts))

/-- Pair the actual CRT-recombined output family of online zero. -/
noncomputable def nextRows {backend : BackendContext} {model : HashModel} {params : Params}
    (ctx : generatedRoot.Ctx backend model params) (target : Fin 18) :
    Fin 2 → ExactMatrix modulus_0 8 1 25 :=
  fun component ↦ generatedRoot.w_991_0 ctx (partIndex target component)

/-- The complete family of CRT terms yields all paired next-root equations. -/
theorem paired_parts {backend : BackendContext} {model : HashModel} {params : Params}
    (ctx : generatedRoot.Ctx backend model params)
    {next : ErrorPoly 8}
    {keys : Fin 18 → Fin 2 → Fin 2 → ExactMatrix modulus_0 8 1 25}
    {target : Fin 18 → Fin 2 → ExactPoly modulus_0 8}
    {gadget : ExactMatrix modulus_0 8 1 25}
    {fresh : Fin 18 → Fin 2 → ErrorMatrix 8 1 25}
    {bound : Fin 18 → Nat}
    (hfresh : ∀ index component, CoeffBound (fresh index component) (bound index))
    (hparts : ∀ index component,
      generatedRoot.w_991_0 ctx (partIndex index component) =
        reducePoly modulus_0 8 next • keys index 0 component + keys index 1 component -
          target index component • gadget +
            reduceMatrix modulus_0 8 1 25 (fresh index component)) :
    ∀ index, Rel next (keys index) (fun component ↦ target index component • gadget)
      (nextRows ctx index) (bound index) :=
  step_refresh_rel hfresh hparts


