import Dio2Online0SourcesReadouts
import Dio2Online0SourcesValues

/-!
# Actual step-zero Fourier values

Generated by gen_s0a.py from the exported table metadata. Signed exponent
readouts are stride-aligned monomials; the coefficient sampler has absolute
value at most one. Table branches, members and coefficients stay quantified.
-/

set_option maxHeartbeats 16000000
set_option maxRecDepth 16384
set_option Elab.async false

namespace Dio2Proof.Online0Sources
open Mxx.Primitives MxxRuntime MxxExponentLut Mxx.ExponentLut.Refresh
  RefreshTopProof.Gen RefreshTopProof.GenIface RefreshTopProof.GenInst
  RefreshTopProof.GenFinal W_Stage_online_0 Dio2Proof.LutKey
open scoped BigOperators


def sigmaReadoutIndex (branch : Fin 8) : Fin 8 :=
  ⟨(sigmaOf Preprocess.sigmaReadoutSigmas branch).toNat % (2 * 8) / 2, by
    have := Nat.mod_lt (sigmaOf Preprocess.sigmaReadoutSigmas branch).toNat (by decide : 0 < 2 * 8)
    omega⟩

noncomputable def sigmaReadoutPermutation : Fin 8 ≃ Fin 8 :=
  Equiv.ofBijective sigmaReadoutIndex (by decide)

theorem sigmaReadout_index (branch : Fin 8) :
    (sigmaOf Preprocess.sigmaReadoutSigmas branch).toNat % (2 * 8) =
      1 + 2 * 1 * (sigmaReadoutPermutation branch).val := by
  exact (by decide : ∀ branch : Fin 8,
    (sigmaOf Preprocess.sigmaReadoutSigmas branch).toNat % (2 * 8) =
      1 + 2 * 1 * (sigmaReadoutIndex branch).val) branch


def sigmaReadoutExponent (exponent : Nat) : Nat :=
  8 * (exponent / 8) +
    (MxxIR.selectInt (Int.ofNat (exponent % 8)) [1, 1, 3, 3, 5, 5, 7, 7]).toNat

noncomputable def sigmaReadoutValue (exponent : Nat) : ErrorPoly 8 :=
  (((-1 : Int) ^ (exponent / 8) : Int) : ErrorPoly 8) *
    Xe (n := 8) (1 *
      (MxxIR.selectInt (Int.ofNat (exponent % 8)) [1, 1, 3, 3, 5, 5, 7, 7]).toNat)

theorem sigmaReadout_monomial (exponent : Nat) :
    sigmaReadoutValue exponent = Xe (n := 8) (1 * sigmaReadoutExponent exponent) := by
  simp only [sigmaReadoutValue, sigmaReadoutExponent, Xe, Nat.mul_add, ← Nat.mul_assoc,
    Nat.reduceMul, pow_add, pow_mul, pow_one, Negacyclic.root_pow_n,
    Int.cast_pow, Int.cast_neg, Int.cast_one]

theorem sigmaReadout_walsh {message : ErrorPoly 8} (exponent : Nat)
    (hmessage : message = Xe (n := 8) (1 * exponent)) :
    (∑ branch : Fin 8, reducePoly modulus_0 8
      (substitution (sigmaOf Preprocess.sigmaReadoutSigmas branch).toNat (Preprocess.sigmaReadoutOdd branch) message) *
        Preprocess.sigmaReadoutCoefficients branch) =
      reducePoly modulus_0 8 (sigmaReadoutValue exponent) := by
  have hinverse : (1583094970036445026219027198948556596896692349152872186330380835483706951869 : ExactPoly modulus_0 8) *
      (8 : ExactPoly modulus_0 8) = 1 :=
    cast_inverse (by norm_num [modulus_0]) (by norm_num [modulus_0])
  have result := PreprocessSwitch.exponent_walsh (q := modulus_0) (n := 8)
    (inverse := 1583094970036445026219027198948556596896692349152872186330380835483706951869) (stride := 1) (outputStride := 1) (log := 3)
    (by norm_num [modulus_0]) (by decide) (by decide)
    (fun index : Fin 8 ↦ MxxIR.selectInt (Int.ofNat index) [1, 1, 3, 3, 5, 5, 7, 7])
    (by decide) hinverse (sigmaOf Preprocess.sigmaReadoutSigmas) Preprocess.sigmaReadoutOdd sigmaReadoutPermutation sigmaReadout_index
    exponent (congrArg (reducePoly modulus_0 8) hmessage)
  simpa only [Preprocess.sigmaReadoutCoefficients, sigmaReadoutValue, show 2 ^ 3 = 8 from rfl]
    using result


