  replace e119 : w.w_119_0 = w.w_111_2 ⟨1, by decide⟩ := e119
  obtain ⟨_, e121⟩ := familyGetStatic_eq (k := 0) h121_0
  replace e121 : w.w_121_0 = w.w_111_3 ⟨0, by decide⟩ := e121
  obtain ⟨_, e122⟩ := familyGetStatic_eq (k := 1) h122_0
  replace e122 : w.w_122_0 = w.w_111_3 ⟨1, by decide⟩ := e122
  obtain ⟨_, e124⟩ := familyGetStatic_eq (k := 0) h124_0
  replace e124 : w.w_124_0 = w.w_111_4 ⟨0, by decide⟩ := e124
  obtain ⟨_, e125⟩ := familyGetStatic_eq (k := 1) h125_0
  replace e125 : w.w_125_0 = w.w_111_4 ⟨1, by decide⟩ := e125
  obtain ⟨_, e127⟩ := familyGetStatic_eq (k := 0) h127_0
  replace e127 : w.w_127_0 = w.w_111_5 ⟨0, by decide⟩ := e127
  obtain ⟨_, e128⟩ := familyGetStatic_eq (k := 1) h128_0
  replace e128 : w.w_128_0 = w.w_111_5 ⟨1, by decide⟩ := e128
  have hloop := sum4 (count := 111) (init := (
      w.w_112_0 + w.w_113_0,
      w.w_115_0 + w.w_116_0,
      w.w_118_0 + w.w_119_0,
      w.w_121_0 + w.w_122_0,
      w.w_124_0 + w.w_125_0,
      w.w_127_0 + w.w_128_0, ()))
    (final := (w.w_130_0, w.w_130_1, w.w_130_2, w.w_130_3, w.w_130_4, w.w_130_5, ())) h130_5
  simp only [addCells, Prod.mk.injEq] at hloop
  obtain ⟨l0, l1, l2, l3, l4, l5, -⟩ := hloop
  have m0 : w.w_130_0 = ∑ i : Fin 113, w.w_111_0 i := by rw [l0, e112, e113]; exact sum_cells _
  have m1 : w.w_130_1 = ∑ i : Fin 113, w.w_111_1 i := by rw [l1, e115, e116]; exact sum_cells _
  have m2 : w.w_130_2 = ∑ i : Fin 113, w.w_111_2 i := by rw [l2, e118, e119]; exact sum_cells _
  have m3 : w.w_130_3 = ∑ i : Fin 113, w.w_111_3 i := by rw [l3, e121, e122]; exact sum_cells _
  have m4 : w.w_130_4 = ∑ i : Fin 113, w.w_111_4 i := by rw [l4, e124, e125]; exact sum_cells _
  have m5 : w.w_130_5 = ∑ i : Fin 113, w.w_111_5 i := by rw [l5, e127, e128]; exact sum_cells _
  have hA : (∑ i : Fin 113, ![![w.w_111_0 i, w.w_111_1 i], ![w.w_111_2 i, w.w_111_3 i]]) =
      ![![w.w_130_0, w.w_130_1], ![w.w_130_2, w.w_130_3]] := by
    funext k j
    fin_cases k <;> fin_cases j <;> simp [Finset.sum_apply, m0, m1, m2, m3]
  have hc : (∑ i : Fin 113, ![w.w_111_4 i, w.w_111_5 i]) = ![w.w_130_4, w.w_130_5] := by
    funext j
    fin_cases j <;> simp [Finset.sum_apply, m4, m5]
  rw [hA, hc] at hsum
  refine ⟨?_, va, fun i j row column ↦ hva i j row column, v, hsum, fun i j row column ↦ hvp i j row column⟩
  rw [← hA]
  exact Finset.sum_congr rfl fun i _ ↦ hkeys i

end LwrProof
