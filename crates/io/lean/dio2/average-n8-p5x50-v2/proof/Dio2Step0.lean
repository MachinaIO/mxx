    (hp : MxxExponentLut.Rel next
      (fun r c ↦ MxxExponentLut.rowOf (generatedRoot.w_872_3 co (StepTransition.partIndex ⟨1, by decide⟩ c)) r)
      (fun c ↦ reducePoly modulus_0 8 (target (StepTransition.partIndex ⟨1, by decide⟩ c)) • generatedRoot.w_57_0 co)
      (StepTransition.nextRows co ⟨1, by decide⟩) 8) :
    MxxExponentLut.Rel next (keyPairG model key modulus_0 25 [114, 110, 115, 45, 98, 103, 103, 47, 114, 111, 111, 116, 45, 105, 110, 112, 117, 116, 47, 100, 105, 111, 50, 47, 108, 97, 98, 101, 108, 45, 48] [.bytes [109, 101, 109, 98, 101, 114], .u64Le (1)])
      (fun c ↦ reducePoly modulus_0 8 (value c) • generatedRoot.w_57_0 co)
      (StepTransition.nextRows co ⟨1, by decide⟩) 8 := by
  refine rel_congr hp (fun r j ↦ ?_) (fun j ↦ by rw [hv]) (fun _ ↦ rfl) le_rfl
  rw [target_nonlabel_key co F _ 1 (by decide) j (by simp only [StepTransition.partIndex]; omega)
    (by simp only [StepTransition.partIndex]; omega)]
  fin_cases j <;> fin_cases r <;> simp only [Fin.zero_eta, Fin.mk_one, Fin.isValue, Step0Targets.pairIndex]
  · rw [Step0Targets.familyPack_entry F.c35.h871_0 _ 2 (by simp) rfl]
    simp only [List.get_eq_getElem, List.getElem_cons_zero, List.getElem_cons_succ]
    rw [modulusReduce_same (by decide) F.c31.h767_0, (concatRows_two F.c31.h766_0).1,
      MxxExponentLut.hashSample_eq F.c31.h764_0, hseed]
    rfl
  · rw [Step0Targets.familyPack_entry F.c35.h871_0 _ 2 (by simp) rfl]
    simp only [List.get_eq_getElem, List.getElem_cons_zero, List.getElem_cons_succ]
    rw [modulusReduce_same (by decide) F.c31.h767_0, (concatRows_two F.c31.h766_0).2,
