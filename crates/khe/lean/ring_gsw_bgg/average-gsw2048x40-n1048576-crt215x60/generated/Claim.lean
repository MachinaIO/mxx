import Backend
import Stage_keygen
import Stage_encrypt
import Stage_evaluate
import Stage_decrypt
import Requirement_0
import Ideal

set_option maxRecDepth 16384
set_option maxHeartbeats 2000000

namespace GeneratedClaim

structure ExternalInputs where
  input_0 : ByteArray
  input_1 : Fin 15057592995680 → Int
  input_2 : Fin 361 → Int
  input_3 : Fin 5435791071440480 → Int
  input_4 : Fin 5435791071440480 → Int
  input_5 : Fin 5435791071440480 → Int
  input_6 : Fin 1 → Int

def ValidExternals (external : ExternalInputs) : Prop :=
  (external.input_0).size = 32 ∧
  (∀ contract_i_0 : Fin 15057592995680, ((0 : Int) ≤ (external.input_1 contract_i_0) ∧ (external.input_1 contract_i_0) ≤ (1 : Int))) ∧
  (∀ contract_i_0 : Fin 361, ((0 : Int) ≤ (external.input_2 contract_i_0) ∧ (external.input_2 contract_i_0) ≤ (15057592995680 : Int))) ∧
  (∀ contract_i_0 : Fin 5435791071440480, ((0 : Int) ≤ (external.input_3 contract_i_0) ∧ (external.input_3 contract_i_0) ≤ (5 : Int))) ∧
  (∀ contract_i_0 : Fin 5435791071440480, ((0 : Int) ≤ (external.input_4 contract_i_0) ∧ (external.input_4 contract_i_0) ≤ (15057592995679 : Int))) ∧
  (∀ contract_i_0 : Fin 5435791071440480, ((0 : Int) ≤ (external.input_5 contract_i_0) ∧ (external.input_5 contract_i_0) ≤ (15057592995679 : Int))) ∧
  (∀ contract_i_0 : Fin 1, ((0 : Int) ≤ (external.input_6 contract_i_0) ∧ (external.input_6 contract_i_0) ≤ (15057592995679 : Int)))

structure Execution where
  «stage_0» : Mxx.Primitives.ExactMatrix  1048576 1 1
  «stage_1» : (Fin 15057592995680 → Mxx.Primitives.ExactMatrix  1048576 1 12900) × Mxx.Primitives.ExactMatrix  1048576 1 12900 × Unit
  «stage_2» : Mxx.Primitives.ExactMatrix  1048576 2 1 × Mxx.Primitives.ExactMatrix  1048576 1 1 × Unit
  «stage_3» : Bool
  «requirement_0» : Bool
  «ideal» : Bool

def stage_0_params : Stage_keygen.Params := { «depth» := (361 : Int), «instance_width» := (26214400 : Int), «max_layer_width» := (15057592995680 : Int), «witness_width» := (0 : Int) }

def stage_1_params : Stage_encrypt.Params := { «depth» := (361 : Int), «instance_width» := (26214400 : Int), «max_layer_width» := (15057592995680 : Int), «witness_width» := (0 : Int) }

def stage_2_params : Stage_evaluate.Params := { «depth» := (361 : Int), «instance_width» := (26214400 : Int), «max_layer_width» := (15057592995680 : Int), «witness_width» := (0 : Int) }

def stage_3_params : Stage_decrypt.Params := { «depth» := (361 : Int), «instance_width» := (26214400 : Int), «max_layer_width» := (15057592995680 : Int), «witness_width» := (0 : Int) }

def requirement_0_params : Requirement_0.Params := { «depth» := (361 : Int), «instance_width» := (26214400 : Int), «max_layer_width» := (15057592995680 : Int), «witness_width» := (0 : Int) }

def ideal_params : Ideal.Params := { «depth» := (361 : Int), «instance_width» := (26214400 : Int), «max_layer_width» := (15057592995680 : Int), «witness_width» := (0 : Int) }

def Runs (hashModel : MxxRuntime.HashModel) (external : ExternalInputs) (tape : MxxRuntime.SampleTape)
    (execution : Execution) : Prop :=
  ValidExternals external ∧
  Stage_keygen.generatedRoot tape [0] stage_0_params (()) execution.«stage_0» ∧
  Stage_encrypt.generatedRoot Backend.backend hashModel tape [1] stage_1_params ((execution.«stage_0», external.input_0, external.input_1, ())) execution.«stage_1» ∧
  Stage_evaluate.generatedRoot Backend.backend hashModel tape [2] stage_2_params ((execution.«stage_1».1, external.input_0, external.input_1, external.input_2, execution.«stage_1».2.1, external.input_3, external.input_4, external.input_5, external.input_6, ())) execution.«stage_2» ∧
  Stage_decrypt.generatedRoot tape [3] stage_3_params ((execution.«stage_2».2.1, execution.«stage_0», execution.«stage_2».1, ())) execution.«stage_3» ∧
  Requirement_0.generatedRoot tape [4] requirement_0_params ((external.input_2, external.input_3, external.input_4, external.input_5, external.input_6, ())) execution.«requirement_0» ∧
  Ideal.generatedRoot tape [5] ideal_params ((external.input_1, external.input_2, external.input_3, external.input_4, external.input_5, external.input_6, ())) execution.«ideal» ∧
  execution.«requirement_0» = true

/-- Executions whose endpoint differs from the ideal one are rare. -/
def CorrectnessClaim : Prop :=
  ∀ hashModel external,
    MxxRuntime.tapeMeasure {tape | ∃ execution, Runs hashModel external tape execution ∧
      ¬ (execution.«stage_3» = execution.«ideal»)} ≤ (2 : ENNReal)⁻¹ ^ 128

end GeneratedClaim
