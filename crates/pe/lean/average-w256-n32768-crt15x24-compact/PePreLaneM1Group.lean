theorem lane (hm : m < 15) {key : ByteArray} {tables : Fin 512 → Int}
    {M : Fin 2 → Fin 2 → ExactMatrix Q N 1 30}
    {K00 K01 K10 K11 : Fin 15 → ExactMatrix Q N 1 30}
    {A0 A1 : ExactMatrix Q N 1 60} {outputs : Output}
    (hA0 : concatColumns (M 0 0) (M 0 1) A0)
    (hA1 : concatColumns (M 1 0) (M 1 1) A1)
    (h : Stage_preprocess.parallel_generatedRoot_155 Backend.backend model tape path params m
      (A0, key, A1, K00, K01, K10, K11, tables, ()) outputs) :
    (∀ slot r jj, row (outputRows outputs) slot r 0 jj =
      lutTRow model key ⟨15 + m, by omega⟩ (inputsKey M K00 K01 K10 K11 slot) r jj) ∧
    (∀ r j, keyOf (outputKey outputs) r j =
      ∑ slot : Fin 4, pairMul (helperKey model key (kSw (15 + m)) r)
        (actionDigits (row (outputRows outputs) slot 0)
          (row (outputRows outputs) slot 1) j) *
        scalarV (branchCoefC tables 256 (slotIndex slot m) (by norm_num))) := by
  obtain ⟨wit, hbody⟩ := h
  let ctx : Stage_preprocess.parallel_generatedRoot_155.Ctx Backend.backend model tape path params m :=
    ⟨(A0, key, A1, K00, K01, K10, K11, tables, ()), wit⟩
  have F := Stage_preprocess.parallel_generatedRoot_155.facts ctx hbody
  have hA := sourceKeys (M := M) F hm hA0 hA1
  have hout := F.c13.hout
  constructor
  · intro slot r jj
    rw [hout]
    exact rows F hm hA slot r jj
  · intro r j
    rw [hout]
    exact member F hm r j

end PeProof.PreLaneM1Group
