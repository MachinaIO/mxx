            (fun j' ↦ theOutput (blockModSwitchRuns [1099511626049, 1099511625409, 1099511623297, 1099511622593, 1099511622529, 1099511621249, 1099511619841] 1) (![ca0 ⟨coords 2 i, coords_lt 2 i⟩, ca1 ⟨coords 2 i, coords_lt 2 i⟩] j' * alignDigits2))
