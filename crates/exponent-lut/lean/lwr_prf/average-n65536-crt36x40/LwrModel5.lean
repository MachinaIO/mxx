/-- The numerator `A v` of the alignment of a member of `a`: its error after the digits `H`, minus
the row residue, plus the mask-weighted key residues. -/
noncomputable def alignNumer5 (sm : ErrorPoly N) (mk : Fin 2 → Fin 2 → ExactMatrix Q36 N 1 144)
    (ea : Fin 2 → ErrorMatrix N 1 144) (row : Fin 2 → ExactMatrix Q36 N 1 144) (j : Fin 2) :
    ErrorMatrix N 1 124 :=
  ea j * liftMatrix alignDigits5 - downResidue A31 (row j * alignDigits5) +
    sm • downResidue A31 (mk 0 j * alignDigits5) + downResidue A31 (mk 1 j * alignDigits5)

/-- The numerator `p v` of a block-1 cell. -/
noncomputable def cellNumer5 (sm : ErrorPoly N) (mk : Fin 2 → Fin 2 → ExactMatrix Q36 N 1 144)
    (va : Fin 2 → ErrorMatrix N 1 124) (es : Fin 2 → ErrorMatrix N 1 120) (α : ErrorPoly N)
    (As : Fin 2 → Fin 2 → ExactMatrix Q31 N 1 120) (top bot : Fin 2 → ExactMatrix Q30 N 1 116)
    (crow : Fin 2 → ExactMatrix Q31 N 1 124) (cs : Fin 2 → ExactMatrix Q31 N 1 120)
    (pay : ExactMatrix Q31 N 1 1) (j : Fin 2) : ErrorMatrix N 1 116 :=
  pairMul (fun j' ↦ pairMul va (liftMatrix (pubDigits5 As j')) + α • es j')
      (liftMatrix (rhsDigits5 top bot j)) -
    downResidue P31 (pairMul (fun j' ↦ pairMul crow (pubDigits5 As j') +
      matrixMulScalarRight (cs j') pay) (rhsDigits5 top bot j)) +
    sm • downResidue P31 (cellKeyUp5 mk As top bot 0 j) + downResidue P31 (cellKeyUp5 mk As top bot 1 j)

