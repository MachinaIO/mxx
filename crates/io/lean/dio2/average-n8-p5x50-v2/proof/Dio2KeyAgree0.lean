variable {n : Nat}

/-- Every component row of a solved preimage equation is solved as well. -/
theorem rowOf_mul_of_solved {q rows inner columns : Nat}
    {anchor : ExactMatrix q n rows inner} {target : ExactMatrix q n rows columns}
    {preimage : ExactMatrix q n inner columns} (solved : anchor * preimage = target)
    (component : Fin rows) : rowOf anchor component * preimage = rowOf target component := by
  rw [← rowOf_mul, solved]


/-- A block-diagonal witness is uniquely determined, for arbitrary block count. -/
theorem blockDiagonalRuns_unique {q rows columns count : Nat}
    (hr : 0 < rows) (hc : 0 < columns) {block : ExactMatrix q n rows columns}
    {left right : ExactMatrix q n (rows * count) (columns * count)}
    (hl : blockDiagonalRuns count block left) (hrr : blockDiagonalRuns count block right) :
    left = right := by
  have leftDiag := blockDiagonal_isDiag hr hc hl
  have rightDiag := blockDiagonal_isDiag hr hc hrr
  funext row column
  rw [leftDiag row column ⟨row.val % rows, Nat.mod_lt _ hr⟩
      ⟨column.val % columns, Nat.mod_lt _ hc⟩ rfl rfl,
    rightDiag row column ⟨row.val % rows, Nat.mod_lt _ hr⟩
      ⟨column.val % columns, Nat.mod_lt _ hc⟩ rfl rfl]

/-- Two arbitrary loops preserve an agreement of projections, without unrolling iterations. -/
theorem iter_projected_agree {Left Right Value : Type}
    {leftBody : Nat → Left → Left → Prop} {rightBody : Nat → Right → Right → Prop}
    (leftKeys : Left → Value) (rightKeys : Right → Value)
    {count : Nat} {leftInitial leftFinal : Left} {rightInitial rightFinal : Right}
    (initial : leftKeys leftInitial = rightKeys rightInitial)
    (step : ∀ digit lc ln rc rn, leftKeys lc = rightKeys rc →
      leftBody digit lc ln → rightBody digit rc rn → leftKeys ln = rightKeys rn)
    (leftRun : MxxIR.IterRuns leftBody count leftInitial leftFinal)
    (rightRun : MxxIR.IterRuns rightBody count rightInitial rightFinal) :
    leftKeys leftFinal = rightKeys rightFinal := by
  induction leftRun generalizing rightFinal with
  | zero => cases rightRun; exact initial
  | step previous leftStep ih =>
    obtain ⟨rightCurrent, rightPrevious, rightStep⟩ := rightRun.step_of_succ
    exact step _ _ _ _ _ (ih initial rightPrevious) leftStep rightStep

end Dio2Proof
