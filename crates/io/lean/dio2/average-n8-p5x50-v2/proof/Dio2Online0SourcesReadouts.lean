  RefreshTopProof.GenFinal W_Stage_online_0 Dio2Proof.LutKey
open scoped BigOperators

def sourceLutBudget (width previous : Nat) : Nat :=
  (width - 1) * ((25 + 25) * 8 * 1 * 2048 +
    (25 + 25) * 8 * previous * 2048) +
  ((25 + 25) * 8 * 1 * 2048 +
    (25 + 25) * 8 * previous * 2048) +
  width * (8 * 1 * Dio2NoiseCertificate.F)


theorem sigma_readout_graph {model : HashModel} {external : GeneratedClaim.ExternalInputs}
    {execution : GeneratedClaim.Execution} {state : Nat}
    (hrun : W_GeneratedClaim.Runs model external execution)
    (initial : State0Witness model external execution (Xe (n := 8) (2 * state)))
    {message result : Fin 8 → ErrorPoly 8} {budget : Nat}
    (hinput : ∀ member, EncRel initial.mask ((generatedRoot.w_34_0 initial.context.online) member, ((generatedRoot.w_34_1 initial.context.online) member, ((generatedRoot.w_34_2 initial.context.online) member, ((generatedRoot.w_34_3 initial.context.online) member, ((generatedRoot.w_34_4 initial.context.online) member, ((generatedRoot.w_34_5 initial.context.online) member, ()))))))
      (fun component ↦ reducePoly modulus_0 8
        (message member * unitPair initial.payload component) • (generatedRoot.w_57_0 initial.context.online)) budget)
    (hsmall : ∀ member branch, polyNorm
      (substitution (sigmaOf Preprocess.readoutSigmas branch).toNat (Preprocess.readoutOdd branch) (message member)) ≤ 1)
    (hwalsh : ∀ member, (∑ branch : Fin 8, reducePoly modulus_0 8
      (substitution (sigmaOf Preprocess.readoutSigmas branch).toNat (Preprocess.readoutOdd branch) (message member)) *
        Preprocess.readoutCoefficients branch) = reducePoly modulus_0 8 (result member))
    (member : Fin 8) :
    EncRel initial.mask ((generatedRoot.w_35_0 initial.context.online) member, ((generatedRoot.w_35_1 initial.context.online) member, ((generatedRoot.w_35_2 initial.context.online) member, ((generatedRoot.w_35_3 initial.context.online) member, ((generatedRoot.w_35_4 initial.context.online) member, ((generatedRoot.w_35_5 initial.context.online) member, ()))))))
      (fun component ↦ reducePoly modulus_0 8
        (result member * unitPair initial.payload component) • (generatedRoot.w_57_0 initial.context.online))
      (sourceLutBudget 8 budget) := by
  classical
  have hq : 1 < modulus_0 := by norm_num [modulus_0]
  have hG := actual_gadget initial
  have hg := centeredRebaseRuns_self hq (by decide) (generatedRoot.w_57_0 initial.context.online)
  have hseed : (generatedRoot.w_7_0 initial.context.online) = (Claim0.initialInputs external execution).2.2.1 := by
    change initial.context.online.inputs.2.2.2.2.2.2.2.1 = _
    rw [initial.context.online_inputs]
    rfl
  have hhelpers : ∀ branch : Fin 8, Rel initial.mask
      (keyPairG model (generatedRoot.w_7_0 initial.context.online) modulus_0 25 [114, 110, 115, 45, 98, 103, 103, 47, 114, 111, 111, 116, 45, 108, 117, 116, 45, 97]
        [.integer (sigmaOf Preprocess.readoutSigmas branch)])
      (fun component ↦ reducePoly modulus_0 8
        (((1 : Nat) : Int) * unitPair
          (substitution (sigmaOf Preprocess.readoutSigmas branch).toNat (Preprocess.readoutOdd branch) initial.mask) component) • (generatedRoot.w_57_0 initial.context.online))
      ![(generatedRoot.w_13_0 initial.context.online) branch, (generatedRoot.w_14_0 initial.context.online) branch] 1 := by
    intro branch
    have root := Online0Claim.imported_rel_helper_ExpLayout_stride_log2_0_width_log2_3_1 hrun initial hG branch
    have htable : MxxIR.selectInt (Int.ofNat branch.val) Preprocess.readoutSigmas = sigmaOf Preprocess.readoutSigmas branch := by
      rfl
    simpa only [rootKey, ← hseed, htable, autoPlaintext, dif_pos (Preprocess.readoutOdd branch),
      Nat.cast_one, Int.cast_one, one_mul] using root
  have hswitch := PreprocessSwitch.switching_errors (Preprocess.claim_readout_switching initial hG)
  have hswitch' : ∀ branch : Fin 8, ∃ error : Fin 2 → ErrorMatrix 8 1 25,
      (∀ component, CoeffBound (error component) Dio2NoiseCertificate.F) ∧ ∀ component,
      reducePoly modulus_0 8
          (substitution (sigmaOf Preprocess.readoutSigmas branch).toNat (Preprocess.readoutOdd branch) initial.payload) •
          (fam4 (generatedRoot.w_9_0 initial.context.online) (generatedRoot.w_10_0 initial.context.online) (generatedRoot.w_11_0 initial.context.online) (generatedRoot.w_12_0 initial.context.online)) 0 component branch +
        (fam4 (generatedRoot.w_9_0 initial.context.online) (generatedRoot.w_10_0 initial.context.online) (generatedRoot.w_11_0 initial.context.online) (generatedRoot.w_12_0 initial.context.online)) 1 component branch =
      (Preprocess.readoutCoefficients branch * reducePoly modulus_0 8
        ((1 : ErrorPoly 8) * unitPair initial.payload component)) • (generatedRoot.w_57_0 initial.context.online) +
          reduceMatrix modulus_0 8 1 25 (error component) := by
    intro branch
    obtain ⟨error, hbound, heq⟩ := hswitch branch
    exact ⟨error, fun component ↦ coeffBound_mono (hbound component) (Nat.zero_le _), heq⟩
  have hmember := hinput member
  unfold EncRel at hmember
  have relation := LutMemberFlat.rel (by decide) (log := 3) (by decide)
    (L := 7) (by decide) hq Backend.layout0 Online0Claim.layout_some Online0Claim.layout_exact
    (fun index current next hstep ↦ sequential_parallel_generatedRoot_35_18.sem hstep)
    (parallel_generatedRoot_35.sem (initial.context.online_facts.c0.h35_5 member))
    Preprocess.readoutOdd initial.mask_small hG hg
    (by simpa only [Nat.cast_one, Int.cast_one, one_mul] using hmember)
    hhelpers hswitch' (hsmall member) (hwalsh member)
  have encoding := encRel_of_rel relation
    (fun key component ↦ by fin_cases key <;> fin_cases component <;> rfl)
    (fun component ↦ by fin_cases component <;> rfl)
  simpa only [sourceLutBudget, one_mul] using encoding


