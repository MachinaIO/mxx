  -- The position of the step.
  have hw1 : generatedRoot.w_131_0 ctx = ((p : Nat) : Int) := by
    rw [familyStatic_four (k := 1) (by norm_num) F.c4.h131_0, ← hp]
    rfl
  -- The product key at row `r`, block `j` of each position.
  have P0 : ∀ r (j : Fin 2) (l : Fin 30),
      ![![generatedRoot.w_137_0 ctx, generatedRoot.w_143_0 ctx],
        ![generatedRoot.w_146_0 ctx, generatedRoot.w_149_0 ctx]] r j 0 l =
      ∑ a, keyCompanionSum model (generatedRoot.w_3_0 ctx) 0 A r ⟨30 * (j : Nat) + l, by omega⟩ a +
      ∑ a : Fin 30, A r 0 0 a *
